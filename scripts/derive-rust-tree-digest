#!/bin/sh

# SPDX-FileCopyrightText: 2026 Alexey Zhokhov
# SPDX-License-Identifier: Apache-2.0

set -eu

if [ -z "${VELNOR_DERIVE_CLEAN-}" ]; then
  exec /usr/bin/env -i VELNOR_DERIVE_CLEAN=1 LC_ALL=C \
    ${PATH+PATH="$PATH"} ${HOME+HOME="$HOME"} ${RUNNER_TEMP+RUNNER_TEMP="$RUNNER_TEMP"} \
    ${RUSTUP_HOME+RUSTUP_HOME="$RUSTUP_HOME"} ${MISE_RUSTUP_HOME+MISE_RUSTUP_HOME="$MISE_RUSTUP_HOME"} \
    ${CARGO_HOME+CARGO_HOME="$CARGO_HOME"} ${VELNOR_TOOL_RUST+VELNOR_TOOL_RUST="$VELNOR_TOOL_RUST"} \
    ${HTTPS_PROXY+HTTPS_PROXY="$HTTPS_PROXY"} ${https_proxy+https_proxy="$https_proxy"} \
    ${HTTP_PROXY+HTTP_PROXY="$HTTP_PROXY"} ${http_proxy+http_proxy="$http_proxy"} \
    ${NO_PROXY+NO_PROXY="$NO_PROXY"} ${no_proxy+no_proxy="$no_proxy"} \
    ${ALL_PROXY+ALL_PROXY="$ALL_PROXY"} ${all_proxy+all_proxy="$all_proxy"} \
    ${SSL_CERT_FILE+SSL_CERT_FILE="$SSL_CERT_FILE"} ${SSL_CERT_DIR+SSL_CERT_DIR="$SSL_CERT_DIR"} \
    ${CURL_CA_BUNDLE+CURL_CA_BUNDLE="$CURL_CA_BUNDLE"} \
    /bin/sh "$0" "$@"
fi

root=$(cd "$(dirname "$0")/.." && pwd)
catalog="$root/crates/velnor-actions-mise/src/catalog_rust_manifests.rs"
dist="https://static.rust-lang.org/dist"
size_cap=4194304
work=""

die() {
  printf '%s\n' "derive-rust-tree-digest: $1" >&2
  exit 1
}

usage() {
  printf '%s\n' "usage: derive-rust-tree-digest --tree DIR" >&2
  printf '%s\n' "       derive-rust-tree-digest --from-manifest VERSION TARGET COMPONENT[,COMPONENT...]" >&2
  exit 2
}

cleanup() {
  [ -z "$work" ] || rm -rf "$work"
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1"
  else
    shasum -a 256 "$1"
  fi | awk '{ print $1 }'
}

sha256_stdin() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum
  else
    shasum -a 256
  fi | awk '{ print $1 }'
}

get() {
  curl -q --proto '=https' --proto-redir '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 --retry-all-errors --connect-timeout 20 --max-time 600 --output "$1" "$2"
}

no_unsafe_names() {
  (cd "$1" && find . -name '*[!A-Za-z0-9._+-]*') > "$work/unsafe"
  [ ! -s "$work/unsafe" ] || die "unsafe path character under $1"
  (cd "$1" && find . ! -type f ! -type d) > "$work/special"
  [ ! -s "$work/special" ] || die "symlink or special file under $1"
}

components_sha() {
  sort "$1" | sha256_stdin
}

canonical_listing() {
  tree=$1
  comp_sha=$2
  no_unsafe_names "$tree"
  (cd "$tree" && find . -type f) > "$work/files"
  (
    cd "$tree"
    while IFS= read -r f; do
      printf '%s  %s\n' "$(sha256_file "$f")" "$f"
    done < "$work/files"
  ) > "$work/sums"
  (cd "$tree" && find . -printf '%y %#m %s %p\n') > "$work/modes" || die "cannot list $tree with find -printf; GNU find is required"
  awk -v cs="$comp_sha" -v cap="$size_cap" '
    NR == FNR { digest[$2] = $1; next }
    {
      kind = $1
      mode = $2
      path = $4
      if (kind != "f" && kind != "d") exit 2
      rel = (path == ".") ? "." : substr(path, 3)
      if (kind == "d") { print "d", mode, "-", rel; next }
      if (rel == "lib/rustlib/multirust-config.toml") {
        if ($3 + 0 > cap + 0) exit 3
        print "b", mode, "-", rel
        next
      }
      if (rel == "lib/rustlib/components") { print "f", mode, cs, rel; next }
      if (!(path in digest)) exit 4
      print "f", mode, digest[path], rel
    }
  ' "$work/sums" "$work/modes" > "$work/listing.raw" || die "listing failed for $tree: an entry has an unsupported type, multirust-config.toml is over $size_cap bytes, or a file has no digest"
  sort -k4,4 "$work/listing.raw" > "$work/listing"
  [ -s "$work/listing" ] || die "empty listing for $tree"
  tr '\n' '\000' < "$work/listing" | sha256_stdin
}

print_digests() {
  printf 'components_sha256=%s\n' "$1"
  printf 'tree_sha256=%s\n' "$2"
}

print_listing() {
  sed 's/^/listing /' "$work/listing"
}

run_tree() {
  [ -f "$1/lib/rustlib/components" ] || die "$1/lib/rustlib/components is missing"
  comp_sha=$(components_sha "$1/lib/rustlib/components")
  tree_sha=$(canonical_listing "$1" "$comp_sha")
  print_digests "$comp_sha" "$tree_sha"
  print_listing
}

manifest_digest() {
  awk -v v="$1" '
    { s = $0; gsub(/[ ",]/, "", s) }
    s == v { getline s; gsub(/[ ",]/, "", s); print s; exit }
  ' "$catalog"
}

component_tarballs() {
  awk -v comps="$1" '
    BEGIN { while ((getline line < comps) > 0) if (line != "") want[line] = 1 }
    /^\[/ {
      key = ""
      if ($0 ~ /^\[pkg\.[^]]*\.target\.[^]]*\]$/) {
        s = substr($0, 6, length($0) - 6)
        p = index(s, ".target.")
        k = substr(s, 1, p - 1) "-" substr(s, p + 8)
        if (k in want) key = k
      }
      next
    }
    key != "" && $1 == "xz_url" { u = $3; gsub(/"/, "", u); url[key] = u }
    key != "" && $1 == "xz_hash" { h = $3; gsub(/"/, "", h); hash[key] = h }
    END {
      for (k in want) {
        if (!(k in url) || !(k in hash)) exit 1
        print k, url[k], hash[k]
      }
    }
  ' "$2"
}

stage_file() {
  [ ! -e "$2" ] || die "two components install $2"
  cp "$1" "$2"
  if [ -n "$(find "$1" \( -perm -100 -o -perm -010 -o -perm -001 \) -print)" ]; then
    chmod 755 "$2"
  else
    chmod 644 "$2"
  fi
}

stage_component() {
  comp=$1
  url=$2
  hash=$3
  stage=$4
  case "$url" in
    https://static.rust-lang.org/dist/*.tar.xz) ;;
    *) die "untrusted component url $url" ;;
  esac
  get "$work/c.tar.xz" "$url"
  [ "$(sha256_file "$work/c.tar.xz")" = "$hash" ] || die "tarball digest mismatch for $comp"
  rm -rf "$work/x"
  mkdir "$work/x"
  tar -xJf "$work/c.tar.xz" -C "$work/x" --strip-components=1
  rm -f "$work/c.tar.xz"
  while read -r sub; do
    case "$sub" in
      *[!A-Za-z0-9._-]* | "" | . | ..) die "invalid sub-component name $sub" ;;
    esac
    src="$work/x/$sub"
    no_unsafe_names "$src"
    [ -f "$src/manifest.in" ] || die "$comp/$sub has no manifest.in"
    ! grep -qv '^file:' "$src/manifest.in" || die "$comp/$sub manifest.in has an entry that is not a file"
    sed 's/^file://' "$src/manifest.in" | sort > "$work/manifest-files"
    (cd "$src" && find . -type f ! -path ./manifest.in) | sed 's|^\./||' | sort > "$work/srcfiles"
    cmp -s "$work/manifest-files" "$work/srcfiles" || die "$comp/$sub manifest.in does not list exactly the tarball files"
    while IFS= read -r file; do
      case "$file" in
        lib/rustlib/components | lib/rustlib/manifest-* | lib/rustlib/multirust-* | lib/rustlib/rust-installer-version)
          die "$comp/$sub ships $file, which the installer writes"
          ;;
      esac
      mkdir -p "$(dirname "$stage/$file")"
      stage_file "$src/$file" "$stage/$file"
    done < "$work/srcfiles"
    mkdir -p "$stage/lib/rustlib"
    stage_file "$src/manifest.in" "$stage/lib/rustlib/manifest-$comp"
  done < "$work/x/components"
}

normalise_modes() {
  find "$1" -type d -exec chmod 755 {} +
  find "$1/lib/rustlib" -maxdepth 1 -type f -exec chmod 644 {} +
}

write_bookkeeping() {
  stage=$1
  mkdir -p "$stage/lib/rustlib"
  cp "$work/channel.toml" "$stage/lib/rustlib/multirust-channel-manifest.toml"
  : > "$stage/lib/rustlib/multirust-config.toml"
  printf 3 > "$stage/lib/rustlib/rust-installer-version"
  cp "$work/components" "$stage/lib/rustlib/components"
}

run_manifest() {
  version=$1
  target=$2
  case "$version$target" in
    *[!A-Za-z0-9._-]* | "") die "invalid version or target" ;;
  esac
  want=$(manifest_digest "$version")
  case "$want" in
    *[!0-9a-f]* | "") die "rust $version has no channel manifest digest in $catalog" ;;
  esac
  [ "${#want}" -eq 64 ] || die "malformed channel manifest digest for $version"
  printf '%s\n' "$3" | tr ',' '\n' | sort > "$work/components"
  while read -r comp; do
    case "$comp" in
      *[!A-Za-z0-9._-]* | "") die "invalid component name $comp" ;;
    esac
  done < "$work/components"
  get "$work/channel.toml" "$dist/channel-rust-$version.toml"
  [ "$(sha256_file "$work/channel.toml")" = "$want" ] || die "channel-rust-$version.toml is not SHA-256 $want"
  component_tarballs "$work/components" "$work/channel.toml" > "$work/tarballs" || die "a listed component is not in channel-rust-$version.toml"
  stage="$work/stage"
  mkdir "$stage"
  while read -r comp url hash; do
    stage_component "$comp" "$url" "$hash" "$stage"
  done < "$work/tarballs"
  write_bookkeeping "$stage"
  normalise_modes "$stage"
  comp_sha=$(components_sha "$work/components")
  tree_sha=$(canonical_listing "$stage" "$comp_sha")
  print_digests "$comp_sha" "$tree_sha"
  printf 'TreeDigestPin::new("%s", "%s", "%s", "%s"),\n' "$version" "$target" "$comp_sha" "$tree_sha"
  print_listing
}

trap cleanup EXIT
work=$(mktemp -d)

case "${1:-}" in
  --tree)
    [ "$#" -eq 2 ] || usage
    run_tree "$2"
    ;;
  --from-manifest)
    [ "$#" -eq 4 ] || usage
    run_manifest "$2" "$3" "$4"
    ;;
  *) usage ;;
esac
