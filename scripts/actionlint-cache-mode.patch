@@ -0,0 +1,75 @@
+package actionlint
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestCacheModeLiteralAndPositions(t *testing.T) {
+	for _, mode := range []string{"read", "write", "write-only", "none"} {
+		input := "name: cache\non: push\ncache-mode: " + mode + "\njobs:\n  test:\n    cache-mode: " + mode + "\n    runs-on: ubuntu-latest\n    steps:\n      - run: true\n"
+		workflow, errors := Parse([]byte(input))
+		if len(errors) != 0 {
+			t.Fatal(errors)
+		}
+		if workflow.CacheMode.Value != mode || workflow.CacheMode.Pos.Line != 3 || workflow.CacheMode.Pos.Col != 13 {
+			t.Fatalf("workflow mode: %+v", workflow.CacheMode)
+		}
+		job := workflow.Jobs["test"]
+		if job.CacheMode.Value != mode || job.CacheMode.Pos.Line != 6 || job.CacheMode.Pos.Col != 17 {
+			t.Fatalf("job mode: %+v", job.CacheMode)
+		}
+	}
+}
+
+func TestCacheModeRejectsInvalidValues(t *testing.T) {
+	for _, value := range []string{"bogus", "Read", "false", "''", "${{ github.event_name }}", "[read]", "{mode: read}", "!!bool read", "!!int write", "!!null none", "!custom read"} {
+		for _, jobLevel := range []bool{false, true} {
+			input := "on: push\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - run: true\n"
+			if jobLevel {
+				input = strings.Replace(input, "    runs-on:", "    cache-mode: "+value+"\n    runs-on:", 1)
+			} else {
+				input = "cache-mode: " + value + "\n" + input
+			}
+			_, errors := Parse([]byte(input))
+			if len(errors) == 0 {
+				t.Fatalf("accepted cache-mode %q at job=%t", value, jobLevel)
+			}
+		}
+	}
+}
+
+func TestCacheModeAliasesAndDuplicateKeys(t *testing.T) {
+	input := "on: push\ncache-mode: &mode read\njobs:\n  test:\n    cache-mode: *mode\n    runs-on: ubuntu-latest\n    steps:\n      - run: true\n"
+	workflow, errors := Parse([]byte(input))
+	if len(errors) != 0 {
+		t.Fatal(errors)
+	}
+	if workflow.Jobs["test"].CacheMode.Value != "read" {
+		t.Fatal("alias not resolved")
+	}
+	for _, duplicate := range []string{strings.Replace(input, "jobs:", "cache-mode: write\njobs:", 1), strings.Replace(input, "    runs-on:", "    cache-mode: write\n    runs-on:", 1)} {
+		_, errors := Parse([]byte(duplicate))
+		if len(errors) == 0 {
+			t.Fatal("duplicate cache-mode accepted")
+		}
+	}
+}
+
+func TestCacheModeReusableCallAndLintOutput(t *testing.T) {
+	input := []byte("on: push\ncache-mode: read\njobs:\n  call:\n    cache-mode: read\n    uses: owner/repository/.github/workflows/build.yml@0123456789012345678901234567890123456789\n")
+	workflow, errors := Parse(input)
+	if len(errors) != 0 {
+		t.Fatal(errors)
+	}
+	if workflow.Jobs["call"].WorkflowCall == nil {
+		t.Fatal("reusable call lost")
+	}
+	linter, err := NewLinter(nil, &LinterOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if errors, err := linter.Lint("cache.yml", input, nil); err != nil || len(errors) != 0 {
+		t.Fatalf("lint errors=%v error=%v", errors, err)
+	}
+}
