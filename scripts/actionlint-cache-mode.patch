+// Cache access is enforced by server-issued scoped tokens. Expressions are
+// deliberately rejected until their server grammar is independently qualified.
+func (p *parser) parseCacheMode(n *yaml.Node) *String {
+	if n.Kind != yaml.ScalarNode || n.Tag != "!!str" {
+		p.error(n, "cache-mode must be a literal string")
+		return nil
+	}
+	mode := p.parseString(n, false)
+	if mode == nil {
+		return nil
+	}
+	switch mode.Value {
+	case "read", "write", "write-only", "none":
+		return mode
+	default:
+		p.errorf(n, "cache-mode must be one of \"read\", \"write\", \"write-only\", or \"none\"; got %q", mode.Value)
+		return nil
+	}
+}
