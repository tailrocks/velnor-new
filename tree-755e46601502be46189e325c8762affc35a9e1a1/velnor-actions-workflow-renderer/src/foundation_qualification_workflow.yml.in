name: Foundation native qualification
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: foundation-native-qualification
  cancel-in-progress: false
jobs:
  fresh-sdk:
    name: First native Foundation positive
    runs-on: ubuntu-26.04
    timeout-minutes: 20
    steps:
      # Publisher replaces the single marker with its actual reviewed immutable
      # <owner>/<repo>/foundation-qualification@<40-hex-source-SHA> reference.
      # No checkout, run command, downloaded tool, or cache step precedes this.
      - name: Observe fresh SDK and run actual native positives
        id: foundation
        uses: __FOUNDATION_ACTION_REF__
      - name: Retain exact Foundation qualification bytes
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: foundation-native-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ steps.foundation.outputs.control-root }}
          if-no-files-found: error
          retention-days: 7
