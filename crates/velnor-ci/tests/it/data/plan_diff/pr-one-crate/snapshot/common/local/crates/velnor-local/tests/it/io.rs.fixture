        if let Some(parent) = full.parent() {
            std::fs::create_dir_all(parent).unwrap_or_else(|e| unreachable!("{e}"));
        }
        std::fs::write(full, content).unwrap_or_else(|e| unreachable!("{e}"));
    }
        .get(&format!("{REPO}/compare/{}...{}", c.base, c.head))
        .await
        .json();

        .get(&format!("{REPO}/compare/{}...{}", c.base, c.head))
        .await;
    let identical = stub
        .get(&format!("{REPO}/compare/{}...{}", c.head, c.head))
        .await
        .json();
    let diverged = stub
        .get(&format!("{REPO}/compare/{side}...{}", c.head))
        .await
        .json();
    let behind = stub
        .get(&format!("{REPO}/compare/{}...{}", c.head, c.base))
        .await
        .json();
    let by_name = stub
        .get(&format!("{REPO}/compare/main...side"))
        .await
        .json();
    let unknown = stub.get(&format!("{REPO}/compare/{}...nope", c.base)).await;
    let paged = stub
        .get(&format!(
            "{REPO}/compare/{}...{}?per_page=1&page=2",
            c.base, c.head
        ))
        .await;
        format!("http://api.localhost{REPO}/compare/main...side")
    );
    assert_eq!(
        by_name["diff_url"],
        "http://api.localhost/tailrocks/velnor-lab/compare/main...side.diff"
    );
    assert_eq!(
        by_name["permalink_url"],
            "http://api.localhost/tailrocks/velnor-lab/compare/tailrocks:{}...tailrocks:{side}",
            c.head
        )
    );
