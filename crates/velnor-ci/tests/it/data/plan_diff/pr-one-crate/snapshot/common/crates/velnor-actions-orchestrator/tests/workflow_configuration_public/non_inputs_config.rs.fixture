            "pub const D: &str = include_str!(\"../../../docs/x.md\");\n",
        )?;
        put(root, "docs/x.md", "x\n")
    })
        std::os::unix::fs::symlink("../docs/guide.md", root.join("links/guide.md"))?;
        Ok(())
    })
}
