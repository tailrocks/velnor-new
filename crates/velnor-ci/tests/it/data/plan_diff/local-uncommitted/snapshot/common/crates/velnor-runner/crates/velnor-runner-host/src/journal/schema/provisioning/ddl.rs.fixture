include!("cleanup_guards.rs");

pub(super) const BOUND_STORAGE_ATTACHMENTS: &str = "CREATE TABLE IF NOT EXISTS capacity_reservation_bound_storage_attachments (reservation_id INTEGER NOT NULL REFERENCES capacity_reservation_provisioning(reservation_id), role TEXT NOT NULL CHECK (role IN ('runner-root', 'runner-home', 'runner-work', 'runner-tmp', 'runner-shm', 'shared-run', 'dind-root', 'dind-data', 'dind-tmp', 'dind-shm', 'engine-metadata')), observer TEXT NOT NULL CHECK (observer IN ('runner', 'dind', 'probe')), container_id TEXT, mount_target TEXT NOT NULL CHECK (length(mount_target) BETWEEN 1 AND 512), source_target TEXT, read_only INTEGER NOT NULL CHECK (read_only IN (0, 1)), mount_id INTEGER NOT NULL CHECK (mount_id > 0), device_major INTEGER NOT NULL CHECK (device_major >= 0), device_minor INTEGER NOT NULL CHECK (device_minor >= 0), statx_device_major INTEGER NOT NULL CHECK (statx_device_major >= 0), statx_device_minor INTEGER NOT NULL CHECK (statx_device_minor >= 0), fs_type_magic INTEGER NOT NULL CHECK (fs_type_magic >= 0), v16_filesystem_id_0 INTEGER, v16_filesystem_id_1 INTEGER, filesystem_id TEXT CHECK (filesystem_id IS NULL OR (length(filesystem_id) = 16 AND filesystem_id NOT GLOB '*[^0-9a-f]*')), filesystem_instance_digest TEXT NOT NULL CHECK (length(filesystem_instance_digest) = 64 AND filesystem_instance_digest NOT GLOB '*[^0-9a-f]*'), CHECK ((v16_filesystem_id_0 IS NOT NULL AND v16_filesystem_id_1 IS NOT NULL AND filesystem_id IS NULL) OR (v16_filesystem_id_0 IS NULL AND v16_filesystem_id_1 IS NULL AND filesystem_id IS NOT NULL)), CHECK ((observer = 'probe' AND container_id IS NULL AND role = 'engine-metadata') OR (observer IN ('runner', 'dind') AND container_id IS NOT NULL)), CHECK ((role = 'engine-metadata' AND ((observer = 'probe' AND mount_target = '/velnor/docker-root' AND source_target = '/var/lib/docker' AND read_only = 1) OR (observer = 'runner' AND mount_target IN ('/.velnor-runtime-identity', '/opt/velnor/job-facts', '/opt/velnor/source-proof/control', '/opt/velnor/source-proof/inbox') AND source_target IS NULL AND read_only = 1) OR (observer = 'dind' AND mount_target IN ('/.velnor-runtime-identity', '/opt/velnor/job-facts') AND source_target IS NULL AND read_only = 1))) OR (role != 'engine-metadata' AND source_target IS NULL)), PRIMARY KEY (reservation_id, role, observer, mount_target))";
pub(super) const V29_BOUND_STORAGE_ATTACHMENTS: &str = "CREATE TABLE IF NOT EXISTS capacity_reservation_bound_storage_attachments (reservation_id INTEGER NOT NULL REFERENCES capacity_reservation_provisioning(reservation_id), role TEXT NOT NULL CHECK (role IN ('runner-root', 'runner-home', 'runner-work', 'runner-tmp', 'runner-shm', 'shared-run', 'dind-root', 'dind-data', 'dind-tmp', 'dind-shm', 'engine-metadata')), observer TEXT NOT NULL CHECK (observer IN ('runner', 'dind', 'probe')), container_id TEXT, mount_target TEXT NOT NULL CHECK (length(mount_target) BETWEEN 1 AND 512), source_target TEXT, read_only INTEGER NOT NULL CHECK (read_only IN (0, 1)), mount_id INTEGER NOT NULL CHECK (mount_id > 0), device_major INTEGER NOT NULL CHECK (device_major >= 0), device_minor INTEGER NOT NULL CHECK (device_minor >= 0), statx_device_major INTEGER NOT NULL CHECK (statx_device_major >= 0), statx_device_minor INTEGER NOT NULL CHECK (statx_device_minor >= 0), fs_type_magic INTEGER NOT NULL CHECK (fs_type_magic >= 0), v16_filesystem_id_0 INTEGER, v16_filesystem_id_1 INTEGER, filesystem_id TEXT CHECK (filesystem_id IS NULL OR (length(filesystem_id) = 16 AND filesystem_id NOT GLOB '*[^0-9a-f]*')), filesystem_instance_digest TEXT NOT NULL CHECK (length(filesystem_instance_digest) = 64 AND filesystem_instance_digest NOT GLOB '*[^0-9a-f]*'), CHECK ((v16_filesystem_id_0 IS NOT NULL AND v16_filesystem_id_1 IS NOT NULL AND filesystem_id IS NULL) OR (v16_filesystem_id_0 IS NULL AND v16_filesystem_id_1 IS NULL AND filesystem_id IS NOT NULL)), CHECK ((observer = 'probe' AND container_id IS NULL AND role = 'engine-metadata') OR (observer IN ('runner', 'dind') AND container_id IS NOT NULL)), CHECK ((role = 'engine-metadata' AND ((observer = 'probe' AND mount_target = '/velnor/docker-root' AND source_target = '/var/lib/docker' AND read_only = 1) OR (observer = 'runner' AND mount_target IN ('/.velnor-runtime-identity', '/opt/velnor/job-facts', '/opt/velnor/source-proof/control', '/opt/velnor/source-proof/inbox') AND source_target IS NULL AND read_only = 1))) OR (role != 'engine-metadata' AND source_target IS NULL)), PRIMARY KEY (reservation_id, role, observer, mount_target))";
