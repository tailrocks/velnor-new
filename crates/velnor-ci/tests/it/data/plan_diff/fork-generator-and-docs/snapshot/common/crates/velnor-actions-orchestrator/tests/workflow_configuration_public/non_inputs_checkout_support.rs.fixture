        .current_dir(root)
        .output()?)
}

        fs::create_dir_all(file.parent().ok_or("no parent")?)?;
        fs::write(file, body)?;
    }
    git(&["add", "-A"], root)?;
    fs::create_dir_all(root.join(info.trim()).parent().ok_or("no parent")?)?;
    fs::write(root.join(info.trim()), format!("{patterns}\n"))?;
    git(&["read-tree", "-mu", "HEAD"], root)?;
    Ok(())
