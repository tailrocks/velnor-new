                ["releases", "assets", ..] => "release_asset",
                ["releases", ..] => "releases",
                ["actions", "runs", _, "attempts", _, "jobs", ..] => "workflow_jobs",
                ["actions", "runs", ..] => "workflow_runs",
                ["actions", "workflows", ..] => "workflows",
                ["branches", ..] => "branches",
                ["git", ..] => "git_objects",
                ["commits", ..] => "commits",
                ["compare", ..] => "compare",
                ["pulls", ..] => "pull_requests",
                _ => "other",
            },
            None => "other",
