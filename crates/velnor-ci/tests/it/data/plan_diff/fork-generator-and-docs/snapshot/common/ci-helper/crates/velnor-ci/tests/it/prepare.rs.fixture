        .current_dir(dir.join("checkout"))
        .status()
        .unwrap_or_else(|e| unreachable!("{e}"));
    assert!(git.success());
        .current_dir(&checkout)
        .env_clear()
        .env("PATH", format!("{}:/usr/bin:/bin", bin.display()))
        .env("CARGO_HOME", &cargo_home)
        .current_dir(dir.join("checkout"))
        .env("CARGO_HOME", dir.join("cargo-home"))
        .env("RUSTC_BOOTSTRAP", "1")
        .output()
