        && value != ".."
        && !value.as_bytes().ends_with(b".git")
        && value
            .bytes()
        && !value.contains("..")
        && !value.contains("//")
        && value
            .bytes()
                && segment != ".."
                && segment
                    .bytes()
                    .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.'))
