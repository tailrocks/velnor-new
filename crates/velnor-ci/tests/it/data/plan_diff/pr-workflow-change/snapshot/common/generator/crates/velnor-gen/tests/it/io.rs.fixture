        fs::create_dir_all(link.parent().ok_or("no parent")?)?;
        symlink(to, link)?;
        Ok(())
    }
    fs::create_dir_all(path.parent().ok_or("no parent")?)?;
    fs::write(path, text)?;
    Ok(())
}
