#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

case "${1:-}" in
    remove|upgrade|deconfigure|failed-upgrade|abort-upgrade|abort-deconfigure)
        # The state directory belongs to velnor, so prove the durable drain as
        # that account. This command uses one configured monotonic deadline and
        # succeeds only after a complete local quiescence proof.
        # Match the unit's private primary group and Docker socket access. These
        # command-local groups do not change the velnor account's NSS membership.
        /usr/sbin/runuser --user velnor --group velnor --supp-group docker -- /usr/bin/velnor-host \
            --config /etc/velnor-host/host.toml \
            --state /var/lib/velnor-host drain --wait

        # Keep Debian's policy-rc.d decision in control of the manager action.
        # A zero result alone is not proof that the unit stopped.
        /usr/bin/deb-systemd-invoke stop velnor-host.service

        # Read-only root-side postcondition; failure aborts before dpkg replaces
        # or removes package files. No second drain/wait is performed here.
        /usr/bin/velnor-host \
            --config /etc/velnor-host/host.toml \
            --state /var/lib/velnor-host service verify-stopped
        ;;
esac

# cargo-deb may insert generated lifecycle fragments here.
#DEBHELPER#
