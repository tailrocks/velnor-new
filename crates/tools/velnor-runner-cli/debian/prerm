#!/bin/sh
set -eu

# Ask the packaged Rust control plane to prove a safe drain and stop.
# Any nonzero result (including unknown state, deadline, or unavailable API)
# aborts the dpkg operation before files are replaced or removed. The script
# never bypasses policy-rc.d with a direct systemctl call.
case "${1:-}" in
    remove|upgrade|deconfigure|failed-upgrade|abort-upgrade|abort-deconfigure)
        /usr/bin/velnor-host --config /etc/velnor-host/host.toml --state /var/lib/velnor-host service stop
        ;;
esac

# cargo-deb may insert generated lifecycle fragments here.
#DEBHELPER#
