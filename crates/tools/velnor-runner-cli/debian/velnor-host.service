# Velnor controller service. This process has host Docker API access.
# Membership in the docker group is root-equivalent; restrict this host to trusted repositories.
[Unit]
Description=Velnor GitHub Actions Scale Set controller
Documentation=https://github.com/tailrocks/velnor-new
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
PartOf=docker.service
Requires=velnor-host-identity-check.service
After=velnor-host-identity-check.service
# These presence conditions do not authorize work; the daemon must enforce its
# durable first-start drain/admission gate before any runner launch.
ConditionPathExists=/var/lib/velnor-host-package/identity
ConditionFileNotEmpty=/etc/velnor-host/host.toml
ConditionFileNotEmpty=/etc/velnor-host/github-token

[Service]
Type=simple
User=velnor
Group=velnor
SupplementaryGroups=docker
WorkingDirectory=/var/lib/velnor-host
UMask=0077
# Keep subprocess lookup on packaged system tools; do not use /usr/local PATH shims.
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
LoadCredential=github-token:/etc/velnor-host/github-token
ExecStartPre=/usr/bin/velnor-host --config /etc/velnor-host/host.toml --state /var/lib/velnor-host service preflight
ExecStart=/usr/bin/velnor-host --config /etc/velnor-host/host.toml --state /var/lib/velnor-host daemon run
# Persist the admission fence only. systemd then sends SIGTERM to MainPID, whose
# daemon-owned coordinator performs bounded cleanup; this hook is not quiescence proof.
ExecStop=/usr/bin/velnor-host --config /etc/velnor-host/host.toml --state /var/lib/velnor-host drain
Restart=on-failure
RestartSec=5s
KillMode=mixed
# Pin the signal delivered after ExecStop or on stop timeout; the Linux daemon
# coordinator owns cleanup until its configured monotonic deadline.
KillSignal=SIGTERM
TimeoutStopFailureMode=terminate
# The configured drain timeout is capped at 1800s; the unit budget is 1860s.
# The fixed 60s allowance is a design allowance, not a measured cleanup margin.
# This unit remains unqualified until an end-to-end stop/drain bound is measured.
TimeoutStopSec=1860s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# The validated state directory is the sole writable host path for journal and drain state.
ReadWritePaths=/var/lib/velnor-host
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
