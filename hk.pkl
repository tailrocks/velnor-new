// Owner hk standard (mise + mbx + hk): the identical base, plus the builtins this repository's stacks need (Rust with
// a nested runner workspace, Markdown, OpenTofu, GitHub Actions). Top-level `steps` feed the `check`, `fix` and
// `pre-commit` hooks; `pre-push` and `security-audit` are custom hooks. Install with `hk install --mise`; run
// `hk run security-audit` manually or on a schedule.
amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Builtins.pkl"

jobs = 2
fail_fast = false

// fixtures/ holds deliberately broken or foreign test projects (malformed Cargo.toml, invalid .tf, hostile configs);
// docs/proposed/opentofu-goldens/ holds generated golden trees. Neither is source that the stack builtins own.
local fixtureTrees = List("fixtures/**", "docs/proposed/opentofu-goldens/**")

steps {
  ["mise"] = Builtins.mise
  ["gitleaks"] = Builtins.gitleaks
  // `--all`: both workspace roots (root and crates/velnor-runner) are virtual manifests, where a plain
  // `cargo fmt --manifest-path` fails with "Failed to find targets".
  ["cargo_fmt"] = (Builtins.cargo_fmt) {
    exclude = fixtureTrees
    check { command = "cargo fmt --all --check --manifest-path {{workspace_indicator}}" }
    check_list_files { command = "cargo fmt --all --check --manifest-path {{workspace_indicator}} -- --files-with-diff" }
    fix { command = "cargo fmt --all --manifest-path {{workspace_indicator}}" }
  }
  ["cargo_check"] = (Builtins.cargo_check) { exclude = fixtureTrees }
  ["cargo_clippy"] = (Builtins.cargo_clippy) { exclude = fixtureTrees }
  // Both deny.toml files (root and crates/velnor-runner) stay; each governs its own workspace.
  ["cargo_deny"] = (Builtins.cargo_deny) { exclude = fixtureTrees }
  ["rust-toolchain-mirror"] {
    glob = List("mise.toml", "rust-toolchain.toml")
    check = "sh scripts/check-rust-toolchain-mirror.sh"
  }
  ["rumdl"] = (Builtins.rumdl) { exclude = fixtureTrees }
  ["tofu"] = (Builtins.tofu) { exclude = List("fixtures/**", "docs/**") }
  // Native jactionlint (hard decision 10, docs/proposed/workflow-lint-contract.md "Local runs"): check-only, because
  // .github/ is generated; the same flags as CI, reading the generated .github/jactionlint.yaml.
  ["jactionlint"] = (Builtins.jactionlint) {
    fix = null
    check_diff = null
    check = "jactionlint --format gcc --strict-exit --no-online --shellcheck=shellcheck --pyflakes= {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = false
    stage = false
    stash = "none"
    steps {
      ["kingfisher-staged"] { check = "kingfisher scan . --staged --no-validate --redact --no-update-check --baseline-file .kingfisher-baseline.yml" }
    }
  }
  ["pre-push"] {
    steps {
      ["betterleaks-history"] { check = "betterleaks git . --redact" }
    }
  }
  // Full history, all findings redacted. .kingfisher-baseline.yml holds reviewed placeholder/test-fixture findings with
  // written reasons; betterleaks and gitleaks read .betterleaksignore / .gitleaksignore.
  ["security-audit"] {
    steps {
      ["kingfisher-history"] { check = "kingfisher scan . --git-history full --confidence low --no-validate --redact --no-update-check --baseline-file .kingfisher-baseline.yml" }
      ["betterleaks-history"] { check = "betterleaks git . --redact" }
      ["gitleaks-history"] { check = "gitleaks git . --redact --no-banner" }
    }
  }
}
