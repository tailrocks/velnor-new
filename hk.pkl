amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"

jobs = 2
fail_fast = false

local fixtureTrees = List("fixtures/**", "docs/proposed/opentofu-goldens/**")

steps {
  ["mise"] = Builtins.mise
  ["gitleaks"] = Builtins.gitleaks
  ["cargo_fmt"] = (Builtins.cargo_fmt) {
    exclude = fixtureTrees
    workspace_indicator = "Cargo.toml"
    dir = "{{workspace}}"
    prefix = "bash \"$(git rev-parse --show-toplevel)/scripts/hk-workspace-admission\" \"$(pwd -P)/Cargo.toml\" -- mise exec --"
    check = (Builtins.cargo_fmt.check as Config.CommandSpec) {
      command = "cargo fmt --all --check"
    }
    check_list_files = (Builtins.cargo_fmt.check_list_files as Config.CommandSpec) {
      command = "cargo fmt --all --check -- --files-with-diff"
    }
    fix = (Builtins.cargo_fmt.fix as Config.CommandSpec) {
      command = "cargo fmt --all"
    }
  }
  ["cargo_check"] = (Builtins.cargo_check) {
    exclude = fixtureTrees
    workspace_indicator = "Cargo.toml"
    dir = "{{workspace}}"
    prefix = "bash \"$(git rev-parse --show-toplevel)/scripts/hk-workspace-admission\" \"$(pwd -P)/Cargo.toml\" -- mise exec --"
    check = (Builtins.cargo_check.check as Config.CommandSpec) {
      command = "cargo check --locked --quiet"
    }
    fix = (Builtins.cargo_check.fix as Config.CommandSpec) {
      command = "cargo fix --locked --allow-dirty --allow-staged --quiet"
    }
  }
  ["cargo_clippy"] = (Builtins.cargo_clippy) {
    exclude = fixtureTrees
    workspace_indicator = "Cargo.toml"
    dir = "{{workspace}}"
    prefix = "bash \"$(git rev-parse --show-toplevel)/scripts/hk-workspace-admission\" \"$(pwd -P)/Cargo.toml\" -- mise exec --"
    check = (Builtins.cargo_clippy.check as Config.CommandSpec) {
      command = "cargo clippy --locked --quiet"
    }
    fix = (Builtins.cargo_clippy.fix as Config.CommandSpec) {
      command = "cargo clippy --fix --allow-dirty --allow-staged --locked --quiet"
    }
  }
  ["cargo_deny"] = (Builtins.cargo_deny) { exclude = fixtureTrees }
  ["rust-toolchain-mirror"] {
    glob = List("mise.toml", "rust-toolchain.toml")
    check = "sh scripts/check-rust-toolchain-mirror.sh"
  }
  ["rumdl"] = (Builtins.rumdl) { exclude = fixtureTrees }
  ["tofu"] = (Builtins.tofu) { exclude = List("fixtures/**", "docs/**") }
  ["jactionlint"] = (Builtins.jactionlint) {
    fix = null
    check_diff = null
    check = "jactionlint --format gcc --strict-exit --no-online --shellcheck=shellcheck --pyflakes= {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = false
    stage = false
    stash = "none"
    steps {
      ["kingfisher-staged"] { check = "kingfisher scan . --staged --no-validate --redact --no-update-check --baseline-file .kingfisher-baseline.yml" }
    }
  }
  ["pre-push"] {
    steps {
      ["betterleaks-history"] { check = "betterleaks git . --redact" }
    }
  }
  ["security-audit"] {
    steps {
      ["kingfisher-history"] { check = "kingfisher scan . --git-history full --confidence low --no-validate --redact --no-update-check --baseline-file .kingfisher-baseline.yml" }
      ["betterleaks-history"] { check = "betterleaks git . --redact" }
      ["gitleaks-history"] { check = "gitleaks git . --redact --no-banner" }
    }
  }
}
