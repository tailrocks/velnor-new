+    let manifest = manifest_for(&seed, &base, &entries_for(&seed));
+    let plan = plan_at(repo.path(), &base, &seed.head, Some(manifest))?;
+    assert!(
+        plan.warnings
+            .iter()
+            .any(|w| w.contains("baseline_publish:forbidden")),
+        "{:?}",
+        plan.warnings
+    );
+    Ok(())
+}
