+/// Derived task ids from a fresh preparation of `root`.
+fn task_ids_for(root: &Path) -> Result<Vec<String>, Box<dyn std::error::Error>> {
+    let prep = prepare(root)?;
+    Ok(prep
+        .discovery
+        .proposals
+        .iter()
+        .map(|task| task.task_id.clone())
+        .collect())
