+    assert_eq!(script.calls, ["acquire"]);
+    let rows = journal.rows().await.map_err(|err| err.to_string())?;
+    assert_eq!(rows[0].state, IntentState::Uncertain);
+    assert_eq!(rows[0].docker_id, None);
+    let id = rows[0].id;
+    let mut replay = Script {
