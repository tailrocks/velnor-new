+/// Version policy mirrored from the working tree (velnor prepare needs it).
+fn repo_policy() -> Result<String, Box<dyn std::error::Error>> {
+    let path = format!(
+        "{}/../../.velnor/version-policy.toml",
+        env!("CARGO_MANIFEST_DIR")
+    );
+    Ok(fs::read_to_string(path)?)
