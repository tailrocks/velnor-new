+#[tokio::test]
+async fn missing_journal_stays_clear_and_uncreated() -> Result<(), String> {
+    let scratch = Scratch::new("absent")?;
+    let path = scratch.path().join("launch.db");
+    let mark = journal_mark(&path, deadline()).await;
+    if path.exists() {
