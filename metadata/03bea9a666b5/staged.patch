+where
+    T: velnor_runner_github::Transport + super::Lane,
+{
+    let Some(worker) = drive_ready(lane, ready, journal, docker, capacity).await? else {
+        return Ok(false);
+    };
+    workers.push(worker);
+    Ok(stop)
+}
