+            "--offline",
+            "--no-track",
+            "--path",
+            "/tmp/owned-acquisition/tools/codebook/sources",
+            "--root",
+            "/tmp/owned-acquisition/tools/codebook/prefix",
+            "--config",
+            "/tmp/owned-acquisition/tools/codebook/cargo-source.toml",
