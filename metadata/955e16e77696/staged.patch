+        &fixture.homes,
+        test_deadline()?,
+    )?;
+    validate_executable_proofs(&tool, platform, std::slice::from_ref(&proof))?;
+    let mut altered = proof;
+    altered.stdout.push_str("altered");
+    assert!(validate_executable_proofs(&tool, platform, &[altered]).is_err());
+    Ok(())
+}
