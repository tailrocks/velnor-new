+            &item.tool_specs,
+            &item.qualification_digest,
+        )
+        .expect("complete runner identity")
+        .flags
+    };
+    let original = flags(&item);
+    for field in 0..10 {
+        let mut changed = item.clone();
+        let Some(HostContainerProfile::Docker {
+            context,
+            socket_path,
+            socket_uid,
+            cli,
+            daemon,
+        }) = &mut changed.check.runner.container
+        else {
