+#[test]
+fn exact_version_probe_clears_ambient_compiler_selector_and_credentials() -> TestResult {
+    if std::env::var_os("QUALIFIED_PROBE_POISON_CHILD").is_none() {
+        let output = std::process::Command::new(std::env::current_exe()?)
+            .args([
