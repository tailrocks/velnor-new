+                    && name.ends_with(&format!("-{source_id}"))
+                {
+                    let prefix_len = name.len() - source_id.len();
+                    name.truncate(prefix_len);
+                    name.push_str(output_id);
+                }
+            }
+            super::ir::StepKind::Internal { .. } => {}
+        }
+    }
+}
