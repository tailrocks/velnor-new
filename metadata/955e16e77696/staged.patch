+            .env("MISE_CONFIG_FILE", "/poisoned/consumer/mise.toml")
+            .output()?;
+        assert!(output.status.success(), "{output:?}");
+        assert!(String::from_utf8(output.stdout)?.contains("1 passed"));
+        return Ok(());
+    }
+    let fixture = Fixture::new()?;
+    let platform = platform()?;
