+        .ok_or_else(|| {
+            format!(
+                "missing lock-staleness row for {subject} with status {status}:\n{}",
+                run.stdout
+            )
+        })?;
+    if let Some(detail) = detail {
+        assert!(
+            row["detail"]
+                .as_str()
+                .is_some_and(|value| value.contains(detail)),
+            "row detail misses {detail}: {row}"
+        );
+    }
+    Ok(())
