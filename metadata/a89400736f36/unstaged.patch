-def evidence_age_hours(entry):
-    stamp = entry.get("checked_at", top_checked)
-    moment = parse_timestamp(stamp)
-    if moment is None:
-        return (None, stamp)
-    return ((NOW - moment).total_seconds() / 3600, stamp)
