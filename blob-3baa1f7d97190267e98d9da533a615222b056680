ignore:
  - "fixtures/**"

rules:
  # alint-policy fixture: comments carry no policy weight.
  - id: required-files
    kind: file_exists
    paths:
      - Cargo.toml
      - Cargo.lock
      - clippy.toml
      - deny.toml
      - rustfmt.toml
      - CODEOWNERS
      - .alint.yml
      - .config/nextest.toml
      - AGENTS.md
    level: error
    message: "Repo-shape file is missing (rust-quality-contract §1)"

  # alint-policy fixture: comments carry no policy weight.
  # alint-policy fixture: comments carry no policy weight.
  # alint-policy fixture: comments carry no policy weight.
  - id: claude-is-agents-pointer
    kind: command
    paths:
      include: ["**/AGENTS.md"]
      exclude: [".github/**"]
    command:
      - sh
      - -c
      - 'dir=$(dirname "$1") && test -f "$dir/CLAUDE.md" && test ! -L "$dir/CLAUDE.md" && printf "@AGENTS.md\n" | cmp -s - "$dir/CLAUDE.md"'
      - alint-claude-pointer
      - "{path}"
    level: error
    message: "Each AGENTS.md must have a sibling CLAUDE.md regular file with the @AGENTS.md pointer body"

  # alint-policy fixture: comments carry no policy weight.
  - id: agent-instructions-max-lines
    kind: file_max_lines
    paths: "**/AGENTS.md"
    max_lines: 100
    level: error
    message: "AGENTS.md exceeds 100 lines; move detailed guidance into docs"

  - id: agent-instructions-max-size
    kind: file_max_size
    paths: "**/AGENTS.md"
    max_bytes: 16384
    level: error
    message: "AGENTS.md exceeds 16 KiB; move detailed guidance into docs"

  # alint-policy fixture: comments carry no policy weight.
  - id: crates-only
    kind: file_absent
    paths:
      include: ["**/*.rs"]
      exclude:
        - "crates/*/src/**"
        - "crates/*/tests/**"
        - "crates/*/benches/**"
        - "crates/*/examples/**"
        - "crates/*/fixtures/**"
        - "crates/*/testdata/**"
        - "crates/*/build.rs"
        - "crates/*/build_support/**"
        - "crates/test_support/**"
        - "crates/velnor-runner/crates/*/src/**"
        - "crates/velnor-runner/crates/*/tests/**"
        - "crates/velnor-runner/crates/*/benches/**"
        - "crates/velnor-runner/crates/*/examples/**"
        - "crates/velnor-runner/crates/*/build.rs"
    level: error
    message: "Rust sources MUST live in canonical crate dirs (ARCH-1.10 strict placement)"

  # alint-policy fixture: comments carry no policy weight.
  # alint-policy fixture: comments carry no policy weight.
  # alint-policy fixture: comments carry no policy weight.
  # alint-policy fixture: comments carry no policy weight.
  - id: rust-max-lines
    kind: file_max_lines
    paths:
      include:
        - "crates/velnor-actions-*/src/**/*.rs"
        - "crates/velnor-actions-*/tests/**/*.rs"
        - "crates/velnor-archive-guard/src/**/*.rs"
        - "crates/velnor-archive-guard/tests/**/*.rs"
        - "crates/velnor-runner/crates/*/src/**/*.rs"
        - "crates/velnor-runner/crates/*/tests/**/*.rs"
      exclude:
        - "**/fixtures/**"
        - "**/testdata/**"
    max_lines: 400
    level: error
    message: "Rust source exceeds 400 physical lines (rust-quality-contract §5)"
