name: Build Linux velnor-actions
description: Shared steps for Build Linux velnor-actions
runs:
  using: composite
  steps:
    - name: Setup Mise
      uses: jdx/mise-action@2d8d4cafcbd33be2ea37d2b6f5ad595363d1f1ca
      with:
        version: 2026.10.7
        sha256: 6eb1b890e90818417ca34c90dbbd47881917d5cd199f31b63b062ea9c6b18d85
        install: "false"
        env: "false"
        cache: "false"
        cache_save: "false"
    - name: Install pinned Rust and MBX
      env:
        GITHUB_TOKEN: ${{ github.token }}
      shell: bash
      run: "set -eu\n: \"${GITHUB_TOKEN:?missing workflow token}\"\nmise --no-config --no-env --no-hooks install rust@1.99.0 mr-boxington@1.23.0"
    - name: Build velnor-actions with MBX
      shell: bash
      run: "set -eu\nenv -u ACTIONS_ID_TOKEN_REQUEST_TOKEN -u ACTIONS_ID_TOKEN_REQUEST_URL -u ACTIONS_RUNTIME_TOKEN -u GITHUB_TOKEN -u MISE_GITHUB_TOKEN -u GH_TOKEN -u GH_HOST -u GH_CONFIG_DIR mise --no-config --no-env --no-hooks exec rust@1.99.0 mr-boxington@1.23.0 -- mbx build --release --locked --package velnor-actions-cli --bin velnor-actions\ncp target/release/velnor-actions velnor-actions-0.1.7-x86_64-unknown-linux-gnu\ntest -s velnor-actions-0.1.7-x86_64-unknown-linux-gnu"
    - name: Verify ELF architecture
      shell: bash
      run: "set -eu\ndesc=\"$(file -b velnor-actions-0.1.7-x86_64-unknown-linux-gnu)\"\ncase \"$desc\" in\n  *ELF*x86-64*) ;;\n  *) echo \"not an x86-64 ELF: $desc\" >&2; exit 1 ;;\nesac"
    - name: Checksum built bytes
      shell: bash
      run: "set -eu\nsha256sum velnor-actions-0.1.7-x86_64-unknown-linux-gnu > velnor-actions-0.1.7-x86_64-unknown-linux-gnu.sha256"
    - name: Record candidate provenance
      shell: bash
      run: "set -eu\ndigest=\"$(awk -v expected='velnor-actions-0.1.7-x86_64-unknown-linux-gnu' 'NR == 1 { if (NF != 2 || length($1) != 64 || $1 !~ /^[0-9a-f]+$/ || $2 != expected) exit 1; print $1; next } { exit 1 } END { if (NR != 1) exit 1 }' 'velnor-actions-0.1.7-x86_64-unknown-linux-gnu.sha256')\"\njq -n --arg repository \"$GITHUB_REPOSITORY\" --arg commit \"$GITHUB_SHA\" --arg target \"x86_64-unknown-linux-gnu\" --arg asset \"velnor-actions-0.1.7-x86_64-unknown-linux-gnu\" --arg sha256 \"$digest\" --arg rust '1.99.0' --arg mr_boxington '1.23.0' '{\"schema\":1,\"version\":\"0.1.7\",\"repository\":$repository,\"commit\":$commit,\"target\":$target,\"asset\":$asset,\"sha256\":$sha256,\"toolchain\":{\"rust\":$rust,\"mr-boxington\":$mr_boxington}}' > velnor-actions-0.1.7-x86_64-unknown-linux-gnu.provenance.json\nchmod 755 velnor-actions-0.1.7-x86_64-unknown-linux-gnu\nchmod 644 velnor-actions-0.1.7-x86_64-unknown-linux-gnu.sha256 velnor-actions-0.1.7-x86_64-unknown-linux-gnu.provenance.json\ntest -s velnor-actions-0.1.7-x86_64-unknown-linux-gnu.provenance.json\ntest -s velnor-actions-0.1.7-x86_64-unknown-linux-gnu"
    - name: Package candidate preserving executable mode
      shell: bash
      run: "set -eu\ntar -cf generator-linux-assets.tar velnor-actions-0.1.7-x86_64-unknown-linux-gnu velnor-actions-0.1.7-x86_64-unknown-linux-gnu.sha256 velnor-actions-0.1.7-x86_64-unknown-linux-gnu.provenance.json\ntest -s generator-linux-assets.tar"
