#[path = "check_system_tools.rs"]
mod check_system_tools;
pub use check_system_tools::{
    CheckSystemTool, CheckSystemToolKind, is_valid_check_system_build,
                    && segment != ".."
                    && segment
                        .bytes()
                        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.'))
