        ));
    }
            "too_many_legs:{legs}:expected_..={MAX_BUN_SUITE_LEGS}"
        ));
    }
    if playwright
                "bad_retention_days:{days}:expected_1..={MAX_BUN_RETENTION_DAYS}"
