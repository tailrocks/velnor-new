        let facts = detect(&two_roots(&[("a/Cargo.toml", &manifest)])?)?;
        let dependencies = &facts.rust_roots[0].members[0].dependencies;
        "[patch.crates-io]\nmid = { path = \"../../outside\" }\n",
    ] {
        detect(&two_roots(&[("a/Cargo.toml", text)])?)?;
