            .arg(source.parent().ok_or("archive source has no parent")?)
            .arg("package")
            .output()?;
        ensure_success("create package archive", &output)?;
                    .parent()
                    .ok_or("openssl has no parent")?
                    .to_path_buf(),
            );
        }
            .current_dir(self.runner_temp.join("npm"))
            .env_clear()
            .env("PATH", path)
            .env("RUNNER_TEMP", &self.runner_temp)
