//! Completion-claim-bound Docker identity writes.

use std::time::{SystemTime, UNIX_EPOCH};

use crate::error::HostError;
use crate::journal::Journal;
use crate::journal_sql::token_rejected;

impl Journal {
    /// Bind one observed container id only for the current live completion claim.
    ///
    /// Docker observation occurs before this write. The claim generation and expiry
    /// check run in the same transaction as the immutable id binding.
    ///
    /// # Errors
    ///
    /// Returns [`HostError::Journal`] when the database operation fails.
    pub(crate) async fn bind_completion_containers(
        &self,
        id: i64,
        generation: i64,
        runner_id: Option<&str>,
        dind_id: Option<&str>,
    ) -> Result<bool, HostError> {
        self.bind_completion_containers_with_clock(
            id,
            generation,
            runner_id,
            dind_id,
            completion_now,
        )
        .await
    }

    #[cfg(test)]
    pub(crate) async fn bind_completion_containers_with_clock_for_test(
        &self,
        id: i64,
        generation: i64,
        runner_id: Option<&str>,
        dind_id: Option<&str>,
        clock: impl FnOnce() -> Result<i64, HostError>,
    ) -> Result<bool, HostError> {
        self.bind_completion_containers_with_clock(id, generation, runner_id, dind_id, clock)
            .await
    }

    async fn bind_completion_containers_with_clock(
        &self,
        id: i64,
        generation: i64,
        runner_id: Option<&str>,
        dind_id: Option<&str>,
        clock: impl FnOnce() -> Result<i64, HostError>,
    ) -> Result<bool, HostError> {
        if id <= 0
            || generation <= 0
            || runner_id.is_some_and(token_rejected)
            || dind_id.is_some_and(token_rejected)
        {
            return Err(HostError::Journal);
        }
        if runner_id.is_none() && dind_id.is_none() {
            return Ok(true);
        }
        let _write = self.write_guard().await;
        self.sync_lineage().await?;
        let connection = self.connection().await?;
        connection
            .execute("BEGIN IMMEDIATE", ())
            .await
            .map_err(|_| HostError::Journal)?;
        let result = async {
            let now = clock()?;
            if now < 0 {
                return Err(HostError::Journal);
            }
            let changed = connection
                .execute(
                    "UPDATE intents SET docker_id = COALESCE(docker_id, ?1), dind_id = COALESCE(dind_id, ?2) WHERE id = ?3 AND kind = 'launch' AND runner_completed = 1 AND cleanup_proven = 0 AND (?1 IS NULL OR docker_id IS NULL OR docker_id = ?1) AND (?2 IS NULL OR dind_id IS NULL OR dind_id = ?2) AND EXISTS (SELECT 1 FROM completion_cleanup AS c WHERE c.intent_id = intents.id AND c.claim_generation = ?4 AND c.lease_until > ?5)",
                    (runner_id, dind_id, id, generation, now),
                )
                .await
                .map_err(|_| HostError::Journal)?;
            Ok(changed == 1)
        }
        .await;
        let ended = if result.is_ok() {
            connection.execute("COMMIT", ()).await
        } else {
            connection.execute("ROLLBACK", ()).await
        };
        ended.map_err(|_| HostError::Journal)?;
        self.sync_after(result).await
    }
}

fn completion_now() -> Result<i64, HostError> {
    let seconds = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .map_err(|_| HostError::Journal)?
        .as_secs();
    i64::try_from(seconds).map_err(|_| HostError::Journal)
}
