+#[test]
+fn a_sweep_after_group_receipt_can_still_evict_it_over_budget() {
+    let source = tempfile::tempdir().unwrap();
+    let destination = tempfile::tempdir().unwrap();
+    let workspace = source.path().join("workspace");
+    std::fs::create_dir_all(&workspace).unwrap();
+    let group = "github-run-42/over-budget";
+    let identity = "6".repeat(64);
+    let output = store_object(source.path(), &vec![b'x'; 4_096]);
+    let action = store_result(source.path(), "completed action larger than budget", &[output]);
+    record_build_in_group(
+        source.path(),
+        &identity,
+        &workspace,
+        std::slice::from_ref(&action),
+        Some(group),
+    );
+
+    // Group receipts are collector roots, but the store may evict rooted
+    // objects once their closure itself cannot fit within the requested budget.
+    gc(source.path(), 1_024).unwrap();
+    let archive = destination.path().join("job.tar");
+    let error = export_group(source.path(), group, &archive).unwrap_err();
+    println!("over-budget post-task collection: {error:#}");
+    assert!(format!("{error:#}").contains("cache object is missing for"));
+}
