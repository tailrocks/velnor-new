          VELNOR_MBX_IMPORT_OUTCOME: ${{ steps.mbx_cache_import.outcome }}
          VELNOR_MBX_IMPORT_QUIESCED: ${{ steps.mbx_cache_import.outputs.mbx_quiesced }}
          VELNOR_MBX_JOB_IDENTITY: ${{ steps.mbx_cache_preflight.outputs.job_identity }}
          VELNOR_MBX_JOB_ROOT: ${{ steps.mbx_cache_preflight.outputs.job_root }}
          VELNOR_MBX_JOB_ROOT_IDENTITY: ${{ steps.mbx_cache_preflight.outputs.job_root_identity }}
          VELNOR_MBX_PRIMARY_CACHE_DIR: ${{ steps.mbx_cache_preflight.outputs.cache_dir }}
