+#[test]
+fn noncontiguous_factory_steps_are_not_shared() {
+    let ctx = context();
+    let mut shared = shared_fixture(&ctx);
+    for job in shared.jobs.values_mut() {
+        let insertion = job
+            .steps
+            .iter()
+            .position(|step| step.name == steps::MBX_RESTORE_NAME)
