+use std::fs;
+use std::io;
+use std::os::unix::fs::PermissionsExt;
+use std::os::unix::process::ExitStatusExt;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Output, Stdio};
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+static NEXT_CASE: AtomicUsize = AtomicUsize::new(0);
+
+#[derive(Debug, PartialEq, Eq)]
+pub(super) struct Outcome {
+    pub(super) status_code: Option<i32>,
+    pub(super) signal: Option<i32>,
+    pub(super) stdout: Vec<u8>,
+    pub(super) stderr: Vec<u8>,
+    pub(super) github_env: String,
+    pub(super) github_path: String,
+    pub(super) cwd_unchanged: bool,
+    pub(super) runner_entries: Vec<(String, Vec<u8>)>,
+    pub(super) child_survives: bool,
+}
+
+pub(super) struct CasePaths {
+    pub(super) root: PathBuf,
+    pub(super) runner: PathBuf,
+    pub(super) tools: PathBuf,
+    pub(super) rust_root: PathBuf,
+    pub(super) github_env: PathBuf,
+    pub(super) github_path: PathBuf,
+    pub(super) cwd_capture: PathBuf,
+    pub(super) ready: PathBuf,
+    pub(super) child_pid: PathBuf,
+}
+
+pub(super) struct OwnedTempDir {
+    path: Option<PathBuf>,
+    canonical: PathBuf,
+}
+
+impl OwnedTempDir {
+    pub(super) fn path(&self) -> &Path {
+        self.path.as_deref().expect("owned temp path")
+    }
+
+    pub(super) fn cleanup(mut self) -> io::Result<()> {
+        let path = self.path();
+        verify_owned_directory(path, &self.canonical)?;
+        fs::remove_dir_all(path)?;
+        self.path = None;
+        Ok(())
+    }
+}
+
+impl Drop for OwnedTempDir {
+    fn drop(&mut self) {
+        let Some(path) = self.path.as_deref() else {
+            return;
+        };
+        if let Err(error) = (|| {
+            verify_owned_directory(path, &self.canonical)?;
+            fs::remove_dir_all(path)
+        })() {
+            eprintln!("shared-script execution fixture cleanup failed: {error}");
+        }
+    }
+}
+
+fn verify_owned_directory(path: &Path, canonical: &Path) -> io::Result<()> {
+    let metadata = fs::symlink_metadata(path)?;
+    if !metadata.is_dir() || metadata.file_type().is_symlink() {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "temporary execution fixture is not the owned directory",
+        ));
+    }
+    if fs::canonicalize(path)? != canonical {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "temporary execution fixture changed canonical identity",
+        ));
+    }
+    Ok(())
+}
+
+pub(super) fn new_root() -> io::Result<OwnedTempDir> {
+    for _ in 0..128 {
+        let id = NEXT_CASE.fetch_add(1, Ordering::Relaxed);
+        let path = std::env::temp_dir().join(format!(
+            "velnor-shared-script-execution-{}-{id}",
+            std::process::id()
+        ));
+        match fs::create_dir(&path) {
+            Ok(()) => return finish_root_setup(path),
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {}
+            Err(error) => return Err(error),
+        }
+    }
+    Err(io::Error::new(
+        io::ErrorKind::AlreadyExists,
+        "could not allocate a unique execution fixture",
+    ))
+}
+
+fn finish_root_setup(path: PathBuf) -> io::Result<OwnedTempDir> {
+    let setup = (|| {
+        let mut permissions = fs::metadata(&path)?.permissions();
+        permissions.set_mode(0o700);
+        fs::set_permissions(&path, permissions)?;
+        fs::canonicalize(&path)
+    })();
+    match setup {
+        Ok(canonical) => Ok(OwnedTempDir {
+            path: Some(path),
+            canonical,
+        }),
+        Err(setup_error) => match fs::remove_dir(&path) {
+            Ok(()) => Err(setup_error),
+            Err(cleanup_error) => Err(io::Error::new(
+                setup_error.kind(),
+                format!("fixture setup failed ({setup_error}); rollback failed ({cleanup_error})"),
+            )),
+        },
+    }
+}
+
+pub(super) fn case_paths(root: &Path) -> CasePaths {
+    CasePaths {
+        root: root.to_path_buf(),
+        runner: root.join("runner-temp"),
+        tools: root.join("tools"),
+        rust_root: root.join("tools/rust-install"),
+        github_env: root.join("github-env"),
+        github_path: root.join("github-path"),
+        cwd_capture: root.join("cwd-capture"),
+        ready: root.join("mise-ready"),
+        child_pid: root.join("mise-child-pid"),
+    }
+}
+
+pub(super) fn collect_outcome(paths: &CasePaths, output: Output) -> Outcome {
+    let rust_root = paths.rust_root.to_string_lossy();
+    let runner = paths.runner.to_string_lossy();
+    let path_text = fs::read_to_string(&paths.github_path).expect("read GITHUB_PATH");
+    let env_text = fs::read_to_string(&paths.github_env).expect("read GITHUB_ENV");
+    let child_survives =
+        fs::read_to_string(&paths.child_pid).is_ok_and(|pid| pid_is_alive(pid.trim()));
+    Outcome {
+        status_code: output.status.code(),
+        signal: output.status.signal(),
+        stdout: output.stdout,
+        stderr: output.stderr,
+        github_env: env_text.replace(runner.as_ref(), "<RUNNER_TEMP>"),
+        github_path: path_text.replace(rust_root.as_ref(), "<RUST_ROOT>"),
+        cwd_unchanged: fs::read_to_string(&paths.cwd_capture)
+            .is_ok_and(|cwd| cwd.trim_end() == paths.root.to_string_lossy()),
+        runner_entries: tree_entries(&paths.runner),
+        child_survives,
+    }
+}
+
+fn tree_entries(root: &Path) -> Vec<(String, Vec<u8>)> {
+    let mut entries = Vec::new();
+    walk_entries(root, root, &mut entries).expect("snapshot runner tree");
+    entries.sort_by(|left, right| left.0.cmp(&right.0));
+    entries
+}
+
+fn walk_entries(
+    root: &Path,
+    current: &Path,
+    entries: &mut Vec<(String, Vec<u8>)>,
+) -> io::Result<()> {
+    for entry in fs::read_dir(current)? {
+        let entry = entry?;
+        let path = entry.path();
+        let relative = path
+            .strip_prefix(root)
+            .map_err(|error| io::Error::new(io::ErrorKind::InvalidInput, error.to_string()))?
+            .to_string_lossy()
+            .into_owned();
+        let metadata = fs::symlink_metadata(&path)?;
+        if metadata.is_dir() {
+            entries.push((format!("dir:{relative}"), Vec::new()));
+            walk_entries(root, &path, entries)?;
+        } else if metadata.is_file() {
+            entries.push((format!("file:{relative}"), fs::read(&path)?));
+        } else if metadata.file_type().is_symlink() {
+            let target = fs::read_link(&path)?;
+            entries.push((
+                format!("link:{relative}"),
+                target.to_string_lossy().as_bytes().to_vec(),
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn pid_is_alive(pid: &str) -> bool {
+    Command::new("/bin/kill")
+        .args(["-0", pid])
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .status()
+        .is_ok_and(|status| status.success())
+}
