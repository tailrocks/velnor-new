+        calls: BTreeMap::new(),
+        checkouts: BTreeMap::new(),
+        env_steps: BTreeMap::new(),
+        prefixes: BTreeMap::new(),
+        preludes: BTreeMap::new(),
+        postludes: BTreeMap::new(),
+        files: Vec::new(),
+    }
+}
