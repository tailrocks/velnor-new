+#[test]
+fn custom_or_repeated_checkout_is_not_eligible() {
+    let ctx = context();
+    let mut custom = shared_fixture(&ctx);
+    for job in custom.jobs.values_mut() {
+        let StepKind::Action { with, .. } = &mut job.steps[0].kind else {
