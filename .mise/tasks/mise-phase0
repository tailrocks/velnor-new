#!/usr/bin/env bash
# Required real-binary qualification for the official Mise miserc regression.
set -euo pipefail

fail() {
  printf 'mise Phase0: %s\n' "$*" >&2
  exit 1
}

: "${RUNNER_TEMP:?RUNNER_TEMP is required}"
: "${HOME:?HOME is required}"
export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
export MISE_RUSTUP_HOME="${MISE_RUSTUP_HOME:-$RUNNER_TEMP/velnor/rustup}"
export MISE_CARGO_HOME="${MISE_CARGO_HOME:-$RUNNER_TEMP/velnor/cargo}"
export RUSTUP_HOME="${RUSTUP_HOME:-$MISE_RUSTUP_HOME}"
export CARGO_HOME="${CARGO_HOME:-$MISE_CARGO_HOME}"
export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-1.98.1}"
export MISE_NO_AUTO_INSTALL=1

case "$(uname -s)/$(uname -m)" in
  Linux/x86_64)
    asset_platform=linux-x64
    affected_sha=31e6859cf639ed4594906da3fcd0fe2055e9daddae75e9786dbe50b3fb3c0f4a
    fixed_sha=8f5f6660336f572830e33cd9b378d3131e529a0d4c4f0c553776be90a1ba302a
    run_mbx=true
    ;;
  Darwin/arm64|Darwin/aarch64)
    asset_platform=macos-arm64
    affected_sha=d225d1c8ef2934a86be93692a19365fb1df1cd6958a0af7b85909514e0c608a7
    fixed_sha=66d49acecca413c8b334922584982a4907a10588912829873d6c55d0c6d42612
    run_mbx=true
    ;;
  Darwin/x86_64)
    asset_platform=macos-x64
    affected_sha=723e3032f26b9bad34954286e56bc64c8901a9da2b8e3585c550f472a443f600
    fixed_sha=1c6b3d4aaeba8d3b8b57e2d06e4b7825a5134b7aa6e97313bd99db6f22bac21f
    run_mbx=false
    ;;
  *) fail "unsupported runner $(uname -s)/$(uname -m)" ;;
esac

mise_bin="$(command -v mise)" || fail 'pinned Mise command is missing'
mise_bin="$(/usr/bin/perl -MCwd=abs_path -e 'print abs_path($ARGV[0])' "$mise_bin")"
[[ -n "$mise_bin" && -f "$mise_bin" && -x "$mise_bin" && ! -L "$mise_bin" ]] \
  || fail "pinned Mise binary is not a regular executable: $mise_bin"

work_dir="$(mktemp -d "${RUNNER_TEMP%/}/mise-phase0.XXXXXX")"
check_sha256() {
  local path="$1"
  local expected="$2"
  local actual
  case "$(uname -s)" in
    Linux) actual="$(/usr/bin/sha256sum "$path" | awk '{print $1}')" ;;
    Darwin) actual="$(/usr/bin/shasum -a 256 "$path" | awk '{print $1}')" ;;
    *) fail "cannot hash binaries on $(uname -s)" ;;
  esac
  [[ "$actual" == "$expected" ]] || fail "sha256 mismatch for $path: $actual"
}

download_mise() {
  local release="$1"
  local expected="$2"
  local path="$work_dir/mise-v${release}-${asset_platform}"
  local url="https://github.com/jdx/mise/releases/download/v${release}/mise-v${release}-${asset_platform}"
  curl --fail --location --silent --show-error --retry 3 --output "$path" "$url"
  check_sha256 "$path" "$expected"
  chmod 0755 "$path"
  printf '%s' "$path"
}

affected_binary="$(download_mise 2026.10.1 "$affected_sha")"
fixed_binary="$(download_mise 2026.10.2 "$fixed_sha")"
export VELNOR_MISE_AFFECTED_BINARY="$affected_binary"
export VELNOR_MISE_FIXED_BINARY="$fixed_binary"
export VELNOR_MISE_CACHE_QUALIFICATION_BINARY="$mise_bin"

if [[ "$run_mbx" == true ]]; then
  mbx_root="$(mise --no-config --no-env --no-hooks where mr-boxington@1.21.1)"
  mbx_binary="$mbx_root/mbx"
  [[ -f "$mbx_binary" && -x "$mbx_binary" && ! -L "$mbx_binary" ]] \
    || fail "pinned MBX binary is not a regular executable: $mbx_binary"
  export VELNOR_MBX_CACHE_QUALIFICATION_BINARY="$mbx_binary"
fi

printf 'Mise Phase0 platform=%s fixed_sha256=%s affected_sha256=%s\n' \
  "$asset_platform" "$fixed_sha" "$affected_sha"
printf 'Mise binary=%s MBX enabled=%s data_dir=%s\n' \
  "$mise_bin" "$run_mbx" "$MISE_DATA_DIR"

mise --no-config --no-env --no-hooks exec rust@1.98.1 -- cargo fetch --locked
export CARGO_TARGET_DIR="$RUNNER_TEMP/velnor/target/mise-phase0"

run_nextest() {
  mise --no-config --no-env --no-hooks exec \
    rust@1.98.1 aqua:nextest-rs/nextest/cargo-nextest@0.9.146 -- \
    cargo nextest "$@"
}

summary_has_exact_counts() {
  local summary_line="$1"
  local expected_count="$2"
  awk -v expected="$expected_count" '
    $1 == "Summary" && $3 == expected && $4 == "tests" && $5 == "run:" {
      passed = $7
      sub(/,$/, "", passed)
      if ($6 == expected && passed == "passed") valid = 1
    }
    END { exit !valid }
  ' <<<"$summary_line"
}

summary_has_exact_counts 'Summary [0.1s] 4 tests run: 4 passed, 341 skipped' 4 \
  || fail 'summary parser rejected exact selected-test counts'
if summary_has_exact_counts 'Summary [0.1s] 14 tests run: 4 passed' 4; then
  fail 'summary parser accepted 14 selected tests as 4'
fi
if summary_has_exact_counts 'Summary [0.1s] 4 tests run: 14 passed' 4; then
  fail 'summary parser accepted 14 passing tests as 4'
fi

run_suite() {
  local name="$1"
  local manifest="$2"
  local package="$3"
  local target_flag="$4"
  local target_name="$5"
  local module_prefix="$6"
  local expected_count="$7"
  shift 7
  local -a expected_names=("$@")
  local -a target_args=("$target_flag")
  if [[ -n "$target_name" ]]; then
    target_args+=("$target_name")
  fi
  local filter="test(/${module_prefix}/)"
  local list_log="$work_dir/${name}-list.log"
  local run_log="$work_dir/${name}-run.log"
  local selected_count
  local passed_count
  local summary
  local test_id

  run_nextest list --locked --offline --manifest-path "$manifest" \
    --package "$package" "${target_args[@]}" --run-ignored only \
    -E "$filter" --list-type full --message-format oneline 2>&1 | tee "$list_log"
  selected_count="$(grep -oF -- "$module_prefix" "$list_log" | wc -l | tr -d '[:space:]')"
  [[ "$selected_count" == "$expected_count" ]] \
    || fail "$name selected $selected_count tests; expected $expected_count"
  for test_name in "${expected_names[@]}"; do
    grep -Fq -- "$test_name" "$list_log" \
      || fail "$name did not list expected test $test_name"
  done

  run_nextest run --profile ci --locked --offline --manifest-path "$manifest" \
    --package "$package" "${target_args[@]}" --run-ignored only \
    -E "$filter" --no-capture --no-tests fail --build-jobs 2 --test-threads 1 \
    2>&1 | tee "$run_log"
  summary="$(grep -E 'Summary .* tests run:' "$run_log" | tail -n 1 || true)"
  summary_has_exact_counts "$summary" "$expected_count" \
    || fail "$name did not report exactly $expected_count passing tests: ${summary:-missing summary}"
  for test_name in "${expected_names[@]}"; do
    test_id="${module_prefix}${test_name}"
    awk -v test_id="$test_id" '
      substr($0, length($0) - length(test_id) + 1) == test_id {
        if ($0 ~ /^[[:space:]]*PASS[[:space:]]/) passed++
        if ($0 ~ /^[[:space:]]*(SKIP|FAIL|TIMEOUT|LEAK)[[:space:]]/) skipped++
      }
      END { exit !(passed == 1 && skipped == 0) }
    ' "$run_log" \
      || fail "$name expected one PASS and no selected skip/failure for $test_id"
  done
}

run_suite phase0-miserc crates/velnor-actions-mise/Cargo.toml \
  velnor-actions-mise --test velnor_mise impl_miserc_isolation:: 4 \
  affected_release_controls_fail_for_both_no_config_selectors \
  fixed_release_flag_and_environment_matrix_skips_all_miserc_layers \
  no_selector_controls_reach_each_malformed_config_layer \
  product::production_command_keeps_no_config_guards_with_a_real_binary

if [[ "$run_mbx" == true ]]; then
  run_suite stock-mbx-cli crates/velnor-actions-workflow-renderer/Cargo.toml \
    velnor-actions-workflow-renderer --lib "" stock_mbx_bundle_cli_tests:: 8 \
    lifecycle_tests::generated_mbx_steps_cover_miss_hit_and_separate_corruption_fallbacks \
    lifecycle_tests::generated_restore_failure_runs_producer_cold_and_disables_save \
    failure_tests::generated_import_rejects_noncanonical_private_paths \
    failure_tests::generated_preflight_rejects_symlink_temp_and_reserved_path_collisions \
    failure_tests::generated_export_skips_empty_group \
    failure_tests::generated_export_hard_fails_before_save_on_wrong_identity \
    failure_tests::generated_export_failure_skips_cache_save \
    predicate_tests::generated_object_predicate_rejects_empty_symlink_and_hardlink_trees
fi
