//! Profile evidence cases.
use velnor_actions_rust::{
    CompileDriver, EvidenceFile, NEXTEST_RECOMMENDATION, PERSIST_EVIDENCE, ProfileError,
    ProfileInputs, TestRunner, detect_profile, evidence_scan_excluded, is_generated_output,
};

/// Wrap `content` read from `path` as evidence input.
fn file<'a>(path: &'a str, content: &'a str) -> EvidenceFile<'a> {
    EvidenceFile { path, content }
}

/// Recommendation codes of an outcome, in order.
fn codes(outcome: &velnor_actions_rust::ProfileOutcome) -> Vec<&str> {
    outcome
        .recommendations
        .iter()
        .map(|item| item.code.as_str())
        .collect()
}

#[test]
fn tool_setting_selects_mbx() {
    let inputs = ProfileInputs {
        tool_config: Some(file("mise.toml", "[tools.rust]\nmr_boxington = true\n")),
        ..ProfileInputs::default()
    };
    let outcome = detect_profile(&inputs);
    let Ok(outcome) = outcome else {
        panic!("tool setting must select a profile");
    };
    assert_eq!(outcome.profile.compile_driver, CompileDriver::Mbx);
    assert_eq!(outcome.profile.test_runner, TestRunner::CargoTest);
    assert_eq!(outcome.profile.evidence.len(), 1);
    assert_eq!(outcome.profile.evidence[0].path, "mise.toml");
    assert_eq!(outcome.profile.evidence[0].line, 2);
    assert_eq!(codes(&outcome), vec![NEXTEST_RECOMMENDATION]);
}

#[test]
fn tool_pin_without_setting_is_not_evidence() {
    let inputs = ProfileInputs {
        tool_config: Some(file("mise.toml", "[tools]\nmr-boxington = \"1.2.3\"\n")),
        ..ProfileInputs::default()
    };
    let Ok(outcome) = detect_profile(&inputs) else {
        panic!("tool pin must fall back to defaults");
    };
    assert_eq!(outcome.profile.compile_driver, CompileDriver::Cargo);
    assert_eq!(
        outcome.profile.evidence,
        [] as [velnor_actions_rust::Evidence; 0]
    );
    assert_eq!(
        codes(&outcome),
        vec![NEXTEST_RECOMMENDATION, PERSIST_EVIDENCE]
    );
}

#[test]
fn rustc_wrapper_naming_mbx_selects_mbx() {
    let inputs = ProfileInputs {
        cargo_configs: vec![file(
            ".cargo/config.toml",
            "[build]\nrustc-wrapper = \"mbx\"\n",
        )],
        ..ProfileInputs::default()
    };
    let Ok(outcome) = detect_profile(&inputs) else {
        panic!("rustc wrapper must select MBX");
    };
    assert_eq!(outcome.profile.compile_driver, CompileDriver::Mbx);
    let plain = ProfileInputs {
        cargo_configs: vec![file(
            ".cargo/config.toml",
            "[build]\nrustc-wrapper = \"sccache\"\n",
        )],
        ..ProfileInputs::default()
    };
    let Ok(plain) = detect_profile(&plain) else {
        panic!("plain wrapper must fall back");
    };
    assert_eq!(plain.profile.compile_driver, CompileDriver::Cargo);
}

