#[test]
fn handwritten_workflow_invoking_mbx_is_strong_evidence() {
    let inputs = ProfileInputs {
        handwritten_workflows: vec![file(
            ".github/workflows/ci.yml",
            "jobs:\n  build:\n    steps:\n      - run: mbx clippy --package a\n",
        )],
        ..ProfileInputs::default()
    };
    let Ok(outcome) = detect_profile(&inputs) else {
        panic!("hand-written workflow must count as evidence");
    };
    assert_eq!(outcome.profile.compile_driver, CompileDriver::Mbx);
    assert_eq!(
        codes(&outcome),
        vec![NEXTEST_RECOMMENDATION, PERSIST_EVIDENCE]
    );
}

#[test]
fn generated_output_is_never_evidence() {
    let generated = "# Generated by Velnor Actions 1.2.3; edit .velnor/config.toml and regenerate.\nrun: mbx clippy\nrun: cargo nextest run\n";
    assert!(is_generated_output(generated));
    let inputs = ProfileInputs {
        executables: vec![file("preview/.github/workflows/ci.yml", generated)],
        tool_config: Some(file("mise.toml", generated)),
        ..ProfileInputs::default()
    };
    let Ok(outcome) = detect_profile(&inputs) else {
        panic!("generated output must fall back to defaults");
    };
    assert_eq!(outcome.profile.compile_driver, CompileDriver::Cargo);
    assert_eq!(outcome.profile.test_runner, TestRunner::CargoTest);
    assert_eq!(
        outcome.profile.evidence,
        [] as [velnor_actions_rust::Evidence; 0]
    );
}

#[test]
fn scan_excludes_output_docs_locks_and_caches() {
    for path in [
        ".github/workflows/ci.yml",
        "README.md",
        "docs/guide.md",
        "CHANGELOG.rst",
        "Cargo.lock",
        "mise.lock",
        "crates/a/Cargo.lock",
        "target/debug/build",
        "crates/a/target/debug",
        ".git/config",
    ] {
        assert!(evidence_scan_excluded(path), "must be excluded: {path}");
    }
    for path in [
        "src/main.rs",
        ".mise/tasks/test",
        "scripts/check.sh",
        "mise.toml",
        ".cargo/config.toml",
    ] {
        assert!(!evidence_scan_excluded(path), "must be scanned: {path}");
    }
}

#[test]
fn comments_and_pins_are_not_evidence() {
    let inputs = ProfileInputs {
        executables: vec![file(
            "scripts/check.sh",
            "# mbx clippy --package a\nmise use mr-boxington@1.2.3\n",
        )],
        handwritten_workflows: vec![file(
            ".github/workflows/ci.yml",
            "steps:\n  - uses: jdx/mr-boxington-action@v1\n  - uses: taiki-e/install-action@nextest\n",
        )],
        ..ProfileInputs::default()
    };
    let Ok(outcome) = detect_profile(&inputs) else {
        panic!("comments and pins must fall back to defaults");
    };
    assert_eq!(
        outcome.profile.evidence,
        [] as [velnor_actions_rust::Evidence; 0]
    );
    assert_eq!(outcome.profile.compile_driver, CompileDriver::Cargo);
}

#[test]
fn nextest_invocation_selects_nextest() {
    let inputs = ProfileInputs {
        executables: vec![file("scripts/test.sh", "cargo nextest run --package a\n")],
        ..ProfileInputs::default()
    };
    let Ok(outcome) = detect_profile(&inputs) else {
        panic!("nextest invocation must select Nextest");
    };
    assert_eq!(outcome.profile.test_runner, TestRunner::CargoNextest);
    assert_eq!(outcome.profile.compile_driver, CompileDriver::Cargo);
    let via_mbx = ProfileInputs {
        executables: vec![file("scripts/test.sh", "mbx nextest run --package a\n")],
        ..ProfileInputs::default()
    };
    let Ok(via_mbx) = detect_profile(&via_mbx) else {
        panic!("mbx nextest must select both");
    };
    assert_eq!(via_mbx.profile.test_runner, TestRunner::CargoNextest);
    assert_eq!(via_mbx.profile.compile_driver, CompileDriver::Mbx);
}

