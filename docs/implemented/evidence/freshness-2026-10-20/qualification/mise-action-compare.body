dx","followers_url":"https://api.github.com/users/jdx/followers","following_url":"https://api.github.com/users/jdx/following{/other_user}","gists_url":"https://api.github.com/users/jdx/gists{/gist_id}","starred_url":"https://api.github.com/users/jdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jdx/subscriptions","organizations_url":"https://api.github.com/users/jdx/orgs","repos_url":"https://api.github.com/users/jdx/repos","events_url":"https://api.github.com/users/jdx/events{/privacy}","received_events_url":"https://api.github.com/users/jdx/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"720e96afaf7f84d94fc5ff7d76cbee788fa20eed","url":"https://api.github.com/repos/jdx/mise-action/commits/720e96afaf7f84d94fc5ff7d76cbee788fa20eed","html_url":"https://github.com/jdx/mise-action/commit/720e96afaf7f84d94fc5ff7d76cbee788fa20eed"}]}],"files":[{"sha":"567ea666af33a163f1196a7faf32f4ca5a5c06b8","filename":"CHANGELOG.md","status":"modified","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/jdx/mise-action/blob/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/CHANGELOG.md","raw_url":"https://github.com/jdx/mise-action/raw/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/CHANGELOG.md","contents_url":"https://api.github.com/repos/jdx/mise-action/contents/CHANGELOG.md?ref=fc42bcc7ddbf51124c30f95a877a0c5168a3bfde","patch":"@@ -1,5 +1,12 @@\n # Changelog\n \n+---\n+## [5.2.1](https://github.com/jdx/mise-action/compare/v5.2.0..v5.2.1) - 2026-10-16\n+\n+### 🐛 Bug Fixes\n+\n+- require the signed packslip for mise 2026.9.3 and later (#695) by [@jdx](https://github.com/jdx) in [#695](https://github.com/jdx/mise-action/pull/695)\n+\n ---\n ## [5.2.0](https://github.com/jdx/mise-action/compare/v5.1.2..v5.2.0) - 2026-10-16\n "},{"sha":"280010aa7dcfc8c552cb8a8e782fd079c1dc5c7c","filename":"dist/index.js","status":"modified","additions":28,"deletions":3,"changes":31,"blob_url":"https://github.com/jdx/mise-action/blob/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/dist%2Findex.js","raw_url":"https://github.com/jdx/mise-action/raw/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/dist%2Findex.js","contents_url":"https://api.github.com/repos/jdx/mise-action/contents/dist%2Findex.js?ref=fc42bcc7ddbf51124c30f95a877a0c5168a3bfde","patch":"@@ -137522,6 +137522,25 @@ var packslip = /*#__PURE__*/Object.freeze({\n \n const PACKSLIP_ISSUER = 'https://token.actions.githubusercontent.com';\n const PACKSLIP_PROJECT = 'github.com/jdx/mise';\n+/** The first mise release that shipped `packslip.sigstore.json`. */\n+const PACKSLIP_REQUIRED_FROM = [2026, 9, 3];\n+/**\n+ * Releases from `PACKSLIP_REQUIRED_FROM` on always ship a packslip. A version\n+ * that is not three dotted numbers is not a release this action can name, so\n+ * it is held to the same rule rather than skipped.\n+ */\n+function packslipRequired(version) {\n+    const m = /^(\\d+)\\.(\\d+)\\.(\\d+)$/.exec(version);\n+    if (!m)\n+        return true;\n+    for (let i = 0; i < 3; i++) {\n+        const have = Number(m[i + 1]);\n+        if (have !== PACKSLIP_REQUIRED_FROM[i]) {\n+            return have > PACKSLIP_REQUIRED_FROM[i];\n+        }\n+    }\n+    return true;\n+}\n function packslipUrl(version) {\n     return `https://github.com/jdx/mise/releases/download/v${version}/packslip.sigstore.json`;\n }\n@@ -137530,12 +137549,18 @@ function packslipIdentity(version) {\n }\n /**\n  * Returns true once `filePath` is verified against the release's packslip, and\n- * false when the release has no packslip (`fetchBundle` resolves undefined).\n- * Any failure once a packslip exists throws; callers must not fall back.\n+ * false when an older release has no packslip (`fetchBundle` resolves\n+ * undefined). A release from `PACKSLIP_REQUIRED_FROM` on must have one, so a\n+ * missing bundle there throws: it would otherwise let a tampered release\n+ * downgrade to the weaker checksum check. Any failure throws; callers must not\n+ * fall back.\n  */\n async function verifyAgainstPackslip(filePath, version, assetName, fetchBundle, verifier) {\n     const bundle = await fetchBundle(packslipUrl(version));\n     if (bundle === undefined) {\n+        if (packslipRequired(version)) {\n+            throw new Error(`mise v${version} must ship a signed packslip, but ${packslipUrl(version)} was not found`);\n+        }\n         return false;\n     }\n     const statement = await verifier.verifyRelease(bundle, {\n@@ -138465,7 +138490,7 @@ async function verifyDownloadedMiseAsset(filePath, version, assetName) {\n     if (getInput('sha256')) {\n         return;\n     }\n-    // The signed packslip is the primary assertion. Releases without one fall\n+    // The signed packslip is the primary assertion. Releases before 2026.9.3 fall\n     // through to the minisign checksums; a packslip that fails verification\n     // throws and never falls back to the weaker check.\n     if (await verifyAgainstPackslip(filePath, version, assetName, fetchPackslipBundle, packslip)) {"},{"sha":"55d7598b30d3ff87367d2ca7d27d00c633e8a6af","filename":"dist/index.js.map","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/jdx/mise-action/blob/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/dist%2Findex.js.map","raw_url":"https://github.com/jdx/mise-action/raw/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/dist%2Findex.js.map","contents_url":"https://api.github.com/repos/jdx/mise-action/contents/dist%2Findex.js.map?ref=fc42bcc7ddbf51124c30f95a877a0c5168a3bfde"},{"sha":"61a71404d3b9433b8b959908ac4b670691ce806e","filename":"package.json","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/jdx/mise-action/blob/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/package.json","raw_url":"https://github.com/jdx/mise-action/raw/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/package.json","contents_url":"https://api.github.com/repos/jdx/mise-action/contents/package.json?ref=fc42bcc7ddbf51124c30f95a877a0c5168a3bfde","patch":"@@ -1,7 +1,7 @@\n {\n   \"name\": \"mise-action\",\n   \"description\": \"mise tool setup action\",\n-  \"version\": \"5.2.0\",\n+  \"version\": \"5.2.1\",\n   \"author\": \"jdx\",\n   \"type\": \"module\",\n   \"private\": true,"},{"sha":"e5991319490afe4cfb20dd942a8eed91aca4eb0c","filename":"scripts/packslip.test.mjs","status":"modified","additions":35,"deletions":2,"changes":37,"blob_url":"https://github.com/jdx/mise-action/blob/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/scripts%2Fpackslip.test.mjs","raw_url":"https://github.com/jdx/mise-action/raw/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/scripts%2Fpackslip.test.mjs","contents_url":"https://api.github.com/repos/jdx/mise-action/contents/scripts%2Fpackslip.test.mjs?ref=fc42bcc7ddbf51124c30f95a877a0c5168a3bfde","patch":"@@ -2,6 +2,7 @@ import assert from 'node:assert/strict'\n import test from 'node:test'\n import {\n   packslipIdentity,\n+  packslipRequired,\n   packslipUrl,\n   verifyAgainstPackslip\n } from '../src/packslip.ts'\n@@ -113,15 +114,47 @@ test('asset missing from the packslip throws', async () => {\n   )\n })\n \n-test('missing packslip reports false so callers can fall back', async () => {\n+test('a release before the first packslip reports false so callers can fall back', async () => {\n   const v = fakeVerifier()\n   assert.equal(\n-    await verifyAgainstPackslip(good, version, asset, async () => undefined, v),\n+    await verifyAgainstPackslip(\n+      good,\n+      '2026.9.2',\n+      asset,\n+      async () => undefined,\n+      v\n+    ),\n     false\n   )\n   assert.deepEqual(v.calls, [])\n })\n \n+test('a missing packslip on a release that must have one throws', async () => {\n+  const v = fakeVerifier()\n+  await assert.rejects(\n+    verifyAgainstPackslip(good, version, asset, async () => undefined, v),\n+    /must ship a signed packslip/\n+  )\n+  assert.deepEqual(v.calls, [])\n+})\n+\n+test('packslipRequired starts at 2026.9.3', () => {\n+  for (const v of [\n+    '2026.9.3',\n+    '2026.9.18',\n+    '2026.10.0',\n+    '2027.1.0',\n+    '2026.10.11'\n+  ]) {\n+    assert.equal(packslipRequired(v), true, v)\n+  }\n+  for (const v of ['2026.9.2', '2026.8.16', '2025.12.31', '2026.9.0']) {\n+    assert.equal(packslipRequired(v), false, v)\n+  }\n+  assert.equal(packslipRequired('not-a-version'), true)\n+  assert.equal(packslipRequired('2026.9.2-extra'), true)\n+})\n+\n test('a failed verification throws instead of falling back', async () => {\n   const v = fakeVerifier()\n   v.verifyRelease = async () => {"},{"sha":"53bea26520c49b5d642663eea961d91eeec15c80","filename":"src/index.ts","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/jdx/mise-action/blob/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/src%2Findex.ts","raw_url":"https://github.com/jdx/mise-action/raw/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/src%2Findex.ts","contents_url":"https://api.github.com/repos/jdx/mise-action/contents/src%2Findex.ts?ref=fc42bcc7ddbf51124c30f95a877a0c5168a3bfde","patch":"@@ -1004,7 +1004,7 @@ async function verifyDownloadedMiseAsset(\n     return\n   }\n \n-  // The signed packslip is the primary assertion. Releases without one fall\n+  // The signed packslip is the primary assertion. Releases before 2026.9.3 fall\n   // through to the minisign checksums; a packslip that fails verification\n   // throws and never falls back to the weaker check.\n   if ("},{"sha":"c895f1a297965a341e30e51ecab353b4229048a4","filename":"src/packslip.ts","status":"modified","additions":31,"deletions":3,"changes":34,"blob_url":"https://github.com/jdx/mise-action/blob/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/src%2Fpackslip.ts","raw_url":"https://github.com/jdx/mise-action/raw/fc42bcc7ddbf51124c30f95a877a0c5168a3bfde/src%2Fpackslip.ts","contents_url":"https://api.github.com/repos/jdx/mise-action/contents/src%2Fpackslip.ts?ref=fc42bcc7ddbf51124c30f95a877a0c5168a3bfde","patch":"@@ -1,6 +1,6 @@\n /**\n  * Verify a downloaded mise release asset against the signed packslip that\n- * every mise release ships (`packslip.sigstore.json`).\n+ * mise releases ship (`packslip.sigstore.json`) from 2026.9.3 on.\n  *\n  * The verifier, digest check and bundle download are injected so the policy\n  * (which identity and tag to require, when to fall back) is testable without\n@@ -11,6 +11,26 @@ import type { ArtifactDigest, VerifiedStatement } from 'packslip'\n export const PACKSLIP_ISSUER = 'https://token.actions.githubusercontent.com'\n export const PACKSLIP_PROJECT = 'github.com/jdx/mise'\n \n+/** The first mise release that shipped `packslip.sigstore.json`. */\n+export const PACKSLIP_REQUIRED_FROM = [2026, 9, 3]\n+\n+/**\n+ * Releases from `PACKSLIP_REQUIRED_FROM` on always ship a packslip. A version\n+ * that is not three dotted numbers is not a release this action can name, so\n+ * it is held to the same rule rather than skipped.\n+ */\n+export function packslipRequired(version: string): boolean {\n+  const m = /^(\\d+)\\.(\\d+)\\.(\\d+)$/.exec(version)\n+  if (!m) return true\n+  for (let i = 0; i < 3; i++) {\n+    const have = Number(m[i + 1])\n+    if (have !== PACKSLIP_REQUIRED_FROM[i]) {\n+      return have > PACKSLIP_REQUIRED_FROM[i]\n+    }\n+  }\n+  return true\n+}\n+\n export interface PackslipVerifier {\n   verifyRelease(\n     bundle: string,\n@@ -30,8 +50,11 @@ export function packslipIdentity(version: string): string {\n \n /**\n  * Returns true once `filePath` is verified against the release's packslip, and\n- * false when the release has no packslip (`fetchBundle` resolves undefined).\n- * Any failure once a packslip exists throws; callers must not fall back.\n+ * false when an older release has no packslip (`fetchBundle` resolves\n+ * undefined). A release from `PACKSLIP_REQUIRED_FROM` on must have one, so a\n+ * missing bundle there throws: it would otherwise let a tampered release\n+ * downgrade to the weaker checksum check. Any failure throws; callers must not\n+ * fall back.\n  */\n export async function verifyAgainstPackslip(\n   filePath: string,\n@@ -42,6 +65,11 @@ export async function verifyAgainstPackslip(\n ): Promise<boolean> {\n   const bundle = await fetchBundle(packslipUrl(version))\n   if (bundle === undefined) {\n+    if (packslipRequired(version)) {\n+      throw new Error(\n+        `mise v${version} must ship a signed packslip, but ${packslipUrl(version)} was not found`\n+      )\n+    }\n     return false\n   }\n   const statement = await verifier.verifyRelease(bundle, {"}]}