.org/@algolia/client-abtesting/-/client-abtesting-5.59.0.tgz\",\n-            \"integrity\": \"sha512-bm2XN0hCSMYwStSsCBT0/PUB2BDxoyR1Lnub3c392HMEy9bi8PUSW8vR6zltVEKWG2t4PQFWMD5C07bmJxGgPg==\",\n+            \"version\": \"5.60.0\",\n+            \"resolved\": \"https://registry.npmjs.org/@algolia/client-abtesting/-/client-abtesting-5.60.0.tgz\",\n+            \"integrity\": \"sha512-eLrG+gFBLcr8S9JuDc75K3jC8irl7v5ZlxSlR4o7N2VCGfmEbKEfu/J/fIuf5MVHV4NOCutyHD7CbxyZEyIzFQ==\",\n             \"license\": \"MIT\",\n             \"dependencies\": {\n-                \"@algolia/client-common\": \"5.59.0\",\n-                \"@algolia/requester-browser-xhr\": \"5.59.0\",\n-                \"@algolia/requester-fetch\": \"5.59.0\",\n-                \"@algolia/requester-node-http\": \"5.59.0\"\n+                \"@algolia/client-common\": \"5.60.0\",\n+                \"@algolia/requester-browser-xhr\": \"5.60.0\",\n+                \"@algolia/requester-fetch\": \"5.60.0\",\n+                \"@algolia/requester-node-http\": \"5.60.0\"\n             },\n             \"engines\": {\n                 \"node\": \">= 14.0.0\"\n             }\n         },\n         \"node_modules/@algolia/client-analytics\": {\n-            \"version\": \"5.59.0\",\n-            \"resolved\": \"https://registry.npmjs.org/@algolia/client-analytics/-/client-analytics-5.59.0.tgz\",\n-            \"integrity\": \"sha512-XOFPOTa69WuqHR6c5tMgnUUwwqQgNSzMpxmhrgA9KmxRf8WIqEa0cokHJvohk5CYb7CZx0xeSL6Bk2IUJ7Lv7Q==\",\n+            \"version\": \"5.60.0\",\n+            \"resolved\": \"https://registry.npmjs.org/@algolia/client-analytics/-/client-analytics-5.60.0.tgz\",\n+            \"integrity\": \"sha512-6Cg5ChVTSz5lP8F+sseoCxL5Jedyo9TSi7crgNNABOFRwlgauVfvZircY712ywpLJCJ7Yw7smEN4eCt9eWRKRg==\",\n             \"license\": \"MIT\",\n             \"dependencies\": {\n-                \"@algolia/client-common\": \"5.59.0\",\n-                \"@algolia/requester-browser-xhr\": \"5.59.0\",\n-                \"