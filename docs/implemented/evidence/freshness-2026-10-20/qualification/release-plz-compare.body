s%2Findex.tsx","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/website%2Fsrc%2Fpages%2Findex.tsx","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/website%2Fsrc%2Fpages%2Findex.tsx?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -68,11 +68,31 @@ export default function Home() {\n         <HomepageFeatures />\n       </main>\n       <QuickStartSection />\n+      <SponsorsSection />\n       <TweetsSection />\n     </Layout>\n   );\n }\n \n+function SponsorsSection() {\n+  return (\n+    <div className={styles.section}>\n+      <div className=\"container text--center\">\n+        <Heading as=\"h2\" className=\"margin-bottom--lg\">\n+          Sponsored by 🤝\n+        </Heading>\n+        <a href=\"https://encore.dev/?utm_source=release-plz&utm_medium=sponsorship&utm_content=website\">\n+          <img className={styles.sponsorLogo} alt=\"Encore\" src=\"img/sponsors/encore.svg\" />\n+        </a>\n+        <p className=\"margin-top--lg margin-bottom--none\">\n+          Want to support Release-plz too?{\" \"}\n+          <a href=\"https://github.com/sponsors/release-plz\">Become a sponsor</a>. ❤️\n+        </p>\n+      </div>\n+    </div>\n+  );\n+}\n+\n function TweetsSection() {\n   const tweetColumns: Tweet[][] = [[], [], []];\n   Tweets.forEach((tweet, i) => tweetColumns[i % 3]!.push(tweet));"},{"sha":"cedc063356be4e2d25e8559bffea6146389c72d7","filename":"website/src/pages/pricing.md","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/website%2Fsrc%2Fpages%2Fpricing.md","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/website%2Fsrc%2Fpages%2Fpricing.md","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/website%2Fsrc%2Fpages%2Fpricing.md?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -13,7 +13,7 @@ Here’s how you can help:\n - **Star**: Give Release-plz a star on [GitHub](https://github.com/release-plz/release-plz). ⭐\n - **Become a Sponsor**: Your financial support helps to dedicate more time to improve\n   Release-plz and develop new features. Sponsor Release-plz development on\n-  [GitHub](https://github.com/sponsors/MarcoIeni). ❤️\n+  [GitHub](https://github.com/sponsors/release-plz). ❤️\n - **Contribute**: Get involved by fixing\n   [issues](https://github.com/release-plz/release-plz/issues). 🚀\n \n@@ -22,7 +22,7 @@ Here’s how you can help:\n If you are using Release-plz at your organization to improve your engineering team's productivity,\n please reflect on the hours Release-plz saves your team every month\n and consider\n-investing a portion of these savings to [sponsor](https://github.com/sponsors/MarcoIeni) the author.\n+investing a portion of these savings to [sponsor](https://github.com/sponsors/release-plz) the author.\n \n By sponsoring, you're enabling the author to focus more on the development of Release-plz, ensuring\n it remains sustainable, up-to-date and secure."},{"sha":"540f4ffb99957e6a252c9518ab896250e8704944","filename":"website/static/img/sponsors/encore.svg","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/website%2Fstatic%2Fimg%2Fsponsors%2Fencore.svg","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/website%2Fstatic%2Fimg%2Fsponsors%2Fencore.svg","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/website%2Fstatic%2Fimg%2Fsponsors%2Fencore.svg?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -0,0 +1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"527.7\" height=\"102.2\" viewBox=\"0 0 527.7 102.2\" role=\"img\" aria-label=\"Encore\"><title>Encore</title><style>path{fill:#111111}@media (prefers-color-scheme:dark){path{f