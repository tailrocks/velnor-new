 in graph.iter().enumerate() {\n+            let current_commit_hash = commit.id.as_str();\n             // Stop lineages that have reached an equal snapshot. Still inspect\n             // ancestors reachable through another lineage: they can contain\n             // surviving changes or another equal snapshot that bounds that lineage.\n             // Without a tag or a published commit bounding the walk, a branch that\n             // changes the package, forked before the release and merged after it,\n             // keeps its fork point and every ancestor of it reachable, so all of\n             // those are inspected.\n-            if retained_changes.skips(&current_commit_hash) {\n+            if retained_changes.skips(current_commit_hash) {\n                 continue;\n             }\n-            checkout_commit(repository, &current_commit_hash)?;\n+            checkout_commit(repository, current_commit_hash)?;\n             // Equality and changed-file checks inspect the same snapshot.\n-            let local_package_files = checkout_package_files.files_at(&current_commit_hash);\n+            let local_package_files = checkout_package_files.files_at(index);\n             if let Some((released_package, released_path)) = released {\n                 let are_packages_equal = self.check_package_equality(\n                     repository,\n@@ -784,12 +789,12 @@ impl Updater<'_> {\n                     // RetainedChanges preserves candidates whose changes survive\n                     // through another lineage.\n                     let ancestors = repository.ancestors_at_paths(\n-                        &current_commit_hash,\n+                        current_commit_hash,\n                         &release_boundaries,\n                         &paths.all(),\n                     )?;\n                     retained_changes.add_boundary(\n-                        &current_commit_hash,\n+                        current_commit_hash,\n                         ancestors,\n                         released_package_files.get(released_path)?,\n                     );\n@@ -801,12 +806,12 @@ impl Updater<'_> {\n             if self.are_changed_files_in_package(\n                 package_path,\n                 repository,\n-                &current_commit_hash,\n+                current_commit_hash,\n                 local_package_files,\n             )? {\n                 diff.commits.push(Commit::new(\n-                    current_commit_hash,\n-                    repository.current_commit_message()?,\n+                    current_commit_hash.to_owned(),\n+                    commit.message()?,\n                 ));\n             }\n         }"},{"sha":"220ed9c1aff85b1d6f32852d0de88c22d06d7372","filename":"crates/release_plz_core/src/command/update/updater/history.rs","status":"modified","additions":7,"deletions":4,"changes":11,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Fupdate%2Fupdater%2Fhistory.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Fupdate%2Fupdater%2Fhistory.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Fupdate%2Fupdater%2Fhistory.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -2,7 +2,7 @@ use std::collections::{HashMap, HashSet};\n \n use anyhow::Context as _;\n use cargo_metadata::camino::{Utf8Path, Utf8PathBuf};\n-use git_cmd::Repo;\n+use git_cmd::{HistoryCommit, Repo};\n use tracing::warn;\n \n use crate::{\n@@ -57,7 +57,7 @@ impl<'a> RetainedChanges<'a> {\n     pub(super) fn new(\n         repository: &'a Repo,\n         head: &str,\n-        graph: &[(String, Vec<String>)],\n+        graph: &[HistoryCommit],\n         paths: &PackagePaths,\n     ) -> anyhow::Result<Self> {\n         // The walked repository can be a temporary copy at a non-canonical path,\n@@ -82,8 +82,11 @@ impl<'a> RetainedChanges<'a> {\n             },\n             released: None,\n             package_files: None,\n-            root: graph.first().map(|(commit, _)| commit.clone()),\n-            parents: graph.iter().cloned().collect(),\n+            root: graph.first().map(|commit| commit.id.clone()),\n+            parents: graph\n+                .iter()\n+                .map(|commit| (commit.id.clone(), commit.parents.clone()))\n+                .collect(),\n             reachable: HashSet::new(),\n             released_ancestors: HashSet::new(),\n         })"},{"sha":"f4b063b0998d0956dbd67f7cdad3e8e7fba58ae8","filename":"crates/release_plz_core/src/command/update/updater/history/package_files.rs","status":"modified","additions":153,"deletions":58,"changes":211,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Fupdate%2Fupdater%2Fhistory%2Fpackage_files.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Fupdate%2Fupdater%2Fhistory%2Fpackage_files.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Fupdate%2Fupdater%2Fhistory%2Fpackage_files.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -22,68 +22,123 @@\n //! absent, as is Git configuration included from a `.rs` file. Hooks and\n //! configuration outside the trees are assumed stable during a walk.\n \n-use anyhow::Context as _;\n-use git_cmd::Repo;\n+use std::iter::Peekable;\n+\n+use git_cmd::{HistoryCommit, Repo};\n use tracing::debug;\n \n use crate::package_compare::PackageFiles;\n \n+/// The number of pairs of consecutive commits that the first batch of a walk\n+/// compares. Each later batch compares twice as many pairs as Git reported on\n+/// in the previous one, and at least as many as the first.\n+const FIRST_BATCH_SIZE: usize = 8;\n+\n /// The package files of the checkouts of a history walk.\n pub(crate) struct CheckoutPackageFiles<'a> {\n     repository: &'a Repo,\n-    /// The last checked-out commit, whose files `files` lists. `None` before the\n-    /// first checkout and when that checkout has, or may have, a checkout hook\n-    /// or a symlinked manifest.\n-    commit: Option<String>,\n+    /// The commits of the walk, in the order it checks out those it doesn't skip.\n+    walk: &'a [HistoryCommit],\n+    /// The comparisons of the last batch: whether only Rust sources differ\n+    /// between each commit of `walk` from position `batch_start` on and the\n+    /// next one, up to the first pair Git didn't report on.\n+    batch: Vec<bool>,\n+    /// The position in `walk` of the first commit of the last batch.\n+    batch_start: usize,\n+    /// The position in `walk` of the last checkout, whose files `files` lists.\n+    /// `None` before the first checkout.\n+    previous: Option<usize>,\n+    /// Whether the last checkout has, or may have, a checkout hook or a\n+    /// symlinked manifest. `None` until a checkout that could reuse `files`\n+    /// needs to know.\n+    prevents_reuse: Option<bool>,\n     files: PackageFiles,\n }\n \n impl<'a> CheckoutPackageFiles<'a> {\n-    /// Prepare to walk the history of `repository`.\n-    pub(crate) fn new(repository: &'a Repo) -> Self {\n+    /// Prepare to check out the commits of `walk` in `repository`.\n+    pub(crate) fn new(repository: &'a Repo, walk: &'a [HistoryCommit]) -> Self {\n         Self {\n             repository,\n-            commit: None,\n+            walk,\n+            batch: Vec::new(),\n+            batch_start: 0,\n+            previous: None,\n+            prevents_reuse: None,\n             files: PackageFiles::default(),\n         }\n     }\n \n-    /// The package files at `commit`, reusing the previous checkout's list when\n-    /// possible. Call this after checking `commit` out, before inspecting the\n-    /// package.\n-    pub(crate) fn files_at(&mut self, commit: &str) -> &PackageFiles {\n-        let reuses = self.commit.take().is_some_and(|previous| {\n-            only_rust_sources_differ(self.repository, &previous, commit).unwrap_or_else(|error| {\n-                debug!(\"cannot compare the trees of {previous} and {commit}: {error:#}\");\n-                false\n-            })\n-        });\n-        if reuses {\n-            // The previous checkout had no checkout hook and no symlinked\n-            // manifest, and source-only differences cannot add either.\n-            if self.files.is_cached() {\n-                debug!(\"reusing historical package file list at {commit}\");\n-            }\n-        } else {\n+    /// The package files at the commit at position `index` of the walk,\n+    /// reusing the previous checkout's list when possible. Call this after\n+    /// checking that commit out, in walk order, before inspecting the package.\n+    pub(crate) fn files_at(&mut self, index: usize) -> &PackageFiles {\n+        let previous = self.previous.replace(index);\n+        if !previous.is_some_and(|previous| self.only_sources_differ(previous, index)) {\n             self.files = PackageFiles::default();\n+            self.prevents_reuse = None;\n+            return &self.files;\n+        }\n+        let commit = &self.walk[index].id;\n+        // Source-only differences can't add or remove a checkout hook or a\n+        // symlinked manifest, so checking this checkout tells about the\n+        // previous one, and the answer holds until the trees differ otherwise.\n+        // Checking only when a list could be reused saves the Git calls at\n+        // checkouts whose successor differs beyond sources.\n+        let prevents_reuse = *self\n+            .prevents_reuse\n+            .get_or_insert_with(|| has_hook_or_symlinked_manifest(self.repository, commit));\n+        if prevents_reuse {\n             // A hook can change files at each checkout without changing the\n-            // trees, so no later checkout may reuse this list.\n-            let has_hook = has_checkout_hook(self.repository).unwrap_or_else(|error| {\n-                debug!(\"cannot check for checkout hooks at {commit}: {error:#}\");\n-                true\n-            });\n-            let has_symlinked_manifest =\n-                has_symlinked_manifest(self.repository).unwrap_or_else(|error| {\n-                    debug!(\"cannot check for symlinked manifests at {commit}: {error:#}\");\n-                    true\n-                });\n-            if has_hook || has_symlinked_manifest {\n-                return &self.files;\n-            }\n+            // trees, and a symlinked manifest can point to a Rust source.\n+            self.files = PackageFiles::default();\n+        } else if self.files.is_cached() {\n+            debug!(\"reusing historical package file list at {commit}\");\n         }\n-        self.commit = Some(commit.to_owned());\n         &self.files\n     }\n+\n+    /// Whether the trees of the checkouts at the positions `previous` and\n+    /// `index` of the walk differ only in Rust sources, see [`compare_trees`].\n+    fn only_sources_differ(&mut self, previous: usize, index: usize) -> bool {\n+        let walk = self.walk;\n+        if previous + 1 != index {\n+            // The walk skipped the commits in between.\n+            let commits = [walk[previous].id.as_str(), walk[index].id.as_str()];\n+            return compare_trees(self.repository, &commits) == [true];\n+        }\n+        // Most checkouts follow the commit before them in the walk: compare\n+        // those pairs in batches, from the current checkout on. The walk can\n+        // stop at any checkout, so the batches start small and double in size:\n+        // a batch compares about as many pairs as the walk covered before it,\n+        // and a long walk takes few Git calls. Git compares each pair on its\n+        // own, so a pair it didn't report on just starts the next batch.\n+        if previous - self.batch_start >= self.batch.len() {\n+            let size = FIRST_BATCH_SIZE.max(2 * self.batch.len());\n+            let end = walk.len().min(index + size);\n+            let commits: Vec<_> = walk[previous..end]\n+                .iter()\n+                .map(|commit| commit.id.as_str())\n+                .collect();\n+            self.batch = compare_trees(self.repository, &commits);\n+            self.batch_start = previous;\n+        }\n+        self.batch.get(previous - self.batch_start) == Some(&true)\n+    }\n+}\n+\n+/// Whether the checkout of `commit` has, or may have, a checkout hook or a\n+/// symlinked manifest.\n+fn has_hook_or_symlinked_manifest(repository: &Repo, commit: &str) -> bool {\n+    let has_hook = has_checkout_hook(repository).unwrap_or_else(|error| {\n+        debug!(\"cannot check for checkout hooks at {commit}: {error:#}\");\n+        true\n+    });\n+    has_hook\n+        || has_symlinked_manifest(repository).unwrap_or_else(|error| {\n+            debug!(\"cannot check for symlinked manifests at {commit}: {error:#}\");\n+            true\n+        })\n }\n \n /// The hooks that `git checkout` runs.\n@@ -154,31 +209,71 @@ fn has_symlinked_manifest(repository: &Repo) -> anyhow::Result<bool> {\n         .any(|entry| entry.starts_with(\"120000 \")))\n }\n \n-/// Whether the trees of the commits `old` and `new` differ only in the contents\n-/// of `.rs` files that are non-executable regular files in both.\n-fn only_rust_sources_differ(repository: &Repo, old: &str, new: &str) -> anyhow::Result<bool> {\n+/// Whether the trees of each commit of `commits` and the next one differ only\n+/// in the contents of `.rs` files that are non-executable regular files in\n+/// both, up to the first pair Git doesn't report on.\n+fn compare_trees(repository: &Repo, commits: &[&str]) -> Vec<bool> {\n+    // With `--stdin`, `diff-tree` compares the commits of each input line\n+    // `<new> <old>` as if `old` were the parent of `new`, and prints `new`\n+    // before their changes, even without changes thanks to `--always`. It\n+    // prints nothing for a line it can't process, though, and still succeeds:\n+    // only the commits it prints in input order are known.\n+    let input: String = commits\n+        .windows(2)\n+        .map(|pair| format!(\"{} {}\\n\", pair[1], pair[0]))\n+        .collect();\n     // `diff-tree` detects no renames, so it reads no blobs and reports a rename\n     // as a deletion and an addition. Report submodule updates even if\n     // `submodule.<name>.ignore` hides them.\n-    let diff = repository.git(&[\n+    let args = [\n         \"diff-tree\",\n         \"-r\",\n         \"-z\",\n         \"--ignore-submodules=none\",\n-        old,\n-        new,\n-    ])?;\n-    // Each change is `:<old mode> <new mode> <old id> <new id> <status>`\n-    // followed by its path, both NUL-terminated.\n-    let mut fields = diff.split_terminator('\\0');\n-    while let Some(change) = fields.next() {\n-        let path = fields\n-            .next()\n-            .with_context(|| format!(\"no path follows the change `{change}`\"))?;\n-        let modified_regular_file = change.starts_with(\":100644 100644 \") && change.ends_with(\" M\");\n-        if !(modified_regular_file && path.ends_with(\".rs\")) {\n-            return Ok(false);\n+        \"--always\",\n+        \"--stdin\",\n+    ];\n+    let diff = match repository.git_output_with_input(&args, input.as_bytes()) {\n+        Ok(diff) => diff,\n+        Err(error) => {\n+            debug!(\"cannot compare the trees of commit pairs: {error:#}\");\n+            return Vec::new();\n         }\n+    };\n+    // With `-z`, Git prints paths verbatim, so they can be invalid UTF-8.\n+    let mut fields = diff.split(|byte| *byte == b'\\0').peekable();\n+    let changes: Vec<bool> = commits\n+        .iter()\n+        .skip(1)\n+        .map_while(|new| next_comparison(&mut fields, new.as_bytes()))\n+        .collect();\n+    if let Some(new) = commits.get(changes.len() + 1) {\n+        debug!(\"diff-tree didn't report on {new} as expected\");\n+    }\n+    changes\n+}\n+\n+/// Read the comparison of `commit` from the `diff-tree` output `fields`: whether\n+/// all of its changes are [Rust source changes](is_rust_source_change). `None`\n+/// if `fields` doesn't continue with `commit` and its changes.\n+fn next_comparison<'d>(\n+    fields: &mut Peekable<impl Iterator<Item = &'d [u8]>>,\n+    commit: &[u8],\n+) -> Option<bool> {\n+    if fields.next()? != commit {\n+        return None;\n+    }\n+    let mut only_sources = true;\n+    while let Some(change) = fields.next_if(|field| field.starts_with(b\":\")) {\n+        only_sources &= is_rust_source_change(change, fields.next()?);\n     }\n-    Ok(true)\n+    Some(only_sources)\n+}\n+\n+/// Whether the `diff-tree` `change` of `path` modifies the contents of a `.rs`\n+/// file that is a non-executable regular file on both sides. Each change is\n+/// `:<old mode> <new mode> <old id> <new id> <status>`.\n+fn is_rust_source_change(change: &[u8], path: &[u8]) -> bool {\n+    let modified_regular_file = change.starts_with(b\":100644 100644 \") && change.ends_with(b\" M\");\n+    modified_regular_file && path.ends_with(b\".rs\")\n }"},{"sha":"b49a4cc19f8f13f92f68202a44a2c530ed84ded3","filename":"crates/release_plz_core/src/download.rs","status":"modified","additions":32,"deletions":2,"changes":34,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fdownload.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fdownload.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz_core%2Fsrc%2Fdownload.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -1,6 +1,6 @@\n //! Download packages from cargo registry, similar to the `git clone` behavior.\n \n-use std::path::Path;\n+use std::{path::Path, thread};\n \n use anyhow::{Context, anyhow};\n use cargo_metadata::{Package, camino::Utf8PathBuf};\n@@ -72,10 +72,40 @@ impl PackageDownloader {\n             .await\n             .context(\"error while downloading packages\")?;\n \n-        package_dirs.iter().map(read_package).collect()\n+        read_packages(&package_dirs)\n     }\n }\n \n+/// Read the packages in `directories`, preserving their order.\n+///\n+/// Reading a package runs `cargo metadata`, so spread the reads across threads\n+/// instead of waiting for each subprocess in turn.\n+fn read_packages(directories: &[Utf8PathBuf]) -> anyhow::Result<Vec<Package>> {\n+    let parallelism = thread::available_parallelism().map_or(1, usize::from);\n+    // `chunks` panics on a size of 0, which an empty list would produce.\n+    let chunk_size = directories.len().div_ceil(parallelism).max(1);\n+    thread::scope(|scope| {\n+        let workers: Vec<_> = directories\n+            .chunks(chunk_size)\n+            .map(|chunk| {\n+                scope.spawn(|| {\n+                    chunk\n+                        .iter()\n+                        .map(read_package)\n+                        .collect::<anyhow::Result<Vec<_>>>()\n+                })\n+            })\n+            .collect();\n+        let mut packages = Vec::with_capacity(directories.len());\n+        // Joining in order returns the error of the first package that can't be\n+        // read, like reading the packages sequentially.\n+        for worker in workers {\n+            packages.extend(worker.join().expect(\"package reading thread panicked\")?);\n+        }\n+        Ok(packages)\n+    })\n+}\n+\n /// Read a package from file system\n pub fn read_package(directory: impl AsRef<Path>) -> anyhow::Result<Package> {\n     let manifest_path = directory.as_ref().join(CARGO_TOML);"},{"sha":"fb75532a7faebc9372337859cd48ee492a8eca0b","filename":"crates/release_plz_core/src/git/forge.rs","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fgit%2Fforge.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fgit%2Fforge.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz_core%2Fsrc%2Fgit%2Fforge.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -46,7 +46,7 @@ pub enum ForgeType {\n     Gitlab,\n }\n \n-#[derive(Debug)]\n+#[derive(Debug, Clone)]\n pub struct GitClient {\n     pub forge: ForgeType,\n     pub remote: Remote,"},{"sha":"2504d730927c5fc7311dabd5256cfc1fd67c9892","filename":"crates/release_plz_core/src/semver_check.rs","status":"modified","additions":51,"deletions":21,"changes":72,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fsemver_check.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fsemver_check.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz_core%2Fsrc%2Fsemver_check.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -1,12 +1,13 @@\n use std::process::{Command, Output};\n \n use anyhow::Context;\n-use cargo_metadata::camino::{Utf8Path, Utf8PathBuf};\n+use cargo_metadata::{\n+    Metadata,\n+    camino::{Utf8Path, Utf8PathBuf},\n+};\n use cargo_utils::CARGO_TOML;\n \n-fn target_dir(path: &Utf8Path) -> Utf8PathBuf {\n-    path.join(\"target\")\n-}\n+use crate::fs_utils::Utf8TempDir;\n \n fn cargo_lock(path: &Utf8Path) -> Utf8PathBuf {\n     path.join(\"Cargo.lock\")\n@@ -41,9 +42,36 @@ impl SemverCheck {\n     }\n }\n \n+/// Where cargo-semver-checks builds the rustdoc JSON of the compared versions.\n+#[derive(Debug, Clone, Copy)]\n+pub enum TargetDir {\n+    /// Inherit the target directory set by the user, to reuse their build cache.\n+    Configured,\n+    /// Use a temporary target directory per package, so the baseline reuses the\n+    /// dependencies built for the current version. Packages don't share it because\n+    /// cargo runs one build at a time per target directory.\n+    PerPackage,\n+}\n+\n+impl TargetDir {\n+    pub fn new(metadata: &Metadata) -> Self {\n+        // `cargo metadata` already reflects these variables, but they can explicitly\n+        // point to the default `target` directory (e.g. to cache it in CI): keep that cache.\n+        if std::env::var_os(\"CARGO_TARGET_DIR\").is_none()\n+            && std::env::var_os(\"CARGO_BUILD_TARGET_DIR\").is_none()\n+            && metadata.target_directory == metadata.workspace_root.join(\"target\")\n+        {\n+            Self::PerPackage\n+        } else {\n+            Self::Configured\n+        }\n+    }\n+}\n+\n pub fn run_semver_check(\n     local_package: &Utf8Path,\n     registry_package: &Utf8Path,\n+    target_dir: TargetDir,\n ) -> anyhow::Result<SemverCheck> {\n     let local_manifest = local_package.join(CARGO_TOML);\n     let manifest: cargo_utils::Manifest = fs_err::read_to_string(&local_manifest)?.parse()?;\n@@ -55,15 +83,21 @@ pub fn run_semver_check(\n         .context(\"cannot find the package name to check for API compatibility\")?;\n     let local_cargo_lock = cargo_lock(local_package);\n     let registry_cargo_lock = cargo_lock(registry_package);\n-    let local_target_dir = target_dir(local_package);\n-    let registry_target_dir = target_dir(registry_package);\n \n     let local_package_contained_cargo_lock = local_cargo_lock.exists();\n     let registry_package_contained_cargo_lock = registry_cargo_lock.exists();\n-    let local_package_contained_target = local_target_dir.exists();\n-    let registry_package_contained_target = registry_target_dir.exists();\n \n-    let output = Command::new(\"cargo-semver-checks\")\n+    let mut command = Command::new(\"cargo-semver-checks\");\n+    // Kept alive until the check is over: dropping it deletes the directory.\n+    let _package_target_dir = match target_dir {\n+        TargetDir::Configured => None,\n+        TargetDir::PerPackage => {\n+            let dir = Utf8TempDir::new()?;\n+            command.env(\"CARGO_TARGET_DIR\", dir.path());\n+            Some(dir)\n+        }\n+    };\n+    let output = command\n         .args([\"semver-checks\", \"check-release\"])\n         .args([\"--color\", \"never\"])\n         // Only changes requiring a major bump are incompatible. Assume a minor\n@@ -87,13 +121,6 @@ pub fn run_semver_check(\n     if !registry_package_contained_cargo_lock && registry_cargo_lock.exists() {\n         fs_err::remove_file(registry_cargo_lock)?;\n     }\n-    // Delete target dir if cargo-semver-checks created it.\n-    if !local_package_contained_target && local_target_dir.exists() {\n-        fs_err::remove_dir_all(local_target_dir)?;\n-    }\n-    if !registry_package_contained_target && registry_target_dir.exists() {\n-        fs_err::remove_dir_all(registry_target_dir)?;\n-    }\n \n     parse_semver_check_output(&output)\n         .with_context(|| format!(\"error while running cargo-semver-checks on {local_package:?}\"))\n@@ -128,7 +155,7 @@ mod tests {\n \n     #[test]\n     fn checks_private_library_with_versionless_dependency() {\n-        let temp = crate::fs_utils::Utf8TempDir::new().unwrap();\n+        let temp = Utf8TempDir::new().unwrap();\n         let baseline = temp.path().join(\"baseline\");\n         let current = temp.path().join(\"current\");\n         for workspace in [&baseline, &current] {\n@@ -164,7 +191,7 @@ mod tests {\n         let baseline = baseline.join(\"wrapper\");\n         let current = current.join(\"wrapper\");\n         assert!(matches!(\n-            run_semver_check(&current, &baseline).unwrap(),\n+            run_semver_check(&current, &baseline, TargetDir::PerPackage).unwrap(),\n             SemverCheck::Compatible\n         ));\n \n@@ -173,7 +200,7 @@ mod tests {\n             \"pub fn answer() -> u32 { support::answer() }\\n\",\n         )\n         .unwrap();\n-        let result = run_semver_check(&current, &baseline).unwrap();\n+        let result = run_semver_check(&current, &baseline, TargetDir::PerPackage).unwrap();\n         assert!(\n             matches!(result, SemverCheck::Incompatible(ref report) if report.contains(\"function_missing\")),\n             \"expected a removed-function report for the private library, got {result:?}\"\n@@ -182,7 +209,7 @@ mod tests {\n \n     #[test]\n     fn only_major_changes_are_incompatible() {\n-        let temp = crate::fs_utils::Utf8TempDir::new().unwrap();\n+        let temp = Utf8TempDir::new().unwrap();\n         let baseline = temp.path().join(\"baseline\");\n         let current = temp.path().join(\"current\");\n         for package in [&baseline, &current] {\n@@ -192,7 +219,7 @@ mod tests {\n \n         let assert_incompatible = |source: &str, incompatible| {\n             fs_err::write(current.join(\"src/lib.rs\"), source).unwrap();\n-            let result = run_semver_check(&current, &baseline).unwrap();\n+            let result = run_semver_check(&current, &baseline, TargetDir::PerPackage).unwrap();\n             assert_eq!(\n                 matches!(result, SemverCheck::Incompatible(_)),\n                 incompatible,\n@@ -203,6 +230,9 @@ mod tests {\n         // Adding #[must_use] requires only a minor bump in cargo-semver-checks.\n         assert_incompatible(\"#[must_use]\\npub fn answer() -> u32 { 42 }\", false);\n         // Removing the existing public function requires a major bump.\n+        // Both versions have the same name and version, so in their shared target dir they\n+        // produce the same rustdoc JSON file. This change is only detected if the baseline\n+        // doesn't overwrite the current rustdoc before they are compared.\n         assert_incompatible(\"pub fn other() -> u32 { 42 }\", true);\n     }\n }"},{"sha":"1f381cf387e6c58929c4f15b9d85690b16718369","filename":"tests/docker-compose.yml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/tests%2Fdocker-compose.yml","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/tests%2Fdocker-compose.yml","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/tests%2Fdocker-compose.yml?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -2,7 +2,7 @@ services:\n   # We use Gitea as a git server.\n   # We test that release-plz can open PRs, create releases, etc.\n   gitea:\n-    image: docker.io/gitea/gitea:28.1.0-rootless\n+    image: docker.io/gitea/gitea:28.2.0-rootless\n     container_name: gitea\n     restart: always\n     environment:"},{"sha":"b7e82b4661fa7264e0954b40495efd47b743554e","filename":"website/docusaurus.config.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/website%2Fdocusaurus.config.js","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/website%2Fdocusaurus.config.js","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/website%2Fdocusaurus.config.js?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -103,7 +103,7 @@ const config = {\n           },\n           {\n             label: \"💖 Sponsor\",\n-            href: \"https://github.com/sponsors/MarcoIeni\",\n+            href: \"https://github.com/sponsors/release-plz\",\n             position: \"right\",\n           },\n           {"},{"sha":"bf36a28652e02428919a8d7c8d82b8808ae4a74c","filename":"w