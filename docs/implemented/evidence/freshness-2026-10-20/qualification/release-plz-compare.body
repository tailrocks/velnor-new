-version = \"2.1.1+zstd.1.5.7\"\n+version = \"2.1.2+zstd.1.5.7\"\n source = \"registry+https://github.com/rust-lang/crates.io-index\"\n-checksum = \"aeec9eaf2dffbbd09201e23bd0ffcbaa33bb8e9266a10734fd7ed90a85eca078\"\n+checksum = \"481ada9c543b2323cbb7bbdbb5249177fbf0188ed959ed2c15e4b22421c84ed3\"\n dependencies = [\n  \"cc\",\n  \"pkg-config\","},{"sha":"60969e3308384ba5744472e1882cb64333e8ad19","filename":"Cargo.toml","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/Cargo.toml","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/Cargo.toml","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/Cargo.toml?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -38,6 +38,7 @@ tempfile = \"3.22.0\"\n tar = { version = \"0.4.46\", default-features = false }\n tera = \"2.0.0\"\n tokio = \"1.47.1\"\n+tokio-util = \"0.7.20\"\n toml = { version = \"1.0.0\" }\n toml_edit = { version = \"0.25.0\" }\n tracing = \"0.1.41\""},{"sha":"dd79db331ec527155869e1f80c678fa59ee99b57","filename":"README.md","status":"modified","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/README.md","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/README.md","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/README.md?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -41,6 +41,14 @@ There are two ways to run release-plz:\n - [GitHub Action](https://release-plz.dev/docs/github): Run Release-plz from CI. The action both updates and releases your packages.\n - [CLI](https://release-plz.dev/docs/usage): Run release-plz from your terminal or other CI systems (Gitea and GitLab supported).\n \n+## 🤝 Sponsors\n+\n+Release-plz is supported by:\n+\n+<a href=\"https://encore.dev/?utm_source=release-plz&utm_medium=sponsorship&utm_content=readme\"><img src=\"website/static/img/sponsors/encore.svg\" alt=\"Encore\" height=\"40\"></a>\n+\n+Want to support release-plz too? [Become a sponsor](https://github.com/sponsors/release-plz). ❤️\n+\n ## 💖 Users\n \n Here you can find the public repositories using the release-plz GitHub action in CI:"},{"sha":"6c3d36f8fd2f7394e9ccb6cd0290d423fba3bba0","filename":"crates/cargo_utils/CHANGELOG.md","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fcargo_utils%2FCHANGELOG.md","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fcargo_utils%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Fcargo_utils%2FCHANGELOG.md?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -7,6 +7,12 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.2.0](https://github.com/release-plz/release-plz/compare/cargo_utils-v0.1.87...cargo_utils-v0.2.0) - 2026-10-19\n+\n+### Performance\n+\n+- don't query the registry again after cargo publish confirms the package ([#3251](https://github.com/release-plz/release-plz/pull/3251))\n+\n ## [0.1.87](https://github.com/release-plz/release-plz/compare/cargo_utils-v0.1.86...cargo_utils-v0.1.87) - 2026-10-12\n \n ### Performance"},{"sha":"d5d7642bcff0481d3a6cc26e67e9d6d66dd697b1","filename":"crates/cargo_utils/Cargo.toml","status":"modified","additions":1,"deletions":2,"changes":3,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fcargo_utils%2FCargo.toml","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fcargo_utils%2FCargo.toml","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Fcargo_utils%2FCargo.toml?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"cargo_utils\"\n-version = \"0.1.87\"\n+version = \"0.2.0\"\n edition.workspace = true\n description = \"Utilities around cargo and Rust workspaces\"\n repository = \"https://github.com/release-plz/release-plz/tree/main/crates/cargo_utils\"\n@@ -19,7 +19,6 @@ fs-err.workspace = true\n toml.workspace = true\n toml_edit.workspace = true\n semver.workspace = true\n-url.workspace = true\n serde.workspace = true\n secrecy.workspace = true\n "},{"sha":"48be6bcfa75111c51fc40be969498c86279478e2","filename":"crates/cargo_utils/src/registry.rs","status":"modified","additions":14,"deletions":189,"changes":203,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fcargo_utils%2Fsrc%2Fregistry.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fcargo_utils%2Fsrc%2Fregistry.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Fcargo_utils%2Fsrc%2Fregistry.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -1,23 +1,3 @@\n-use anyhow::Context;\n-use serde::Deserialize;\n-use std::collections::HashMap;\n-use std::path::{Path, PathBuf};\n-use url::Url;\n-\n-const CRATES_IO_INDEX: &str = \"https://github.com/rust-lang/crates.io-index\";\n-const CRATES_IO_REGISTRY: &str = \"crates-io\";\n-\n-/// Read index for a specific registry using environment variables.\n-/// <https://doc.rust-lang.org/cargo/reference/environment-variables.html>\n-///\n-/// Returns:\n-/// - [`Result::Err`] if the registry name is invalid.\n-/// - [`Result::Ok`] with [`Option::None`] if the environment variable is not set.\n-pub fn registry_index_url_from_env(registry: &str) -> anyhow::Result<Option<String>> {\n-    let env_var_name = cargo_registries_index_env_var_name(registry)?;\n-    Ok(std::env::var(env_var_name).ok())\n-}\n-\n pub fn cargo_registries_token_env_var_name(registry: &str) -> anyhow::Result<String> {\n     let name = if registry == \"crates-io\" {\n         \"CARGO_REGISTRY_TOKEN\".to_string()\n@@ -30,13 +10,6 @@ pub fn cargo_registries_token_env_var_name(registry: &str) -> anyhow::Result<Str\n     Ok(name)\n }\n \n-fn cargo_registries_index_env_var_name(registry: &str) -> anyhow::Result<String> {\n-    Ok(format!(\n-        \"CARGO_REGISTRIES_{}_INDEX\",\n-        registry_env_var_name(registry)?\n-    ))\n-}\n-\n /// Sanitizes the registry name to construct a valid environment variable name.\n /// Mirrors Cargo's behavior:\n /// - Alphanumeric characters and underscores (`_`) are preserved.\n@@ -58,179 +31,33 @@ fn registry_env_var_name(registry: &str) -> anyhow::Result<String> {\n     Ok(sanitized_name.to_uppercase())\n }\n \n-/// Find the URL of a registry\n-pub fn registry_url(manifest_path: &Path, registry: Option<&str>) -> anyhow::Result<Url> {\n-    fn read_config(\n-        registries: &mut HashMap<String, Source>,\n-        path: impl AsRef<Path>,\n-    ) -> anyhow::Result<()> {\n-        // TODO unit test for source replacement\n-        let content = fs_err::read_to_string(path).context(\"failed to read cargo config file\")?;\n-        let config = toml::from_str::<CargoConfig>(&content).context(\"Invalid cargo config\")?;\n-        for (key, value) in config.registries {\n-            registries.entry(key).or_insert(Source {\n-                registry: value.index,\n-                replace_with: None,\n-            });\n-        }\n-        for (key, value) in config.source {\n-            registries.entry(key).or_insert(value);\n-        }\n-        Ok(())\n-    }\n-    // registry might be replaced with another source\n-    // it's looks like a singly linked list\n-    // put relations in this map.\n-    let mut registries: HashMap<String, Source> = HashMap::new();\n-\n-    // set top-level env var override if it exists.\n-    if let Some(registry_name) = registry\n-        && let Some(env_var_override) = registry_index_url_from_env(registry_name)?\n-    {\n-        registries\n-            .entry(registry_name.to_string())\n-            .or_insert(Source {\n-                registry: Some(env_var_override),\n-                replace_with: None,\n-            });\n-    }\n-\n-    // ref: https://doc.rust-lang.org/cargo/reference/config.html#hierarchical-structure\n-    for work_dir in manifest_path\n-        .parent()\n-        .expect(\"there must be a parent directory\")\n-        .ancestors()\n-    {\n-        let work_cargo_dir = work_dir.join(\".cargo\");\n-        let config_path = work_cargo_dir.join(\"config\");\n-        if config_path.is_file() {\n-            read_config(&mut registries, config_path)?;\n-        } else {\n-            let config_path = work_cargo_dir.join(\"config.toml\");\n-            if config_path.is_file() {\n-                read_config(&mut registries, config_path)?;\n-            }\n-        }\n-    }\n-\n-    let default_cargo_home = cargo_home()?;\n-    let default_config_path = default_cargo_home.join(\"config\");\n-    if default_config_path.is_file() {\n-        read_config(&mut registries, default_config_path)?;\n-    } else {\n-        let default_config_path = default_cargo_home.join(\"config.toml\");\n-        if default_config_path.is_file() {\n-            read_config(&mut registries, default_config_path)?;\n-        }\n-    }\n-\n-    // find head of the relevant linked list\n-    let mut source = match registry {\n-        Some(CRATES_IO_INDEX) | None => {\n-            let mut source = registries.remove(CRATES_IO_REGISTRY).unwrap_or_default();\n-            source\n-                .registry\n-                .get_or_insert_with(|| CRATES_IO_INDEX.to_string());\n-            source\n-        }\n-        Some(r) => registries\n-            .remove(r)\n-            .with_context(|| anyhow::anyhow!(\"The registry '{r}' could not be found\"))?,\n-    };\n-\n-    // search this linked list and find the tail\n-    while let Some(replace_with) = &source.replace_with {\n-        let is_crates_io = replace_with == CRATES_IO_INDEX;\n-        source = registries\n-            .remove(replace_with)\n-            .with_context(|| anyhow::anyhow!(\"The source '{replace_with}' could not be found\"))?;\n-        if is_crates_io {\n-            source\n-                .registry\n-                .get_or_insert_with(|| CRATES_IO_INDEX.to_string());\n-        }\n-    }\n-\n-    let registry_url = source\n-        .registry\n-        .and_then(|x| Url::parse(&x).ok())\n-        .context(\"Invalid cargo config\")?;\n-\n-    Ok(registry_url)\n-}\n-\n-#[derive(Debug, Deserialize)]\n-struct CargoConfig {\n-    #[serde(default)]\n-    registries: HashMap<String, Registry>,\n-    #[serde(default)]\n-    source: HashMap<String, Source>,\n-}\n-\n-#[derive(Default, Debug, Deserialize)]\n-struct Source {\n-    #[serde(rename = \"replace-with\")]\n-    replace_with: Option<String>,\n-    registry: Option<String>,\n-}\n-\n-#[derive(Debug, Deserialize)]\n-struct Registry {\n-    index: Option<String>,\n-}\n-\n-pub fn cargo_home() -> anyhow::Result<PathBuf> {\n-    let default_cargo_home = std::env::home_dir()\n-        .map(|x| x.join(\".cargo\"))\n-        .context(\"Failed to read home directory\")?;\n-    let cargo_home = std::env::var(\"CARGO_HOME\")\n-        .map(PathBuf::from)\n-        .unwrap_or(default_cargo_home);\n-    Ok(cargo_home)\n-}\n-\n #[cfg(test)]\n mod tests {\n     use super::*;\n \n     #[test]\n     fn test_get_registry_env_var_name() {\n+        assert_eq!(registry_env_var_name(\"my-registry\").unwrap(), \"MY_REGISTRY\");\n+        assert_eq!(registry_env_var_name(\"my_registry\").unwrap(), \"MY_REGISTRY\");\n+        assert_eq!(registry_env_var_name(\"registry1\").unwrap(), \"REGISTRY1\");\n+        assert_eq!(registry_env_var_name(\"UPPERCASE\").unwrap(), \"UPPERCASE\");\n         assert_eq!(\n-            cargo_registries_index_env_var_name(\"my-registry\").unwrap(),\n-            \"CARGO_REGISTRIES_MY_REGISTRY_INDEX\"\n-        );\n-        assert_eq!(\n-            cargo_registries_index_env_var_name(\"my_registry\").unwrap(),\n-            \"CARGO_REGISTRIES_MY_REGISTRY_INDEX\"\n-        );\n-        assert_eq!(\n-            cargo_registries_index_env_var_name(\"registry1\").unwrap(),\n-            \"CARGO_REGISTRIES_REGISTRY1_INDEX\"\n-        );\n-        assert_eq!(\n-            cargo_registries_index_env_var_name(\"UPPERCASE\").unwrap(),\n-            \"CARGO_REGISTRIES_UPPERCASE_INDEX\"\n-        );\n-        assert_eq!(\n-            cargo_registries_index_env_var_name(\"-leading-dash\").unwrap(),\n-            \"CARGO_REGISTRIES__LEADING_DASH_INDEX\"\n+            registry_env_var_name(\"-leading-dash\").unwrap(),\n+            \"_LEADING_DASH\"\n         );\n         assert_eq!(\n-            cargo_registries_index_env_var_name(\"trailing-dash-\").unwrap(),\n-            \"CARGO_REGISTRIES_TRAILING_DASH__INDEX\"\n+            registry_env_var_name(\"trailing-dash-\").unwrap(),\n+            \"TRAILING_DASH_\"\n         );\n         assert_eq!(\n-            cargo_registries_index_env_var_name(\"multiple---dashes\").unwrap(),\n-            \"CARGO_REGISTRIES_MULTIPLE___DASHES_INDEX\"\n+            registry_env_var_name(\"multiple---dashes\").unwrap(),\n+            \"MULTIPLE___DASHES\"\n         );\n         assert_eq!(\n-            cargo_registries_index_env_var_name(\"mixed-dashes-and_underscores\").unwrap(),\n-            \"CARGO_REGISTRIES_MIXED_DASHES_AND_UNDERSCORES_INDEX\"\n-        );\n-        assert_eq!(\n-            cargo_registries_index_env_var_name(\"---\").unwrap(),\n-            \"CARGO_REGISTRIES_____INDEX\"\n+            registry_env_var_name(\"mixed-dashes-and_underscores\").unwrap(),\n+            \"MIXED_DASHES_AND_UNDERSCORES\"\n         );\n+        assert_eq!(registry_env_var_name(\"---\").unwrap(), \"___\");\n \n         // Invalid characters should fail\n \n@@ -275,8 +102,6 @@ mod tests {\n     }\n \n     fn registry_env_var_name_error(registry: &str) -> String {\n-        cargo_registries_index_env_var_name(registry)\n-            .unwrap_err()\n-            .to_string()\n+        registry_env_var_name(registry).unwrap_err().to_string()\n     }\n }"},{"sha":"4f9463f59213b79f2971e9086dd9f4ef905482e5","filename":"crates/cargo_utils/src/token.rs","status":"modified","additions":11,"deletions":1,"changes":12,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fcargo_utils%2Fsrc%2Ftoken.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fcargo_utils%2Fsrc%2Ftoken.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Fcargo_utils%2Fsrc%2Ftoken.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -64,7 +64,7 @@ fn read_cargo_credentials() -> anyhow::Result<Option<CargoCredentials>> {\n }\n \n fn credentials_path() -> anyhow::Result<Option<PathBuf>> {\n-    let cargo_home = crate::cargo_home()?;\n+    let cargo_home = cargo_home()?;\n     let mut path = cargo_home.join(\"credentials.toml\");\n     if !path.exists() {\n         path = cargo_home.join(\"credentials\");\n@@ -75,6 +75,16 @@ fn credentials_path() -> anyhow::Result<Option<PathBuf>> {\n     Ok(Some(path))\n }\n \n+fn cargo_home() -> anyhow::Result<PathBuf> {\n+    let default_cargo_home = std::env::home_dir()\n+        .map(|x| x.join(\".cargo\"))\n+        .context(\"Failed to read home directory\")?;\n+    let cargo_home = std::env::var(\"CARGO_HOME\")\n+        .map(PathBuf::from)\n+        .unwrap_or(default_cargo_home);\n+    Ok(cargo_home)\n+}\n+\n #[derive(Debug, Deserialize, Default, PartialEq)]\n struct CargoCredentials {\n     #[serde(default)]"},{"sha":"f701603cadf61b5f70dcc3fb27186f289ee77d0c","filename":"crates/fake_package/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Ffake_package%2FCargo.toml","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Ffake_package%2FCargo.toml","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Ffake_package%2FCargo.toml?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -9,6 +9,6 @@ license.workspace = true\n workspace = true\n \n [dependencies]\n-cargo_utils = { path = \"../cargo_utils\", version = \"0.1\"}\n+cargo_utils = { path = \"../cargo_utils\", version = \"0.2\" }\n cargo_metadata.workspace = true\n serde_json.workspace = true"},{"sha":"375e9e4c113887fc9bfc7253b57c23105041c90b","filename":"crates/git_cmd/CHANGELOG.md","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fgit_cmd%2FCHANGELOG.md","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fgit_cmd%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Fgit_cmd%2FCHANGELOG.md?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -7,6 +7,12 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.9.1](https://github.com/release-plz/release-plz/compare/git_cmd-v0.9.0...git_cmd-v0.9.1) - 2026-10-19\n+\n+### Performance\n+\n+- spawn fewer and cheaper git processes in history walks ([#3250](https://github.com/release-plz/release-plz/pull/3250))\n+\n ## [0.9.0](https://github.com/release-plz/release-plz/compare/git_cmd-v0.8.0...git_cmd-v0.9.0) - 2026-10-10\n \n ### Performance"},{"sha":"244751b844c183415f29bc9777e748d2d2ba1be2","filename":"crates/git_cmd/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fgit_cmd%2FCargo.toml","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fgit_cmd%2FCargo.toml","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Fgit_cmd%2FCargo.toml?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"git_cmd\"\n-version = \"0.9.0\"\n+version = \"0.9.1\"\n edition.workspace = true\n description = \"Wrapper around git cli\"\n repository = \"https://github.com/release-plz/release-plz/tree/main/crates/git_cmd\""},{"sha":"30d5a85cccf02caddd144ea3d184a96e0061b3ed","filename":"crates/git_cmd/src/lib.rs","status":"modified","additions":241,"deletions":54,"changes":295,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fgit_cmd%2Fsrc%2Flib.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Fgit_cmd%2Fsrc%2Flib.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Fgit_cmd%2Fsrc%2Flib.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -4,7 +4,12 @@ mod cmd;\n #[cfg(feature = \"test_fixture\")]\n pub mod test_fixture;\n \n-use std::{collections::HashSet, path::Path, process::Command};\n+use std::{\n+    collections::HashSet,\n+    io::{ErrorKind, Write as _},\n+    path::Path,\n+    process::{Command, Output, Stdio},\n+};\n \n use anyhow::{Context, anyhow};\n use camino::{Utf8Path, Utf8PathBuf};\n@@ -30,6 +35,48 @@ pub struct CommitSignatures {\n     pub committer_email: String,\n }\n \n+/// A commit of [`Repo::parents_at_paths`].\n+#[derive(Debug)]\n+pub struct HistoryCommit {\n+    pub id: String,\n+    /// The parents, rewritten by history simplification.\n+    pub parents: Vec<String>,\n+    /// The message as Git prints it. Like other Git output, it must be UTF-8,\n+    /// but only once read: callers may read the messages of some commits only.\n+    message: Vec<u8>,\n+}\n+\n+impl HistoryCommit {\n+    /// Parse an entry `commit <id> <parents>\\n<message>` of `git rev-list --parents`.\n+    fn parse(entry: &[u8]) -> anyhow::Result<Self> {\n+        let header_end = entry\n+            .iter()\n+            .position(|byte| *byte == b'\\n')\n+            .unwrap_or(entry.len());\n+        let (header, message) = entry.split_at(header_end);\n+        let header = std::str::from_utf8(header).context(\"non-UTF-8 rev-list header\")?;\n+        let mut ids = header\n+            .strip_prefix(\"commit \")\n+            .with_context(|| format!(\"unexpected rev-list header `{header}`\"))?\n+            .split_whitespace()\n+            .map(str::to_owned);\n+        Ok(Self {\n+            id: ids.next().context(\"rev-list printed no commit id\")?,\n+            parents: ids.collect(),\n+            // Skip the newline that ends the header.\n+            message: message.get(1..).unwrap_or_default().to_vec(),\n+        })\n+    }\n+\n+    /// The message, as [`Repo::current_commit_message`] reads it with this\n+    /// commit checked out.\n+    pub fn message(&self) -> anyhow::Result<String> {\n+        let message = std::str::from_utf8(&self.message)\n+            .with_context(|| format!(\"non-UTF-8 message in commit {}\", self.id))?;\n+        Ok(message.trim().to_owned())\n+    }\n+}\n+\n impl Repo {\n     /// Returns an error if the directory doesn't contain any commit\n     #[instrument(skip_all)]\n@@ -209,6 +256,12 @@ impl Repo {\n         git_in_dir(&self.directory, args)\n     }\n \n+    /// Like [`Repo::git`], but write `input` to the standard input of git and\n+    /// return its standard output as is, which can be invalid UTF-8.\n+    pub fn git_output_with_input(&self, args: &[&str], input: &[u8]) -> anyhow::Result<Vec<u8>> {\n+        git_output_in_dir(&self.directory, args, &[], Some(input))\n+    }\n+\n     pub fn stash_pop(&self) -> anyhow::Result<()> {\n         self.git(&[\"stash\", \"pop\"])?;\n         Ok(())\n@@ -239,7 +292,11 @@ impl Repo {\n \n     #[instrument(skip(self))]\n     pub fn checkout(&self, object: &str) -> anyhow::Result<()> {\n-        self.git(&[\"checkout\", object])\n+        // Nobody reads the feedback, and computing it is a large part of a\n+        // checkout: Git diffs the worktree to list local changes and, when\n+        // leaving a detached HEAD, walks the history of every ref to warn about\n+        // the commits left behind. Errors are still reported.\n+        self.git(&[\"checkout\", \"--quiet\", object])\n             .context(\"failed to checkout\")?;\n         Ok(())\n     }\n@@ -297,7 +354,7 @@ impl Repo {\n         max_commits: Option<u32>,\n     ) -> anyhow::Result<Vec<String>> {\n         let graph = self.parents_at_paths(head, exclude, paths, max_commits)?;\n-        Ok(graph.into_iter().map(|(commit, _)| commit).collect())\n+        Ok(graph.into_iter().map(|commit| commit.id).collect())\n     }\n \n     /// Commits reachable from `commit` that touch `paths`.\n@@ -314,11 +371,13 @@ impl Repo {\n         exclude: &[&str],\n         paths: &[impl AsRef<Utf8Path>],\n     ) -> anyhow::Result<Vec<String>> {\n-        self.rev_list(&[\"--full-history\", commit], exclude, paths)\n+        let output = self.rev_list(&[\"--full-history\", commit], exclude, paths)?;\n+        let output = cmd::string_from_bytes(output)?;\n+        Ok(output.lines().map(str::to_owned).collect())\n     }\n \n-    /// Commits reachable from `head` that touch `paths`, each paired with its\n-    /// parents and ordered with `--date-order`.\n+    /// Commits reachable from `head` that touch `paths`, with their parents and\n+    /// messages, ordered with `--date-order`.\n     ///\n     /// `exclude` commits and their ancestors are dropped. An `exclude` entry that\n     /// doesn't exist in this repository is ignored, so a commit hash recorded by a\n@@ -340,39 +399,39 @@ impl Repo {\n         exclude: &[&str],\n         paths: &[impl AsRef<Utf8Path>],\n         max_commits: Option<u32>,\n-    ) -> anyhow::Result<Vec<(String, Vec<String>)>> {\n+    ) -> anyhow::Result<Vec<HistoryCommit>> {\n         let limit = max_commits.map(|n| format!(\"--max-count={n}\"));\n-        let mut args = vec![\"--parents\", \"--date-order\", head];\n+        // Listing the messages here saves a `git log` for each commit a walk\n+        // keeps. Git prints each commit as `commit <id> <parents>\\n<format>\\n`.\n+        // Messages can't contain NUL, so a NUL ends each one unambiguously.\n+        let mut args = vec![\"--parents\", \"--date-order\", \"--format=%B%x00\", head];\n         args.extend(limit.as_deref());\n-        let lines = self.rev_list(&args, exclude, paths)?;\n-        Ok(lines\n-            .iter()\n-            .filter_map(|line| {\n-                let mut ids = line.split_whitespace();\n-                Some((ids.next()?.to_owned(), ids.map(str::to_owned).collect()))\n-            })\n-            .collect())\n+        let output = self.rev_list(&args, exclude, paths)?;\n+        output\n+            .split(|byte| *byte == b'\\0')\n+            .map(|entry| entry.strip_prefix(b\"\\n\").unwrap_or(entry))\n+            .filter(|entry| !entry.is_empty())\n+            .map(HistoryCommit::parse)\n+            .collect()\n     }\n \n-    /// Run `git rev-list` with `args`, restricted to the commits touching `paths`.\n+    /// Run `git rev-list` with `args`, restricted to the commits touching `paths`,\n+    /// and return its raw output.\n     fn rev_list(\n         &self,\n         args: &[&str],\n         exclude: &[&str],\n         paths: &[impl AsRef<Utf8Path>],\n-    ) -> anyhow::Result<Vec<String>> {\n-        let exclusions: Vec<String> = exclude\n-            .iter()\n-            .filter(|commit| self.commit_exists(commit))\n-            .map(|commit| format!(\"^{commit}\"))\n-            .collect();\n-        let mut rev_list = vec![\"rev-list\"];\n+    ) -> anyhow::Result<Vec<u8>> {\n+        let exclusions: Vec<String> = exclude.iter().map(|commit| format!(\"^{commit}\")).collect();\n+        // Drop the exclusions that don't exist in this repository. A missing\n+        // tip would be dropped too, listing no commits.\n+        let mut rev_list = vec![\"rev-list\", \"--ignore-missing\"];\n         rev_list.extend(args);\n         rev_list.extend(exclusions.iter().map(String::as_str));\n         rev_list.push(\"--\");\n         rev_list.extend(paths.iter().map(|p| p.as_ref().as_str()));\n-        let output = self.git(&rev_list)?;\n-        Ok(output.lines().map(str::to_owned).collect())\n+        git_output_in_dir(&self.directory, &rev_list, &[], None)\n     }\n \n     pub fn current_commit_message(&self) -> anyhow::Result<String> {\n@@ -456,17 +515,6 @@ impl Repo {\n         .is_ok()\n     }\n \n-    /// Whether `object` resolves to a commit in this repository.\n-    fn commit_exists(&self, object: &str) -> bool {\n-        self.git(&[\n-            \"rev-parse\",\n-            \"--verify\",\n-            \"--quiet\",\n-            &format!(\"{object}^{{commit}}\"),\n-        ])\n-        .is_ok()\n-    }\n-\n     /// Name of the remote when the [`Repo`] was created.\n     pub fn original_remote(&self) -> &str {\n         &self.original_remote\n@@ -508,7 +556,6 @@ fn changed_files(output: &str, filter: impl FnMut(&&str) -> bool) -> Vec<String>\n         .collect()\n }\n \n-#[instrument]\n pub fn git_in_dir(dir: &Utf8Path, args: &[&str]) -> anyhow::Result<String> {\n     git_in_dir_with_env(dir, args, &[])\n }\n@@ -519,39 +566,88 @@ pub(crate) fn git_in_dir_with_env(\n     args: &[&str],\n     envs: &[(&str, &str)],\n ) -> anyhow::Result<String> {\n+    let stdout = git_output_in_dir(dir, args, envs, None)?;\n+    cmd::string_from_bytes(stdout)\n+}\n+\n+/// Like [`git_in_dir_with_env`], but write `input`, if any, to the standard\n+/// input of the git process, and return the stdout as is.\n+// Don't record `envs`, which can carry credentials, nor `input`.\n+#[instrument(skip(envs, input))]\n+fn git_output_in_dir(\n+    dir: &Utf8Path,\n+    args: &[&str],\n+    envs: &[(&str, &str)],\n+    input: Option<&[u8]>,\n+) -> anyhow::Result<Vec<u8>> {\n     let args: Vec<&str> = args.iter().map(|s| s.trim()).collect();\n-    let output = Command::new(\"git\")\n+    let mut command = Command::new(\"git\");\n+    command\n         .arg(\"-C\")\n         .arg(dir)\n         .args(&args)\n-        .envs(envs.iter().copied())\n-        .output()\n-        .with_context(|| {\n-            format!(\"error while running git in directory `{dir:?}` with args `{args:?}`\")\n-        })?;\n+        .envs(envs.iter().copied());\n+    let output = match input {\n+        None => command.output(),\n+        Some(input) => output_with_input(&mut command, input),\n+    }\n+    .with_context(|| {\n+        format!(\"error while running git in directory `{dir:?}` with args `{args:?}`\")\n+    })?;\n     trace!(\"git {:?}: output = {:?}\", args, output);\n-    let stdout = cmd::string_from_bytes(output.stdout)?;\n     if output.status.success() {\n-        Ok(stdout)\n+        Ok(output.stdout)\n     } else {\n         let mut error =\n             format!(\"error while running git in directory `{dir:?}` with args `{args:?}\");\n-        let stderr = cmd::string_from_bytes(output.stderr)?;\n+        // The output can be invalid UTF-8, such as paths: decode it lossily\n+        // so that the error always reports why git failed.\n+        let stdout = String::from_utf8_lossy(&output.stdout);\n+        let stdout = stdout.trim();\n+        let stderr = String::from_utf8_lossy(&output.stderr);\n+        let stderr = stderr.trim();\n         if !stdout.is_empty() || !stderr.is_empty() {\n             error.push(':');\n         }\n         if !stdout.is_empty() {\n             error.push_str(\"\\n- stdout: \");\n-            error.push_str(&stdout);\n+            error.push_str(stdout);\n         }\n         if !stderr.is_empty() {\n             error.push_str(\"\\n- stderr: \");\n-            error.push_str(&stderr);\n+            error.push_str(stderr);\n         }\n         Err(anyhow!(error))\n     }\n }\n \n+/// Run `command` like [`Command::output`], but write `input` to its standard input.\n+fn output_with_input(command: &mut Command, input: &[u8]) -> std::io::Result<Output> {\n+    let mut child = command\n+        .stdin(Stdio::piped())\n+        .stdout(Stdio::piped())\n+        .stderr(Stdio::piped())\n+        .spawn()?;\n+    let mut stdin = child.stdin.take().expect(\"stdin is piped\");\n+    std::thread::scope(|scope| {\n+        // Write from another thread: the child can fill its output pipes\n+        // before it reads all of its input. Dropping stdin then closes it.\n+        let writer = scope.spawn(move || stdin.write_all(input));\n+        let output = child.wait_with_output()?;\n+        let written = writer.join().expect(\"writing to the child panicked\");\n+        // A child that fails stops reading: its own error explains more. A\n+        // child that succeeds can exit without reading the input it doesn't\n+        // need, which breaks the pipe.\n+        if output.status.success()\n+            && let Err(error) = written\n+            && error.kind() != ErrorKind::BrokenPipe\n+        {\n+            return Err(error);\n+        }\n+        Ok(output)\n+    })\n+}\n+\n /// Get the name of the current branch.\n fn get_current_branch(directory: impl AsRef<Utf8Path>) -> anyhow::Result<String> {\n     git_in_dir(directory.as_ref(), &[\"rev-parse\", \"--abbrev-ref\", \"HEAD\"]).map_err(|e| {\n@@ -703,15 +799,106 @@ mod tests {\n         let path = Utf8Path::new(\"pkg\");\n         fs_err::create_dir(directory.path().join(path)).unwrap();\n         let KeepMineMerge { base, mine, .. } = keep_mine_merge(&repo, path);\n+        let parents = |exclude: &[&str]| -> Vec<_> {\n+            repo.parents_at_paths(\"HEAD\", exclude, &[path], None)\n+                .unwrap()\n+                .into_iter()\n+                .map(|commit| (commit.id, commit.parents))\n+                .collect()\n+        };\n \n         assert_eq!(\n-            repo.parents_at_paths(\"HEAD\", &[], &[path], None).unwrap(),\n+            parents(&[]),\n             [(mine.clone(), vec![base.clone()]), (base.clone(), vec![])]\n         );\n-        assert_eq!(\n-            repo.parents_at_paths(\"HEAD\", &[&base], &[path], None)\n-                .unwrap(),\n-            [(mine, vec![base])]\n+        assert_eq!(parents(&[&base]), [(mine, vec![base])]);\n+    }\n+\n+    /// [`Repo::parents_at_paths`] reads every message in one go, so it must split\n+    /// them from the commit headers whatever they contain.\n+    #[test]\n+    fn history_messages_equal_the_messages_of_checked_out_commits() {\n+        test_logs::init();\n+        let directory = tempdir().unwrap();\n+        let repo = Repo::init(&directory);\n+        let path = Utf8Path::new(\"file\");\n+        for message in [\n+            // A line that looks like the header of another commit.\n+            \"feat: first\\n\\ncommit 0000000000000000000000000000000000000000\\n\",\n+            // Surrounding whitespace, which both readers trim.\n+            \"  fix: second  \\n\\n\",\n+            \"\",\n+        ] {\n+            fs_err::write(directory.path().join(path), message).unwrap();\n+            repo.git(&[\"add\", \".\"]).unwrap();\n+            // Commit the message from stdin: `Repo::git` trims its arguments.\n+            repo.git_output_with_input(\n+                &[\n+                    \"commit\",\n+                    \"--cleanup=verbatim\",\n+                    \"--allow-empty-message\",\n+                    \"-F\",\n+                    \"-\",\n+                ],\n+                message.as_bytes(),\n+            )\n+            .unwrap();\n+        }\n+\n+        let commits = repo.parents_at_paths(\"HEAD\", &[], &[path], None).unwrap();\n+        assert_eq!(commits.len(), 3);\n+        for commit in commits {\n+            repo.checkout(&commit.id).unwrap();\n+            assert_eq!(\n+                commit.message().unwrap(),\n+                repo.current_commit_message().unwrap()\n+            );\n+        }\n+    }\n+\n+    /// Git can exit successfully without reading all of its input, breaking the\n+    /// pipe for any input it didn't read.\n+    #[test]\n+    fn input_that_git_does_not_read_is_not_an_error() {\n+        test_logs::init();\n+        let directory = tempdir().unwrap();\n+        let repo = Repo::init(&directory);\n+        // More than a pipe holds, so writing it can't finish before git exits.\n+        let input = b\"x\\n\".repeat(1 << 20);\n+        repo.git_output_with_input(&[\"rev-parse\", \"HEAD\"], &input)\n+            .unwrap();\n+    }\n+\n+    /// Git can print invalid UTF-8, such as paths, before it fails: the error\n+    /// must still report why it failed.\n+    #[test]\n+    fn git_error_is_reported_after_invalid_utf8_output() {\n+        test_logs::init();\n+        let directory = tempdir().unwrap();\n+        let repo = Repo::init(&directory);\n+        // Stage the path from stdin: file systems can reject invalid UTF-8 names.\n+        let blob = repo.git(&[\"rev-parse\", \"HEAD:README.md\"]).unwrap();\n+        let entry = [format!(\"100644 {blob}\\t\").as_bytes(), b\"invalid-\\xff\\n\"].concat();\n+        repo.git_output_with_input(&[\"update-index\", \"--index-info\"], &entry)\n+            .unwrap();\n+        repo.git(&[\"commit\", \"-m\", \"add invalid UTF-8 path\"])\n+            .unwrap();\n+        let commit = repo.current_commit_hash().unwrap();\n+\n+        // Git prints the path added by `commit`, then fails on the missing parent.\n+        let missing = \"0000000000000000000000000000000000000001\";\n+        let input = format!(\"{commit}\\n{commit} {missing}\\n\");\n+        let error = repo\n+            .git_output_with_input(\n+                &[\"diff-tree\", \"-r\", \"-z\", \"--always\", \"--stdin\"],\n+                input.as_bytes(),\n+            )\n+            .unwrap_err();\n+        assert!(\n+            error\n+                .to_string()\n+                .contains(&format!(\"fatal: unable to parse commit {missing}\")),\n+            \"{error:#}\"\n         );\n     }\n "},{"sha":"e5fafe9d278206ba24f64dce82e718326f145d8b","filename":"crates/release_plz/Cargo.toml","status":"modified","additions":4,"deletions":4,"changes":8,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2FCargo.toml","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2FCargo.toml","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz%2FCargo.toml?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"release-plz\"\n-version = \"0.3.172\"\n+version = \"0.3.173\"\n edition.workspace = true\n description = \"Update version and changelog based on semantic versioning and conventional commits\"\n repository = \"https://github.com/release-plz/release-plz\"\n@@ -20,9 +20,9 @@ docker-tests = []\n all-static = [\"release_plz_core/all-static\"]\n \n [dependencies]\n-git_cmd = { path = \"../git_cmd\", version = \"0.9.0\" }\n-release_plz_core = { path = \"../release_plz_core\", version = \"0.40.0\", default-features = false }\n-cargo_utils = { path = \"../cargo_utils\", version = \"0.1\" }\n+git_cmd = { path = \"../git_cmd\", version = \"0.9.1\" }\n+release_plz_core = { path = \"../release_plz_core\", version = \"0.41.0\", default-features = false }\n+cargo_utils = { path = \"../cargo_utils\", version = \"0.2\" }\n \n anyhow.workspace = true\n base64.workspace = true"},{"sha":"b006e54500ee54f490da6546632bcbfdbd7479a9","filename":"crates/release_plz/tests/all/download.rs","status":"modified","additions":1,"deletions":4,"changes":5,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Fdownload.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Fdownload.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz%2Ftests%2Fall%2Fdownload.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -120,12 +120,9 @@ async fn download_respects_source_replacement() {\n     let name = &context.gitea.repo;\n     context.run_cargo_publish(name);\n \n-    let config_path = context.repo_dir().join(\".cargo/config.toml\");\n-    let mut config = fs_err::read_to_string(&config_path).unwrap();\n-    config.push_str(&format!(\n+    context.append_cargo_config(&format!(\n         \"\\n[source.crates-io]\\nreplace-with = '{TEST_REGISTRY}'\\n\"\n     ));\n-    fs_err::write(config_path, config).unwrap();\n \n     let dest_dir = Utf8TempDir::new().unwrap();\n     let packages = PackageDownloader::new([name], dest_dir.path().as_str())"},{"sha":"9854533584108e7364721d78356272bcdf893469","filename":"crates/release_plz/tests/all/helpers/gitea/gitea_client.rs","status":"modified","additions":11,"deletions":1,"changes":12,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Fhelpers%2Fgitea%2Fgitea_client.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Fhelpers%2Fgitea%2Fgitea_client.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz%2Ftests%2Fall%2Fhelpers%2Fgitea%2Fgitea_client.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -1,6 +1,6 @@\n use crate::helpers::{gitea::gitea_address, reqwest_utils::ReqwestUtils};\n \n-use super::{GiteaContext, GiteaUser};\n+use super::{CARGO_INDEX_REPO, GiteaContext, GiteaUser};\n \n impl GiteaContext {\n     pub fn repo_clone_url(&self) -> String {\n@@ -15,6 +15,16 @@ impl GiteaContext {\n         )\n     }\n \n+    /// Index of the Cargo registry that gitea hosts for the user.\n+    /// See <https://docs.gitea.com/usage/packages/cargo>.\n+    pub fn cargo_index_url(&self) -> String {\n+        format!(\n+            \"http://{}/{}/{CARGO_INDEX_REPO}.git\",\n+            gitea_address(),\n+            self.user.username()\n+        )\n+    }\n+\n     pub async fn repo_exists(&self, repo_name: &str) -> bool {\n         let repo = self.get_repo(repo_name).await;\n         repo == repo_name"},{"sha":"6aa48fb8fdb529405eaca6b4d08bd8256d111b2c","filename":"crates/release_plz/tests/all/helpers/mod.rs","status":"modified","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Fhelpers%2Fmod.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Fhelpers%2Fmod.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz%2Ftests%2Fall%2Fhelpers%2Fmod.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -14,6 +14,13 @@ pub fn today() -> String {\n     chrono::Utc::now().format(\"%Y-%m-%d\").to_string()\n }\n \n+pub fn assert_cargo_semver_checks_is_installed() {\n+    assert!(\n+        release_plz_core::semver_check::is_cargo_semver_checks_installed(),\n+        \"cargo-semver-checks is not installed. Please install it to run tests: https://github.com/obi1kenobi/cargo-semver-checks\"\n+    );\n+}\n+\n /// Check resolved versions with `--locked`, which also rejects stale lockfiles.\n pub fn assert_locked_versions(project_dir: &Utf8Path, expected_versions: &[(&str, &str)]) {\n     let metadata = locked_metadata(project_dir);"},{"sha":"158ae1ebd0f9d313bdb1c72bca7be6e5c8968321","filename":"crates/release_plz/tests/all/helpers/test_context.rs","status":"modified","additions":41,"deletions":32,"changes":73,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Fhelpers%2Ftest_context.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Fhelpers%2Ftest_context.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz%2Ftests%2Fall%2Fhelpers%2Ftest_context.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -1,6 +1,5 @@\n use std::{process::Command, time::Duration};\n \n-use crate::helpers::gitea::CARGO_INDEX_REPO;\n use assert_cmd::assert::Assert;\n use cargo_metadata::{\n     Package,\n@@ -17,11 +16,7 @@ use secrecy::SecretString;\n \n use tracing::info;\n \n-use super::{\n-    TEST_REGISTRY, fake_utils,\n-    gitea::{GiteaContext, gitea_address},\n-    package::TestPackage,\n-};\n+use super::{TEST_REGISTRY, fake_utils, gitea::GiteaContext, package::TestPackage};\n \n const CRATES_DIR: &str = \"crates\";\n const RELEASE_PLZ_LOG: &str = \"RELEASE_PLZ_LOG\";\n@@ -204,30 +199,42 @@ impl TestContext {\n     }\n \n     pub fn run_release_pr(&self) -> Assert {\n-        self.run_release_pr_with_log(&log_level())\n+        self.release_pr_command(&self.gitea.token).assert()\n     }\n \n     pub fn run_release_pr_with_log(&self, log: &str) -> Assert {\n-        super::cmd::release_plz_cmd(&self.cargo_target_dir())\n-            .current_dir(self.repo_dir())\n+        self.release_pr_command(&self.gitea.token)\n             .env(RELEASE_PLZ_LOG, log)\n+            .assert()\n+    }\n+\n+    pub fn release_pr_command(&self, git_token: &str) -> assert_cmd::Command {\n+        let mut command = super::cmd::release_plz_cmd(&self.cargo_target_dir());\n+        command\n+            .current_dir(self.repo_dir())\n+            .env(RELEASE_PLZ_LOG, log_level())\n             .arg(\"release-pr\")\n             .arg(\"--verbose\")\n             .arg(\"--git-token\")\n-            .arg(&self.gitea.token)\n+            .arg(git_token)\n             .arg(\"--forge\")\n             .arg(\"gitea\")\n             .arg(\"--registry\")\n             .arg(TEST_REGISTRY)\n             .arg(\"--output\")\n             .arg(\"json\")\n-            .timeout(Duration::from_secs(300))\n-            .assert()\n+            .timeout(Duration::from_secs(300));\n+        command\n     }\n \n     pub fn run_release(&self) -> Assert {\n+        self.release_command().assert()\n+    }\n+\n+    pub fn release_command(&self) -> assert_cmd::Command {\n         let token_env_var = cargo_registries_token_env_var_name(TEST_REGISTRY).unwrap();\n-        super::cmd::release_plz_cmd(&self.cargo_target_dir())\n+        let mut command = super::cmd::release_plz_cmd(&self.cargo_target_dir());\n+        command\n             .current_dir(self.repo_dir())\n             .env(RELEASE_PLZ_LOG, log_level())\n             .env(token_env_var, format!(\"Bearer {}\", self.gitea.token))\n@@ -241,8 +248,8 @@ impl TestContext {\n             .arg(TEST_REGISTRY)\n             .arg(\"--output\")\n             .arg(\"json\")\n-            .timeout(Duration::from_secs(300))\n-            .assert()\n+            .timeout(Duration::from_secs(300));\n+        command\n     }\n \n     pub fn repo_dir(&self) -> Utf8PathBuf {\n@@ -263,6 +270,13 @@ impl TestContext {\n         self.push_all_changes(\"add config file\");\n     }\n \n+    pub fn append_cargo_config(&self, content: &str) {\n+        let config_path = self.repo_dir().join(\".cargo/config.toml\");\n+        let mut config = fs_err::read_to_string(&config_path).unwrap();\n+        config.push_str(content);\n+        fs_err::write(config_path, config).unwrap();\n+    }\n+\n     pub fn write_changelog(&self, content: &str) {\n         let changelog_path = self.repo_dir().join(\"CHANGELOG.md\");\n         fs_err::write(changelog_path, content).unwrap();\n@@ -322,37 +336,32 @@ fn configure_repo(repo_dir: &Utf8Path, gitea: &GiteaContext) -> Repo {\n         .unwrap();\n     repo.disable_gpg_signing().unwrap();\n \n-    create_cargo_config(repo_dir, username);\n+    create_cargo_config(repo_dir, &gitea.cargo_index_url());\n \n     repo\n }\n \n-fn create_cargo_config(repo_dir: &Utf8Path, username: &str) {\n+fn create_cargo_config(repo_dir: &Utf8Path, index_url: &str) {\n     let config_dir = repo_dir.join(\".cargo\");\n     fs_err::create_dir(&config_dir).unwrap();\n     let config_file = config_dir.join(\"config.toml\");\n-    let cargo_config = cargo_config(username);\n+    let cargo_config = cargo_config(index_url);\n     fs_err::write(config_file, cargo_config).unwrap();\n }\n \n-fn cargo_config(username: &str) -> String {\n+fn cargo_config(index_url: &str) -> String {\n     // matches the docker compose file\n-    let cargo_registries = format!(\n-        \"[registry]\\ndefault = \\\"{TEST_REGISTRY}\\\"\\n\\n[registries.{TEST_REGISTRY}]\\nindex = \"\n-    );\n-    // we use gitea as a cargo registry:\n-    // https://docs.gitea.com/usage/packages/cargo\n-    let gitea_index = format!(\n-        \"\\\"http://{}/{}/{CARGO_INDEX_REPO}.git\\\"\",\n-        gitea_address(),\n-        username\n-    );\n+    format!(\n+        r#\"[registry]\n+default = \"{TEST_REGISTRY}\"\n+\n+[registries.{TEST_REGISTRY}]\n+index = \"{index_url}\"\n \n-    let config_end = r\"\n [net]\n git-fetch-with-cli = true\n-    \";\n-    format!(\"{cargo_registries}{gitea_index}{config_end}\")\n+\"#\n+    )\n }\n \n fn git_client(repo_url: &str, token: &str) -> GitClient {"},{"sha":"04263b7557a8fedb1eb944d14941d7f4cf17cd8a","filename":"crates/release_plz/tests/all/release.rs","status":"modified","additions":151,"deletions":0,"changes":151,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Frelease.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Frelease.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz%2Ftests%2Fall%2Frelease.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -267,3 +267,154 @@ async fn release_plz_can_do_backports() {\n     .to_string();\n     outcome.stdout(format!(\"{expected_stdout}\\n\"));\n }\n+\n+/// How [`CARGO_WRAPPER`] and the registry behave during the release.\n+#[cfg(unix)]\n+#[derive(Debug)]\n+enum Scenario {\n+    /// `cargo publish` confirms that the package is in the registry.\n+    Confirmed,\n+    /// `cargo publish` doesn't print the `Published` status,\n+    /// like a Cargo whose wait for the package timed out.\n+    Unconfirmed,\n+    /// `cargo publish` confirms the package, but Cargo resolves dependencies from a\n+    /// mirror of the registry, which catches up only after the first failed check\n+    /// following publication.\n+    LaggingMirror,\n+    /// `cargo publish` confirms the package, and Cargo resolves dependencies from a\n+    /// local directory, which never receives the published package.\n+    VendoredSource,\n+}\n+\n+/// Cargo wrapper that records the subcommands run by release-plz\n+/// and simulates the [`Scenario`] passed in `SCENARIO`.\n+#[cfg(unix)]\n+const CARGO_WRAPPER: &str = r#\"#!/bin/sh\n+echo \"$1\" >> \"$WRAPPER_DIR/calls\"\n+if [ \"$1\" = info ] && [ \"$SCENARIO\" = LaggingMirror ] && grep -qx publish \"$WRAPPER_DIR/calls\" && [ ! -f \"$WRAPPER_DIR/mirror_updated\" ]; then\n+    \"$REAL_CARGO\" \"$@\"\n+    status=$?\n+    if [ \"$status\" = 0 ]; then\n+        echo 'mirror unexpectedly contains the new package' >&2\n+        exit 1\n+    fi\n+    git -C \"$WRAPPER_DIR/mirror\" pull --ff-only >&2 || exit 1\n+    touch \"$WRAPPER_DIR/mirror_updated\"\n+    exit \"$status\"\n+fi\n+if [ \"$1\" = publish ]; then\n+    \"$REAL_CARGO\" \"$@\" 2> \"$WRAPPER_DIR/publish_stderr\"\n+    status=$?\n+    if [ \"$SCENARIO\" = Unconfirmed ]; then\n+        grep -v Published \"$WRAPPER_DIR/publish_stderr\" >&2\n+    else\n+        cat \"$WRAPPER_DIR/publish_stderr\" >&2\n+    fi\n+    exit $status\n+fi\n+exec \"$REAL_CARGO\" \"$@\"\n+\"#;\n+\n+/// Release a new project through [`CARGO_WRAPPER`] in the given `scenario` and return\n+/// the `cargo info` and `cargo publish` subcommands run by release-plz, in order.\n+#[cfg(unix)]\n+async fn release_cargo_calls(scenario: Scenario) -> Vec<String> {\n+    let context = TestContext::new().await;\n+    let wrapper_dir = Utf8TempDir::new().unwrap();\n+    let cargo = wrapper_dir.path().join(\"cargo\");\n+    fs_err::write(&cargo, CARGO_WRAPPER).unwrap();\n+    crate::helpers::make_executable(&cargo);\n+\n+    let index = context.gitea.cargo_index_url();\n+    let replacement = match scenario {\n+        Scenario::Confirmed | Scenario::Unconfirmed => None,\n+        Scenario::LaggingMirror => {\n+            let mirror = wrapper_dir.path().join(\"mirror\");\n+            assert_cmd::Command::new(\"git\")\n+                .args([\"clone\", &index, mirror.as_str()])\n+                .assert()\n+                .success();\n+            let mirror_url = url::Url::from_directory_path(&mirror).unwrap();\n+            Some(format!(\"registry = {:?}\", mirror_url.as_str()))\n+        }\n+        Scenario::VendoredSource => {\n+            let vendor = wrapper_dir.path().join(\"vendor\");\n+            fs_err::create_dir(&vendor).unwrap();\n+            // If release-plz waited for the package to appear in the directory,\n+            // fail after a few seconds instead of the default 30 minutes.\n+            context.write_release_plz_toml(\"[workspace]\\npublish_timeout = \\\"10s\\\"\\n\");\n+            Some(format!(\"directory = {:?}\", vendor.as_str()))\n+        }\n+    };\n+    if let Some(replacement) = replacement {\n+        // The source name deliberately differs from the registry name: Cargo\n+        // matches replacements by index URL, not by registry name.\n+        context.append_cargo_config(&format!(\n+            \"\\n[source.origin]\\nregistry = {index:?}\\nreplace-with = \\\"replacement\\\"\\n\\\n+             [source.replacement]\\n{replacement}\\n\"\n+        ));\n+        context.push_all_changes(\"replace registry source\");\n+    }\n+\n+    context\n+        .release_command()\n+        .env(\"CARGO\", &cargo)\n+        .env(\"REAL_CARGO\", env!(\"CARGO\"))\n+        .env(\"WRAPPER_DIR\", wrapper_dir.path())\n+        .env(\"SCENARIO\", format!(\"{scenario:?}\"))\n+        .assert()\n+        .success();\n+\n+    if !matches!(scenario, Scenario::Unconfirmed) {\n+        let stderr = fs_err::read_to_string(wrapper_dir.path().join(\"publish_stderr\")).unwrap();\n+        assert!(stderr.contains(\"Published\"), \"{stderr}\");\n+    }\n+    let calls = fs_err::read_to_string(wrapper_dir.path().join(\"calls\")).unwrap();\n+    calls\n+        .lines()\n+        .filter(|subcommand| [\"info\", \"publish\"].contains(subcommand))\n+        .map(str::to_string)\n+        .collect()\n+}\n+\n+#[cfg(unix)]\n+#[tokio::test]\n+#[cfg_attr(not(feature = \"docker-tests\"), ignore)]\n+async fn release_trusts_cargo_publish_confirmation() {\n+    // The first `cargo info` checks whether the package was already published.\n+    assert_eq!(\n+        release_cargo_calls(Scenario::Confirmed).await,\n+        [\"info\", \"publish\"]\n+    );\n+}\n+\n+#[cfg(unix)]\n+#[tokio::test]\n+#[cfg_attr(not(feature = \"docker-tests\"), ignore)]\n+async fn release_waits_for_package_if_cargo_publish_does_not_confirm() {\n+    assert_eq!(\n+        release_cargo_calls(Scenario::Unconfirmed).await,\n+        [\"info\", \"publish\", \"info\"]\n+    );\n+}\n+\n+#[cfg(unix)]\n+#[tokio::test]\n+#[cfg_attr(not(feature = \"docker-tests\"), ignore)]\n+async fn release_waits_for_mirror_after_cargo_publish_confirms() {\n+    assert_eq!(\n+        release_cargo_calls(Scenario::LaggingMirror).await,\n+        [\"info\", \"publish\", \"info\", \"info\"]\n+    );\n+}\n+\n+#[cfg(unix)]\n+#[tokio::test]\n+#[cfg_attr(not(feature = \"docker-tests\"), ignore)]\n+async fn release_trusts_cargo_publish_confirmation_with_vendored_sources() {\n+    // The directory never receives the package, so release-plz must not wait for it.\n+    assert_eq!(\n+        release_cargo_calls(Scenario::VendoredSource).await,\n+        [\"info\", \"publish\"]\n+    );\n+}"},{"sha":"ebf2aaeba1f366818d6e4d93c3d92a990c9c0540","filename":"crates/release_plz/tests/all/release_pr.rs","status":"modified","additions":16,"deletions":8,"changes":24,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Frelease_pr.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Frelease_pr.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz%2Ftests%2Fall%2Frelease_pr.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -1,5 +1,5 @@\n use crate::helpers::{\n-    TEST_REGISTRY, assert_locked_versions,\n+    TEST_REGISTRY, assert_cargo_semver_checks_is_installed, assert_locked_versions,\n     package::{PackageType, TestPackage},\n     test_context::TestContext,\n     today,\n@@ -145,13 +145,6 @@ async fn release_pr_pre_bumped_shared_versions_update_dependency_requirements()\n     );\n }\n \n-fn assert_cargo_semver_checks_is_installed() {\n-    assert!(\n-        release_plz_core::semver_check::is_cargo_semver_checks_installed(),\n-        \"cargo-semver-checks is not installed. Please install it to run tests: https://github.com/obi1kenobi/cargo-semver-checks\"\n-    );\n-}\n-\n #[tokio::test]\n #[cfg_attr(not(feature = \"docker-tests\"), ignore)]\n async fn release_plz_opens_pr_with_default_config() {\n@@ -195,6 +188,21 @@ This PR was generated with [release-plz](https://github.com/release-plz/release-\n     );\n }\n \n+#[tokio::test]\n+#[cfg_attr(not(feature = \"docker-tests\"), ignore)]\n+async fn release_pr_ignores_forge_errors_when_nothing_to_release() {\n+    let context = TestContext::new().await;\n+    context.run_release().success();\n+\n+    // release-pr lists the open PRs while it analyzes the packages. With nothing to release,\n+    // the listing isn't needed, so its failure (caused by the invalid token) must not fail the command.\n+    context\n+        .release_pr_command(\"invalid-token\")\n+        .assert()\n+        .success()\n+        .stdout(\"{\\\"prs\\\":[]}\\n\");\n+}\n+\n #[tokio::test]\n #[cfg_attr(not(feature = \"docker-tests\"), ignore)]\n async fn release_plz_opens_pr_without_breaking_changes() {"},{"sha":"367bec38dd379f009925c97c6477ec9596b25c9d","filename":"crates/release_plz/tests/all/update.rs","status":"modified","additions":108,"deletions":4,"changes":112,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Fupdate.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz%2Ftests%2Fall%2Fupdate.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz%2Ftests%2Fall%2Fupdate.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -2,7 +2,86 @@ use cargo_metadata::camino::Utf8Path;\n use git_cmd::Repo;\n use release_plz_core::fs_utils::Utf8TempDir;\n \n-use crate::helpers::{assert_locked_versions, cmd::release_plz_cmd, locked_metadata};\n+use crate::helpers::{\n+    assert_cargo_semver_checks_is_installed, assert_locked_versions, cmd::release_plz_cmd,\n+    locked_metadata,\n+};\n+\n+#[test]\n+fn semver_check_preserves_explicit_default_target_directory() {\n+    for variable in [\"CARGO_TARGET_DIR\", \"CARGO_BUILD_TARGET_DIR\"] {\n+        let (_temp_dir, repo) = update_with_removed_function(|repo, cmd| {\n+            cmd.env(variable, repo.directory().join(\"target\"));\n+        });\n+\n+        // Even when it matches Cargo's default, an explicit target directory\n+        // must retain the rustdoc build artifacts for reuse on the next run.\n+        assert!(\n+            repo.directory().join(\"target/doc/one.json\").exists(),\n+            \"{variable}\"\n+        );\n+    }\n+}\n+\n+#[test]\n+fn semver_check_preserves_target_directory_from_cargo_config() {\n+    let (_temp_dir, repo) = update_with_removed_function(|repo, _| {\n+        let cargo_dir = repo.directory().join(\".cargo\");\n+        fs_err::create_dir(&cargo_dir).unwrap();\n+        fs_err::write(\n+            cargo_dir.join(\"config.toml\"),\n+            \"[build]\\ntarget-dir = \\\"custom\\\"\\n\",\n+        )\n+        .unwrap();\n+    });\n+\n+    // Unlike the target directory variables, `build.target-dir` is only visible in\n+    // the cargo metadata, and it must retain the rustdoc build artifacts all the same.\n+    assert!(repo.directory().join(\"custom/doc/one.json\").exists());\n+}\n+\n+#[test]\n+fn semver_check_builds_in_a_temporary_target_directory_by_default() {\n+    // Without a configured target directory, release-plz picks one per package.\n+    let (temp_dir, _repo) = update_with_removed_function(|_, _| {});\n+\n+    // Without a temporary target directory, cargo-semver-checks would build the\n+    // baseline in `registry/target`, the default target directory of its workspace.\n+    assert!(!temp_dir.path().join(\"registry/target\").exists());\n+}\n+\n+/// Runs `release-plz update` with semver checks after a `fix:` commit to `one`,\n+/// whose published version has a public function missing from the local one.\n+/// The target directory variables are removed, so `configure` decides the target\n+/// directory. It runs before the commit, as release-plz rejects uncommitted changes.\n+fn update_with_removed_function(\n+    configure: impl FnOnce(&Repo, &mut assert_cmd::Command),\n+) -> (Utf8TempDir, Repo) {\n+    assert_cargo_semver_checks_is_installed();\n+    let (temp_dir, repo) = released_workspace(\n+        &[(\"one\", \"version = \\\"1.0.0\\\"\\n\")],\n+        \"\",\n+        \"[workspace]\\nsemver_check = true\\n\",\n+    );\n+    fs_err::write(\n+        temp_dir.path().join(\"registry/one/src/lib.rs\"),\n+        \"pub fn removed() {}\\n\",\n+    )\n+    .unwrap();\n+    let mut cmd = workspace_update_command(&temp_dir, &repo);\n+    cmd.env_remove(\"CARGO_TARGET_DIR\")\n+        .env_remove(\"CARGO_BUILD_TARGET_DIR\");\n+    configure(&repo, &mut cmd);\n+    change_package(&repo, \"one\", \"fix: update library\");\n+\n+    cmd.assert().success();\n+\n+    // The current and the baseline version have the same name and version, so they\n+    // write the same rustdoc JSON file in the shared target directory. The `fix`\n+    // commit bumps the major version only if the removed function is still detected.\n+    assert_locked_versions(repo.directory(), &[(\"one\", \"2.0.0\")]);\n+    (temp_dir, repo)\n+}\n \n #[test]\n fn update_workspace_without_publishable_packages() {\n@@ -230,6 +309,26 @@ fn update_lists_package_files_again_after_changes_in_skipped_commits() {\n     );\n }\n \n+#[test]\n+fn update_lists_package_files_again_after_changes_beyond_the_first_batch() {\n+    // The walk has more snapshots than the first `diff-tree` batch compares,\n+    // and a commit in a later batch adds a Rust source. HEAD and the parent of\n+    // that commit each ask Cargo, and every other snapshot reuses a list.\n+    assert_package_file_listings_with_change(\n+        \"later batch\",\n+        |repo| {\n+            for i in 0..20 {\n+                if i == 10 {\n+                    fs_err::write(repo.directory().join(\"one/src/extra.rs\"), \"\").unwrap();\n+                }\n+                change_package(repo, \"one\", &format!(\"fix: change {i}\"));\n+            }\n+        },\n+        3,\n+        21,\n+    );\n+}\n+\n #[cfg(unix)]\n #[test]\n fn update_lists_package_files_when_checkout_hooks_change_files() {\n@@ -278,8 +377,13 @@ fn update_lists_package_files_when_older_snapshots_track_a_checkout_hook() {\n     // only when the walk starts would still reuse a stale list.\n     fs_err::remove_file(&hook).unwrap();\n     change_package(&repo, \"one\", \"fix: second change\");\n+    // Neither HEAD nor the second change has the hook, so the second change\n+    // reuses HEAD's list. The hook's removal makes the first change ask Cargo,\n+    // and the release snapshot must check for the hook again rather than keep\n+    // the answer for the newer checkouts.\n+    change_package(&repo, \"one\", \"fix: third change\");\n \n-    assert_package_file_listings(&temp_dir, &repo, \"tracked hook\", 4, 0);\n+    assert_package_file_listings(&temp_dir, &repo, \"tracked hook\", 4, 1);\n }\n \n /// Install at `hook` an executable script that removes the untracked file\n@@ -367,8 +471,8 @@ fn assert_package_file_listings_with_change(\n /// Assert that updating the [`single_package_workspace`] of `repo` runs\n /// `cargo package --list` `cargo_runs` times, including once for the released\n /// source tree, and reuses a historical package file list `reuses` times, while\n-/// the update still finds exactly the package changes `fix: first change` and\n-/// `fix: second change`.\n+/// the update still finds the package changes `fix: first change` and\n+/// `fix: second change` but not the initial commit.\n fn assert_package_file_listings(\n     temp_dir: &Utf8TempDir,\n     repo: &Repo,"},{"sha":"6304fd29711defcaccdcade8c853c71feaa684f1","filename":"crates/release_plz_core/CHANGELOG.md","status":"modified","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2FCHANGELOG.md","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz_core%2FCHANGELOG.md?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -7,6 +7,16 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.41.0](https://github.com/release-plz/release-plz/compare/release_plz_core-v0.40.0...release_plz_core-v0.41.0) - 2026-10-19\n+\n+### Performance\n+\n+- spawn fewer and cheaper git processes in history walks ([#3250](https://github.com/release-plz/release-plz/pull/3250))\n+- don't query the registry again after cargo publish confirms the package ([#3251](https://github.com/release-plz/release-plz/pull/3251))\n+- reuse dependency builds between current and baseline semver checks ([#3243](https://github.com/release-plz/release-plz/pull/3243))\n+- list open PRs while release-pr analyzes the packages ([#3249](https://github.com/release-plz/release-plz/pull/3249))\n+- read downloaded registry packages in parallel ([#3246](https://github.com/release-plz/release-plz/pull/3246))\n+\n ## [0.40.0](https://github.com/release-plz/release-plz/compare/release_plz_core-v0.39.0...release_plz_core-v0.40.0) - 2026-10-12\n \n ### Performance"},{"sha":"4b00be4bc1816e8984943261e81d59261b2cc5d1","filename":"crates/release_plz_core/Cargo.toml","status":"modified","additions":5,"deletions":4,"changes":9,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2FCargo.toml","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2FCargo.toml","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz_core%2FCargo.toml?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"release_plz_core\"\n-version = \"0.40.0\"\n+version = \"0.41.0\"\n edition.workspace = true\n description = \"Update version and changelog based on semantic versioning and conventional commits\"\n repository = \"https://github.com/release-plz/release-plz/tree/main/crates/release_plz_core\"\n@@ -17,8 +17,8 @@ all-static = [\"cargo/vendored-libgit2\", \"cargo/all-static\"]\n \n [dependencies]\n base64.workspace = true\n-cargo_utils = { path = \"../cargo_utils\", version = \"0.1.87\" }\n-git_cmd = { path = \"../git_cmd\", version = \"0.9.0\" }\n+cargo_utils = { path = \"../cargo_utils\", version = \"0.2.0\" }\n+git_cmd = { path = \"../git_cmd\", version = \"0.9.1\" }\n next_version = { path = \"../next_version\", version = \"0.3\" }\n \n anyhow.workspace = true\n@@ -46,7 +46,8 @@ url = { workspace = true, features = [\"serde\"] }\n walkdir.workspace = true\n toml_edit.workspace = true\n serde_json.workspace = true\n-tokio = { workspace = true, features = [\"fs\", \"macros\"] }\n+tokio = { workspace = true, features = [\"fs\", \"macros\", \"rt\"] }\n+tokio-util = { workspace = true, features = [\"rt\"] }\n tera.workspace = true\n git2.workspace = true\n "},{"sha":"a6c870f505ab908849e62ad6b389308accb080bf","filename":"crates/release_plz_core/src/cargo.rs","status":"modified","additions":61,"deletions":26,"changes":87,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fcargo.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fcargo.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz_core%2Fsrc%2Fcargo.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -1,5 +1,5 @@\n use anyhow::Context;\n-use cargo::{GlobalContext, util::homedir};\n+use cargo::{GlobalContext, sources::SourceConfigMap, util::homedir, workspace::SourceId};\n use cargo_metadata::{\n     Package,\n     camino::{Utf8Path, Utf8PathBuf},\n@@ -11,7 +11,6 @@ use std::{\n     time::{Duration, Instant},\n };\n use tracing::{debug, info};\n-use url::Url;\n \n /// Read a workspace member without resolving its dependencies.\n pub(crate) fn read_package_metadata(\n@@ -46,7 +45,32 @@ pub struct CargoRegistry {\n     /// Name of the registry.\n     /// [`Option::None`] means default 'crate.io'.\n     pub name: Option<String>,\n-    pub index_url: Option<Url>,\n+    /// Whether Cargo resolves dependencies from a remote mirror, i.e. a remote registry\n+    /// other than the one where `cargo publish` confirms the package, which may lag behind.\n+    pub has_remote_mirror: bool,\n+}\n+\n+impl CargoRegistry {\n+    pub fn new(config: &GlobalContext, name: Option<String>) -> anyhow::Result<Self> {\n+        let source_id = SourceId::alt_registry(config, registry_or_crates_io(name.as_deref()))?;\n+        // `cargo publish` confirms the package on the publish registry, which follows only\n+        // Cargo's built-in replacement (e.g. the crates.io sparse index).\n+        let publish_source = SourceConfigMap::empty(config)?\n+            .load(source_id)?\n+            .replaced_source_id();\n+        // Dependency resolution follows the configured replacement instead, which may be\n+        // a remote mirror that lags behind. Local replacements (`directory` and\n+        // `local-registry`) never receive the published package, so don't wait for them.\n+        let dependency_source = SourceConfigMap::new(config)?\n+            .load(source_id)?\n+            .replaced_source_id();\n+        let has_remote_mirror =\n+            dependency_source.is_remote_registry() && dependency_source != publish_source;\n+        Ok(Self {\n+            name,\n+            has_remote_mirror,\n+        })\n+    }\n }\n \n fn cargo_cmd() -> Command {\n@@ -107,11 +131,10 @@ pub async fn is_published(\n     package: &Package,\n     timeout: Duration,\n     registry: Option<&str>,\n-    index_url: Option<&Url>,\n     token: Option<&SecretString>,\n ) -> anyhow::Result<bool> {\n     tokio::time::timeout(timeout, async {\n-        let output = run_cargo_info(workspace_root, package, registry, index_url, token)\n+        let output = run_cargo_info(workspace_root, package, registry, token)\n             .context(\"cannot run cargo info\")?;\n         if output.status.success() {\n             Ok(true)\n@@ -135,7 +158,7 @@ pub async fn is_published(\n     .with_context(|| format!(\"timeout while checking if `{}` is published\", package.name))\n }\n \n-fn cargo_info_registry_name(registry: Option<&str>) -> &str {\n+fn registry_or_crates_io(registry: Option<&str>) -> &str {\n     match registry {\n         None | Some(\"crates-io\") => \"crates-io\",\n         Some(name) => name,\n@@ -153,27 +176,16 @@ fn run_cargo_info(\n     workspace_root: &Utf8Path,\n     package: &Package,\n     registry: Option<&str>,\n-    index_url: Option<&Url>,\n     token: Option<&SecretString>,\n ) -> anyhow::Result<CmdOutput> {\n-    let registry_name = cargo_info_registry_name(registry);\n-    let mut args = vec![\n-        \"info\".to_string(),\n-        format!(\"{}@{}\", package.name, package.version),\n-    ];\n-\n-    if let Some(index_url) = index_url {\n-        args.push(\"--index\".to_string());\n-        args.push(index_url.as_str().to_string());\n-    } else {\n-        args.push(\"--registry\".to_string());\n-        args.push(registry_name.to_string());\n-    }\n+    let registry_name = registry_or_crates_io(registry);\n+    let spec = format!(\"{}@{}\", package.name, package.version);\n+    let args = [\"info\", &spec, \"--registry\", registry_name];\n \n     debug!(\"Run `cargo {}` in {workspace_root}\", args.join(\" \"));\n \n     let mut cmd = cargo_cmd();\n-    cmd.current_dir(workspace_root).args(&args);\n+    cmd.current_dir(workspace_root).args(args);\n \n     let mut envs = vec![];\n \n@@ -182,25 +194,22 @@ fn run_cargo_info(\n         envs.push((env_var, token.clone()));\n     }\n \n-    let args_refs: Vec<&str> = args.iter().map(|s| s.as_str()).collect();\n-    run_cargo_with_env(workspace_root, &args_refs, &envs)\n+    run_cargo_with_env(workspace_root, &args, &envs)\n }\n \n pub async fn wait_until_published(\n     workspace_root: &Utf8Path,\n     package: &Package,\n     timeout: Duration,\n     registry: Option<&str>,\n-    index_url: Option<&Url>,\n     token: Option<&SecretString>,\n ) -> anyhow::Result<()> {\n     let now: Instant = Instant::now();\n     let sleep_time = Duration::from_secs(2);\n     let mut logged = false;\n \n     loop {\n-        let is_published =\n-            is_published(workspace_root, package, timeout, registry, index_url, token).await?;\n+        let is_published = is_published(workspace_root, package, timeout, registry, token).await?;\n         if is_published {\n             break;\n         } else if timeout < now.elapsed() {\n@@ -224,3 +233,29 @@ pub async fn wait_until_published(\n \n     Ok(())\n }\n+\n+#[cfg(test)]\n+mod tests {\n+    use super::*;\n+\n+    #[test]\n+    fn crates_io_sparse_index_does_not_require_a_mirror_wait() {\n+        // Cargo reads the configuration of the Cargo home and of the `.cargo` directories\n+        // of the working directory and its ancestors. Use a temporary Cargo home and the\n+        // filesystem root as working directory, so that the Cargo configuration of the\n+        // machine running the test (e.g. a crates.io mirror) doesn't apply, even if the\n+        // temporary directory is inside the home directory.\n+        let temporary = crate::fs_utils::Utf8TempDir::new().unwrap();\n+        let cargo_home = temporary.path().as_std_path();\n+        let root = cargo_home.ancestors().last().unwrap();\n+        #[expect(\n+            clippy::default_trait_access,\n+            reason = \"Cargo doesn't export the shell type\"\n+        )]\n+        let config = GlobalContext::new(Default::default(), root.to_owned(), cargo_home.to_owned());\n+        for name in [None, Some(\"crates-io\".to_string())] {\n+            let registry = CargoRegistry::new(&config, name).unwrap();\n+            assert!(!registry.has_remote_mirror);\n+        }\n+    }\n+}"},{"sha":"9c4f387981b032520b6362559fe0c085d6354ac3","filename":"crates/release_plz_core/src/command/release.rs","status":"modified","additions":56,"deletions":79,"changes":135,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Frelease.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Frelease.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Frelease.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -16,12 +16,14 @@ use git_cmd::Repo;\n use secrecy::SecretString;\n use serde::Serialize;\n use tracing::{debug, info, instrument, trace, warn};\n-use url::Url;\n \n use crate::{\n     CHANGELOG_FILENAME, DEFAULT_BRANCH_PREFIX, GitForge, PackagePath, Project, Publishable as _,\n     ReleaseMetadata, ReleaseMetadataBuilder, Remote,\n-    cargo::{CargoRegistry, CmdOutput, is_published, run_cargo_with_env, wait_until_published},\n+    cargo::{\n+        CargoRegistry, CmdOutput, is_published, new_cargo_config, run_cargo_with_env,\n+        wait_until_published,\n+    },\n     changelog_parser,\n     git::forge::GitClient,\n     next_ver::takes_part_in_release,\n@@ -732,17 +734,20 @@ async fn release_package_if_needed(\n     let mut package_was_released = false;\n \n     if should_publish {\n-        let registry_indexes = registry_indexes(package, input.registry.clone())\n-            .context(\"can't determine registry indexes\")?;\n+        let registry_indexes = registry_indexes(\n+            package,\n+            input.registry.clone(),\n+            &input.metadata.workspace_root,\n+        )\n+        .context(\"can't determine registry indexes\")?;\n \n-        for CargoRegistry { name, index_url } in registry_indexes {\n-            let token = input.find_registry_token(name.as_deref())?;\n+        for registry in registry_indexes {\n+            let token = input.find_registry_token(registry.name.as_deref())?;\n             let pkg_is_published = is_published(\n                 &input.metadata.workspace_root,\n                 package,\n                 input.publish_timeout,\n-                name.as_deref(),\n-                index_url.as_ref(),\n+                registry.name.as_deref(),\n                 token.as_ref(),\n             )\n             .await\n@@ -758,9 +763,7 @@ async fn release_package_if_needed(\n                 context,\n                 &release_info,\n                 token.as_ref(),\n-                name.as_deref(),\n-                name.as_deref(),\n-                index_url.as_ref(),\n+                &registry,\n             )\n             .await\n             .context(\"failed to release package\")?;\n@@ -840,39 +843,26 @@ async fn should_release(\n     }\n }\n \n-/// Get the indexes where the package should be published.\n+/// Get the registries where the package should be published.\n /// If `registry` is specified, it takes precedence over the `publish` field\n /// of the package manifest.\n fn registry_indexes(\n     package: &Package,\n     registry: Option<String>,\n+    workspace_root: &Utf8Path,\n ) -> anyhow::Result<Vec<CargoRegistry>> {\n     let registries = registry\n         .map(|r| vec![r])\n         .unwrap_or_else(|| package.publish.clone().unwrap_or_default());\n-    let registry_urls = registries\n-        .into_iter()\n-        .map(|r| {\n-            cargo_utils::registry_url(package.manifest_path.as_ref(), Some(&r))\n-                .context(\"failed to retrieve registry url\")\n-                .map(|url| (r, url))\n-        })\n-        .collect::<anyhow::Result<Vec<(String, Url)>>>()?;\n-\n-    let mut registry_indexes = registry_urls\n-        .into_iter()\n-        .map(|(registry, u)| CargoRegistry {\n-            name: Some(registry),\n-            index_url: Some(u),\n-        })\n-        .collect::<Vec<CargoRegistry>>();\n-    if registry_indexes.is_empty() {\n-        registry_indexes.push(CargoRegistry {\n-            name: None,\n-            index_url: None,\n-        });\n+    let config = new_cargo_config(Some(workspace_root.to_owned()))?;\n+    if registries.is_empty() {\n+        Ok(vec![CargoRegistry::new(&config, None)?])\n+    } else {\n+        registries\n+            .into_iter()\n+            .map(|name| CargoRegistry::new(&config, Some(name)))\n+            .collect()\n     }\n-    Ok(registry_indexes)\n }\n \n struct ReleaseInfo<'a> {\n@@ -884,18 +874,16 @@ struct ReleaseInfo<'a> {\n }\n \n /// Return `true` if package was published, `false` otherwise.\n-#[allow(clippy::too_many_arguments)]\n async fn release_package(\n     input: &ReleaseRequest,\n     repo: &Repo,\n     context: &mut ReleaseContext<'_>,\n     release_info: &ReleaseInfo<'_>,\n     token: Option<&SecretString>,\n-    registry_name: Option<&str>,\n-    registry: Option<&str>,\n-    index_url: Option<&Url>,\n+    registry: &CargoRegistry,\n ) -> anyhow::Result<bool> {\n     let workspace_root = &input.metadata.workspace_root;\n+    let registry_name = registry.name.as_deref();\n     let is_crates_io = registry_name.is_none() || registry_name == Some(\"crates-io\");\n \n     let should_publish = input.is_publish_enabled(&release_info.package.name);\n@@ -956,6 +944,21 @@ async fn release_package(\n                 );\n             }\n         }\n+        // Wait if a remote mirror may still lag behind (`cargo publish` only checks the\n+        // publish registry) or if `cargo publish` didn't confirm the package.\n+        if !input.dry_run\n+            && (registry.has_remote_mirror\n+                || !is_publish_confirmed_by_cargo(&output, release_info.package))\n+        {\n+            wait_until_published(\n+                workspace_root,\n+                release_info.package,\n+                input.publish_timeout,\n+                registry_name,\n+                token,\n+            )\n+            .await?;\n+        }\n     }\n \n     if input.dry_run {\n@@ -967,18 +970,6 @@ async fn release_package(\n         );\n         Ok(false)\n     } else {\n-        if should_publish {\n-            wait_until_published(\n-                workspace_root,\n-                release_info.package,\n-                input.publish_timeout,\n-                registry,\n-                index_url,\n-                token,\n-            )\n-            .await?;\n-        }\n-\n         create_git_tag_and_release(\n             input,\n             repo,\n@@ -997,6 +988,21 @@ async fn release_package(\n     }\n }\n \n+/// Return `true` if `cargo publish` reported that the package is available in the registry.\n+///\n+/// After the upload, Cargo waits until the new version appears in the registry index\n+/// and then prints `Published <package> v<version> at <registry>`.\n+/// If the wait times out (after 60 s on stable Cargo), Cargo prints a warning instead,\n+/// and release-plz must wait.\n+fn is_publish_confirmed_by_cargo(output: &CmdOutput, package: &Package) -> bool {\n+    // The status is colored, so look for the status and the package on the same line.\n+    let published_package = format!(\"{} v{} at \", package.name, package.version);\n+    output\n+        .stderr\n+        .lines()\n+        .any(|line| line.contains(\"Published\") && line.contains(&published_package))\n+}\n+\n fn is_already_published(output: &CmdOutput, release_info: &ReleaseInfo<'_>) -> bool {\n     // Error happening if the crate was published while `cargo publish` was running.\n     let already_uploaded_message = format!(\n@@ -1836,35 +1842,6 @@ mod tests {\n         });\n     }\n \n-    #[test]\n-    fn should_reference_env_var_provided_index() {\n-        use cargo_utils::registry_url;\n-\n-        let registry_name = \"my_registry\";\n-        let mock_index = \"https://example.com/git/index\";\n-        let mock_index_url = Url::parse(mock_index).unwrap();\n-\n-        let index_env_var = format!(\"CARGO_REGISTRIES_{}_INDEX\", registry_name.to_uppercase());\n-\n-        let fake_metadata = fake_metadata();\n-        let fake_manifest_path = fake_metadata.workspace_root.as_ref();\n-\n-        with_env_var(&index_env_var, mock_index, || {\n-            let maybe_registry_index =\n-                registry_url(fake_manifest_path, Some(registry_name)).unwrap();\n-\n-            // assert the registry index is properly overriden\n-            assert_eq!(maybe_registry_index, mock_index_url);\n-        });\n-\n-        let non_overriden_maybe_registry_index =\n-            registry_url(fake_manifest_path, Some(registry_name)).ok();\n-\n-        // assert the index is inherited from the workspace after the env var\n-        // is cleared.\n-        assert_eq!(non_overriden_maybe_registry_index, None);\n-    }\n-\n     #[test]\n     fn release_config_git_only_reaches_release_rule() {\n         // The full rule is covered by `packages_taking_part_in_a_release` in `next_ver.rs`;"},{"sha":"4ea1e29aa9bba834ede9636bb7680520a8755a99","filename":"crates/release_plz_core/src/command/release_pr/mod.rs","status":"modified","additions":20,"deletions":11,"changes":31,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Frelease_pr%2Fmod.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Frelease_pr%2Fmod.rs","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Frelease_pr%2Fmod.rs?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -7,7 +7,8 @@ use git_cmd::Repo;\n \n use anyhow::Context;\n use serde::Serialize;\n-use tracing::{debug, info, instrument};\n+use tokio_util::task::AbortOnDropHandle;\n+use tracing::{Instrument as _, debug, info, instrument};\n use url::Url;\n pub(crate) mod git;\n \n@@ -128,14 +129,26 @@ pub async fn release_pr(input: &ReleasePrRequest) -> anyhow::Result<Option<Relea\n         !Repo::new(&original_project_root)?.is_head_detached()?,\n         \"release-pr requires a branch. Check out the target branch instead of a detached HEAD\"\n     );\n+    validate_labels(&input.labels)?;\n+    let git_client = input\n+        .update_request\n+        .git_client()?\n+        .context(\"can't find git client\")?;\n+    // Listing the open PRs doesn't depend on the version analysis and takes one slow request per\n+    // page, so run it in the background while the packages are updated.\n+    // If there's nothing to release, the listing is aborted and its errors are ignored.\n+    let opened_release_prs = AbortOnDropHandle::new(tokio::spawn({\n+        let git_client = git_client.clone();\n+        let branch_prefix = input.branch_prefix.clone();\n+        async move { git_client.opened_prs(&branch_prefix).await }.in_current_span()\n+    }));\n     let tmp_project_root_parent = copy_to_temp_dir(&original_project_root)?;\n     let tmp_project_manifest_dir = new_manifest_dir_path(\n         &original_project_root,\n         manifest_dir,\n         tmp_project_root_parent.path(),\n     )?;\n \n-    validate_labels(&input.labels)?;\n     let tmp_project_root =\n         new_project_root(&original_project_root, tmp_project_root_parent.path())?;\n \n@@ -150,21 +163,21 @@ pub async fn release_pr(input: &ReleasePrRequest) -> anyhow::Result<Option<Relea\n     let (packages_to_update, _temp_repository) = update(&new_update_request)\n         .await\n         .context(\"failed to update packages\")?;\n-    let git_client = input\n-        .update_request\n-        .git_client()?\n-        .context(\"can't find git client\")?;\n \n     if !packages_to_update.updates().is_empty() {\n         let unreleased_package_worktree_repo =\n             Repo::new(&tmp_project_root).context(\"create new repo\")?;\n         let there_are_commits_to_push = unreleased_package_worktree_repo.is_clean().is_err();\n         if there_are_commits_to_push {\n+            let opened_release_prs = opened_release_prs\n+                .await?\n+                .context(\"cannot get opened release-plz prs\")?;\n             let pr = open_or_update_release_pr(\n                 &local_manifest,\n                 &packages_to_update,\n                 &git_client,\n                 &unreleased_package_worktree_repo,\n+                &opened_release_prs,\n                 ReleasePrOptions {\n                     draft: input.draft,\n                     pr_name: input.pr_name_template.clone(),\n@@ -194,13 +207,9 @@ async fn open_or_update_release_pr(\n     packages_to_update: &PackagesUpdate,\n     git_client: &GitClient,\n     repo: &Repo,\n+    opened_release_prs: &[GitPr],\n     release_pr_options: ReleasePrOptions,\n ) -> anyhow::Result<ReleasePr> {\n-    let opened_release_prs = git_client\n-        .opened_prs(&release_pr_options.pr_branch_prefix)\n-        .await\n-        .context(\"cannot get opened release-plz prs\")?;\n-\n     // Close all release-plz prs, except one.\n     let old_release_prs = opened_release_prs.iter().skip(1);\n     for pr in old_release_prs {"},{"sha":"7f4507c09902e6a2e6eea43f6fb45c229cb0b48f","filename":"crates/release_plz_core/src/command/update/updater.rs","status":"modified","additions":18,"deletions":13,"changes":31,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Fupdate%2Fupdater.rs","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/crates%2Frelease_plz_core%2Fsrc%2Fcommand%2Fupdate%2Fupdater.rs","cont