b69d392354803c04cd75bb6e6fa0/.github%2Fworkflows%2Fcd.yml","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/.github%2Fworkflows%2Fcd.yml","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/.github%2Fworkflows%2Fcd.yml?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -71,7 +71,7 @@ jobs:\n         with:\n           target: ${{ matrix.target }}\n         if: startsWith(matrix.os, 'ubuntu') && !contains(matrix.target, '-musl')\n-      - uses: taiki-e/install-action@ab6895351a88b908e96a4697860d4ffea5e57dbe # v2.87.27\n+      - uses: taiki-e/install-action@8cca0918f8471c33515202b73f56ab27f2bed283 # v2.87.29\n         with:\n           tool: cross\n         if: contains(matrix.target, '-musl')"},{"sha":"a185e7f91f1f3e74a3417b1cc785b8e33f5a9808","filename":".github/workflows/ci.yml","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/.github%2Fworkflows%2Fci.yml","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/.github%2Fworkflows%2Fci.yml","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/.github%2Fworkflows%2Fci.yml?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -29,7 +29,7 @@ jobs:\n         with:\n           persist-credentials: false\n       - name: Install cargo-semver-checks\n-        uses: taiki-e/install-action@ab6895351a88b908e96a4697860d4ffea5e57dbe # v2.87.27\n+        uses: taiki-e/install-action@8cca0918f8471c33515202b73f56ab27f2bed283 # v2.87.29\n         with:\n           tool: cargo-semver-checks@0.50\n       - name: Start containers\n@@ -55,7 +55,7 @@ jobs:\n         with:\n           persist-credentials: false\n       - name: Install cargo-semver-checks\n-        uses: taiki-e/install-action@ab6895351a88b908e96a4697860d4ffea5e57dbe # v2.87.27\n+        uses: taiki-e/install-action@8cca0918f8471c33515202b73f56ab27f2bed283 # v2.87.29\n         with:\n           tool: cargo-semver-checks@0.50\n       - name: Install Rust toolchain\n@@ -117,7 +117,7 @@ jobs:\n         with:\n           persist-credentials: false\n       - name: Run zizmor\n-        uses: zizmorcore/zizmor-action@cc914d7f3750a2d13d75c7f184a1060aa0e9d482 # v0.6.4\n+        uses: zizmorcore/zizmor-action@85b2b9fb8e3325e7a23d7d0a9d7ba5ae0f999e3e # v0.7.1\n         with:\n           persona: pedantic\n           # Don't use GitHub advanced security."},{"sha":"61eba559264fda3b88c273ba41b5b626e3e56546","filename":".github/workflows/deny.yml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/.github%2Fworkflows%2Fdeny.yml","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/.github%2Fworkflows%2Fdeny.yml","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/.github%2Fworkflows%2Fdeny.yml?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -26,7 +26,7 @@ jobs:\n       - name: Install Rust toolchain\n         uses: actions-rust-lang/setup-rust-toolchain@ecabd13d1c56bd1345c230e542e9144811ad706f # v2.0.0\n       - name: Install cargo-deny\n-        uses: taiki-e/install-action@ab6895351a88b908e96a4697860d4ffea5e57dbe # v2.87.27\n+        uses: taiki-e/install-action@8cca0918f8471c33515202b73f56ab27f2bed283 # v2.87.29\n         with:\n           tool: cargo-deny\n       - name: Audit dependencies"},{"sha":"3b085b86d255a4119ed8578b44e2b49703f1d345","filename":".github/workflows/release-plz.yml","status":"modified","additions":4,"deletions":4,"changes":8,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/.github%2Fworkflows%2Frelease-plz.yml","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/.github%2Fworkflows%2Frelease-plz.yml","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/.github%2Fworkflows%2Frelease-plz.yml?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -27,15 +27,15 @@ jobs:\n       # Generating a GitHub token, so that PRs and tags created by\n       # the release-plz-action can trigger actions workflows.\n       - name: Generate GitHub token\n-        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0\n+        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0\n         id: generate-token\n         with:\n           app-id: ${{ secrets.APP_ID }}\n           private-key: ${{ secrets.APP_PRIVATE_KEY }}\n           # pull-requests permission is not needed for the `release` command, so restricting it to contents only\n           permission-contents: write\n       - name: Run release-plz\n-        uses: release-plz/action@f393a7b38aca9d9b4c58447b291dbac963901df6 # v0.5.141\n+        uses: release-plz/action@8921286633dfa0c4020f7f30bd1c14fe19cbb10e # v0.5.142\n         with:\n           command: release\n         env:\n@@ -62,15 +62,15 @@ jobs:\n       # Generating a GitHub token, so that PRs and tags created by\n       # the release-plz-action can trigger actions workflows.\n       - name: Generate GitHub token\n-        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0\n+        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0\n         id: generate-token\n         with:\n           app-id: ${{ secrets.APP_ID }}\n           private-key: ${{ secrets.APP_PRIVATE_KEY }}\n           permission-contents: write\n           permission-pull-requests: write\n       - name: Run release-plz\n-        uses: release-plz/action@f393a7b38aca9d9b4c58447b291dbac963901df6 # v0.5.141\n+        uses: release-plz/action@8921286633dfa0c4020f7f30bd1c14fe19cbb10e # v0.5.142\n         with:\n           command: release-pr\n         env:"},{"sha":"3738176cd0a15bd9d5c4a2d45ad450ee3aa1e150","filename":"CHANGELOG.md","status":"modified","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/release-plz/release-plz/blob/907af6d031bbb69d392354803c04cd75bb6e6fa0/CHANGELOG.md","raw_url":"https://github.com/release-plz/release-plz/raw/907af6d031bbb69d392354803c04cd75bb6e6fa0/CHANGELOG.md","contents_url":"https://api.github.com/repos/release-plz/release-plz/contents/CHANGELOG.md?ref=907af6d031bbb69d392354803c04cd75bb6e6fa0","patch":"@@ -7,6 +7,21 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.3.173](https://github.com/release-plz/release-plz/compare/release-plz-v0.3.172...release-plz-v0.3.173) - 2026-10-19\n+\n+### Other\n+\n+- add UTM params to Encore sponsor links ([#3237](https://github.com/release-plz/release-plz/pull/3237))\n+- add sponsors to readme ([#3235](https://github.com/release-plz/release-plz/pull/3235))\n+\n+### Performance\n+\n+- spawn fewer and cheaper git processes in history walks ([#3250](https://github.com/release-plz/release-plz/pull/3250))\n+- don't query the registry again after cargo publish confirms the package ([#3251](https://github.com/release-plz/release-plz/pull/3251))\n+- reuse dependency builds between current and baseline semver checks ([#3243](https://github.com/release-plz/release-plz/pull/3243))\n+- list open PRs while release-pr analyzes the packages ([#3249](https://github.com/release-plz/release-plz/pull/3249))\n+- read downloaded registry packages in parallel ([#3246](https://github.com/release-plz/release-plz/pull/3246))\n+\n ## [0.3.172](https://github.com/release-plz/release-plz/compare/release-plz-v0.3.171...release-plz-v0.3.172) - 2026-10-12\n \n ### Other"},{"sha":"7b0f8d9895cffecbf7c9c4467d41f1ef58311267","filename":"Cargo.lock","status":"modified","additions":98,"deletions":97,"changes":195,"blob_url":"https://github.com/release-plz/r