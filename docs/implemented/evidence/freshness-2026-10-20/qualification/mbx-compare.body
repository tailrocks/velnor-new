w/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cargo%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-cargo%2FCHANGELOG.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -7,6 +7,12 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.3.15](https://github.com/jdx/mr-boxington/compare/mbx-cache-cargo-v0.3.14...mbx-cache-cargo-v0.3.15) - 2026-10-19\n+\n+### Other\n+\n+- updated the following local packages: mbx-cache-core\n+\n ## [0.3.14](https://github.com/jdx/mr-boxington/compare/mbx-cache-cargo-v0.3.13...mbx-cache-cargo-v0.3.14) - 2026-10-15\n \n ### Other"},{"sha":"38fdacbd5132a6a2199a9f465eab6e4df79f12e1","filename":"crates/mbx-cache-cargo/Cargo.toml","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cargo%2FCargo.toml","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cargo%2FCargo.toml","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-cargo%2FCargo.toml?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"mbx-cache-cargo\"\n-version = \"0.3.14\"\n+version = \"0.3.15\"\n description = \"Unstable Cargo invocation integration for mbx cache embedders\"\n edition.workspace = true\n rust-version.workspace = true\n@@ -11,7 +11,7 @@ readme.workspace = true\n \n [dependencies]\n dirs = \"7\"\n-mbx-cache-core = { path = \"../mbx-cache-core\", version = \"0.20.2\", default-features = false }\n+mbx-cache-core = { path = \"../mbx-cache-core\", version = \"0.20.3\", default-features = false }\n serde = { version = \"1\", features = [\"derive\"] }\n serde_json = \"1\"\n toml = \"1\""},{"sha":"701ff5aa8c43e633839d039116b7297e04d012d9","filename":"crates/mbx-cache-cc/CHANGELOG.md","status":"modified","additions":11,"deletions":0,"changes":11,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cc%2FCHANGELOG.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cc%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-cc%2FCHANGELOG.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -7,6 +7,17 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.20.3](https://github.com/jdx/mr-boxington/compare/mbx-cache-cc-v0.20.2...mbx-cache-cc-v0.20.3) - 2026-10-19\n+\n+### Fixed\n+\n+- *(cc)* enumerate include directories on every manifest request ([#738](https://github.com/jdx/mr-boxington/pull/738))\n+- *(cc)* identify MSVC from preprocessor macros, not banner text ([#735](https://github.com/jdx/mr-boxington/pull/735))\n+\n+### Other\n+\n+- fix clippy findings that only appear on Windows ([#733](https://github.com/jdx/mr-boxington/pull/733))\n+\n ## [0.20.0](https://github.com/jdx/mr-boxington/compare/mbx-cache-cc-v0.19.4...mbx-cache-cc-v0.20.0) - 2026-10-08\n \n ### Added"},{"sha":"8f8e9776274bfe5e3c48e5fdec63960c5faa6404","filename":"crates/mbx-cache-cc/Cargo.toml","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cc%2FCargo.toml","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cc%2FCargo.toml","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-cc%2FCargo.toml?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"mbx-cache-cc\"\n-version = \"0.20.2\"\n+version = \"0.20.3\"\n description = \"mbx internals: conservative C and C++ action analysis and key construction. No API stability -- use the mbx CLI or mbx-cache-protocol.\"\n edition.workspace = true\n rust-version.workspace = true\n@@ -16,7 +16,7 @@ all-features = true\n \n [dependencies]\n memchr = \"2\"\n-mbx-cache-core = { path = \"../mbx-cache-core\", version = \"0.20.2\", default-features = false }\n+mbx-cache-core = { path = \"../mbx-cache-core\", version = \"0.20.3\", default-features = false }\n serde = { version = \"1\", features = [\"derive\"] }\n serde_json = \"1\"\n strum = { version = \"0.28\", features = [\"derive\"] }"},{"sha":"ae0ca84a2344e0547a7e23233472baa75a183f54","filename":"crates/mbx-cache-cc/src/cc_cache_tests.rs","status":"modified","additions":44,"deletions":2,"changes":46,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cc%2Fsrc%2Fcc_cache_tests.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cc%2Fsrc%2Fcc_cache_tests.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-cc%2Fsrc%2Fcc_cache_tests.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -768,13 +768,44 @@ fn compiler_families_classify_from_probe_text() {\n #[cfg(windows)]\n #[test]\n fn msvc_style_probe_output_selects_the_msvc_adapter() {\n-    let probe = \"Microsoft (R) C/C++ Optimizing Compiler Version 19.38\\n\";\n+    let probe = msvc_identity(\n+        \"mbx_msc_ver 1938\\nmbx_msc_full_ver 193833135\\nmbx_msc_build 0\\nmbx_clang __clang__\\n\",\n+    )\n+    .unwrap();\n     assert_eq!(\n-        CcCompilerFamily::classify(probe).unwrap(),\n+        CcCompilerFamily::classify(&probe).unwrap(),\n         CcCompilerFamily::Msvc\n     );\n }\n \n+#[test]\n+fn msvc_identity_reads_macros_not_banner_text() {\n+    let identity = msvc_identity(\n+        \"mbx_msc_ver 1938\\r\\nmbx_msc_full_ver 193833135\\r\\nmbx_msc_build 0\\r\\nmbx_clang __clang__\\r\\nmbx_x64 1\\r\\nmbx_x86 _M_IX86\\r\\nmbx_arm64 _M_ARM64\\r\\n\",\n+    )\n+    .unwrap();\n+    assert_eq!(\n+        identity,\n+        \"mbx-msvc-identity _MSC_VER=1938 _MSC_FULL_VER=193833135 _MSC_BUILD=0 ARCH=_M_X64\\n\"\n+    );\n+}\n+\n+#[test]\n+fn msvc_identity_rejects_compilers_that_do_not_define_the_macros() {\n+    assert!(msvc_identity(\"mbx_msc_ver _MSC_VER\\nmbx_msc_full_ver _MSC_FULL_VER\\n\").is_none());\n+    assert!(msvc_identity(\"\").is_none());\n+}\n+\n+#[test]\n+fn msvc_identity_rejects_clang_cl() {\n+    assert!(\n+        msvc_identity(\n+            \"mbx_msc_ver 1938\\nmbx_msc_full_ver 193833135\\nmbx_msc_build 0\\nmbx_clang 1\\n\"\n+        )\n+        .is_none()\n+    );\n+}\n+\n #[test]\n fn only_gcc_carries_an_external_assembler_in_its_identity() {\n     assert!(CcCompilerFamily::Gcc.uses_external_assembler());\n@@ -1399,3 +1430,14 @@ fn active_developer_roots_include_resolved_symlinks() {\n     assert!(roots.contains(&alias));\n     assert!(roots.contains(&std::fs::canonicalize(real).unwrap()));\n }\n+\n+#[test]\n+fn msvc_identity_distinguishes_target_architectures() {\n+    let for_arch = |x64: &str, arm64: &str| {\n+        msvc_identity(&format!(\n+            \"mbx_msc_ver 1938\\nmbx_msc_full_ver 193833135\\nmbx_msc_build 0\\nmbx_clang __clang__\\nmbx_x64 {x64}\\nmbx_arm64 {arm64}\\n\"\n+        ))\n+        .unwrap()\n+    };\n+    assert_ne!(for_arch(\"1\", \"_M_ARM64\"), for_arch(\"_M_X64\", \"1\"));\n+}"},{"sha":"901501eccfee9ef07bb05ce0a44eadc8123cb34c","filename":"crates/mbx-cache-cc/src/depfile.rs","status":"modified","additions":6,"deletions":112,"changes":118,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cc%2Fsrc%2Fdepfile.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cc%2Fsrc%2Fdepfile.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-cc%2Fsrc%2Fdepfile.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -700,6 +700,12 @@ fn is_includable(name: &str) -> bool {\n /// so this exists purely to notice a file appearing where it could shadow one\n /// of them. A directory that does not exist has an empty manifest, which is\n /// what makes \"the directory was created\" a key change rather than an error.\n+///\n+/// Every call walks the directory afresh. Directory timestamps advance in\n+/// coarse ticks on some filesystems, so unchanged metadata cannot prove that no\n+/// header appeared or vanished; a cached answer would make the snapshots taken\n+/// before and after a compilation agree even when the compiler saw a different\n+/// header search result.\n fn include_manifest(directory: &Path, budget: &mut usize) -> Result<CacheDigest, CcBypassReason> {\n     include_manifest_with(directory, budget, &|path| std::fs::read_dir(path))\n }\n@@ -709,25 +715,9 @@ fn include_manifest_with(\n     budget: &mut usize,\n     read_dir: &impl Fn(&Path) -> std::io::Result<std::fs::ReadDir>,\n ) -> Result<CacheDigest, CcBypassReason> {\n-    #[cfg(unix)]\n-    if let Some(memo) = manifest_memo::find(directory) {\n-        *budget = budget.saturating_add(memo.entries);\n-        if *budget > MAX_MANIFEST_ENTRIES {\n-            return Err(CcBypassReason::TooManyInputs);\n-        }\n-        return Ok(memo.digest);\n-    }\n-    #[cfg(unix)]\n-    let mut directories = Vec::new();\n-    #[cfg(unix)]\n-    let initial_budget = *budget;\n     let mut names = Vec::new();\n     let mut pending = vec![(directory.to_path_buf(), String::new())];\n     while let Some((current, prefix)) = pending.pop() {\n-        // Capture before enumeration and validate again after the complete\n-        // walk. A directory changed while being read cannot seed the memo.\n-        #[cfg(unix)]\n-        directories.push((current.clone(), manifest_memo::Identity::read(&current)));\n         let entries = match read_dir(&current) {\n             Ok(entries) => entries,\n             Err(error) if error.kind() == std::io::ErrorKind::NotFound => continue,\n@@ -774,105 +764,9 @@ fn include_manifest_with(\n     }\n     names.sort();\n     let digest = CacheDigest::blake3(names.join(\"\\n\").as_bytes());\n-    #[cfg(unix)]\n-    manifest_memo::record(directory, &digest, *budget - initial_budget, directories);\n     Ok(digest)\n }\n \n-// A wrapper checks the same manifests during prediction, discovery, and\n-// publication. Reuse their exact name digest while every directory is unchanged.\n-// This is process-local: no persisted timestamps can outlive a filesystem mount.\n-#[cfg(unix)]\n-mod manifest_memo {\n-    use super::*;\n-    use std::os::unix::fs::MetadataExt;\n-    use std::sync::{Mutex, OnceLock};\n-\n-    const MAX_ROOTS: usize = 32;\n-    const MAX_DIRECTORIES: usize = 4096;\n-    static MEMOS: OnceLock<Mutex<BTreeMap<PathBuf, Memo>>> = OnceLock::new();\n-\n-    #[derive(Clone, PartialEq, Eq)]\n-    pub(super) struct Identity {\n-        device: u64,\n-        inode: u64,\n-        modified: (i64, i64),\n-        changed: (i64, i64),\n-        mode: u32,\n-    }\n-    impl Identity {\n-        pub(super) fn read(path: &Path) -> Option<Self> {\n-            let metadata = std::fs::metadata(path).ok()?;\n-            // Whole-second timestamps cannot distinguish rapid edits. Preserve\n-            // enumeration on filesystems that expose only that precision.\n-            if !metadata.is_dir() || metadata.mtime_nsec() == 0 || metadata.ctime_nsec() == 0 {\n-                return None;\n-            }\n-            // Reuse the digest ledger's filesystem qualification. In particular,\n-            // Linux NFS identities omit ctime and must keep enumerating names.\n-            let changed = FileIdentity::for_digest_cache(path, &metadata)\n-                .ok()??\n-                .changed?;\n-            Some(Self {\n-                device: metadata.dev(),\n-                inode: metadata.ino(),\n-                modified: (metadata.mtime(), metadata.mtime_nsec()),\n-                changed,\n-                mode: metadata.mode(),\n-            })\n-        }\n-    }\n-    #[derive(Clone)]\n-    pub(super) struct Memo {\n-        pub digest: CacheDigest,\n-        pub entries: usize,\n-        directories: Vec<(PathBuf, Identity)>,\n-    }\n-    impl Memo {\n-        fn valid(&self) -> bool {\n-            self.directories\n-                .iter()\n-                .all(|(path, identity)| Identity::read(path).as_ref() == Some(identity))\n-        }\n-    }\n-    pub(super) fn find(directory: &Path) -> Option<Memo> {\n-        let memo = MEMOS.get()?.lock().ok()?.get(directory)?.clone();\n-        memo.valid().then_some(memo)\n-    }\n-    pub(super) fn record(\n-        directory: &Path,\n-        digest: &CacheDigest,\n-        entries: usize,\n-        directories: Vec<(PathBuf, Option<Identity>)>,\n-    ) {\n-        if directories.is_empty() || directories.len() > MAX_DIRECTORIES {\n-            return;\n-        }\n-        let Some(directories) = directories\n-            .into_iter()\n-            .map(|(path, identity)| Some((path, identity?)))\n-            .collect::<Option<Vec<_>>>()\n-        else {\n-            return;\n-        };\n-        let memo = Memo {\n-            digest: digest.clone(),\n-            entries,\n-            directories,\n-        };\n-        if !memo.valid() {\n-            return;\n-        }\n-        let Ok(mut memos) = MEMOS.get_or_init(Default::default).lock() else {\n-            return;\n-        };\n-        if memos.len() >= MAX_ROOTS {\n-            memos.clear();\n-        }\n-        memos.insert(directory.to_path_buf(), memo);\n-    }\n-}\n-\n /// Whether a preprocessor input can make the assembler read another file.\n ///\n /// Searching for the directive text, including in comments and inactive"},{"sha":"ed3bb393c3cc0a4477eb84890a666f64412c6442","filename":"crates/mbx-cache-cc/src/depfile_tests.rs","status":"modified","additions":18,"deletions":26,"changes":44,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cc%2Fsrc%2Fdepfile_tests.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cc%2Fsrc%2Fdepfile_tests.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-cc%2Fsrc%2Fdepfile_tests.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -637,11 +637,13 @@ fn parses_msvc_source_dependencies() {\n }\n \n /// A ledger that answers one known identity with a fixed digest.\n+#[cfg(unix)]\n struct SentinelLedger {\n     known: FileIdentity,\n     digest: CacheDigest,\n }\n \n+#[cfg(unix)]\n impl FileDigestCache for SentinelLedger {\n     fn find(&self, _scope: FileDigestScope, files: &[FileIdentity]) -> Vec<Option<CacheDigest>> {\n         files\n@@ -800,9 +802,8 @@ fn a_rendered_caller_depfile_reads_back_and_quotes_like_the_driver() {\n     assert_eq!(plain, \"out/a\\\\ b.o: \\\\\\n /src/a.c\\n\");\n }\n \n-#[cfg(unix)]\n #[test]\n-fn unchanged_manifests_reuse_enumeration_but_still_charge_the_budget() {\n+fn every_manifest_request_enumerates_and_charges_the_budget() {\n     use std::cell::Cell;\n     let root = tempfile::tempdir().unwrap();\n     std::fs::create_dir(root.path().join(\"nested\")).unwrap();\n@@ -818,28 +819,27 @@ fn unchanged_manifests_reuse_enumeration_but_still_charge_the_budget() {\n         reads.set(reads.get() + 1);\n         std::fs::read_dir(path)\n     };\n-    let first = include_manifest_with(root.path(), &mut 0, &enumerate).unwrap();\n+    let mut budget = 0;\n+    let first = include_manifest_with(root.path(), &mut budget, &enumerate).unwrap();\n     assert_eq!(reads.get(), 2);\n-    // Unsupported timestamp precision deliberately preserves the full walk.\n-    if manifest_memo::find(root.path()).is_none() {\n-        return;\n-    }\n+    assert_eq!(budget, 1000);\n+    // Unchanged directory metadata must not suppress the second walk: a\n+    // header can change within one timestamp tick.\n     reads.set(0);\n     let mut budget = 0;\n     let second = include_manifest_with(root.path(), &mut budget, &enumerate).unwrap();\n     assert_eq!(first, second);\n-    assert_eq!(reads.get(), 0);\n+    assert_eq!(reads.get(), 2);\n     assert_eq!(budget, 1000);\n     assert!(matches!(\n         include_manifest_with(root.path(), &mut (MAX_MANIFEST_ENTRIES - 999), &enumerate),\n         Err(CcBypassReason::TooManyInputs)\n     ));\n-    assert_eq!(reads.get(), 0);\n }\n \n #[cfg(unix)]\n #[test]\n-fn memo_detects_nested_header_creation_removal_and_precompiled_headers() {\n+fn manifest_detects_nested_header_creation_removal_and_precompiled_headers() {\n     let root = tempfile::tempdir().unwrap();\n     let nested = root.path().join(\"nested\");\n     std::fs::create_dir(&nested).unwrap();\n@@ -860,7 +860,7 @@ fn memo_detects_nested_header_creation_removal_and_precompiled_headers() {\n \n #[cfg(unix)]\n #[test]\n-fn memo_does_not_mask_directory_replacement_or_missing_roots() {\n+fn manifest_does_not_mask_directory_replacement_or_missing_roots() {\n     let root = tempfile::tempdir().unwrap();\n     let include = root.path().join(\"include\");\n     let empty = include_manifest(&include, &mut 0).unwrap();\n@@ -874,24 +874,16 @@ fn memo_does_not_mask_directory_replacement_or_missing_roots() {\n     assert_ne!(first, include_manifest(&include, &mut 0).unwrap());\n }\n \n-#[cfg(unix)]\n #[test]\n-fn mutation_during_enumeration_does_not_seed_a_stale_memo() {\n-    use std::cell::Cell;\n+fn mutation_between_manifest_requests_is_observed() {\n     let root = tempfile::tempdir().unwrap();\n     std::fs::write(root.path().join(\"a.h\"), b\"a\").unwrap();\n-    let mutated = Cell::new(false);\n-    let enumerate = |path: &Path| {\n-        let entries = std::fs::read_dir(path)?;\n-        if !mutated.replace(true) {\n-            std::fs::write(path.join(\"b.h\"), b\"b\")?;\n-        }\n-        Ok(entries)\n-    };\n-    include_manifest_with(root.path(), &mut 0, &enumerate).unwrap();\n-    assert!(manifest_memo::find(root.path()).is_none());\n-    let stable = include_manifest(root.path(), &mut 0).unwrap();\n-    assert_eq!(stable, include_manifest(root.path(), &mut 0).unwrap());\n+    let before = include_manifest(root.path(), &mut 0).unwrap();\n+    std::fs::write(root.path().join(\"b.h\"), b\"b\").unwrap();\n+    let after = include_manifest(root.path(), &mut 0).unwrap();\n+    assert_ne!(before, after);\n+    std::fs::remove_file(root.path().join(\"b.h\")).unwrap();\n+    assert_eq!(before, include_manifest(root.path(), &mut 0).unwrap());\n }\n \n #[cfg(unix)]"},{"sha":"83f389e844109d0a54cedbbe569f9ed59ea3d6be","filename":"crates/mbx-cache-cc/src/lib.rs","status":"modified","additions":52,"deletions":1,"changes":53,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cc%2Fsrc%2Flib.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-cc%2Fsrc%2Flib.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-cc%2Fsrc%2Flib.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -570,6 +570,57 @@ pub enum CcCompilerFamily {\n     Msvc,\n }\n \n+/// Source preprocessed to ask `cl.exe` who it is.\n+///\n+/// The macros survive unexpanded in any compiler that does not define them, so\n+/// the answer does not depend on banner wording or the console locale.\n+pub const MSVC_IDENTITY_SOURCE: &str = \"mbx_msc_ver _MSC_VER\\nmbx_msc_full_ver _MSC_FULL_VER\\nmbx_msc_build _MSC_BUILD\\nmbx_clang __clang__\\nmbx_x64 _M_X64\\nmbx_x86 _M_IX86\\nmbx_arm64 _M_ARM64\\nmbx_arm64ec _M_ARM64EC\\nmbx_arm _M_ARM\\n\";\n+\n+/// Leading text of an identity built by [`msvc_identity`].\n+pub const MSVC_IDENTITY_PREFIX: &str = \"mbx-msvc-identity\";\n+\n+/// Build the identity text for `cl.exe` from its preprocessed\n+/// [`MSVC_IDENTITY_SOURCE`], or `None` when the compiler is not MSVC.\n+///\n+/// `clang-cl` defines `_MSC_VER` too, so `__clang__` rejects it: it is a\n+/// different compiler with its own version line.\n+pub fn msvc_identity(preprocessed: &str) -> Option<String> {\n+    let value = |name: &str| {\n+        preprocessed.lines().find_map(|line| {\n+            let (key, rest) = line.trim().split_once(' ')?;\n+            (key == name).then(|| rest.trim().to_string())\n+        })\n+    };\n+    let defined = |text: &str, macro_name: &str| {\n+        !text.is_empty() && text != macro_name && text.bytes().all(|b| b.is_ascii_digit())\n+    };\n+    let ver = value(\"mbx_msc_ver\").filter(|v| defined(v, \"_MSC_VER\"))?;\n+    let full = value(\"mbx_msc_full_ver\").filter(|v| defined(v, \"_MSC_FULL_VER\"))?;\n+    let build = value(\"mbx_msc_build\")\n+        .filter(|v| defined(v, \"_MSC_BUILD\"))\n+        .unwrap_or_default();\n+    if value(\"mbx_clang\").is_some_and(|v| v != \"__clang__\") {\n+        return None;\n+    }\n+    // The version macros match across the x86, x64 and ARM64 toolset binaries,\n+    // so the architecture the compiler targets has to be keyed separately.\n+    let architecture = [\n+        (\"mbx_x64\", \"_M_X64\"),\n+        (\"mbx_x86\", \"_M_IX86\"),\n+        (\"mbx_arm64\", \"_M_ARM64\"),\n+        (\"mbx_arm64ec\", \"_M_ARM64EC\"),\n+        (\"mbx_arm\", \"_M_ARM\"),\n+    ]\n+    .iter()\n+    .filter(|(key, macro_name)| value(key).is_some_and(|v| v != *macro_name))\n+    .map(|(_, macro_name)| *macro_name)\n+    .collect::<Vec<_>>()\n+    .join(\",\");\n+    Some(format!(\n+        \"{MSVC_IDENTITY_PREFIX} _MSC_VER={ver} _MSC_FULL_VER={full} _MSC_BUILD={build} ARCH={architecture}\\n\"\n+    ))\n+}\n+\n impl CcCompilerFamily {\n     /// Stable name recorded in the action key.\n     pub fn as_str(self) -> &'static str {\n@@ -603,7 +654,7 @@ impl CcCompilerFamily {\n     /// Classify a driver from its verbose probe output.\n     pub fn classify(probe: &str) -> Result<Self, CcBypassReason> {\n         #[cfg(windows)]\n-        if probe.contains(\"Microsoft (R) C/C++ Optimizing Compiler\") {\n+        if probe.starts_with(MSVC_IDENTITY_PREFIX) {\n             return Ok(Self::Msvc);\n         }\n         if probe.contains(\"Apple clang version\") {"},{"sha":"fcddbbca785b062e292cf8328254145400b9c223","filename":"crates/mbx-cache-core/CHANGELOG.md","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-core%2FCHANGELOG.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-core%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-core%2FCHANGELOG.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -7,6 +7,12 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.20.3](https://github.com/jdx/mr-boxington/compare/mbx-cache-core-v0.20.2...mbx-cache-core-v0.20.3) - 2026-10-19\n+\n+### Other\n+\n+- fix clippy findings that only appear on Windows ([#733](https://github.com/jdx/mr-boxington/pull/733))\n+\n ## [0.20.2](https://github.com/jdx/mr-boxington/compare/mbx-cache-core-v0.20.1...mbx-cache-core-v0.20.2) - 2026-10-15\n \n ### Fixed"},{"sha":"5636987610f400c94f18711a2349d2300ba83464","filename":"crates/mbx-cache-core/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-core%2FCargo.toml","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-core%2FCargo.toml","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-core%2FCargo.toml?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"mbx-cache-core\"\n-version = \"0.20.2\"\n+version = \"0.20.3\"\n description = \"Unstable CAS, transport, and cache-agent primitives for mbx embedders\"\n edition.workspace = true\n rust-version.workspace = true"},{"sha":"afb36cce6fc4ca6ae2e2cd26206d7bfeb744094e","filename":"crates/mbx-cache-core/src/local.rs","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-core%2Fsrc%2Flocal.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-core%2Fsrc%2Flocal.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-core%2Fsrc%2Flocal.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -241,7 +241,10 @@ fn make_owner_writable(path: &Path) -> Result<()> {\n     Ok(())\n }\n \n+// The lint warns that this makes a Unix file world-writable. Windows has no\n+// such mode: it clears only the read-only attribute.\n #[cfg(windows)]\n+#[allow(clippy::permissions_set_readonly_false)]\n fn make_owner_writable(path: &Path) -> Result<()> {\n     let mut permissions = fs::metadata(path)?.permissions();\n     permissions.set_readonly(false);"},{"sha":"6431c694579f403e482b5c9a77b3689bdd841fbc","filename":"crates/mbx-cache-rustc/CHANGELOG.md","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-rustc%2FCHANGELOG.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-rustc%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-rustc%2FCHANGELOG.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -7,6 +7,12 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.20.3](https://github.com/jdx/mr-boxington/compare/mbx-cache-rustc-v0.20.2...mbx-cache-rustc-v0.20.3) - 2026-10-19\n+\n+### Added\n+\n+- seed incremental state ([#754](https://github.com/jdx/mr-boxington/pull/754))\n+\n ## [0.20.2](https://github.com/jdx/mr-boxington/compare/mbx-cache-rustc-v0.20.1...mbx-cache-rustc-v0.20.2) - 2026-10-15\n \n ### Added"},{"sha":"f3f5977c09e4d0e222a91b289472b9120668fe11","filename":"crates/mbx-cache-rustc/Cargo.toml","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-rustc%2FCargo.toml","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-rustc%2FCargo.toml","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-rustc%2FCargo.toml?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"mbx-cache-rustc\"\n-version = \"0.20.2\"\n+version = \"0.20.3\"\n description = \"mbx internals: conservative rustc action analysis and key construction. No API stability -- use the mbx CLI or mbx-cache-protocol.\"\n edition.workspace = true\n rust-version.workspace = true\n@@ -15,7 +15,7 @@ readme.workspace = true\n all-features = true\n \n [dependencies]\n-mbx-cache-core = { path = \"../mbx-cache-core\", version = \"0.20.2\", default-features = false }\n+mbx-cache-core = { path = \"../mbx-cache-core\", version = \"0.20.3\", default-features = false }\n serde = { version = \"1\", features = [\"derive\"] }\n shlex = \"2\"\n strum = { version = \"0.28\", features = [\"derive\"] }"},{"sha":"f4277e662bc111a3a35e6a3c96e171e8d970349d","filename":"crates/mbx-cache-rustc/src/lib.rs","status":"modified","additions":26,"deletions":0,"changes":26,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-rustc%2Fsrc%2Flib.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-rustc%2Fsrc%2Flib.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-rustc%2Fsrc%2Flib.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -591,6 +591,20 @@ impl RustcInvocation {\n         &self.crate_name\n     }\n \n+    /// Whether rustc records a virtual directory in place of the working\n+    /// directory (`-Zremap-cwd-prefix`).\n+    ///\n+    /// rustc checks incremental state against its options, the working\n+    /// directory included, and ignores state recorded anywhere else. Under this\n+    /// flag, with the paths under the working directory named relative to it,\n+    /// every checkout presents the same options, so one checkout's state is as\n+    /// good as another's.\n+    pub fn remaps_working_directory(&self) -> bool {\n+        self.arguments.iter().any(|argument| {\n+            matches!(argument, Argument::Plain(flag) if flag.starts_with(\"-Zremap-cwd-prefix=\"))\n+        })\n+    }\n+\n     /// Digest of the inputs this compilation owns: its sources and whatever\n     /// they read, but not the artifacts it merely links against.\n     ///\n@@ -1580,8 +1594,20 @@ impl<'a> Parser<'a> {\n                 \"threads\" | \"threads=\" => {\n                     return Err(BypassReason::MissingValue(\"-Zthreads\".into()));\n                 }\n+                \"remap-cwd-prefix\" | \"remap-cwd-prefix=\" => {\n+                    return Err(BypassReason::MissingValue(\"-Zremap-cwd-prefix\".into()));\n+                }\n                 _ => {}\n             }\n+            // Replaces the working directory in every path rustc records, and\n+            // in the options its incremental state is checked against. The\n+            // value is the virtual directory written in the working\n+            // directory's place, kept verbatim like `--remap-path-prefix`'s\n+            // destination.\n+            if option.starts_with(\"remap-cwd-prefix=\") {\n+                self.parsed.push(Argument::Plain(format!(\"-Z{option}\")));\n+                return Ok(());\n+            }\n             if option == \"share-generics\" {\n                 return Err(BypassReason::MissingValue(\"-Zshare-generics\".into()));\n             }"},{"sha":"b0602dc566e12dce84afa7c0af46da0d1abe601e","filename":"crates/mbx-cache-rustc/src/rustc_cache_tests.rs","status":"modified","additions":38,"deletions":0,"changes":38,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-rustc%2Fsrc%2Frustc_cache_tests.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-rustc%2Fsrc%2Frustc_cache_tests.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-rustc%2Fsrc%2Frustc_cache_tests.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -1756,6 +1756,44 @@ fn models_parallel_frontend_options_in_the_action_key() {\n     );\n }\n \n+#[test]\n+fn models_working_directory_remapping_in_the_action_key() {\n+    let invocation = |remap: &[&str]| {\n+        let mut arguments = vec![\n+            \"--crate-name=widget\",\n+            \"--crate-type=lib\",\n+            \"--emit=dep-info,metadata,link\",\n+        ];\n+        arguments.extend_from_slice(remap);\n+        arguments.push(\"src/lib.rs\");\n+        RustcInvocation::parse(&args(&arguments)).unwrap()\n+    };\n+    let key = |invocation: RustcInvocation| {\n+        invocation\n+            .action(context(&[(\"src/lib.rs\", \"source\")]))\n+            .unwrap()\n+            .digest\n+    };\n+    let remapped = invocation(&[\"-Zremap-cwd-prefix=/src\"]);\n+    assert_eq!(remapped, invocation(&[\"-Z\", \"remap-cwd-prefix=/src\"]));\n+    assert!(remapped.remaps_working_directory());\n+    assert!(!invocation(&[]).remaps_working_directory());\n+    assert_ne!(\n+        key(remapped),\n+        key(invocation(&[\"-Zremap-cwd-prefix=/build\"]))\n+    );\n+    assert_ne!(\n+        key(invocation(&[\"-Zremap-cwd-prefix=/src\"])),\n+        key(invocation(&[]))\n+    );\n+    for spelling in [\"-Zremap-cwd-prefix\", \"-Zremap-cwd-prefix=\"] {\n+        assert_eq!(\n+            RustcInvocation::parse(&args(&[spelling, \"src/lib.rs\"])),\n+            Err(BypassReason::MissingValue(\"-Zremap-cwd-prefix\".into()))\n+        );\n+    }\n+}\n+\n #[test]\n fn models_embedded_metadata_selection_in_the_action_key() {\n     let invocation = |selection: &[&str]| {"},{"sha":"ed47a0521aa5dbdba0608c3dfadaeaf646296781","filename":"crates/mbx-cache-store/CHANGELOG.md","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-store%2FCHANGELOG.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-store%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-store%2FCHANGELOG.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -7,6 +7,12 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.1.41](https://github.com/jdx/mr-boxington/compare/mbx-cache-store-v0.1.40...mbx-cache-store-v0.1.41) - 2026-10-19\n+\n+### Other\n+\n+- updated the following local packages: mbx-cache-core\n+\n ## [0.1.40](https://github.com/jdx/mr-boxington/compare/mbx-cache-store-v0.1.39...mbx-cache-store-v0.1.40) - 2026-10-15\n \n ### Other"},{"sha":"f902e0b9b016dd560088f9297f107d413860bda1","filename":"crates/mbx-cache-store/Cargo.toml","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-store%2FCargo.toml","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx-cache-store%2FCargo.toml","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx-cache-store%2FCargo.toml?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"mbx-cache-store\"\n-version = \"0.1.40\"\n+version = \"0.1.41\"\n description = \"Unstable shared action-store retention and inspection for mbx embedders\"\n edition.workspace = true\n rust-version.workspace = true\n@@ -13,7 +13,7 @@ readme.workspace = true\n eyre = \"0.6\"\n fslock = \"0.2\"\n log = \"0.4\"\n-mbx-cache-core = { path = \"../mbx-cache-core\", version = \"0.20.2\", default-features = false }\n+mbx-cache-core = { path = \"../mbx-cache-core\", version = \"0.20.3\", default-features = false }\n serde = { version = \"1\", features = [\"derive\"] }\n serde_json = \"1\"\n tar = { version = \"0.4\", default-features = false }"},{"sha":"e8fddda7269e8879c61350baefc8a9858ee88402","filename":"crates/mbx/CHANGELOG.md","status":"modified","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2FCHANGELOG.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2FCHANGELOG.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -7,6 +7,38 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [1.25.0](https://github.com/jdx/mr-boxington/compare/v1.24.1...v1.25.0) - 2026-10-19\n+\n+### Added\n+\n+- seed incremental state ([#754](https://github.com/jdx/mr-boxington/pull/754))\n+- *(scheduler)* estimate memory from a calibrated window of recent peaks ([#755](https://github.com/jdx/mr-boxington/pull/755))\n+- *(scheduler)* budget CPU and memory separately ([#750](https://github.com/jdx/mr-boxington/pull/750))\n+- *(scheduler)* let queued builds share capacity they cannot use yet ([#748](https://github.com/jdx/mr-boxington/pull/748))\n+- *(scheduler)* record build identity and reservations in the observation log ([#749](https://github.com/jdx/mr-boxington/pull/749))\n+- *(scheduler)* record estimate accuracy and summarize it in mbx stats ([#746](https://github.com/jdx/mr-boxington/pull/746))\n+- *(scheduler)* estimate compile memory for each build mode ([#742](https://github.com/jdx/mr-boxington/pull/742))\n+- *(cache)* add remote.trust_writes for CI systems mbx does not detect ([#724](https://github.com/jdx/mr-boxington/pull/724))\n+\n+### Fixed\n+\n+- *(scheduler)* cap memory estimates at the previous rule until the spread is calibrated ([#756](https://github.com/jdx/mr-boxington/pull/756))\n+- *(gc)* cap incremental state at 10% of gc.max_total_size ([#751](https://github.com/jdx/mr-boxington/pull/751))\n+- *(gc)* prune incremental state after worktree removal ([#752](https://github.com/jdx/mr-boxington/pull/752))\n+- *(materialize)* stop restored build scripts from rerunning on the next unchanged build ([#745](https://github.com/jdx/mr-boxington/pull/745))\n+- *(scheduler)* honor an explicit memory budget that fits the local machine ([#741](https://github.com/jdx/mr-boxington/pull/741))\n+- *(setup)* skip mise's mbx shim when the Windows cargo.exe shim forwards ([#736](https://github.com/jdx/mr-boxington/pull/736))\n+- *(cc)* identify MSVC from preprocessor macros, not banner text ([#735](https://github.com/jdx/mr-boxington/pull/735))\n+- *(cli)* let cargo clean -p run when a managed target link dangles ([#732](https://github.com/jdx/mr-boxington/pull/732))\n+- *(cli)* report build.rustc-wrapper = \"mbx\" instead of failing with -Zscript ([#727](https://github.com/jdx/mr-boxington/pull/727))\n+- *(scheduler)* prevent starvation across shared container builds ([#721](https://github.com/jdx/mr-boxington/pull/721))\n+\n+### Other\n+\n+- *(setup)* keep the Windows end-to-end tests out of the developer's profile ([#737](https://github.com/jdx/mr-boxington/pull/737))\n+- fix clippy findings that only appear on Windows ([#733](https://github.com/jdx/mr-boxington/pull/733))\n+- *(seed)* run the access-time seeding test on Windows volumes that track access times ([#730](https://github.com/jdx/mr-boxington/pull/730))\n+\n ## [1.24.1](https://github.com/jdx/mr-boxington/compare/v1.24.0...v1.24.1) - 2026-10-15\n \n ### Fixed"},{"sha":"58218f259abed38632a15d9f1bb834cdd66b323b","filename":"crates/mbx/Cargo.toml","status":"modified","additions":6,"deletions":6,"changes":12,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2FCargo.toml","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2FCargo.toml","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2FCargo.toml?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"mbx\"\n-version = \"1.24.1\"\n+version = \"1.25.0\"\n description = \"A build cache for Rust projects\"\n edition.workspace = true\n rust-version.workspace = true\n@@ -31,11 +31,11 @@ memchr = \"2\"\n unicode-segmentation = \"1.13.3\"\n unicode-width = \"0.2.2\"\n portable-pty = \"0.9\"\n-mbx-cache-core = { path = \"../mbx-cache-core\", version = \"0.20.2\", default-features = false }\n-mbx-cache-cargo = { path = \"../mbx-cache-cargo\", version = \"0.3.14\", default-features = false }\n-mbx-cache-cc = { path = \"../mbx-cache-cc\", version = \"0.20.2\", default-features = false }\n-mbx-cache-rustc = { path = \"../mbx-cache-rustc\", version = \"0.20.2\", default-features = false }\n-mbx-cache-store = { path = \"../mbx-cache-store\", version = \"0.1.40\", default-features = false }\n+mbx-cache-core = { path = \"../mbx-cache-core\", version = \"0.20.3\", default-features = false }\n+mbx-cache-cargo = { path = \"../mbx-cache-cargo\", version = \"0.3.15\", default-features = false }\n+mbx-cache-cc = { path = \"../mbx-cache-cc\", version = \"0.20.3\", default-features = false }\n+mbx-cache-rustc = { path = \"../mbx-cache-rustc\", version = \"0.20.3\", default-features = false }\n+mbx-cache-store = { path = \"../mbx-cache-store\", version = \"0.1.41\", default-features = false }\n rand = \"0.10\"\n ratatui = { version = \"0.30\", default-features = false, features = [\"crossterm\"] }\n reflink-copy = \"0.1\""},{"sha":"1e84c63abc68cba08abc37df7f2932d52c86a351","filename":"crates/mbx/src/cc.rs","status":"modified","additions":36,"deletions":16,"changes":52,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcc.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcc.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fcc.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -982,9 +982,11 @@ fn compiler_identity(compiler: &OsStr, language: CcLanguage) -> Result<CcCompile\n     })\n }\n \n-/// MSVC prints its detailed `/Bv` identity before complaining that no source\n-/// was supplied. That non-zero exit is a property of the query shape, not a\n-/// failed identity probe, so accept it only when the expected banner is there.\n+/// Ask `cl.exe` for its `_MSC_VER`, `_MSC_FULL_VER` and `_MSC_BUILD` by\n+/// preprocessing a tiny source.\n+///\n+/// The banner text is localized and reworded between releases, so it is not an\n+/// identity. The macros are, and `/EP` prints them without compiling anything.\n fn probe_msvc(executable: &Path) -> Result<String> {\n     let environment = BTreeMap::new();\n     if let Ok(responses) = session::request_agent(&[AgentRequest::FindExecutableIdentity {\n@@ -995,19 +997,7 @@ fn probe_msvc(executable: &Path) -> Result<String> {\n     {\n         return Ok(String::from_utf8_lossy(&text).into_owned());\n     }\n-    let output = Command::new(executable)\n-        .arg(\"/Bv\")\n-        .output()\n-        .map_err(|error| CcBypassReason::CompilerIdentityUnavailable(error.to_string()))?;\n-    let mut text = String::from_utf8_lossy(&output.stderr).into_owned();\n-    text.push_str(&String::from_utf8_lossy(&output.stdout));\n-    if !text.contains(\"Microsoft (R) C/C++ Optimizing Compiler\") {\n-        return Err(CcBypassReason::CompilerIdentityUnavailable(format!(\n-            \"{} did not report an MSVC compiler identity\",\n-            executable.display()\n-        ))\n-        .into());\n-    }\n+    let text = run_msvc_probe(executable)?;\n     let _ = session::request_agent(&[AgentRequest::StoreExecutableIdentity {\n         executable: executable.to_path_buf(),\n         environment,\n@@ -1017,6 +1007,36 @@ fn probe_msvc(executable: &Path) -> Result<String> {\n     Ok(text)\n }\n \n+/// Run the preprocessing probe itself, without consulting the agent's memo.\n+fn run_msvc_probe(executable: &Path) -> Result<String> {\n+    let unavailable = |reason: String| CcBypassReason::CompilerIdentityUnavailable(reason);\n+    let scratch = tempfile::tempdir().map_err(|error| unavailable(error.to_string()))?;\n+    let source = scratch.path().join(\"identity.c\");\n+    std::fs::write(&source, mbx_cache_cc::MSVC_IDENTITY_SOURCE)\n+        .map_err(|error| unavailable(error.to_string()))?;\n+    let output = Command::new(executable)\n+        .args([\"/nologo\", \"/EP\"])\n+        .arg(&source)\n+        .output()\n+        .map_err(|error| unavailable(error.to_string()))?;\n+    if !output.status.success() {\n+        return Err(unavailable(format!(\n+            \"{} exited with {} while reporting its identity\",\n+            executable.display(),\n+            output.status\n+        ))\n+        .into());\n+    }\n+    let text =\n+        mbx_cache_cc::msvc_identity(&String::from_utf8_lossy(&output.stdout)).ok_or_else(|| {\n+            unavailable(format!(\n+                \"{} did not report an MSVC compiler identity\",\n+                executable.display()\n+            ))\n+        })?;\n+    Ok(text)\n+}\n+\n /// The assembler path a driver named, if it named one at all.\n ///\n /// `-print-prog-name` echoes the bare name back when the driver cannot resolve"},{"sha":"e6ef63fd8d207a383da334a9a39f94535a5205da","filename":"crates/mbx/src/cc_tests.rs","status":"modified","additions":16,"deletions":0,"changes":16,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcc_tests.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcc_tests.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fcc_tests.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -378,3 +378,19 @@ fn output_scan_matches_logical_macos_mapping_roots() {\n         assert!(!portable.outputs_are_clean(&object, &[PathMapping::new(&physical, \"target\")]));\n     }\n }\n+\n+/// Runs the real `cl.exe` probe, so a change to its command line or output that\n+/// the parser rejects fails here instead of silently disabling caching.\n+#[cfg(windows)]\n+#[test]\n+fn probe_msvc_accepts_the_real_compiler() {\n+    let Ok(executable) = which::which(\"cl\") else {\n+        eprintln!(\"skipping: cl.exe is not on PATH\");\n+        return;\n+    };\n+    let probe = run_msvc_probe(&executable).unwrap();\n+    assert_eq!(\n+        mbx_cache_cc::CcCompilerFamily::classify(&probe).unwrap(),\n+        mbx_cache_cc::CcCompilerFamily::Msvc\n+    );\n+}"},{"sha":"285c3f8b302e76f6b28e641b2575d21720255a05","filename":"crates/mbx/src/cli/gc.rs","status":"modified","additions":4,"deletions":2,"changes":6,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Fgc.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Fgc.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fcli%2Fgc.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -45,8 +45,10 @@ pub(super) struct GcArgs {\n     ///\n     /// Defaults to `gc.max_size`. Managed targets, learned incremental state,\n     /// and generated source trees are still collected to their own budgets.\n-    /// With `gc.max_total_size` set, they share what is left of that total\n-    /// after the action store, whose share this flag caps.\n+    /// With `gc.max_total_size` set, incremental state and generated source\n+    /// trees default to a cap of 10% of the total, at least 10 GiB but never\n+    /// above the total; managed targets use what remains after them and the\n+    /// action store, whose share this flag caps.\n     #[usage(long, value_name = \"SIZE\")]\n     pub(super) max_size: Option<ByteSize>,\n     /// Print a stable machine-readable report."},{"sha":"7bd47ce2cba7f8aa3272162631e1ea13c4c4f514","filename":"crates/mbx/src/cli/mod.rs","status":"modified","additions":5,"deletions":2,"changes":7,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Fmod.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Fmod.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fcli%2Fmod.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -141,8 +141,11 @@ enum Commands {\n     /// mbx collects learned incremental state and managed targets first, then\n     /// evicts store objects until the action store fits its budget\n     /// (`--max-size`, or `gc.max_size` by default, lowered when\n-    /// `gc.max_total_size` leaves less room). When a disk has less free space\n-    /// than `gc.min_free_size`, mbx also collects past those budgets to free\n+    /// `gc.max_total_size` leaves less room). Under a combined budget,\n+    /// incremental state and generated source trees default to a cap of 10%\n+    /// of the total, at least 10 GiB but never above the total.\n+    /// When a disk has less free space than `gc.min_free_size`, mbx also\n+    /// collects past those budgets to free\n     /// the shortfall: private state and managed targets go first, then shared\n     /// store objects, even below `gc.max_size`. Active and most recently used\n     /// state stays, so a disk filled by something else can remain short."},{"sha":"4265430559a3e7169e7a84fad15670ae3ddd34e1","filename":"crates/mbx/src/cli/reserve.rs","status":"modified","additions":7,"deletions":3,"changes":10,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Freserve.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Freserve.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fcli%2Freserve.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -8,7 +8,7 @@ use std::process::{Command, ExitCode};\n \n #[derive(usage_rs::Args)]\n pub(super) struct ReserveArgs {\n-    /// CPU permits to hold while the command runs.\n+    /// CPU cores to hold while the command runs.\n     #[usage(long, value_name = \"N\")]\n     cpus: Option<u64>,\n     /// Memory to hold from the configured scheduler budget.\n@@ -50,12 +50,16 @@ fn run_direct(config: &Config, args: ReserveArgs) -> Result<ExitCode> {\n     let Some(pool) = crate::scheduler::reservation_pool(config, args.priority) else {\n         eyre::bail!(\"reserve needs scheduler.enabled\")\n     };\n-    let _permit = pool.reserve(args.cpus, args.memory.map(|memory| memory.as_u64()))?;\n+    let (permit, admission) =\n+        pool.reserve_observed(args.cpus, args.memory.map(|memory| memory.as_u64()))?;\n     let status = external_command(program, arguments)\n         // Nested mbx work is covered by this reservation. Letting its compiler\n         // shims take new permits would deadlock when this lease fills the pool.\n         .status()\n-        .wrap_err_with(|| format!(\"failed to run {program}\"))?;\n+        .wrap_err_with(|| format!(\"failed to run {program}\"));\n+    drop(permit);\n+    pool.observe_reservation(admission, status.as_ref().ok());\n+    let status = status?;\n     Ok(exit_code(status))\n }\n "},{"sha":"55ad97507646a2e17f04f22c0b0330e606a7120c","filename":"crates/mbx/src/cli/setup.rs","status":"modified","additions":23,"deletions":10,"changes":33,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Fsetup.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Fsetup.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fcli%2Fsetup.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -391,6 +391,12 @@ pub(super) fn rust_analyzer_override_is_installed(path: &Path, shim: &Path) -> R\n /// beside `Cargo.toml` parses and validates but never runs. The override goes\n /// to the user-level file whichever mise scope activation uses.\n fn rust_analyzer_config_path() -> Result<PathBuf> {\n+    // Windows locates the configuration directory without consulting the\n+    // environment, so tests cannot isolate it the way XDG_CONFIG_HOME does.\n+    #[cfg(debug_assertions)]\n+    if let Some(path) = std::env::var_os(\"MBX_TEST_RUST_ANALYZER_CONFIG\") {\n+        return Ok(path.into());\n+    }\n     dirs::config_dir()\n         .map(|directory| {\n             directory\n@@ -959,11 +965,18 @@ pub(super) fn same_file_contents(left: &Path, right: &Path) -> Result<bool> {\n \n #[cfg(windows)]\n pub(crate) fn cargo_shim_target(install_dir: &Path) -> Option<PathBuf> {\n-    if let Some(target) = std::env::var_os(\"PATH\").and_then(|path| {\n-        std::env::split_paths(&path)\n+    cargo_shim_target_on(install_dir, std::env::var_os(\"PATH\").as_deref())\n+}\n+\n+#[cfg(windows)]\n+pub(super) fn cargo_shim_target_on(install_dir: &Path, path: Option<&OsStr>) -> Option<PathBuf> {\n+    // mise's shim fails outside directories whose mise config enables mbx, so\n+    // it cannot stand in for the mbx that setup recorded.\n+    if let Some(target) = path.and_then(|path| {\n+        std::env::split_paths(path)\n             .filter(|directory| !same_path(directory, install_dir))\n             .map(|directory| directory.join(\"mbx.exe\"))\n-            .find(|candidate| candidate.is_file())\n+            .find(|candidate| candidate.is_file() && !super::shim::is_mise_shim_path(candidate))\n     }) {\n         return Some(target);\n     }\n@@ -975,16 +988,16 @@ fn configured_cargo_shim_target(install_dir: &Path) -> Option<PathBuf> {\n     use std::os::windows::ffi::OsStringExt as _;\n \n     let bytes = std::fs::read(install_dir.join(super::CARGO_SHIM_TARGET_FILE)).ok()?;\n-    let mut chunks = bytes.chunks_exact(2);\n+    let (units, remainder) = bytes.as_chunks::<2>();\n+    if !remainder.is_empty() {\n+        return None;\n+    }\n     let target = std::ffi::OsString::from_wide(\n-        &chunks\n-            .by_ref()\n-            .map(|bytes| u16::from_le_bytes([bytes[0], bytes[1]]))\n+        &units\n+            .iter()\n+            .map(|unit| u16::from_le_bytes(*unit))\n             .collect::<Vec<_>>(),\n     );\n-    if !chunks.remainder().is_empty() {\n-        return None;\n-    }\n     let target = PathBuf::from(target);\n     target.is_absolute().then_some(target)\n }"},{"sha":"b9a46695052a488897e0eed434318ac4ff6d1ab5","filename":"crates/mbx/src/cli/setup_tests.rs","status":"modified","additions":44,"deletions":0,"changes":44,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Fsetup_tests.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Fsetup_tests.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fcli%2Fsetup_tests.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -463,6 +463,50 @@ fn setup_status_detects_and_setup_refreshes_a_replaced_wrapper() {\n     assert!(cargo_shim_is_current(&executable, &shim).unwrap());\n }\n \n+#[cfg(windows)]\n+#[test]\n+fn cargo_shim_skips_the_mise_mbx_shim_on_path() {\n+    let directory = tempfile::tempdir().unwrap();\n+    let recorded = directory.path().join(\"recorded/mbx.exe\");\n+    std::fs::create_dir_all(recorded.parent().unwrap()).unwrap();\n+    std::fs::write(&recorded, b\"mbx binary\").unwrap();\n+    let install = directory.path().join(\"data/bin\");\n+    setup_at(&recorded, &install).unwrap();\n+    // mise's shim fails outside directories whose mise config enables mbx.\n+    let mise_shims = directory.path().join(\"mise/shims\");\n+    std::fs::create_dir_all(&mise_shims).unwrap();\n+    std::fs::write(mise_shims.join(\"mbx.exe\"), b\"mise shim\").unwrap();\n+\n+    let path = std::env::join_paths([&install, &mise_shims]).unwrap();\n+    assert_eq!(cargo_shim_target_on(&install, Some(&path)), Some(recorded));\n+\n+    let active = directory.path().join(\"active\");\n+    std::fs::create_dir_all(&active).unwrap();\n+    std::fs::write(active.join(\"mbx.exe\"), b\"new mbx binary\").unwrap();\n+    let path = std::env::join_paths([&install, &mise_shims, &active]).unwrap();\n+    assert_eq!(\n+        cargo_shim_target_on(&install, Some(&path)),\n+        Some(active.join(\"mbx.exe\"))\n+    );\n+}\n+\n+#[cfg(windows)]\n+#[test]\n+fn cargo_shim_skips_the_mise_mbx_shim_however_path_spells_it() {\n+    let directory = tempfile::tempdir().unwrap();\n+    let recorded = directory.path().join(\"recorded/mbx.exe\");\n+    std::fs::create_dir_all(recorded.parent().unwrap()).unwrap();\n+    std::fs::write(&recorded, b\"mbx binary\").unwrap();\n+    let install = directory.path().join(\"data/bin\");\n+    setup_at(&recorded, &install).unwrap();\n+    let mise_shims = directory.path().join(\"Mise/Shims\");\n+    std::fs::create_dir_all(&mise_shims).unwrap();\n+    std::fs::write(mise_shims.join(\"mbx.exe\"), b\"mise shim\").unwrap();\n+\n+    let path = std::env::join_paths([&install, &mise_shims]).unwrap();\n+    assert_eq!(cargo_shim_target_on(&install, Some(&path)), Some(recorded));\n+}\n+\n #[cfg(unix)]\n #[test]\n fn setup_status_reports_a_shim_whose_target_was_removed_as_outdated() {"},{"sha":"6b7c64d38779db3078f0905d9f04d9f1b22ace50","filename":"crates/mbx/src/cli/shim.rs","status":"modified","additions":100,"deletions":8,"changes":108,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Fshim.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Fshim.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fcli%2Fshim.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -83,6 +83,9 @@ pub fn run_cargo_shim() -> Result<ExitCode> {\n     if enclosing_session(std::env::var_os(crate::session::SOCKET_ENV).as_deref())\n         || cargo_proxy_passthrough(&arguments)\n     {\n+        if super::launch::cargo_subcommand(&arguments) == Some(\"clean\") {\n+            drop_dangling_managed_link(&real_cargo, &arguments);\n+        }\n         return run_real_cargo(&real_cargo, &arguments);\n     }\n     let Ok(string_arguments) = super::strings(&arguments) else {\n@@ -115,6 +118,36 @@ pub fn run_cargo_shim() -> Result<ExitCode> {\n     super::cargo::run_with_roots(&config, &settings, &string_arguments, roots)\n }\n \n+/// Collection removes a managed target but leaves the checkout's `target` link\n+/// dangling until the next build places it again. Cargo cannot create a\n+/// directory through that link, so `cargo clean -p` would fail on a checkout\n+/// that has nothing left to clean. Dropping the link first lets Cargo report\n+/// the clean it would have done. Best effort: any failure leaves Cargo to run\n+/// against the checkout as it is.\n+fn drop_dangling_managed_link(real_cargo: &OsStr, arguments: &[OsString]) {\n+    let Ok(string_arguments) = super::strings(arguments) else {\n+        return;\n+    };\n+    let target_dir_env = std::env::var_os(CARGO_TARGET_DIR_ENV);\n+    let Some(roots) = cargo_roots(real_cargo, &string_arguments, target_dir_env.as_deref()) else {\n+        return;\n+    };\n+    if roots.target_dir != roots.workspace_root.join(\"target\")\n+        || !std::fs::symlink_metadata(&roots.target_dir)\n+            .is_ok_and(|metadata| metadata.file_type().is_symlink())\n+    {\n+        return;\n+    }\n+    let Ok((config, _)) = Config::load_for_cli() else {\n+        return;\n+    };\n+    if let Err(error) =\n+        crate::target::remove_dangling_link(&config.target.root, &roots.workspace_root)\n+    {\n+        log::warn!(\"could not remove the dangling managed target link: {error:#}\");\n+    }\n+}\n+\n fn resolve_active_cargo_shim(\n     configured: &Path,\n     reported: Option<&OsStr>,\n@@ -489,18 +522,50 @@ fn is_mise_cargo_proxy_path(path: &Path) -> bool {\n         return true;\n     }\n     let name = if cfg!(windows) { \"cargo.exe\" } else { \"cargo\" };\n-    let Some(shims) = path.parent().filter(|parent| {\n-        parent.file_name() == Some(OsStr::new(\"shims\"))\n-            && path.file_name() == Some(OsStr::new(name))\n-    }) else {\n+    path.file_name() == Some(OsStr::new(name)) && is_mise_shim_path(path)\n+}\n+\n+/// Whether `path` is in mise's shims directory. A mise shim runs its tool only\n+/// where mise config enables it and fails everywhere else.\n+pub(crate) fn is_mise_shim_path(path: &Path) -> bool {\n+    is_mise_shim_path_in(\n+        path,\n+        std::env::var_os(\"MISE_SHIMS_DIR\").as_deref(),\n+        std::env::var_os(\"MISE_DATA_DIR\").as_deref(),\n+    )\n+}\n+\n+/// `shims_dir` and `data_dir` are mise's `MISE_SHIMS_DIR` and `MISE_DATA_DIR`.\n+/// A `shims_dir` set only in mise's global config is not visible here.\n+fn is_mise_shim_path_in(path: &Path, shims_dir: Option<&OsStr>, data_dir: Option<&OsStr>) -> bool {\n+    let Some(directory) = path.parent() else {\n         return false;\n     };\n-    let Some(data_dir) = shims.parent() else {\n+    if shims_dir.is_some_and(|configured| same_path(directory, Path::new(configured))) {\n+        return true;\n+    }\n+    if !directory\n+        .file_name()\n+        .is_some_and(|name| file_name_is(name, \"shims\"))\n+    {\n+        return false;\n+    }\n+    let Some(parent) = directory.parent() else {\n         return false;\n     };\n-    data_dir.file_name() == Some(OsStr::new(\"mise\"))\n-        || std::env::var_os(\"MISE_DATA_DIR\")\n-            .is_some_and(|configured| same_path(data_dir, Path::new(&configured)))\n+    parent\n+        .file_name()\n+        .is_some_and(|name| file_name_is(name, \"mise\"))\n+        || data_dir.is_some_and(|configured| same_path(parent, Path::new(configured)))\n+}\n+\n+/// Windows compares file names without regard to case.\n+fn file_name_is(name: &OsStr, expected: &str) -> bool {\n+    if cfg!(windows) {\n+        name.eq_ignore_ascii_case(expected)\n+    } else {\n+        name == expected\n+    }\n }\n \n fn resolve_real_cargo_from(\n@@ -870,4 +935,31 @@ mod tests {\n             real.into_os_string()\n         );\n     }\n+\n+    #[test]\n+    fn mise_shims_are_recognized_in_configured_and_default_directories() {\n+        let directory = tempfile::tempdir().unwrap();\n+        let custom = directory.path().join(\"tools/bin\");\n+        std::fs::create_dir_all(&custom).unwrap();\n+        let shim = custom.join(\"mbx\");\n+        assert!(!is_mise_shim_path_in(&shim, None, None));\n+        assert!(is_mise_shim_path_in(&shim, Some(custom.as_os_str()), None));\n+\n+        let data = directory.path().join(\"data\");\n+        assert!(is_mise_shim_path_in(\n+            &data.join(\"shims/mbx\"),\n+            None,\n+            Some(data.as_os_str())\n+        ));\n+        assert!(is_mise_shim_path_in(\n+            &directory.path().join(\"mise/shims/mbx\"),\n+            None,\n+            None\n+        ));\n+        assert!(!is_mise_shim_path_in(\n+            &directory.path().join(\"other/shims/mbx\"),\n+            None,\n+            None\n+        ));\n+    }\n }"},{"sha":"691cefa82b215fcf94c8740b3f86427493dce932","filename":"crates/mbx/src/cli/stats.rs","status":"modified","additions":7,"deletions":1,"changes":8,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Fstats.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fcli%2Fstats.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fcli%2Fstats.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -7,10 +7,16 @@ pub(super) struct StatsArgs {\n     /// Print a stable machine-readable report, with byte counts and nanoseconds.\n     #[usage(long)]\n     json: bool,\n+    /// Show compile memory estimates and a read-only scheduler activity snapshot.\n+    #[usage(long)]\n+    scheduler: bool,\n }\n \n pub(super) fn run(config: &Config, args: StatsArgs, style: SavingsStyle) -> Result<ExitCode> {\n-    let report = crate::stats::collect(&config.store_dir(), &config.target.root)?;\n+    let mut report = crate::stats::collect(&config.store_dir(), &config.target.root)?;\n+    if args.scheduler {\n+        report.scheduler = Some(crate::scheduler::scheduler_report(config));\n+    }\n     if args.json {\n         super::cache::print_json(&report)?;\n     } else {"},{"sha":"09532d795a0fbb505822a97d4edc6b03ae7b09b0","filename":"crates/mbx/src/config.rs","status":"modified","additions":75,"deletions":31,"changes":106,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fconfig.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fconfig.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fconfig.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -213,10 +213,11 @@ pub(crate) struct RawConfig {\n     /// How much learned incremental state one crate may keep, or `\"none\"`.\n     ///\n     /// State past this is discarded before the crate compiles again.\n+    /// Defaults to 8 GiB even when `gc.max_total_size` is set.\n     #[usage(\n         key = \"learned_incremental_max_size\",\n         env = \"MBX_LEARNED_INCREMENTAL_MAX_SIZE\",\n-        default_note = \"8 GiB, or `gc.max_total_size` when set\"\n+        default_note = \"8 GiB\"\n     )]\n     learned_incremental_max_size: Option<String>,\n     /// Cap on the per-compilation history one build records, or `\"none\"`.\n@@ -406,23 +407,24 @@ struct RawScheduler {\n     /// variable wins.\n     #[usage(env = \"MBX_SCHEDULER\", default = true)]\n     enabled: bool,\n-    /// Number of compile permits in the machine-wide pool.\n+    /// CPU core budget in the machine-wide pool before `scheduler.reserve_cpus`.\n     ///\n-    /// A typical compilation takes one permit; links and memory-heavy crates\n-    /// can take more. This may also be set in workspace `.mbx.toml`; the\n-    /// environment variable wins.\n+    /// Compilers charge their thread counts; test binaries can use learned core\n+    /// counts. Memory has its own independent budget. This may also be set in\n+    /// workspace `.mbx.toml`; the environment variable wins.\n     #[usage(env = \"MBX_SCHEDULER_CPUS\", default_note = \"logical CPUs\")]\n     cpus: Option<i64>,\n-    /// Permits withheld from `scheduler.cpus` to leave CPUs for other work.\n+    /// CPU cores withheld from `scheduler.cpus` to leave CPUs for other work.\n     ///\n-    /// At least one permit always remains. This may also be set in workspace\n-    /// `.mbx.toml`; the environment variable wins.\n+    /// At least one core always remains; the memory budget is unaffected. This\n+    /// may also be set in workspace `.mbx.toml`; the environment variable wins.\n     #[usage(env = \"MBX_SCHEDULER_RESERVE_CPUS\", default = 0)]\n     reserve_cpus: i64,\n-    /// Memory budget the permits divide, such as `24GiB`, or `\"none\"`.\n+    /// Independent memory budget, such as `24GiB`, or `\"none\"`.\n     ///\n-    /// Each permit stands for an equal share of it. `\"none\"` leaves plain CPU\n-    /// permits and also turns off `scheduler.pressure` and `scheduler.suspend`.\n+    /// Requests charge predicted memory bytes separately from CPU cores.\n+    /// `\"none\"` schedules CPU only and turns off `scheduler.pressure` and\n+    /// `scheduler.suspend`.\n     /// This may also be set in workspace `.mbx.toml`; the environment\n     /// variable wins.\n     #[usage(\n@@ -507,14 +509,24 @@ struct RawRemote {\n     /// Remote access mode.\n     ///\n     /// Only trusted CI (a push to a protected branch on GitHub Actions or GitLab\n-    /// CI) may write. Everywhere else, including a local shell, `read-write`\n-    /// acts as `read-only` and `write-only` disables the remote.\n+    /// CI) may write, unless `remote.trust_writes` is set. Everywhere else,\n+    /// including a local shell, `read-write` acts as `read-only` and\n+    /// `write-only` disables the remote.\n     #[usage(\n         env = \"MBX_REMOTE_MODE\",\n         default = \"read-write\",\n         choices(\"read-write\", \"read-only\", \"write-only\")\n     )]\n     mode: String,\n+    /// Skip the CI write policy and use `remote.mode` as configured.\n+    ///\n+    /// For CI systems mbx does not detect, such as Buildkite or Jenkins. Set it\n+    /// only from the agent or pipeline environment, only for builds you trust,\n+    /// and never from a file that a pull request can change. Workspace\n+    /// `.mbx.toml` refuses it. The write credential should still be limited to\n+    /// those builds.\n+    #[usage(env = \"MBX_REMOTE_TRUST_WRITES\", default = false)]\n+    trust_writes: bool,\n     /// S3 endpoint for a service other than AWS, such as MinIO or R2.\n     #[usage(env = \"MBX_REMOTE_S3_ENDPOINT\", ty = \"url\")]\n     s3_endpoint: Option<String>,\n@@ -611,8 +623,10 @@ struct RawGc {\n     ///\n     /// A size such as `50GiB` counts logical bytes across the action store,\n     /// managed targets, learned incremental state, and generated source trees.\n-    /// When set, it replaces the disk-scaled defaults of the component budgets;\n-    /// explicit component limits still apply. Active and protected state may\n+    /// When set, it replaces disk-scaled defaults and caps incremental state and\n+    /// generated source trees at 10% of the total, at least 10 GiB but never\n+    /// above the total, unless `gc.incremental_max_size` is explicit.\n+    /// Explicit component limits still apply. Active and protected state may\n     /// exceed this target.\n     #[usage(env = \"MBX_GC_MAX_TOTAL_SIZE\")]\n     max_total_size: Option<String>,\n@@ -622,9 +636,11 @@ struct RawGc {\n     /// Over budget, mbx collects the incremental state of inactive checkouts\n     /// least recently used first and keeps the most recently used checkout's.\n     /// Generated source trees get whatever budget incremental state leaves.\n+    /// With `gc.max_total_size`, defaults to 10% of that total, at least\n+    /// 10 GiB but never above the total.\n     #[usage(\n         env = \"MBX_GC_INCREMENTAL_MAX_SIZE\",\n-        default_note = \"5% of the cache disk, from 10 GiB to 100 GiB; shared budget when `gc.max_total_size` is set\"\n+        default_note = \"5% of the cache disk, from 10 GiB to 100 GiB; with `gc.max_total_size`, 10% of the total, at least 10 GiB but never above the total\"\n     )]\n     incremental_max_size: Option<String>,\n     /// Collect learned incremental state unused this long, or `\"none\"`.\n@@ -841,11 +857,11 @@ impl Config {\n pub struct SchedulerSettings {\n     /// Whether compilations take permits at all.\n     pub enabled: bool,\n-    /// Machine-wide concurrent compile permits.\n+    /// Machine-wide CPU core budget before reserving cores for other work.\n     pub cpus: u64,\n-    /// Permits withheld from the configured CPU count.\n+    /// Cores withheld from the configured CPU count.\n     pub reserve_cpus: u64,\n-    /// Memory the permits divide; `None` leaves plain CPU permits.\n+    /// Independent memory budget; `None` leaves CPU-only scheduling.\n     pub memory_bytes: Option<u64>,\n     /// Priority of this build's compilations against other builds.\n     pub priority: SchedulerPriority,\n@@ -931,6 +947,7 @@ pub struct RemoteSettings {\n     pub token_file: Option<PathBuf>,\n     pub oidc_audience: Option<String>,\n     pub mode: RemoteCacheMode,\n+    pub trust_writes: bool,\n     pub s3_endpoint: Option<String>,\n     pub s3_region: Option<String>,\n     pub s3_force_path_style: Option<bool>,\n@@ -1313,9 +1330,10 @@ impl Config {\n             target_max_age: parse_optional_duration(&raw.target.max_age)\n                 .wrap_err(Invalid(\"target.max_age\"))?,\n             incremental_max_bytes: incremental_budget.unwrap_or_else(|| {\n-                total_budget\n-                    .is_none()\n-                    .then(|| INCREMENTAL_BUDGET.resolve(store_disk))\n+                Some(total_budget.map_or_else(\n+                    || INCREMENTAL_BUDGET.resolve(store_disk),\n+                    |total| total.min((total / 10).max(INCREMENTAL_BUDGET.floor)),\n+                ))\n             }),\n             incremental_max_age: parse_optional_duration(&raw.gc.incremental_max_age)\n                 .wrap_err(Invalid(\"gc.incremental_max_age\"))?,\n@@ -1437,6 +1455,7 @@ impl Config {\n                 token_file: raw.remote.token_file,\n                 oidc_audience: raw.remote.oidc_audience,\n                 mode,\n+                trust_writes: raw.remote.trust_writes,\n                 s3_endpoint: raw.remote.s3_endpoint,\n                 s3_region: raw.remote.s3_region,\n                 s3_force_path_style: raw.remote.s3_force_path_style,\n@@ -1459,9 +1478,7 @@ impl Config {\n                     .map(parse_optional_byte_size)\n                     .transpose()\n                     .wrap_err(Invalid(\"learned_incremental_max_size\"))?\n-                    .unwrap_or(Some(\n-                        total_budget.unwrap_or(DEFAULT_LEARNED_INCREMENTAL_MAX_SIZE),\n-                    )),\n+                    .unwrap_or(Some(DEFAULT_LEARNED_INCREMENTAL_MAX_SIZE)),\n                 cache_links: raw.cache_links,\n                 events_max_size: parse_optional_byte_size(&raw.events_max_size)\n                     .wrap_err(Invalid(\"events_max_size\"))?,\n@@ -2435,18 +2452,27 @@ mod tests {\n \n     #[test]\n     fn a_total_budget_replaces_only_implicit_size_limits() {\n-        for total in [1, 100] {\n-            let value = format!(\"{total}GiB\");\n+        for (total, incremental) in [\n+            (10 * 1024 * GIB, 1024 * GIB),\n+            (100 * GIB, 10 * GIB),\n+            (50 * GIB, 10 * GIB),\n+            (8 * GIB, 8 * GIB),\n+            (123 * GIB + 7, (123 * GIB + 7) / 10),\n+        ] {\n+            let value = format!(\"{total}B\");\n             let (config, settings) =\n                 configured_measuring(None, &[(\"MBX_GC_MAX_TOTAL_SIZE\", &value)], |_| {\n                     panic!(\"a total budget needs no disk-scaled defaults\")\n                 })\n                 .unwrap();\n-            assert_eq!(config.gc.max_bytes, total * GIB);\n-            assert_eq!(settings.retention.max_total_bytes, Some(total * GIB));\n+            assert_eq!(config.gc.max_bytes, total);\n+            assert_eq!(settings.retention.max_total_bytes, Some(total));\n             assert_eq!(settings.retention.target_max_bytes, None);\n-            assert_eq!(settings.retention.incremental_max_bytes, None);\n-            assert_eq!(settings.learned_incremental_max_size, Some(total * GIB));\n+            assert_eq!(settings.retention.incremental_max_bytes, Some(incremental));\n+            assert_eq!(\n+                settings.learned_incremental_max_size,\n+                Some(DEFAULT_LEARNED_INCREMENTAL_MAX_SIZE)\n+            );\n             assert_eq!(settings.retention.min_free, Some(MinFree::ShareOfDisk));\n             assert_eq!(\n                 settings.retention.target_max_age,\n@@ -2827,6 +2853,24 @@ default = \"rust-lld\"\n         );\n     }\n \n+    #[test]\n+    fn workspace_policy_refuses_remote_trust_writes() {\n+        let directory = tempfile::tempdir().unwrap();\n+        std::fs::write(\n+            directory.path().join(\".mbx.toml\"),\n+            \"[remote]\\ntrust_writes = true\\n\",\n+        )\n+        .unwrap();\n+        let mut config = configured(None, &[]).unwrap();\n+\n+        let error = config\n+            .apply_workspace_policy_with(directory.path(), |_| false)\n+            .unwrap_err();\n+\n+        assert!(format!(\"{error:?}\").contains(\"unsupported workspace setting \\\"remote\\\"\"));\n+        assert!(!config.remote.trust_writes);\n+    }\n+\n     #[test]\n     fn workspace_linker_policy_rejects_executable_paths() {\n         let directory = tempfile::tempdir().unwrap();"},{"sha":"171fe9ec3082aa75cfe1e1ab868e65eb78fdfd13","filename":"crates/mbx/src/doctor.rs","status":"modified","additions":2,"deletions":1,"changes":3,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fdoctor.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fdoctor.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fdoctor.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -619,7 +619,8 @@ fn setup_path() -> Option<PathBuf> {\n }\n \n async fn remote_checks(config: &Config) -> Vec<Check> {\n-    let effective_mode = policy::effective_remote_cache_mode(config.remote.mode);\n+    let effective_mode =\n+        policy::effective_remote_cache_mode(config.remote.mode, config.remote.trust_writes);\n     remote_checks_with_policy(config, effective_mode).await\n }\n "},{"sha":"fdac1d0adcb22d91d387a29cca24370c269e80d0","filename":"crates/mbx/src/incremental.rs","status":"modified","additions":503,"deletions":8,"changes":511,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fincremental.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fincremental.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fincremental.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -120,7 +120,11 @@ pub(crate) fn workspaces(root: &Path) -> Result<Vec<PathBuf>> {\n     Ok(workspaces)\n }\n \n-/// Collect deleted, expired, and least-recently-used checkout state.\n+/// Collect expired and least-recently-used checkout state.\n+///\n+/// A deleted checkout's state is kept like any other until it expires or the\n+/// budget needs the room: it is what the next new checkout starts from (see\n+/// [`seed`]), and worktrees are usually removed as soon as their work merges.\n pub(crate) fn collect(\n     root: &Path,\n     max_bytes: Option<u64>,\n@@ -141,7 +145,7 @@ pub(crate) fn collect(\n             continue;\n         };\n         let expired = max_age.is_some_and(|age| now.saturating_sub(updated_secs) > age.as_secs());\n-        if entry.live == Some(false) || expired {\n+        if expired {\n             required.insert(entry.key.clone());\n         }\n     }\n@@ -272,7 +276,7 @@ fn entries(root: &Path) -> Result<Vec<Entry>> {\n             bytes: tree_bytes(&directory),\n             live: record\n                 .as_ref()\n-                .map(|record| crate::store::checkout_is_live(&record.workspace_root)),\n+                .map(|record| crate::store::checkout_is_live_on(root, &record.workspace_root)),\n             updated_secs: record.as_ref().map(|record| record.updated_secs),\n             directory,\n         });\n@@ -394,6 +398,236 @@ fn cleanup_lock_dir(locks: &Path) {\n     let _ = std::fs::remove_dir(locks);\n }\n \n+/// Copy the most recently used other checkout's state for one unit into\n+/// `checkout`, under the same unit name. Returns that checkout's workspace\n+/// root, or `None` when no other checkout has state for the unit.\n+///\n+/// Only worth doing for a compilation whose state does not depend on where\n+/// the checkout lives (`-Zremap-cwd-prefix`): rustc ignores state recorded\n+/// under another working directory. The unit's name is the digest of its\n+/// path-normalized invocation, so it is the same in every checkout of the\n+/// project, and rustc validates whatever it inherits against the sources it\n+/// compiles, as it does after any edit.\n+///\n+/// The donor holds a lease while it is read, so collection cannot remove it\n+/// halfway, and each session it copies is locked the way rustc locks it, so\n+/// the donor's own compiler cannot remove that either. A session the donor's\n+/// compiler is still writing, or may be removing, is left out. The copy is\n+/// made beside its final name and renamed into place, so an interrupted copy\n+/// leaves no partial state; a donor that cannot be copied gives way to the\n+/// next.\n+///\n+/// Files are hard-linked. rustc writes a session once, into a directory of\n+/// its own, and links what it reuses into the next one rather than changing\n+/// it, so sharing them is as safe as rustc's own reuse. A clone would be just\n+/// as correct, but it is a new file: the donor's pages in the file cache do\n+/// not carry over, and the first compilation rereads every object and bitcode\n+/// file in the state. Lock files, which rustc locks rather than reads, are\n+/// copied, and so is any file that cannot be linked.\n+pub(crate) fn seed(checkout: &Path, unit: &str) -> Result<Option<PathBuf>> {\n+    let (Some(root), Some(own)) = (checkout.parent(), checkout.file_name()) else {\n+        return Ok(None);\n+    };\n+    let mut donors = Vec::new();\n+    for entry in std::fs::read_dir(root)?.flatten() {\n+        let name = entry.file_name();\n+        if name == own || name == LOCKS_DIR || !entry.path().join(unit).is_dir() {\n+            continue;\n+        }\n+        if let Some(record) = read_record(&entry.path().join(RECORD_FILE)) {\n+            donors.push((record.updated_secs, record.workspace_root, name));\n+        }\n+    }\n+    donors.sort_by_key(|donor| std::cmp::Reverse(donor.0));\n+    let destination = checkout.join(unit);\n+    let mut failure = None;\n+    for (_, workspace_root, name) in donors {\n+        let Some(key) = name.to_str() else {\n+            continue;\n+        };\n+        let _lease = acquire_lease(root, key)?;\n+        let source = root.join(key).join(unit);\n+        if !holds_finished_session(&source) {\n+            continue;\n+        }\n+        let mut staging = destination.clone().into_os_string();\n+        staging.push(format!(\".seeding-{}\", std::process::id()));\n+        let staging = PathBuf::from(staging);\n+        let mut held = Vec::new();\n+        let copied = destination\n+            .parent()\n+            .map_or(Ok(()), std::fs::create_dir_all)\n+            .and_then(|()| copy_state(&source, &staging, &mut held));\n+        // Every session the donor's compiler could have been removing was\n+        // skipped, so there may be nothing left to start from.\n+        let copied = copied.and_then(|()| {\n+            if holds_finished_session(&staging) {\n+                std::fs::rename(&staging, &destination).map(|()| true)\n+            } else {\n+                Ok(false)\n+            }\n+        });\n+        drop(held);\n+        match copied {\n+            Ok(true) => return Ok(Some(workspace_root)),\n+            Ok(false) => {\n+                let _ = std::fs::remove_dir_all(&staging);\n+            }\n+            Err(error) => {\n+                let _ = std::fs::remove_dir_all(&staging);\n+                failure = Some(eyre::Report::from(error).wrap_err(format!(\n+                    \"failed to copy incremental state from {}\",\n+                    workspace_root.display()\n+                )));\n+            }\n+        }\n+    }\n+    failure.map_or(Ok(None), Err)\n+}\n+\n+/// rustc names a session it is still writing `s-<time>-<random>-working`,\n+/// and renames it once the compilation finishes.\n+fn is_unfinished_session(name: &std::ffi::OsStr) -> bool {\n+    name.to_str()\n+        .is_some_and(|name| name.starts_with(\"s-\") && name.ends_with(\"-working\"))\n+}\n+\n+/// Whether a unit's directory holds a session rustc finished:\n+/// `<crate>-<hash>/s-...`.\n+fn holds_finished_session(unit: &Path) -> bool {\n+    let Ok(crates) = std::fs::read_dir(unit) else {\n+        return false;\n+    };\n+    crates.flatten().any(|krate| {\n+        std::fs::read_dir(krate.path()).is_ok_and(|sessions| {\n+            sessions.flatten().any(|session| {\n+                let name = session.file_name();\n+                session.path().is_dir()\n+                    && name.to_str().is_some_and(|name| name.starts_with(\"s-\"))\n+                    && !is_unfinished_session(&name)\n+            })\n+        })\n+    })\n+}\n+\n+/// The name of the lock file rustc keeps beside a session: the session's name\n+/// up to its third `-`, `s-<time>-<random>.lock`, the same before and after\n+/// rustc finishes the session.\n+fn session_lock_name(session: &std::ffi::OsStr) -> Option<std::ffi::OsString> {\n+    let name = session.to_str()?;\n+    let (end, _) = name.match_indices('-').nth(2)?;\n+    Some(format!(\"{}.lock\", &name[..end]).into())\n+}\n+\n+/// Hold a shared lock on a finished session's lock file, as a reader.\n+///\n+/// rustc removes a superseded session only after it takes that lock\n+/// exclusively, so a session locked here cannot disappear while it is being\n+/// copied. A session whose lock is taken, or that has no lock file, may be\n+/// going away and is left out. rustc locks through the same primitive as\n+/// `File::try_lock_shared`.\n+fn lock_session(lock: &Path) -> Option<std::fs::File> {\n+    let lock = std::fs::File::open(lock).ok()?;\n+    lock.try_lock_shared().ok()?;\n+    Some(lock)\n+}\n+\n+/// Copy one unit's state: `<unit>/<crate>-<hash>/<session>`. Sessions are\n+/// only ever directly inside a crate's directory, which is the only level\n+/// where they are treated as such: a crate may be named `s`.\n+fn copy_state(\n+    unit: &Path,\n+    destination: &Path,\n+    held: &mut Vec<std::fs::File>,\n+) -> std::io::Result<()> {\n+    std::fs::create_dir(destination)?;\n+    for entry in std::fs::read_dir(unit)? {\n+        let entry = entry?;\n+        let to = destination.join(entry.file_name());\n+        if entry.file_type()?.is_dir() {\n+            copy_crate_state(&entry.path(), &to, held)?;\n+        } else {\n+            copy_file(&entry.path(), &to)?;\n+        }\n+    }\n+    Ok(())\n+}\n+\n+/// Copy a crate's finished sessions, holding each one's lock, and the lock\n+/// files of the sessions copied.\n+fn copy_crate_state(\n+    krate: &Path,\n+    destination: &Path,\n+    held: &mut Vec<std::fs::File>,\n+) -> std::io::Result<()> {\n+    std::fs::create_dir(destination)?;\n+    let mut entries = Vec::new();\n+    for entry in std::fs::read_dir(krate)? {\n+        let entry = entry?;\n+        entries.push((entry.file_name(), entry.path(), entry.file_type()?));\n+    }\n+    // Lock every finished session first, so the lock files of the sessions\n+    // left out are left out too.\n+    let mut skipped = HashSet::new();\n+    for (name, path, kind) in &entries {\n+        if !kind.is_dir() {\n+            continue;\n+        }\n+        let lock_name = session_lock_name(name);\n+        let lock = lock_name\n+            .as_ref()\n+            .filter(|_| !is_unfinished_session(name))\n+            .and_then(|lock_name| lock_session(&path.with_file_name(lock_name)));\n+        match lock {\n+            Some(lock) => held.push(lock),\n+            None => {\n+                skipped.extend(lock_name);\n+                skipped.insert(name.clone());\n+            }\n+        }\n+    }\n+    for (name, from, kind) in &entries {\n+        if skipped.contains(name) {\n+            continue;\n+        }\n+        let to = destination.join(name);\n+        if kind.is_dir() {\n+            copy_tree(from, &to)?;\n+        } else if kind.is_file() {\n+            copy_file(from, &to)?;\n+        }\n+    }\n+    Ok(())\n+}\n+\n+/// Copy a finished session's files as they are.\n+fn copy_tree(source: &Path, destination: &Path) -> std::io::Result<()> {\n+    std::fs::create_dir(destination)?;\n+    for entry in std::fs::read_dir(source)? {\n+        let entry = entry?;\n+        let to = destination.join(entry.file_name());\n+        let kind = entry.file_type()?;\n+        if kind.is_dir() {\n+            copy_tree(&entry.path(), &to)?;\n+        } else if kind.is_file() {\n+            copy_file(&entry.path(), &to)?;\n+        }\n+    }\n+    Ok(())\n+}\n+\n+/// Hard-link a state file, or copy it: a lock file, which rustc locks rather\n+/// than reads, or one that cannot be linked.\n+fn copy_file(from: &Path, to: &Path) -> std::io::Result<()> {\n+    let lock = from\n+        .extension()\n+        .is_some_and(|extension| extension == \"lock\");\n+    if lock || std::fs::hard_link(from, to).is_err() {\n+        std::fs::copy(from, to)?;\n+    }\n+    Ok(())\n+}\n+\n fn read_record(path: &Path) -> Option<CheckoutRecord> {\n     let bytes = std::fs::read(path).ok()?;\n     let record = serde_json::from_slice::<CheckoutRecord>(&bytes).ok()?;\n@@ -491,10 +725,12 @@ mod tests {\n     }\n \n     #[test]\n-    fn abandoned_checkout_state_is_pruned() {\n+    fn abandoned_checkout_state_is_kept_until_it_expires() {\n         let cache = tempfile::tempdir().unwrap();\n         let parent = tempfile::tempdir().unwrap();\n-        let checkout = parent.path().join(\"checkout\");\n+        let checkout_parent = parent.path().join(\"manager\");\n+        std::fs::create_dir(&checkout_parent).unwrap();\n+        let checkout = checkout_parent.join(\"checkout\");\n         let key = checkout_key(&checkout);\n         std::fs::create_dir(&checkout).unwrap();\n         let state = touch(cache.path(), &checkout).unwrap();\n@@ -504,15 +740,61 @@ mod tests {\n         drop(state);\n \n         std::fs::remove_dir(&checkout).unwrap();\n-        assert!(!crate::store::checkout_is_live(&checkout));\n-        let outcome = collect(cache.path(), None, None, false).unwrap();\n+        std::fs::remove_dir(&checkout_parent).unwrap();\n+        assert!(!crate::store::checkout_is_live_on(cache.path(), &checkout));\n+        let kept = collect(cache.path(), None, None, false).unwrap();\n+        assert_eq!(\n+            kept.removed_directories, 0,\n+            \"a new checkout may seed from it\"\n+        );\n+        assert!(directory.exists());\n \n+        // Expiry is measured in whole seconds.\n+        std::thread::sleep(Duration::from_millis(1100));\n+        let outcome = collect(cache.path(), None, Some(Duration::ZERO), false).unwrap();\n         assert_eq!(outcome.removed_directories, 1);\n         assert!(outcome.removed_bytes > 0);\n         assert!(!directory.exists());\n         assert!(!lock_dir(cache.path(), &key).exists());\n     }\n \n+    #[cfg(target_os = \"linux\")]\n+    #[test]\n+    fn checkout_on_another_filesystem_is_kept() {\n+        let Some(other_fs) = Path::new(\"/dev/shm\")\n+            .exists()\n+            .then_some(Path::new(\"/dev/shm\"))\n+        else {\n+            return;\n+        };\n+        let cache = tempfile::tempdir().unwrap();\n+        if crate::store::same_filesystem_paths(cache.path(), other_fs) {\n+            return;\n+        }\n+        // An unwritable mount is not a test failure, as in\n+        // real_cross_device_probe_warns.\n+        let Ok(parent) = tempfile::Builder::new()\n+            .prefix(\"mbx-incremental-\")\n+            .tempdir_in(other_fs)\n+        else {\n+            return;\n+        };\n+        let checkout_parent = parent.path().join(\"manager\");\n+        std::fs::create_dir(&checkout_parent).unwrap();\n+        let checkout = checkout_parent.join(\"checkout\");\n+        std::fs::create_dir(&checkout).unwrap();\n+        let state = touch(cache.path(), &checkout).unwrap();\n+        let directory = state.directory.clone();\n+        drop(state);\n+\n+        std::fs::remove_dir(&checkout).unwrap();\n+        std::fs::remove_dir(&checkout_parent).unwrap();\n+        let outcome = collect(cache.path(), None, None, false).unwrap();\n+\n+        assert_eq!(outcome.removed_directories, 0);\n+        assert!(directory.exists());\n+    }\n+\n     #[test]\n     fn dry_run_does_not_create_checkout_lock_bookkeeping() {\n         let cache = tempfile::tempdir().unwrap();\n@@ -525,7 +807,9 @@ mod tests {\n         assert!(!lock_dir(cache.path(), &key).exists());\n \n         std::fs::remove_dir(&checkout).unwrap();\n-        let outcome = collect(cache.path(), None, None, true).unwrap();\n+        // Expiry is measured in whole seconds.\n+        std::thread::sleep(Duration::from_millis(1100));\n+        let outcome = collect(cache.path(), None, Some(Duration::ZERO), true).unwrap();\n \n         assert_eq!(outcome.removed_directories, 1);\n         assert!(!lock_dir(cache.path(), &key).exists());\n@@ -539,6 +823,8 @@ mod tests {\n         std::fs::create_dir(&checkout).unwrap();\n         let state = touch(cache.path(), &checkout).unwrap();\n         std::fs::remove_dir(&checkout).unwrap();\n+        // Expiry is measured in whole seconds.\n+        std::thread::sleep(Duration::from_millis(1100));\n \n         let outcome = collect(cache.path(), Some(0), Some(Duration::ZERO), false).unwrap();\n         assert_eq!(outcome.removed_directories, 0);\n@@ -633,4 +919,213 @@ mod tests {\n         assert!(!selected_directory.exists());\n         assert!(kept_state.directory.exists());\n     }\n+\n+    /// A checkout last used at `updated_secs`, holding the given rustc session\n+    /// directories for one unit.\n+    fn checkout_with_sessions(\n+        cache: &Path,\n+        key: &str,\n+        updated_secs: u64,\n+        unit: &str,\n+        sessions: &[&str],\n+    ) -> PathBuf {\n+        let directory = cache.join(key);\n+        for session in sessions {\n+            let session = directory.join(unit).join(\"widget-0abc\").join(session);\n+            std::fs::create_dir_all(&session).unwrap();\n+            std::fs::write(session.join(\"dep-graph.bin\"), key).unwrap();\n+            let lock = session_lock_name(session.file_name().unwrap()).unwrap();\n+            std::fs::write(session.with_file_name(lock), b\"\").unwrap();\n+        }\n+        std::fs::create_dir_all(&directory).unwrap();\n+        let record = CheckoutRecord {\n+            version: RECORD_VERSION,\n+            workspace_root: PathBuf::from(format!(\"/work/{key}\")),\n+            updated_secs,\n+        };\n+        std::fs::write(\n+            directory.join(RECORD_FILE),\n+            serde_json::to_vec(&record).unwrap(),\n+        )\n+        .unwrap();\n+        directory\n+    }\n+\n+    #[test]\n+    fn seeding_copies_the_newest_finished_state_of_another_checkout() {\n+        let cache = tempfile::tempdir().unwrap();\n+        let unit = \"blake3/0123456789\";\n+        let own = checkout_with_sessions(cache.path(), \"own\", 40, unit, &[]);\n+        checkout_with_sessions(cache.path(), \"older\", 10, unit, &[\"s-1-a-finished\"]);\n+        checkout_with_sessions(cache.path(), \"newer\", 20, unit, &[\"s-2-b-finished\"]);\n+        // The most recent, but its compiler is still writing its only session.\n+        checkout_with_sessions(cache.path(), \"busy\", 30, unit, &[\"s-3-c-working\"]);\n+        checkout_with_sessions(\n+            cache.path(),\n+            \"other\",\n+            50,\n+            \"blake3/9876543210\",\n+            &[\"s-4-d-done\"],\n+        );\n+\n+        let donor = seed(&own, unit).unwrap();\n+\n+        assert_eq!(donor, Some(PathBuf::from(\"/work/newer\")));\n+        let copied = own.join(unit).join(\"widget-0abc\");\n+        assert_eq!(\n+            std::fs::read_to_string(copied.join(\"s-2-b-finished/dep-graph.bin\")).unwrap(),\n+            \"newer\"\n+        );\n+        // One session, and its lock file.\n+        assert_eq!(std::fs::read_dir(&copied).unwrap().count(), 2);\n+        #[cfg(unix)]\n+        {\n+            use std::os::unix::fs::MetadataExt as _;\n+            let donor = cache.path().join(\"newer\").join(unit).join(\"widget-0abc\");\n+            let inode = |path: &Path| std::fs::metadata(path).unwrap().ino();\n+            assert_eq!(\n+                inode(&copied.join(\"s-2-b-finished/dep-graph.bin\")),\n+                inode(&donor.join(\"s-2-b-finished/dep-graph.bin\")),\n+                \"state files are shared, not copied\"\n+            );\n+            assert_ne!(\n+                inode(&copied.join(\"s-2-b.lock\")),\n+                inode(&donor.join(\"s-2-b.lock\")),\n+                \"lock files are not shared\"\n+            );\n+        }\n+        assert_eq!(\n+            std::fs::read_dir(own.join(\"blake3\")).unwrap().count(),\n+            1,\n+            \"no staging directory is left behind\"\n+        );\n+    }\n+\n+    #[test]\n+    fn seeding_leaves_unfinished_sessions_and_unknown_units_alone() {\n+        let cache = tempfile::tempdir().unwrap();\n+        let unit = \"blake3/0123456789\";\n+        let own = checkout_with_sessions(cache.path(), \"own\", 40, unit, &[]);\n+        checkout_with_sessions(\n+            cache.path(),\n+            \"donor\",\n+            20,\n+            unit,\n+            &[\"s-1-a-finished\", \"s-2-b-working\"],\n+        );\n+\n+        assert_eq!(seed(&own, \"blake3/9999999999\").unwrap(), None);\n+        assert!(!own.join(\"blake3/9999999999\").exists());\n+\n+        seed(&own, unit).unwrap();\n+        let copied = own.join(unit).join(\"widget-0abc\");\n+        assert!(copied.join(\"s-1-a-finished\").is_dir());\n+        assert!(!copied.join(\"s-2-b-working\").exists());\n+    }\n+\n+    /// Hold `session`'s lock the way rustc does while it removes the session.\n+    fn lock_exclusively(checkout: &Path, unit: &str, session: &str) -> std::fs::File {\n+        let lock = checkout\n+            .join(unit)\n+            .join(\"widget-0abc\")\n+            .join(session_lock_name(std::ffi::OsStr::new(session)).unwrap());\n+        let file = std::fs::OpenOptions::new()\n+            .read(true)\n+            .write(true)\n+            .open(lock)\n+            .unwrap();\n+        file.try_lock().unwrap();\n+        file\n+    }\n+\n+    #[test]\n+    fn seeding_leaves_out_a_session_the_donor_is_removing() {\n+        let cache = tempfile::tempdir().unwrap();\n+        let unit = \"blake3/0123456789\";\n+        let own = checkout_with_sessions(cache.path(), \"own\", 40, unit, &[]);\n+        let donor = checkout_with_sessions(\n+            cache.path(),\n+            \"donor\",\n+            20,\n+            unit,\n+            &[\"s-1-a-superseded\", \"s-2-b-current\"],\n+        );\n+        let _removing = lock_exclusively(&donor, unit, \"s-1-a-superseded\");\n+\n+        seed(&own, unit).unwrap();\n+\n+        let copied = own.join(unit).join(\"widget-0abc\");\n+        assert!(copied.join(\"s-2-b-current\").is_dir());\n+        assert!(copied.join(\"s-2-b.lock\").is_file());\n+        assert!(!copied.join(\"s-1-a-superseded\").exists());\n+        assert!(!copied.join(\"s-1-a.lock\").exists());\n+    }\n+\n+    #[test]\n+    fn seeding_falls_back_to_another_donor_when_one_has_nothing_to_give() {\n+        let cache = tempfile::tempdir().unwrap();\n+        let unit = \"blake3/0123456789\";\n+        let own = checkout_with_sessions(cache.path(), \"own\", 40, unit, &[]);\n+        checkout_with_sessions(cache.path(), \"older\", 10, unit, &[\"s-1-a-finished\"]);\n+        let busy = checkout_with_sessions(cache.path(), \"newer\", 20, unit, &[\"s-2-b-finished\"]);\n+        let _removing = lock_exclusively(&busy, unit, \"s-2-b-finished\");\n+\n+        assert_eq!(\n+            seed(&own, unit).unwrap(),\n+            Some(PathBuf::from(\"/work/older\"))\n+        );\n+        assert!(\n+            own.join(unit)\n+                .join(\"widget-0abc\")\n+                .join(\"s-1-a-finished\")\n+                .is_dir()\n+        );\n+        assert_eq!(\n+            std::fs::read_dir(own.join(\"blake3\")).unwrap().count(),\n+            1,\n+            \"the abandoned copy is cleaned up\"\n+        );\n+    }\n+\n+    #[test]\n+    fn a_crate_named_s_is_seeded_too() {\n+        let cache = tempfile::tempdir().unwrap();\n+        let unit = \"blake3/0123456789\";\n+        let own = checkout_with_sessions(cache.path(), \"own\", 40, unit, &[]);\n+        let donor = cache.path().join(\"donor\");\n+        let krate = donor.join(unit).join(\"s-0abc\");\n+        std::fs::create_dir_all(krate.join(\"s-1-a-finished\")).unwrap();\n+        std::fs::write(krate.join(\"s-1-a-finished/dep-graph.bin\"), b\"s\").unwrap();\n+        std::fs::write(krate.join(\"s-1-a.lock\"), b\"\").unwrap();\n+        let record = CheckoutRecord {\n+            version: RECORD_VERSION,\n+            workspace_root: PathBuf::from(\"/work/donor\"),\n+            updated_secs: 20,\n+        };\n+        std::fs::write(\n+            donor.join(RECORD_FILE),\n+            serde_json::to_vec(&record).unwrap(),\n+        )\n+        .unwrap();\n+\n+        assert_eq!(\n+            seed(&own, unit).unwrap(),\n+            Some(PathBuf::from(\"/work/donor\"))\n+        );\n+        assert!(\n+            own.join(unit)\n+                .join(\"s-0abc/s-1-a-finished/dep-graph.bin\")\n+                .is_file()\n+        );\n+    }\n+\n+    #[test]\n+    fn a_checkout_never_seeds_from_itself() {\n+        let cache = tempfile::tempdir().unwrap();\n+        let unit = \"blake3/0123456789\";\n+        let own = checkout_with_sessions(cache.path(), \"own\", 40, unit, &[\"s-1-a-finished\"]);\n+        std::fs::remove_dir_all(own.join(unit)).unwrap();\n+\n+        assert_eq!(seed(&own, unit).unwrap(), None);\n+    }\n }"},{"sha":"292f43869b20e7738e90a23e5bc2207b7bdb8504","filename":"crates/mbx/src/main.rs","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fmain.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fmain.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fmain.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -19,6 +19,9 @@ fn main() -> ExitCode {\n     if mbx::session::is_rustc_shim() {\n         return mbx::session::run_rustc_shim();\n     }\n+    if mbx::session::is_configured_as_rustc_wrapper() {\n+        return mbx::session::reject_configured_rustc_wrapper();\n+    }\n     if mbx::session::is_rustdoc_shim() {\n         return mbx::session::run_rustdoc_shim();\n     }"},{"sha":"74a4fbae902bca918f515a8c5a6fda598bcc2d1e","filename":"crates/mbx/src/materialize.rs","status":"modified","additions":51,"deletions":0,"changes":51,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fmaterialize.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fmaterialize.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fmaterialize.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -382,7 +382,34 @@ fn readable_by_owner(mode: u32) -> bool {\n }\n \n /// Give a file the modification time a compiler writing it now would.\n+///\n+/// On Unix the kernel picks the time (`UTIME_NOW`), so the stamp comes from the\n+/// same coarse clock that stamps every later write. An explicit\n+/// `SystemTime::now()` reads a finer clock and can land up to one tick ahead of\n+/// a write Cargo makes right after the restore, which leaves that newer file\n+/// looking older than the restored one and reruns the build script.\n pub(crate) fn set_modified_now(path: &Path) -> Result<()> {\n+    #[cfg(unix)]\n+    {\n+        use std::os::unix::io::AsRawFd as _;\n+        let file = std::fs::OpenOptions::new().read(true).open(path)?;\n+        let omit = libc::timespec {\n+            tv_sec: 0,\n+            tv_nsec: libc::UTIME_OMIT,\n+        };\n+        let now = libc::timespec {\n+            tv_sec: 0,\n+            tv_nsec: libc::UTIME_NOW,\n+        };\n+        let times = [omit, now];\n+        // SAFETY: `file` is an open descriptor and `times` holds the two\n+        // timespecs futimens reads (access, then modification).\n+        if unsafe { libc::futimens(file.as_raw_fd(), times.as_ptr()) } != 0 {\n+            return Err(std::io::Error::last_os_error().into());\n+        }\n+        Ok(())\n+    }\n+    #[cfg(not(unix))]\n     set_modified(path, std::time::SystemTime::now())\n }\n \n@@ -678,7 +705,10 @@ pub(crate) fn make_owner_writable(path: &Path) -> Result<()> {\n     Ok(())\n }\n \n+// The lint warns that this makes a Unix file world-writable. Windows has no\n+// such mode: it clears only the read-only attribute.\n #[cfg(windows)]\n+#[allow(clippy::permissions_set_readonly_false)]\n pub(crate) fn make_owner_writable(path: &Path) -> Result<()> {\n     let mut permissions = std::fs::metadata(path)?.permissions();\n     permissions.set_readonly(false);\n@@ -1195,6 +1225,27 @@ mod materialization_tests {\n         );\n     }\n \n+    #[cfg(unix)]\n+    #[test]\n+    fn a_restore_stamp_is_never_ahead_of_a_write_that_follows_it() {\n+        // Cargo writes `invoked.timestamp` right after a restore and treats a\n+        // restored binary newer than it as a rebuilt dependency, so the stamp\n+        // must come from the clock the kernel uses for ordinary writes.\n+        let root = tempfile::tempdir().unwrap();\n+        for i in 0..500 {\n+            let restored = root.path().join(format!(\"restored-{i}\"));\n+            let written = root.path().join(format!(\"written-{i}\"));\n+            std::fs::write(&restored, b\"bin\").unwrap();\n+            set_modified_now(&restored).unwrap();\n+            std::fs::write(&written, b\"ts\").unwrap();\n+            assert!(\n+                std::fs::metadata(&written).unwrap().modified().unwrap()\n+                    >= std::fs::metadata(&restored).unwrap().modified().unwrap(),\n+                \"iteration {i}: the restore stamp is ahead of a later write\"\n+            );\n+        }\n+    }\n+\n     #[test]\n     fn an_output_already_in_place_can_be_marked_restored_while_read_only() {\n         let root = tempfile::tempdir().unwrap();"},{"sha":"4fc2a15508f83b858e2d3ad380f3d3c0b49a199e","filename":"crates/mbx/src/out_dir.rs","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fout_dir.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fout_dir.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fout_dir.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -751,6 +751,8 @@ fn remove_tree(path: &Path) -> std::io::Result<()> {\n                     pending.push(entry.path());\n                 } else {\n                     let mut permissions = entry.metadata()?.permissions();\n+                    // Not Unix, so this clears only the read-only attribute.\n+                    #[allow(clippy::permissions_set_readonly_false)]\n                     permissions.set_readonly(false);\n                     std::fs::set_permissions(entry.path(), permissions)?;\n                 }"},{"sha":"a9bd39099332a0e455614a90e657ae44e8c541ff","filename":"crates/mbx/src/policy.rs","status":"modified","additions":39,"deletions":11,"changes":50,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fpolicy.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fpolicy.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fpolicy.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -14,16 +14,22 @@ pub(crate) fn is_ci() -> bool {\n \n /// Resolve the remote-cache mode that is actually permitted here.\n ///\n-/// Returns `None` when the configured mode leaves nothing to do.\n-pub fn effective_remote_cache_mode(configured: RemoteCacheMode) -> Option<RemoteCacheMode> {\n-    effective_remote_cache_mode_with(configured, |name| std::env::var(name).ok())\n+/// `trust_writes` is the operator's statement that this build is trusted, for CI\n+/// systems the policy cannot recognize. Returns `None` when the configured mode\n+/// leaves nothing to do.\n+pub fn effective_remote_cache_mode(\n+    configured: RemoteCacheMode,\n+    trust_writes: bool,\n+) -> Option<RemoteCacheMode> {\n+    effective_remote_cache_mode_with(configured, trust_writes, |name| std::env::var(name).ok())\n }\n \n fn effective_remote_cache_mode_with(\n     configured: RemoteCacheMode,\n+    trust_writes: bool,\n     get_env: impl Fn(&str) -> Option<String>,\n ) -> Option<RemoteCacheMode> {\n-    if trusted_cache_writer(&get_env) {\n+    if trust_writes || trusted_cache_writer(&get_env) {\n         return Some(configured);\n     }\n     match configured {\n@@ -98,11 +104,11 @@ mod tests {\n     fn untrusted_contexts_only_read() {\n         let local = env(&[]);\n         assert_eq!(\n-            effective_remote_cache_mode_with(RemoteCacheMode::ReadWrite, &local),\n+            effective_remote_cache_mode_with(RemoteCacheMode::ReadWrite, false, &local),\n             Some(RemoteCacheMode::ReadOnly)\n         );\n         assert_eq!(\n-            effective_remote_cache_mode_with(RemoteCacheMode::WriteOnly, &local),\n+            effective_remote_cache_mode_with(RemoteCacheMode::WriteOnly, false, &local),\n             None\n         );\n     }\n@@ -116,7 +122,7 @@ mod tests {\n             (\"GITHUB_REF_PROTECTED\", \"true\"),\n         ]);\n         assert_eq!(\n-            effective_remote_cache_mode_with(RemoteCacheMode::ReadWrite, &ci),\n+            effective_remote_cache_mode_with(RemoteCacheMode::ReadWrite, false, &ci),\n             Some(RemoteCacheMode::ReadWrite)\n         );\n     }\n@@ -130,7 +136,7 @@ mod tests {\n             (\"GITHUB_REF_PROTECTED\", \"true\"),\n         ]);\n         assert_eq!(\n-            effective_remote_cache_mode_with(RemoteCacheMode::ReadWrite, &pull_request),\n+            effective_remote_cache_mode_with(RemoteCacheMode::ReadWrite, false, &pull_request),\n             Some(RemoteCacheMode::ReadOnly)\n         );\n     }\n@@ -144,7 +150,7 @@ mod tests {\n             (\"CI_COMMIT_REF_PROTECTED\", \"true\"),\n         ]);\n         assert_eq!(\n-            effective_remote_cache_mode_with(RemoteCacheMode::ReadWrite, &merge_request),\n+            effective_remote_cache_mode_with(RemoteCacheMode::ReadWrite, false, &merge_request),\n             Some(RemoteCacheMode::ReadOnly)\n         );\n     }\n@@ -159,7 +165,7 @@ mod tests {\n             (\"GITHUB_REF_PROTECTED\", \"true\"),\n         ]);\n         assert_eq!(\n-            effective_remote_cache_mode_with(RemoteCacheMode::ReadWrite, &release),\n+            effective_remote_cache_mode_with(RemoteCacheMode::ReadWrite, false, &release),\n             Some(RemoteCacheMode::ReadWrite)\n         );\n \n@@ -169,11 +175,33 @@ mod tests {\n             (\"GITHUB_REF_TYPE\", \"tag\"),\n         ]);\n         assert_eq!(\n-            effective_remote_cache_mode_with(RemoteCacheMode::ReadWrite, &tag),\n+            effective_remote_cache_mode_with(RemoteCacheMode::ReadWrite, false, &tag),\n             Some(RemoteCacheMode::ReadOnly)\n         );\n     }\n \n+    #[test]\n+    fn trust_writes_skips_the_ci_policy() {\n+        let pull_request = env(&[\n+            (\"GITHUB_ACTIONS\", \"true\"),\n+            (\"GITHUB_EVENT_NAME\", \"pull_request\"),\n+        ]);\n+        for ci in [&env(&[]), &pull_request] {\n+            assert_eq!(\n+                effective_remote_cache_mode_with(RemoteCacheMode::ReadWrite, true, ci),\n+                Some(RemoteCacheMode::ReadWrite)\n+            );\n+            assert_eq!(\n+                effective_remote_cache_mode_with(RemoteCacheMode::WriteOnly, true, ci),\n+                Some(RemoteCacheMode::WriteOnly)\n+            );\n+            assert_eq!(\n+                effective_remote_cache_mode_with(RemoteCacheMode::ReadOnly, true, ci),\n+                Some(RemoteCacheMode::ReadOnly)\n+            );\n+        }\n+    }\n+\n     #[test]\n     fn ci_never_compiles_incrementally() {\n         assert!(!incremental_allowed_with(true, env(&[(\"CI\", \"true\")])));"},{"sha":"b9f947aaa2210438ec4800313ced081da2e10f76","filename":"crates/mbx/src/rustc.rs","status":"modified","additions":213,"deletions":24,"changes":237,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Frustc.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Frustc.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Frustc.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -5,7 +5,7 @@ use crate::materialize::{\n     record_action_hit_with_diagnostic, record_verification, replay_bytes, resolve_executable,\n     stage_verified_cached_output, staging_directory, validate_file_mode,\n };\n-use crate::{session, util::workspace_root};\n+use crate::{incremental, session, util::workspace_root};\n use eyre::{Context, Result, bail};\n use mbx_cache_core::{\n     ActionDiagnostic, ActionPrediction, AgentRequest, AgentResponse, CacheDigest, CacheDirectory,\n@@ -66,10 +66,16 @@ struct LearnedPlan {\n }\n \n impl LearnedPlan {\n-    /// Find somewhere to keep the state, for a unit that earned it.\n-    fn resolved(mut self, invocation: &CacheDigest, crate_name: &str) -> Self {\n+    /// Find somewhere to keep the state, for a unit that earned it. State\n+    /// that does not depend on the checkout's location may start from another\n+    /// checkout's; see [`incremental::seed`].\n+    fn resolved(mut self, compilation: &Compilation<'_>, unit: &CacheDigest) -> Self {\n         if self.hot {\n-            self.directory = incremental_directory(invocation, crate_name);\n+            self.directory = incremental_directory(\n+                unit,\n+                compilation.invocation.crate_name(),\n+                shares_incremental_state(compilation.rustc, compilation.invocation),\n+            );\n         }\n         self\n     }\n@@ -499,9 +505,14 @@ pub(crate) fn compile(\n     // The machine-wide permit is taken after every chance to hit the cache,\n     // and before anything expensive starts. The timer starts afterwards: time\n     // spent waiting for the machine is not time this compilation cost.\n-    let demand =\n-        crate::scheduler::Demand::new(invocation.crate_name(), invocation.links_natively())\n-            .with_link_profile(&profile_arguments(&arguments));\n+    let (demand, incremental_flag) = compiler_demand(\n+        invocation.crate_name(),\n+        invocation.links_natively(),\n+        rustc,\n+        &arguments,\n+        learned.directory.as_deref(),\n+        wrapper_argument,\n+    );\n     let permit = crate::scheduler::pool().and_then(|pool| pool.admit(&demand));\n     // Capture these after admission: an edit while this compile waits for\n     // capacity happened before rustc ran and belongs to the valid compilation\n@@ -515,14 +526,16 @@ pub(crate) fn compile(\n     let compilation_started = SystemTime::now();\n     let compiler_timer = Instant::now();\n     let mut command = compiler_command(rustc, wrapper_argument);\n-    command.args(&arguments).current_dir(&working_dir);\n+    if incremental_flag.is_some() && shares_incremental_state(rustc, &invocation) {\n+        command.args(paths_relative_to(&arguments, &working_dir));\n+    } else {\n+        command.args(&arguments);\n+    }\n+    command.current_dir(&working_dir);\n     let private_outputs = private_inputs || learned.engaged();\n-    if let Some(directory) = learned.directory.as_deref() {\n-        // Appended here rather than to the parsed argument vector: the parser\n-        // treats incremental state as uncacheable and would bypass the whole\n-        // compilation, which is the opposite of what this is for.\n-        let mut flag = OsString::from(\"-Cincremental=\");\n-        flag.push(directory);\n+    if let Some(flag) = incremental_flag {\n+        // Keep private incremental state out of cacheability parsing, while\n+        // admission above still sees the command that actually runs.\n         command.arg(flag);\n     }\n     if private_outputs {\n@@ -1007,6 +1020,26 @@ fn profile_arguments(arguments: &[OsString]) -> Vec<OsString> {\n     RustcInvocation::expand_arguments(arguments).unwrap_or_else(|_| arguments.to_vec())\n }\n \n+/// `wrapper_argument` is set only when `rustc` is clippy-driver, which is\n+/// handed the real rustc and compiles in its own process.\n+fn compiler_demand(\n+    name: &str,\n+    links: bool,\n+    rustc: &OsStr,\n+    arguments: &[OsString],\n+    incremental_directory: Option<&Path>,\n+    wrapper_argument: Option<&OsStr>,\n+) -> (crate::scheduler::Demand, Option<OsString>) {\n+    let flag = incremental_directory.map(private_incremental_flag);\n+    let demand = crate::scheduler::Demand::new(name, links).with_compiler_execution(\n+        &profile_arguments(arguments),\n+        flag.as_deref(),\n+        session::compiler_runs_through_wrapper(rustc),\n+        wrapper_argument.is_some(),\n+    );\n+    (demand, flag)\n+}\n+\n /// Compile a build script whose native link cannot be action-cached, then\n /// install the execution-cache launcher keyed by its compilation action.\n fn compile_execution_only_build_script(\n@@ -1018,8 +1051,14 @@ fn compile_execution_only_build_script(\n     outputs: &RustcOutputs,\n     portable: &Portable,\n ) -> Result<ExitCode> {\n-    let demand = crate::scheduler::Demand::new(invocation.crate_name(), true)\n-        .with_link_profile(&profile_arguments(arguments));\n+    let (demand, _) = compiler_demand(\n+        invocation.crate_name(),\n+        true,\n+        rustc,\n+        arguments,\n+        None,\n+        wrapper_argument,\n+    );\n     let permit = crate::scheduler::pool().and_then(|pool| pool.admit(&demand));\n     let required_inputs = invocation.required_inputs_in(working_dir);\n     let source = working_dir.join(invocation.source());\n@@ -1227,6 +1266,109 @@ fn compiler_command(rustc: &OsStr, wrapper_argument: Option<&OsStr>) -> Command\n     command\n }\n \n+/// The arguments with every path under the working directory named relative\n+/// to it.\n+///\n+/// rustc checks incremental state against its options and records where it\n+/// found upstream crates and wrote its outputs; state recorded with other\n+/// paths is ignored or mostly recompiled. Each checkout has its own target\n+/// directory, so the absolute paths in a compilation -- search paths, extern\n+/// crates, the output directory, mbx's own `OUT_DIR` remapping -- differ\n+/// between checkouts even where nothing else does. Relative to the working\n+/// directory, which `-Zremap-cwd-prefix` keeps out of the state, they are the\n+/// same in each, and they still name this checkout's files.\n+///\n+/// Only the command that runs changes: the key resolves relative paths against\n+/// the working directory too. See [`relative_in`] for what counts as a path.\n+fn paths_relative_to(arguments: &[OsString], working_dir: &Path) -> Vec<OsString> {\n+    let Some(root) = working_dir.to_str() else {\n+        return arguments.to_vec();\n+    };\n+    let mut rewritten = Vec::with_capacity(arguments.len());\n+    let mut previous = None;\n+    for argument in arguments {\n+        let Some(text) = argument.to_str() else {\n+            previous = None;\n+            rewritten.push(argument.clone());\n+            continue;\n+        };\n+        let value = if previous == Some(\"--remap-path-prefix\") {\n+            remap_relative_in(text, root)\n+        } else if let Some(remap) = text.strip_prefix(\"--remap-path-prefix=\") {\n+            format!(\"--remap-path-prefix={}\", remap_relative_in(remap, root))\n+        } else if text.starts_with(\"-Zremap-cwd-prefix\")\n+            || (previous == Some(\"-Z\") && text.starts_with(\"remap-cwd-prefix\"))\n+        {\n+            // The virtual directory written in the working directory's place.\n+            text.to_owned()\n+        } else if is_link_option(text, previous) {\n+            // Only the linker reads these, and rustc leaves them out of what\n+            // its state is checked against. They can also embed a path in the\n+            // output, such as an rpath, which has to stay absolute.\n+            text.to_owned()\n+        } else {\n+            relative_in(text, root)\n+        };\n+        previous = Some(text);\n+        rewritten.push(OsString::from(value));\n+    }\n+    rewritten\n+}\n+\n+/// `-C link-arg`, `-C link-args`, `-C linker`, and `-Z pre-link-arg(s)`,\n+/// attached or after a separate `-C`/`-Z`.\n+fn is_link_option(text: &str, previous: Option<&str>) -> bool {\n+    const CODEGEN: [&str; 2] = [\"link-arg\", \"linker\"];\n+    const UNSTABLE: [&str; 1] = [\"pre-link-arg\"];\n+    let starts = |value: &str, names: &[&str]| names.iter().any(|name| value.starts_with(name));\n+    text.strip_prefix(\"-C\")\n+        .is_some_and(|value| starts(value, &CODEGEN))\n+        || text\n+            .strip_prefix(\"-Z\")\n+            .is_some_and(|value| starts(value, &UNSTABLE))\n+        || (previous == Some(\"-C\") && starts(text, &CODEGEN))\n+        || (previous == Some(\"-Z\") && starts(text, &UNSTABLE))\n+}\n+\n+/// A `--remap-path-prefix` value with its source made relative. rustc splits\n+/// it at the last `=`, and the destination is the literal text recorded in the\n+/// source's place, not a path to open, so it stays as written.\n+fn remap_relative_in(remap: &str, root: &str) -> String {\n+    match remap.rsplit_once('=') {\n+        Some((from, to)) => format!(\"{}={to}\", relative_in(from, root)),\n+        None => remap.to_owned(),\n+    }\n+}\n+\n+/// `text` with the working directory written as `.` wherever a path starts:\n+/// at the beginning, or after `=` or `,`. `./` rather than nothing keeps a\n+/// shortened executable, such as a linker, from being looked up on `PATH`.\n+fn relative_in(text: &str, root: &str) -> String {\n+    let mut rewritten = String::with_capacity(text.len());\n+    let mut rest = text;\n+    let mut at_start = true;\n+    while !rest.is_empty() {\n+        if at_start\n+            && let Some(after) = rest.strip_prefix(root)\n+            // Windows accepts either separator, and Cargo can mix them.\n+            && after\n+                .chars()\n+                .next()\n+                .is_none_or(|next| std::path::is_separator(next) || matches!(next, '=' | ','))\n+        {\n+            rewritten.push('.');\n+            rest = after;\n+        }\n+        let Some(next) = rest.chars().next() else {\n+            break;\n+        };\n+        rewritten.push(next);\n+        rest = &rest[next.len_utf8()..];\n+        at_start = matches!(next, '=' | ',');\n+    }\n+    rewritten\n+}\n+\n /// The executable Cargo will run as a build script, when this compilation\n /// produced one; see [`session::is_cargo_build_script`].\n fn cargo_build_script_executable<'a>(\n@@ -1290,16 +1432,59 @@ fn learned_plan(\n     }\n }\n \n+/// Whether one checkout's incremental state for this compilation is as good as\n+/// another's, so that it can be seeded from one and its paths made relative.\n+///\n+/// That takes `-Zremap-cwd-prefix`, and a rustc that checks its state against\n+/// the working directory as the flag presents it, which it first does in 1.98.\n+/// Earlier releases compare the real directory and ignore state recorded in\n+/// any other checkout, so copying it would only cost time and disk.\n+fn shares_incremental_state(rustc: &OsStr, invocation: &RustcInvocation) -> bool {\n+    invocation.remaps_working_directory()\n+        && compiler_identity(rustc)\n+            .is_ok_and(|identity| release_at_least(&identity.rustc_version, (1, 98)))\n+}\n+\n+/// Whether a [`CompilerIdentity::rustc_version`] names `minimum` or later, by\n+/// its `rustc <major>.<minor>.<patch>` line.\n+fn release_at_least(rustc_version: &str, minimum: (u32, u32)) -> bool {\n+    let Some(release) = rustc_version\n+        .split(['\\n', ';'])\n+        .find_map(|line| line.trim().strip_prefix(\"rustc \"))\n+    else {\n+        return false;\n+    };\n+    let mut parts = release.split(|c: char| !c.is_ascii_digit());\n+    let mut next = || parts.next().and_then(|part| part.parse::<u32>().ok());\n+    matches!((next(), next()), (Some(major), Some(minor)) if (major, minor) >= minimum)\n+}\n+\n /// Where one unit keeps its incremental state.\n ///\n /// A session gives it a persistent per-checkout root outside Cargo's target\n /// directory. A standalone shim falls back to its target directory when one is\n /// available, and compiles normally when it has nowhere to put state.\n-pub(crate) fn incremental_directory(invocation: &CacheDigest, crate_name: &str) -> Option<PathBuf> {\n+///\n+/// A `seedable` unit starting without state here takes another checkout's\n+/// first, so the checkout's first edit to it compiles incrementally too.\n+pub(crate) fn incremental_directory(\n+    invocation: &CacheDigest,\n+    crate_name: &str,\n+    seedable: bool,\n+) -> Option<PathBuf> {\n     let root = incremental_root()?;\n     let key = invocation.key();\n     let shard = key.get(..16)?;\n     let directory = root.join(shard);\n+    if seedable\n+        && !directory.exists()\n+        && let Err(error) = incremental::seed(&root, shard)\n+    {\n+        // Compiles from scratch, as it would have without a donor.\n+        session::report_shim_warning(&format!(\n+            \"incremental state for {crate_name} was not seeded: {error:#}\"\n+        ));\n+    }\n     match prepare_incremental_directory(&directory, session::learned_incremental_max_size()) {\n         Ok(discarded) => {\n             if let Some(bytes) = discarded {\n@@ -1321,6 +1506,12 @@ pub(crate) fn incremental_directory(invocation: &CacheDigest, crate_name: &str)\n     }\n }\n \n+fn private_incremental_flag(directory: &Path) -> OsString {\n+    let mut flag = OsString::from(\"-Cincremental=\");\n+    flag.push(directory);\n+    flag\n+}\n+\n /// The incremental flag for a workspace library that mbx cannot cache.\n ///\n /// A `staticlib`, `cdylib`, or `dylib` bypasses the cache before any learned\n@@ -1365,10 +1556,8 @@ pub(crate) fn bypassed_library_incremental_flag(arguments: &[OsString]) -> Optio\n         identity.extend_from_slice(argument.as_encoded_bytes());\n         identity.push(0);\n     }\n-    let directory = incremental_directory(&CacheDigest::blake3(&identity), &crate_name)?;\n-    let mut flag = OsString::from(\"-Cincremental=\");\n-    flag.push(directory);\n-    Some(flag)\n+    let directory = incremental_directory(&CacheDigest::blake3(&identity), &crate_name, false)?;\n+    Some(private_incremental_flag(&directory))\n }\n \n /// Make sure the unit's state directory exists and is inside its budget.\n@@ -1452,7 +1641,7 @@ fn plan_learned_reuse(\n             record: Some((state_path, sources)),\n             ..plan\n         }\n-        .resolved(&unit, compilation.invocation.crate_name()))\n+        .resolved(compilation, &unit))\n     })();\n     match planned {\n         Ok(plan) => plan,\n@@ -1582,7 +1771,7 @@ fn eager_incremental_plan(compilation: &Compilation<'_>) -> LearnedPlan {\n                 hot: true,\n                 ..LearnedPlan::default()\n             }\n-            .resolved(&unit, compilation.invocation.crate_name()),\n+            .resolved(compilation, &unit),\n         )\n     })();\n     planned.unwrap_or_else(|error| {\n@@ -1648,7 +1837,7 @@ fn reuse_hot_workspace_plan(\n             directory: None,\n             record: Some((state_path, sources)),\n         }\n-        .resolved(&unit, compilation.invocation.crate_name()))\n+        .resolved(compilation, &unit))\n     })();\n     match planned {\n         Ok(plan) => plan,"},{"sha":"8f7a9f91976f96938e66b43b9e19fe705e431e14","filename":"crates/mbx/src/rustc_tests.rs","status":"modified","additions":164,"deletions":0,"changes":164,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Frustc_tests.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Frustc_tests.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Frustc_tests.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -1748,3 +1748,167 @@ fn relative_external_native_paths_are_mapped_from_the_working_directory() {\n         .unwrap()\n     );\n }\n+\n+#[test]\n+fn learned_incremental_demand_uses_the_flag_appended_to_the_command() {\n+    let args = vec![OsString::from(\"--emit=metadata\")];\n+    let directory = Path::new(\"private-incremental\");\n+    let (demand, flag) = compiler_demand(\n+        \"crate\",\n+        false,\n+        OsStr::new(\"rustc\"),\n+        &args,\n+        Some(directory),\n+        None,\n+    );\n+    assert_eq!(\n+        flag,\n+        Some(OsString::from(\"-Cincremental=private-incremental\"))\n+    );\n+    assert!(\n+        demand\n+            .compile_mode_key()\n+            .unwrap()\n+            .contains(\"incremental-on\")\n+    );\n+    let (cold, flag) = compiler_demand(\"crate\", false, OsStr::new(\"rustc\"), &args, None, None);\n+    assert!(flag.is_none());\n+    assert!(cold.compile_mode_key().unwrap().contains(\"incremental-off\"));\n+    assert_ne!(demand.compile_mode_key(), cold.compile_mode_key());\n+}\n+\n+#[test]\n+fn cached_clippy_compiles_count_samples_under_their_own_mode() {\n+    let args = vec![OsString::from(\"--emit=metadata\")];\n+    let clippy_driver = OsStr::new(\"clippy-driver\");\n+    let (clippy, _) = compiler_demand(\n+        \"crate\",\n+        false,\n+        clippy_driver,\n+        &args,\n+        None,\n+        Some(OsStr::new(\"rustc\")),\n+    );\n+    let (check, _) = compiler_demand(\"crate\", false, OsStr::new(\"rustc\"), &args, None, None);\n+    assert!(clippy.counts_compile_samples());\n+    assert!(check.counts_compile_samples());\n+    assert_ne!(clippy.compile_mode_key(), check.compile_mode_key());\n+}\n+\n+#[test]\n+fn paths_under_the_working_directory_become_relative() {\n+    let working_dir = Path::new(\"/work/checkout\");\n+    let rewrite = |arguments: &[&str]| -> Vec<String> {\n+        let arguments: Vec<OsString> = arguments.iter().map(OsString::from).collect();\n+        paths_relative_to(&arguments, working_dir)\n+            .into_iter()\n+            .map(|argument| argument.into_string().unwrap())\n+            .collect()\n+    };\n+\n+    assert_eq!(\n+        rewrite(&[\n+            \"--crate-name\",\n+            \"render\",\n+            \"crates/render/src/lib.rs\",\n+            \"-L\",\n+            \"dependency=/work/checkout/target/debug/deps\",\n+            \"-Lnative=/work/checkout/target/debug/build/blake3-0abc/out\",\n+            \"--extern\",\n+            \"bevy=/work/checkout/target/debug/deps/libbevy-0abc.rmeta\",\n+            \"--extern=log=/work/checkout/target/debug/deps/liblog-0abc.rmeta\",\n+            \"--out-dir\",\n+            \"/work/checkout/target/debug/deps\",\n+            \"--remap-path-prefix=/work/checkout/target/debug/build/render-0abc/out=${target}/out\",\n+            \"--remap-path-prefix=/work/checkout=${workspace}\",\n+            \"--remap-path-prefix\",\n+            \"/work/checkout/vendor=/vendor\",\n+            \"--emit=dep-info=/work/checkout/target/debug/deps/render.d\",\n+        ]),\n+        [\n+            \"--crate-name\",\n+            \"render\",\n+            \"crates/render/src/lib.rs\",\n+            \"-L\",\n+            \"dependency=./target/debug/deps\",\n+            \"-Lnative=./target/debug/build/blake3-0abc/out\",\n+            \"--extern\",\n+            \"bevy=./target/debug/deps/libbevy-0abc.rmeta\",\n+            \"--extern=log=./target/debug/deps/liblog-0abc.rmeta\",\n+            \"--out-dir\",\n+            \"./target/debug/deps\",\n+            \"--remap-path-prefix=./target/debug/build/render-0abc/out=${target}/out\",\n+            \"--remap-path-prefix=.=${workspace}\",\n+            \"--remap-path-prefix\",\n+            \"./vendor=/vendor\",\n+            // `./` rather than nothing, so a path never turns into a name.\n+            \"--emit=dep-info=./target/debug/deps/render.d\",\n+        ]\n+    );\n+    // Elsewhere, including a path that merely contains the working directory,\n+    // one that only shares its name's prefix, a remap destination (the text\n+    // recorded in the source's place), the virtual working directory itself,\n+    // and what only the linker reads -- which can embed a path, such as an\n+    // rpath, that must stay absolute -- stays as it was.\n+    let unrelated = [\n+        \"-Lnative=/opt/homebrew/lib\",\n+        \"--extern=std=/mnt/work/checkout/libstd.rlib\",\n+        \"-L\",\n+        \"/work/checkout-two/target\",\n+        \"--remap-path-prefix=/vendor=/work/checkout/vendor\",\n+        \"--remap-path-prefix\",\n+        \"/vendor=/work/checkout/vendor\",\n+        \"-Zremap-cwd-prefix=/work/checkout\",\n+        \"-Z\",\n+        \"remap-cwd-prefix=/work/checkout\",\n+        \"-Clinker=/work/checkout/tools/clang\",\n+        \"-Clink-arg=-Wl,-rpath,/work/checkout/target/debug/lib\",\n+        \"-C\",\n+        \"link-args=-Wl,-rpath=/work/checkout/lib -L/work/checkout/lib\",\n+        \"-C\",\n+        \"linker=/work/checkout/tools/clang\",\n+        \"-Zpre-link-arg=/work/checkout/crt0.o\",\n+    ];\n+    assert_eq!(rewrite(&unrelated), unrelated);\n+}\n+\n+#[cfg(windows)]\n+#[test]\n+fn windows_paths_under_the_working_directory_become_relative_with_either_separator() {\n+    let working_dir = Path::new(r\"E:\\work\\checkout\");\n+    let arguments: Vec<OsString> = [\n+        r\"dependency=E:\\work\\checkout\\target\\debug\\deps\",\n+        \"--extern=log=E:\\\\work\\\\checkout/target/debug/deps/liblog.rmeta\",\n+        r\"E:\\work\\checkout-two\\target\",\n+    ]\n+    .iter()\n+    .map(OsString::from)\n+    .collect();\n+    assert_eq!(\n+        paths_relative_to(&arguments, working_dir),\n+        [\n+            OsString::from(r\"dependency=.\\target\\debug\\deps\"),\n+            OsString::from(\"--extern=log=./target/debug/deps/liblog.rmeta\"),\n+            OsString::from(r\"E:\\work\\checkout-two\\target\"),\n+        ]\n+    );\n+}\n+\n+#[test]\n+fn relocatable_incremental_state_needs_rustc_1_98() {\n+    // As `query_compiler_identity` keeps it: the version lines of `rustc -vV`.\n+    let identity = |release: &str| {\n+        format!(\n+            \"rustc {release} (88d9e12ae 2026-08-18); commit-hash: 88d9e12ae; LLVM version: 21.1.0\"\n+        )\n+    };\n+    assert!(!release_at_least(&identity(\"1.94.0\"), (1, 98)));\n+    assert!(!release_at_least(&identity(\"1.97.1\"), (1, 98)));\n+    assert!(release_at_least(&identity(\"1.98.0\"), (1, 98)));\n+    assert!(release_at_least(&identity(\"1.101.0-nightly\"), (1, 98)));\n+    assert!(release_at_least(&identity(\"2.0.0\"), (1, 98)));\n+    assert!(\n+        !release_at_least(\"commit-hash: 88d9e12ae\", (1, 98)),\n+        \"no version line\"\n+    );\n+}"},{"sha":"d83e693d5cb1f3f3c9b6247c59d3f51020162789","filename":"crates/mbx/src/scheduler.rs","status":"modified","additions":1604,"deletions":160,"changes":1764,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fscheduler.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fscheduler.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fscheduler.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -17,16 +17,11 @@\n //! by the next admission scan. Admission itself serializes on one registrar\n //! lock, held only long enough to scan and grant.\n //!\n-//! Weights make links and historically memory-heavy crates cost more than one\n-//! permit: the sum of admitted weights never exceeds the capacity, so the\n-//! *predicted* memory of everything running stays inside the configured\n-//! budget. Prediction comes from a small ledger of peak RSS per crate name,\n-//! measured after every real compile on Unix; the static link weight is only\n-//! the guess that stands in until one has been measured. Two things remain\n-//! out of reach and are accepted: a single compilation larger than the\n-//! machine will still be too large when it runs alone, and a simultaneous\n-//! pile-up of never-measured crates can overshoot before the ledger has\n-//! learned them.\n+//! CPU cores and predicted memory bytes are independent budgets. A request\n+//! must fit both, with an empty-scope exception on each dimension so oversize\n+//! work can make progress. Peak-RSS history supplies the memory prediction;\n+//! unmeasured work keeps the original permit-based memory guess. The legacy\n+//! weight and permit size remain in records for older wrappers.\n //!\n //! Concurrent sessions may be configured with different capacities; each\n //! enforces its own bound against the same leases, so the loosest\n@@ -48,6 +43,11 @@\n //! never around the other way, and a waiter blocked on a flight holds no\n //! permit.\n \n+#[path = \"scheduler_accuracy.rs\"]\n+mod accuracy;\n+#[path = \"scheduler_memory.rs\"]\n+mod memory;\n+\n use crate::config::{Config, SchedulerPriority};\n use eyre::{Context, Result};\n use log::debug;\n@@ -64,6 +64,7 @@ use std::time::{Duration, Instant};\n const SCHEDULER_DIR: &str = \"scheduler\";\n /// Subdirectory holding one locked lease file per admitted compilation.\n const LEASES_DIR: &str = \"leases\";\n+const WAITERS_DIR: &str = \"waiters\";\n /// Subdirectory holding one locked flight file per compiling invocation.\n const INFLIGHT_DIR: &str = \"inflight\";\n /// Registrar lock serializing admission scans.\n@@ -97,16 +98,22 @@ pub(crate) const SCHED_DIR_ENV: &str = \"MBX_SCHED_DIR\";\n /// A nested `mbx` command otherwise constructs a new session and re-resolves\n /// configuration, which would replace an inherited empty `MBX_SCHED_DIR`.\n pub(crate) const SCHED_DISABLE_ENV: &str = \"MBX_SCHED_DISABLE\";\n-/// Machine-wide concurrent compile permits.\n+/// Machine-wide CPU budget after reserving cores for other work.\n pub(crate) const SCHED_SLOTS_ENV: &str = \"MBX_SCHED_SLOTS\";\n-/// Memory one permit stands for; zero disables memory weighting.\n+/// Configured CPU count before reserve_cpus, for the local CPU ceiling.\n+const SCHED_CPUS_ENV: &str = \"MBX_SCHED_CPUS\";\n+/// Exact memory budget, independent of legacy permit rounding.\n+const SCHED_MEMORY_BYTES_ENV: &str = \"MBX_SCHED_MEMORY_BYTES\";\n+/// Legacy memory share; zero disables memory predictions.\n pub(crate) const SCHED_SLOT_BYTES_ENV: &str = \"MBX_SCHED_SLOT_BYTES\";\n /// Permit priority of this build's compilations.\n pub(crate) const SCHED_PRIORITY_ENV: &str = \"MBX_SCHED_PRIORITY\";\n /// Identity shared by every compiler shim in one Cargo build.\n const SCHED_PRESSURE_ENV: &str = \"MBX_SCHED_PRESSURE\";\n+/// The session's resolved events gate, including workspace overrides.\n+const SCHED_EVENTS_ENV: &str = \"MBX_SCHED_EVENTS\";\n const SCHED_BUILD_ID_ENV: &str = \"MBX_SCHED_BUILD_ID\";\n-/// Most weighted permits one Cargo build may hold at once.\n+/// Most CPU cores one Cargo build may hold at once.\n const SCHED_BUILD_SLOTS_ENV: &str = \"MBX_SCHED_BUILD_SLOTS\";\n \n /// Schema version of one lease record.\n@@ -129,11 +136,8 @@ const MAX_LEDGER_ENTRIES: usize = 1024;\n /// and a window long enough to remember a toolchain ago would keep quoting a\n /// number nothing here produces any more.\n const MAX_LINK_SAMPLES: usize = 16;\n-/// Measurements the window needs before it may speak for an unmeasured link.\n-///\n-/// One link is an anecdote -- the first one on a machine is as likely to be a\n-/// trivial build script as the program itself -- so the static floor stands\n-/// until a few have been seen.\n+/// Trust threshold used only by the independent old-reader test reference.\n+#[cfg(test)]\n const MIN_LINK_SAMPLES: usize = 3;\n /// Permits a native link costs before it has ever been measured.\n ///\n@@ -237,6 +241,12 @@ pub(crate) struct Demand {\n     profile: Option<String>,\n     /// A nextest test whose measurements belong in its separate history file.\n     per_test: Option<TestIdentity>,\n+    compile_mode: Option<String>,\n+    /// Another wrapper may have returned a cache hit without running rustc.\n+    count_compile_samples: bool,\n+    observation: std::cell::Cell<Option<accuracy::Admission>>,\n+    /// Frozen before waiting; completion residuals must use the prediction’s features.\n+    memory_features: std::cell::Cell<Option<memory::Features>>,\n }\n \n #[derive(Debug, Clone)]\n@@ -257,12 +267,15 @@ impl Demand {\n             threads: Some(1),\n             learns_cpu: false,\n             profile: None,\n+            compile_mode: None,\n+            count_compile_samples: true,\n+            observation: std::cell::Cell::new(None),\n+            memory_features: std::cell::Cell::new(None),\n             per_test: None,\n         }\n     }\n \n-    /// Remember a link apart from the same crate's links under other\n-    /// code-generation settings.\n+    /// Remember links by code-generation profile and non-links by compile mode.\n     ///\n     /// A release build with fat LTO and one codegen unit peaks several times\n     /// higher than a dev link of the same binary, and the ledger never lowers\n@@ -274,10 +287,52 @@ impl Demand {\n             let profile = link_profile(arguments);\n             self.name = format!(\"{} [{profile}]\", self.name);\n             self.profile = Some(profile);\n+        } else {\n+            self.compile_mode = Some(format!(\n+                \"{} [compile {}]\",\n+                self.name,\n+                compile_profile(arguments)\n+            ));\n         }\n         self\n     }\n \n+    /// Build the mode from the effective compiler flags, including a private\n+    /// flag appended by mbx after argument parsing. Wrapper RSS can raise a\n+    /// peak, but cannot establish a successful real-compiler sample.\n+    pub(crate) fn with_compiler_execution(\n+        mut self,\n+        arguments: &[std::ffi::OsString],\n+        appended_flag: Option<&std::ffi::OsStr>,\n+        wrapped: bool,\n+        clippy: bool,\n+    ) -> Self {\n+        let mut effective = arguments.to_vec();\n+        effective.extend(appended_flag.map(std::ffi::OsStr::to_os_string));\n+        self.count_compile_samples = !wrapped;\n+        let mut demand = self.with_link_profile(&effective);\n+        // Clippy runs lint passes a plain check does not, so it learns its own\n+        // estimate rather than borrowing one from `cargo check`.\n+        if clippy && demand.compile_mode.is_some() {\n+            demand.compile_mode = Some(format!(\n+                \"{} [compile clippy {}]\",\n+                demand.name,\n+                compile_profile(&effective)\n+            ));\n+        }\n+        demand\n+    }\n+\n+    #[cfg(test)]\n+    pub(crate) fn compile_mode_key(&self) -> Option<&str> {\n+        self.compile_mode.as_deref()\n+    }\n+\n+    #[cfg(test)]\n+    pub(crate) fn counts_compile_samples(&self) -> bool {\n+        self.count_compile_samples\n+    }\n+\n     /// A test binary, remembered apart from the crate that compiled it.\n     ///\n     /// Half the pool by default rather than all of it. libtest starts a\n@@ -302,6 +357,10 @@ impl Demand {\n             threads,\n             learns_cpu: true,\n             profile: None,\n+            compile_mode: None,\n+            count_compile_samples: true,\n+            observation: std::cell::Cell::new(None),\n+            memory_features: std::cell::Cell::new(None),\n             per_test: None,\n         }\n     }\n@@ -314,6 +373,10 @@ impl Demand {\n             threads: Some(1),\n             learns_cpu: true,\n             profile: None,\n+            compile_mode: None,\n+            count_compile_samples: true,\n+            observation: std::cell::Cell::new(None),\n+            memory_features: std::cell::Cell::new(None),\n             per_test: Some(TestIdentity {\n                 binary: binary.to_owned(),\n                 test: test.to_owned(),\n@@ -343,13 +406,468 @@ impl Drop for Permit {\n }\n \n /// One lease record, stored beside the lock that proves its holder is alive.\n-#[derive(Debug, Serialize, Deserialize)]\n+#[derive(Clone, Debug, Serialize, Deserialize)]\n struct Lease {\n     version: u8,\n+    #[serde(default)]\n+    name: Option<String>,\n+    #[serde(default)]\n+    mode_key: Option<String>,\n     weight: u64,\n+    #[serde(default)]\n+    cpu: Option<u64>,\n+    #[serde(default)]\n+    memory_bytes: Option<u64>,\n     priority: String,\n     #[serde(default)]\n     build_id: Option<String>,\n+    #[serde(default)]\n+    domain: Option<String>,\n+    #[serde(default)]\n+    bytes_per_permit: u64,\n+}\n+\n+#[derive(Clone, Serialize, Deserialize)]\n+struct Waiting {\n+    #[serde(default)]\n+    name: Option<String>,\n+    #[serde(default)]\n+    mode_key: Option<String>,\n+    ticket: u64,\n+    weight: u64,\n+    #[serde(default)]\n+    cpu: Option<u64>,\n+    #[serde(default)]\n+    memory_bytes: Option<u64>,\n+    priority: String,\n+    domain: String,\n+    domain_capacity: u64,\n+    #[serde(default)]\n+    global_capacity: Option<u64>,\n+    #[serde(default)]\n+    cpu_cap: Option<u64>,\n+    #[serde(default)]\n+    mem_cap: Option<u64>,\n+    #[serde(default)]\n+    domain_memory_cap: Option<u64>,\n+    #[serde(default)]\n+    domain_cpu_cap: Option<u64>,\n+    bytes_per_permit: u64,\n+    build: Option<(String, u64)>,\n+}\n+\n+struct QueueEntry {\n+    ticket: u64,\n+    _guard: Permit,\n+}\n+\n+fn fits(used: u64, weight: u64, capacity: u64) -> bool {\n+    used == 0\n+        || used\n+            .checked_add(weight)\n+            .is_some_and(|total| total <= capacity)\n+}\n+\n+/// Physical resources. A zero memory ceiling means unlimited memory.\n+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\n+pub(crate) struct Resources {\n+    cpu: u64,\n+    memory_bytes: u64,\n+}\n+\n+impl Resources {\n+    fn fits(self, used: Self, request: Self) -> bool {\n+        // Each dimension grants its own empty-scope exception. An oversize\n+        // CPU request still needs memory room, and vice versa.\n+        fits(used.cpu, request.cpu, self.cpu)\n+            && (self.memory_bytes == 0\n+                || fits(used.memory_bytes, request.memory_bytes, self.memory_bytes))\n+    }\n+}\n+\n+/// The only legacy conversion: old records reserve their full weight on both\n+/// axes. Keep zero as a real value for new memory-only/CPU-only reservations.\n+fn record_resources(cpu: Option<u64>, memory: Option<u64>, weight: u64, unit: u64) -> Resources {\n+    Resources {\n+        cpu: cpu.unwrap_or(weight),\n+        memory_bytes: memory.unwrap_or_else(|| weight.saturating_mul(unit)),\n+    }\n+}\n+\n+impl Lease {\n+    fn resources(&self) -> Resources {\n+        record_resources(\n+            self.cpu,\n+            self.memory_bytes,\n+            self.weight,\n+            self.bytes_per_permit,\n+        )\n+    }\n+}\n+\n+impl Waiting {\n+    fn resources(&self) -> Resources {\n+        record_resources(\n+            self.cpu,\n+            self.memory_bytes,\n+            self.weight,\n+            self.bytes_per_permit,\n+        )\n+    }\n+    fn global_budget(&self, fallback: Resources) -> Resources {\n+        Resources {\n+            cpu: self\n+                .cpu_cap\n+                .or(self.global_capacity)\n+                .unwrap_or(fallback.cpu),\n+            memory_bytes: self.mem_cap.unwrap_or_else(|| {\n+                self.global_capacity.map_or(fallback.memory_bytes, |cap| {\n+                    cap.saturating_mul(self.bytes_per_permit)\n+                })\n+            }),\n+        }\n+    }\n+    fn domain_budget(&self) -> Resources {\n+        Resources {\n+            cpu: self.domain_cpu_cap.unwrap_or(self.domain_capacity),\n+            memory_bytes: self\n+                .domain_memory_cap\n+                .unwrap_or_else(|| self.domain_capacity.saturating_mul(self.bytes_per_permit)),\n+        }\n+    }\n+}\n+\n+#[derive(Clone, Copy, Debug)]\n+struct Plan {\n+    resources: Resources,\n+    weight: u64,\n+    predicted: Option<u64>,\n+    source: &'static str,\n+}\n+\n+const MEMORY_QUANTUM: u64 = 16 * 1024 * 1024;\n+\n+// Match the scalar charge an old reader computes after a permit-unit change.\n+fn weight_in_units(weight: u64, original_unit: u64, unit: u64) -> u64 {\n+    if unit == 0 {\n+        weight\n+    } else {\n+        weight.max(weight.saturating_mul(original_unit).div_ceil(unit))\n+    }\n+}\n+\n+fn can_pass_waiters(capacity: u64, live: &[u64], older: &[u64], weight: u64) -> bool {\n+    can_pass_quantized(capacity, live, older, weight, 1)\n+}\n+\n+/// Protect every older prefix against every possible completion subset.\n+fn can_pass_quantized(capacity: u64, live: &[u64], older: &[u64], charge: u64, unit: u64) -> bool {\n+    if older.is_empty() {\n+        return true;\n+    }\n+    const MAX_BITS: u64 = 1 << 16;\n+    let Some(total) = live.iter().chain(older).try_fold(0_u64, |sum, w| {\n+        sum.checked_add(w.div_ceil(unit))\n+            .filter(|sum| *sum < MAX_BITS)\n+    }) else {\n+        return false;\n+    };\n+    let Some(used) = live.iter().try_fold(0_u64, |sum, w| sum.checked_add(*w)) else {\n+        return false;\n+    };\n+    let Some(free) = capacity.checked_sub(used) else {\n+        return false;\n+    };\n+    if charge > free {\n+        return false;\n+    }\n+    let mut sums = vec![0_u64; (total as usize + 1).div_ceil(64)];\n+    sums[0] = 1;\n+    for w in live {\n+        add_subset_weight(&mut sums, w.div_ceil(unit) as usize);\n+    }\n+    let mut prefix = 0_u64;\n+    for (index, h) in older.iter().enumerate() {\n+        let Some(next) = prefix.checked_add(*h) else {\n+            return false;\n+        };\n+        prefix = next;\n+        let slack = if prefix <= free {\n+            free - prefix\n+        } else {\n+            let threshold = prefix - free;\n+            let quantized_threshold = threshold.div_ceil(unit) as usize;\n+            let first_word = quantized_threshold / 64;\n+            let Some(sum) = (first_word..sums.len()).find_map(|index| {\n+                let bits = if index == first_word {\n+                    sums[index] & (u64::MAX << (quantized_threshold % 64))\n+                } else {\n+                    sums[index]\n+                };\n+                (bits != 0).then(|| index * 64 + bits.trailing_zeros() as usize)\n+            }) else {\n+                return false;\n+            };\n+            // Every eligible exact subset S >= threshold has rounded-up sum\n+            // Q(S) >= ceil(threshold/unit). Thus the minimum DP sum is no\n+            // larger than Q(S). Each item adds at most unit-1 rounding bytes;\n+            // subtracting n*(unit-1) makes this a LOWER bound on every eligible\n+            // exact sum, hence on slack. Extra ineligible subsets only reduce\n+            // the bound. Saturation must refuse, not manufacture slack.\n+            let Some(error) = (live.len() + index)\n+                .try_into()\n+                .ok()\n+                .and_then(|count: u64| count.checked_mul(unit - 1))\n+            else {\n+                return false;\n+            };\n+            let Some(lower) = (sum as u64)\n+                .checked_mul(unit)\n+                .and_then(|sum| sum.checked_sub(error))\n+            else {\n+                return false;\n+            };\n+            let Some(slack) = lower.checked_sub(threshold) else {\n+                return false;\n+            };\n+            slack\n+        };\n+        if charge > slack {\n+            return false;\n+        }\n+        add_subset_weight(&mut sums, h.div_ceil(unit) as usize);\n+    }\n+    true\n+}\n+\n+fn add_subset_weight(sums: &mut [u64], weight: usize) {\n+    let words = weight / 64;\n+    let shift = weight % 64;\n+    for index in (words..sums.len()).rev() {\n+        let mut shifted = sums[index - words] << shift;\n+        if shift != 0 && index > words {\n+            shifted |= sums[index - words - 1] >> (64 - shift);\n+        }\n+        sums[index] |= shifted;\n+    }\n+}\n+\n+fn scope_used<'a>(leases: impl Iterator<Item = &'a Lease>) -> Resources {\n+    leases.fold(Resources::default(), |used, lease| {\n+        let charge = lease.resources();\n+        Resources {\n+            cpu: used.cpu.saturating_add(charge.cpu),\n+            memory_bytes: used.memory_bytes.saturating_add(charge.memory_bytes),\n+        }\n+    })\n+}\n+\n+fn domain_used(live: &[Lease], domain: &str) -> Resources {\n+    scope_used(\n+        live.iter()\n+            .filter(|lease| lease.domain.as_deref().is_none_or(|id| id == domain)),\n+    )\n+}\n+\n+fn build_fits(live: &[Lease], build: &Option<(String, u64)>, cpu: u64) -> bool {\n+    build.as_ref().is_none_or(|(id, capacity)| {\n+        fits(\n+            scope_used(\n+                live.iter()\n+                    .filter(|lease| lease.build_id.as_ref() == Some(id)),\n+            )\n+            .cpu,\n+            cpu,\n+            *capacity,\n+        )\n+    })\n+}\n+\n+#[derive(Debug, PartialEq, Eq)]\n+enum AdmissionDecision {\n+    Ordered,\n+    Passing,\n+    Waiting,\n+}\n+\n+/// Both physical axes must fit before queue order or safe passing is checked.\n+fn admission_decision<'a>(\n+    capacity: u64,\n+    live: &[Lease],\n+    waiting: impl Iterator<Item = &'a Waiting>,\n+    request: &Waiting,\n+) -> AdmissionDecision {\n+    let fallback = Resources {\n+        cpu: capacity,\n+        memory_bytes: capacity.saturating_mul(request.bytes_per_permit),\n+    };\n+    let budget = request.global_budget(fallback);\n+    let charge = request.resources();\n+    if !build_fits(live, &request.build, charge.cpu)\n+        || !request\n+            .domain_budget()\n+            .fits(domain_used(live, &request.domain), charge)\n+        || !budget.fits(scope_used(live.iter()), charge)\n+    {\n+        return AdmissionDecision::Waiting;\n+    }\n+    let mut older: Vec<_> = waiting\n+        .filter(|older| {\n+            older.ticket < request.ticket\n+                && !(older.priority == \"low\" && request.priority == \"normal\")\n+        })\n+        .collect();\n+    older.sort_unstable_by_key(|older| older.ticket);\n+    let ordered_blocked = older.iter().any(|older| {\n+        if !build_fits(live, &older.build, older.resources().cpu) {\n+            return older.build.as_ref().map(|(id, _)| id)\n+                == request.build.as_ref().map(|(id, _)| id);\n+        }\n+        if !older\n+            .domain_budget()\n+            .fits(domain_used(live, &older.domain), older.resources())\n+        {\n+            return older.domain == request.domain;\n+        }\n+        true\n+    });\n+    if !ordered_blocked {\n+        return AdmissionDecision::Ordered;\n+    }\n+    let scope_allows = |budget: Resources, build: Option<&str>, domain: Option<&str>| {\n+        let live: Vec<_> = live\n+            .iter()\n+            .filter(|lease| {\n+                build.is_none_or(|id| lease.build_id.as_deref() == Some(id))\n+                    && domain.is_none_or(|id| {\n+                        lease\n+                            .domain\n+                            .as_deref()\n+                            .is_none_or(|lease_id| lease_id == id)\n+                    })\n+            })\n+            .map(Lease::resources)\n+            .collect();\n+        let heads: Vec<_> = older\n+            .iter()\n+            .filter(|waiter| {\n+                build.is_none_or(|id| waiter.build.as_ref().map(|(id, _)| id.as_str()) == Some(id))\n+                    && domain.is_none_or(|id| waiter.domain == id)\n+            })\n+            .map(|waiter| waiter.resources())\n+            .collect();\n+        let cpus: Vec<_> = live.iter().map(|r| r.cpu).collect();\n+        let head_cpus: Vec<_> = heads.iter().map(|r| r.cpu).collect();\n+        let memory: Vec<_> = live.iter().map(|r| r.memory_bytes).collect();\n+        let head_memory: Vec<_> = heads.iter().map(|r| r.memory_bytes).collect();\n+        // Subsets sufficient on both axes are a subset of those sufficient\n+        // on either one. Independent minima are therefore no larger than\n+        // the joint minimum; requiring both independent slack bounds is safe.\n+        can_pass_waiters(budget.cpu, &cpus, &head_cpus, charge.cpu)\n+            && (budget.memory_bytes == 0\n+                || can_pass_quantized(\n+                    budget.memory_bytes,\n+                    &memory,\n+                    &head_memory,\n+                    charge.memory_bytes,\n+                    MEMORY_QUANTUM,\n+                ))\n+    };\n+    if !scope_allows(budget, None, None) {\n+        return AdmissionDecision::Waiting;\n+    }\n+    // Queue entries commonly share budgets. Evaluate each physical scope's\n+    // distinct ceilings once, as in the scalar policy.\n+    let mut checked_global = std::collections::BTreeSet::from([(budget.cpu, budget.memory_bytes)]);\n+    let mut checked = std::collections::BTreeSet::new();\n+    for waiter in &older {\n+        let global = waiter.global_budget(budget);\n+        if checked_global.insert((global.cpu, global.memory_bytes))\n+            && !scope_allows(global, None, None)\n+        {\n+            return AdmissionDecision::Waiting;\n+        }\n+        let domain = waiter.domain_budget();\n+        if waiter.domain == request.domain\n+            && checked.insert((false, domain.cpu, domain.memory_bytes))\n+            && !scope_allows(domain, None, Some(&waiter.domain))\n+        {\n+            return AdmissionDecision::Waiting;\n+        }\n+        if let (Some((id, ceiling)), Some((request_id, _))) = (&waiter.build, &request.build)\n+            && id == request_id\n+            && checked.insert((true, *ceiling, 0))\n+            && !scope_allows(\n+                Resources {\n+                    cpu: *ceiling,\n+                    memory_bytes: 0,\n+                },\n+                Some(id),\n+                None,\n+            )\n+        {\n+            return AdmissionDecision::Waiting;\n+        }\n+    }\n+    // Old writers still decide their own admission using scalar weights.\n+    // Vector slack cannot protect them: max(cpu, memory permits) is not\n+    // additive across leases with different dominant resources.\n+    let scalar_scope_allows = |capacity, unit, build: Option<&str>, domain: Option<&str>| {\n+        let weights: Vec<_> = live\n+            .iter()\n+            .filter(|lease| {\n+                build.is_none_or(|id| lease.build_id.as_deref() == Some(id))\n+                    && domain\n+                        .is_none_or(|id| lease.domain.as_deref().is_none_or(|other| other == id))\n+            })\n+            .map(|lease| weight_in_units(lease.weight, lease.bytes_per_permit, unit))\n+            .collect();\n+        let heads: Vec<_> = older\n+            .iter()\n+            .filter(|waiter| {\n+                build.is_none_or(|id| waiter.build.as_ref().map(|(id, _)| id.as_str()) == Some(id))\n+                    && domain.is_none_or(|id| waiter.domain == id)\n+            })\n+            .map(|waiter| weight_in_units(waiter.weight, waiter.bytes_per_permit, unit))\n+            .collect();\n+        can_pass_waiters(\n+            capacity,\n+            &weights,\n+            &heads,\n+            weight_in_units(request.weight, request.bytes_per_permit, unit),\n+        )\n+    };\n+    let mut scalar_checked = std::collections::BTreeSet::new();\n+    for waiter in &older {\n+        // New waiters need only the vector checks. An old scalar passer\n+        // reading their legacy weights is conservative: weight >= cpu and\n+        // weight * bytes_per_permit >= memory (subject to the existing\n+        // legacy capacity clamp for oversized demands).\n+        if waiter.cpu.is_some() && waiter.memory_bytes.is_some() {\n+            continue;\n+        }\n+        let unit = waiter.bytes_per_permit;\n+        let global = waiter.global_capacity.unwrap_or(capacity);\n+        if scalar_checked.insert((0, global, unit))\n+            && !scalar_scope_allows(global, unit, None, None)\n+        {\n+            return AdmissionDecision::Waiting;\n+        }\n+        if waiter.domain == request.domain\n+            && scalar_checked.insert((1, waiter.domain_capacity, unit))\n+            && !scalar_scope_allows(waiter.domain_capacity, unit, None, Some(&waiter.domain))\n+        {\n+            return AdmissionDecision::Waiting;\n+        }\n+        if let (Some((id, ceiling)), Some((request_id, _))) = (&waiter.build, &request.build)\n+            && id == request_id\n+            && scalar_checked.insert((2, *ceiling, unit))\n+            && !scalar_scope_allows(*ceiling, unit, Some(id), None)\n+        {\n+            return AdmissionDecision::Waiting;\n+        }\n+    }\n+    AdmissionDecision::Passing\n }\n \n /// What one finished compilation leaves in its flight file: the prediction\n@@ -611,6 +1129,19 @@ struct MemoryLedger {\n     /// Recent link measurements by code-generation profile, newest last.\n     #[serde(default)]\n     profile_link_peaks: BTreeMap<String, Vec<u64>>,\n+    /// Successful non-link samples, capped at the trust threshold. Peaks stay\n+    /// in `crates` so old shims preserve them, but dropping counts is safe.\n+    #[serde(default)]\n+    compile_samples: BTreeMap<String, u8>,\n+    /// Recent successful unwrapped peaks (plus doubled OOM peaks), newest last.\n+    #[serde(default)]\n+    memory_windows: BTreeMap<String, Vec<u64>>,\n+    /// Causal standardized residuals, newest last, independently per kind.\n+    #[serde(default)]\n+    memory_residuals: BTreeMap<String, Vec<f64>>,\n+    /// Derived once per read, never persisted alongside the raw observations.\n+    #[serde(skip)]\n+    pooled_spreads: BTreeMap<String, f64>,\n }\n \n #[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]\n@@ -641,11 +1172,17 @@ struct