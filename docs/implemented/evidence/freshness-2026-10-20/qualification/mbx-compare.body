) {\n+        if arg == \"--test\" {\n+            test = true;\n+            continue;\n+        }\n+        let emit = if arg == \"--emit\" {\n+            args.next()\n+        } else {\n+            arg.strip_prefix(\"--emit=\")\n+        };\n+        if let Some(value) = emit {\n+            saw_emit = true;\n+            emits.extend(value.split(',').filter_map(|kind| {\n+                let kind = kind.split('=').next()?;\n+                (kind != \"dep-info\").then_some(kind)\n+            }));\n+            continue;\n+        }\n+        let types = if arg == \"--crate-type\" {\n+            args.next()\n+        } else {\n+            arg.strip_prefix(\"--crate-type=\")\n+        };\n+        if let Some(value) = types {\n+            crate_types.extend(value.split(','));\n+            continue;\n+        }\n+        let triple = if arg == \"--target\" {\n+            args.next()\n+        } else {\n+            arg.strip_prefix(\"--target=\")\n+        };\n+        if let Some(value) = triple {\n+            targets.push(value);\n+            continue;\n+        }\n+        let setting = match arg {\n+            \"-C\" | \"--codegen\" => args.next(),\n+            _ => arg\n+                .strip_prefix(\"-C\")\n+                .or_else(|| arg.strip_prefix(\"--codegen=\")),\n+        };\n+        if let Some(value) = setting.and_then(|s| s.strip_prefix(\"incremental=\")) {\n+            incremental = !value.is_empty();\n+        }\n+        let unstable = match arg {\n+            \"-Z\" => args.next(),\n+            _ => arg.strip_prefix(\"-Z\"),\n+        };\n+        if let Some(value) = unstable.and_then(|s| s.strip_prefix(\"threads=\")) {\n+            threads = Some(value);\n+        }\n+    }\n+    if !saw_emit {\n+        emits.insert(\"link\");\n+    }\n+    format!(\n+        \"emit={} crate-type={}{}{} {} incremental-{}{}\",\n+        emits.into_iter().collect::<Vec<_>>().join(\",\"),\n+        crate_types.into_iter().collect::<Vec<_>>().join(\",\"),\n+        // Every target, in order, when there is more than one: such a compile\n+        // must not share a key with any single-target compile, whichever\n+        // target a rustc would honor.\n+        match targets.as_slice() {\n+            [] => String::new(),\n+            [target] => format!(\" target={target:?}\"),\n+            targets => format!(\" targets={targets:?}\"),\n+        },\n+        if test { \" test\" } else { \"\" },\n+        link_profile(arguments),\n+        if incremental { \"on\" } else { \"off\" },\n+        threads.map(|n| format!(\" threads={n}\")).unwrap_or_default()\n+    )\n+}\n+\n+fn update_legacy_link(\n+    ledger: &mut MemoryLedger,\n+    name: &str,\n+    peak: u64,\n+    links: bool,\n+    profile: Option<&str>,\n+) -> bool {\n+    // The window records every link, including one whose per-crate entry\n+    // is already higher: it says what links cost around here lately, which\n+    // a measurement no worse than the last one still answers.\n+    if links {\n+        let window = match profile {\n+            Some(profile) => ledger\n+                .profile_link_peaks\n+                .entry(profile.to_string())\n+                .or_default(),\n+            None => &mut ledger.link_peaks,\n+        };\n+        window.push(peak);\n+        let surplus = window.len().saturating_sub(MAX_LINK_SAMPLES);\n+        window.drain(..surplus);\n+        while ledger.profile_link_peaks.len() > MAX_LEDGER_ENTRIES {\n+            ledger.profile_link_peaks.pop_first();\n+        }\n+    }\n+    let known = ledger.crates.get(name).is_some_and(|known| *known >= peak);\n+    if known && !links {\n+        // Nothing moved: the entry already stands higher and there is no\n+        // window entry to add. Rewriting the file identically would cost\n+        // every repeat compilation a write under this lock.\n+        return false;\n+    }\n+    if !known {\n+        ledger.crates.insert(name.to_string(), peak);\n+    }\n+    true\n+}\n+\n+fn update_legacy_compile(\n+    ledger: &mut MemoryLedger,\n+    demand: &Demand,\n+    measured: u64,\n+    peak: Option<u64>,\n+    succeeded: bool,\n+    oom: bool,\n+) -> bool {\n+    let key = demand.compile_mode.as_ref().expect(\"compile mode\");\n+    if peak.is_none() && !ledger.crates.contains_key(&demand.name) {\n+        return false;\n+    }\n+    let mode_peak = peak.unwrap_or(measured);\n+    let bare_known = ledger.crates.get(&demand.name).copied();\n+    let mode_known = ledger.crates.get(key).copied();\n+    let count = ledger.compile_samples.get(key).copied().unwrap_or(0);\n+    if bare_known.is_some_and(|bare| peak.is_none_or(|peak| peak <= bare))\n+        && mode_known.is_some_and(|known| known >= mode_peak)\n+        && (!succeeded || oom || count >= 3)\n+    {\n+        return false;\n+    }\n+    if let Some(peak) = peak {\n+        // A mode may survive without its bare entry (e.g. an old writer's\n+        // eviction). Recreating the fallback must cover every retained\n+        // mode, rather than cap a known mode below its measured maximum.\n+        let retained = if bare_known.is_none() {\n+            let prefix = format!(\"{} [compile \", demand.name);\n+            ledger\n+                .crates\n+                .iter()\n+                .filter(|(name, _)| name.starts_with(&prefix))\n+                .map(|(_, peak)| *peak)\n+                .max()\n+                .unwrap_or(0)\n+        } else {\n+            0\n+        };\n+        let bare = ledger.crates.entry(demand.name.clone()).or_default();\n+        *bare = (*bare).max(peak).max(retained);\n+    }\n+    if !ledger.crates.contains_key(&demand.name) {\n+        return false;\n+    }\n+    // Even a light successful mode must learn when its crate is heavy.\n+    let mode = ledger.crates.entry(key.clone()).or_default();\n+    *mode = (*mode).max(mode_peak);\n+    if succeeded && !oom {\n+        let count = ledger.compile_samples.entry(key.clone()).or_default();\n+        *count = count.saturating_add(1).min(3);\n+    }\n+    true\n+}\n+\n+#[cfg(test)]\n+// Independent old-reader prediction for compatibility assertions only.\n+fn legacy_compile_prediction(ledger: &MemoryLedger, name: &str, key: &str) -> (Option<u64>, bool) {\n+    let bare = ledger.crates.get(name).copied();\n+    if ledger.compile_samples.get(key).copied().unwrap_or(0) >= 3\n+        && let Some(peak) = ledger.crates.get(key).copied()\n+    {\n+        let padded = peak.saturating_add(peak.div_ceil(2));\n+        return (Some(bare.map_or(padded, |bare| padded.min(bare))), true);\n+    }\n+    (bare, false)\n+}\n+\n+fn trim_compile_ledger(ledger: &mut MemoryLedger) {\n+    while ledger.crates.len() > MAX_LEDGER_ENTRIES {\n+        let smallest = ledger\n+            .crates\n+            .iter()\n+            .min_by_key(|(_, peak)| **peak)\n+            .map(|(name, _)| name.clone())\n+            .expect(\"overfull ledger\");\n+        ledger.crates.remove(&smallest);\n+        ledger.compile_samples.remove(&smallest);\n+        // If a crate-wide fallback is evicted, remove its modes too. Counts\n+        // must never survive an evicted peak and authorize a new low reading.\n+        let prefix = format!(\"{smallest} [compile \");\n+        ledger.crates.retain(|key, _| !key.starts_with(&prefix));\n+    }\n+    ledger\n+        .compile_samples\n+        .retain(|key, _| ledger.crates.contains_key(key));\n+}\n+\n+/// A read-only snapshot: files may include abandoned records until the next\n+/// admission reclaims them. Inspecting statistics must never acquire a lease.\n+#[derive(Debug, Serialize)]\n+pub(crate) struct SchedulerReport {\n+    enabled: bool,\n+    capacity: u64,\n+    memory_capacity: u64,\n+    bytes_per_permit: u64,\n+    entries: Vec<SchedulerEntry>,\n+    memory_calibration: Vec<MemoryCalibration>,\n+    activity: Vec<SchedulerActivity>,\n+    accuracy: accuracy::Summary,\n+}\n+\n+#[derive(Debug, Serialize)]\n+struct SchedulerEntry {\n+    key: String,\n+    recorded_peak_bytes: u64,\n+    successful_samples: u8,\n+    n: usize,\n+    window_max_bytes: Option<u64>,\n+    bound_bytes: Option<u64>,\n+    q: Option<f64>,\n+    charge_bytes: Option<u64>,\n+    charge_permits: Option<u64>,\n+    charge_cpu: Option<u64>,\n+    source: &'static str,\n+}\n+\n+#[derive(Debug, Serialize)]\n+struct MemoryCalibration {\n+    kind: &'static str,\n+    target_p: f64,\n+    sigma_pool: f64,\n+    residual_count: usize,\n+    /// A cold-key t multiplier (df=4) until calibrated; each key shows its q.\n+    q: f64,\n+    calibrated: bool,\n+}\n+\n+#[derive(Debug, Serialize)]\n+struct SchedulerActivity {\n+    kind: &'static str,\n+    name: String,\n+    mode_key: String,\n+    build_id: String,\n+    pressure_domain: String,\n+    charged_permits: u64,\n+    charged_cpu: u64,\n+    charged_memory_bytes: u64,\n+    charged_bytes: u64,\n+    age_secs: Option<u64>,\n+}\n+\n+/// Charges under the global scheduler settings. A workspace `.mbx.toml` can\n+/// change them for its own builds, and only `mbx cargo` resolves which\n+/// workspace that is; lease and waiter records keep what was really charged.\n+pub(crate) fn scheduler_report(config: &Config) -> SchedulerReport {\n+    let capacity = config.scheduler.permits();\n+    let mut report = scheduler_snapshot(\n+        &config.cache_dir.join(SCHEDULER_DIR),\n+        capacity,\n+        bytes_per_permit(config.scheduler.memory_bytes, capacity),\n+        config.scheduler.enabled,\n+    );\n+    report.memory_capacity = config.scheduler.memory_bytes.unwrap_or(0);\n+    report\n+}\n+\n+fn scheduler_snapshot(\n+    dir: &Path,\n+    capacity: u64,\n+    bytes_per_permit: u64,\n+    enabled: bool,\n+) -> SchedulerReport {\n+    let ledger = read_ledger(&dir.join(LEDGER_FILE));\n+    let keys: std::collections::BTreeSet<_> = ledger\n+        .crates\n+        .keys()\n+        .chain(ledger.memory_windows.keys())\n+        .collect();\n+    let entries = keys\n+        .into_iter()\n+        .map(|key| {\n+            let mode = key.split_once(\" [compile \");\n+            let kind = memory::kind(key);\n+            let predictable = mode.is_some() || !key.contains(\" [\") || kind == \"link\";\n+            let estimate = (mode.is_some() || kind == \"link\")\n+                .then(|| memory::estimate(&ledger, key, kind))\n+                .flatten();\n+            let (charge, source) = if kind == \"link\" {\n+                let profile = key\n+                    .strip_suffix(\" [link]\")\n+                    .and_then(|name| name.split_once(\" [\"))\n+                    .map(|(_, profile)| profile.trim_end_matches(']'));\n+                memory::link_prediction(\n+                    &ledger,\n+                    key,\n+                    profile,\n+                    LINK_WEIGHT.saturating_mul(bytes_per_permit),\n+                )\n+            } else if let Some((name, _)) = mode {\n+                memory::compile_prediction(&ledger, name, key, bytes_per_permit)\n+            } else if predictable {\n+                (ledger.crates.get(key).copied(), \"legacy\")\n+            } else {\n+                (None, \"see admission\")\n+            };\n+            let charge_bytes = (bytes_per_permit > 0).then_some(charge).flatten();\n+            SchedulerEntry {\n+                key: key.clone(),\n+                recorded_peak_bytes: ledger.crates.get(key).copied().unwrap_or(0),\n+                successful_samples: ledger.compile_samples.get(key).copied().unwrap_or(0),\n+                n: estimate.map_or(0, |e| e.n),\n+                window_max_bytes: estimate.map(|e| e.window_max),\n+                bound_bytes: estimate.map(|e| e.bound),\n+                q: estimate.map(|e| e.q),\n+                charge_bytes,\n+                charge_cpu: predictable.then_some(1),\n+                charge_permits: charge_bytes\n+                    .map(|bytes| bytes.div_ceil(bytes_per_permit).clamp(1, capacity)),\n+                source: if bytes_per_permit == 0 && predictable {\n+                    \"CPU-only\"\n+                } else {\n+                    source\n+                },\n+            }\n+        })\n+        .collect();\n+    let memory_calibration = memory::KINDS\n+        .into_iter()\n+        .map(|kind| {\n+            let residual_count = ledger.memory_residuals.get(kind).map_or(0, Vec::len);\n+            MemoryCalibration {\n+                kind,\n+                target_p: memory::TARGET_P,\n+                sigma_pool: memory::sigma_pool(&ledger, kind),\n+                residual_count,\n+                q: memory::quantile(&ledger, kind, 1),\n+                calibrated: residual_count >= 50,\n+            }\n+        })\n+        .collect();\n+    let mut activity = Vec::new();\n+    for (subdir, kind) in [(LEASES_DIR, \"lease\"), (WAITERS_DIR, \"waiter\")] {\n+        let Ok(files) = std::fs::read_dir(dir.join(subdir)) else {\n+            continue;\n+        };\n+        let mut paths: Vec<_> = files\n+            .filter_map(|entry| entry.ok().map(|e| e.path()))\n+            .collect();\n+        paths.sort();\n+        for path in paths {\n+            let Ok(bytes) = std::fs::read(&path) else {\n+                continue;\n+            };\n+            let age_secs = std::fs::metadata(&path)\n+                .ok()\n+                .and_then(|m| m.modified().ok())\n+                .and_then(|t| t.elapsed().ok())\n+                .map(|d| d.as_secs());\n+            let record = if kind == \"lease\" {\n+                serde_json::from_slice::<Lease>(&bytes).ok().map(|l| {\n+                    (\n+                        l.resources(),\n+                        l.name,\n+                        l.mode_key,\n+                        l.build_id,\n+                        l.domain,\n+                        l.weight,\n+                        l.bytes_per_permit,\n+                    )\n+                })\n+            } else {\n+                serde_json::from_slice::<Waiting>(&bytes).ok().map(|w| {\n+                    (\n+                        w.resources(),\n+                        w.name,\n+                        w.mode_key,\n+                        w.build.map(|(id, _)| id),\n+                        Some(w.domain),\n+                        w.weight,\n+                        w.bytes_per_permit,\n+                    )\n+                })\n+            };\n+            if let Some((resources, name, mode, build, domain, weight, unit)) = record {\n+                let unknown = || \"unknown\".to_owned();\n+                activity.push(SchedulerActivity {\n+                    kind,\n+                    name: name.unwrap_or_else(unknown),\n+                    mode_key: mode.unwrap_or_else(unknown),\n+                    build_id: build.unwrap_or_else(unknown),\n+                    pressure_domain: domain.unwrap_or_else(unknown),\n+                    charged_permits: weight,\n+                    charged_cpu: resources.cpu,\n+                    charged_memory_bytes: resources.memory_bytes,\n+                    charged_bytes: weight.saturating_mul(unit),\n+                    age_secs,\n+                });\n+            }\n+        }\n+    }\n+    SchedulerReport {\n+        enabled,\n+        capacity,\n+        memory_capacity: capacity.saturating_mul(bytes_per_permit),\n+        bytes_per_permit,\n+        entries,\n+        memory_calibration,\n+        activity,\n+        accuracy: accuracy::Summary::read(dir),\n+    }\n+}\n+\n+impl SchedulerReport {\n+    pub(crate) fn text(&self) -> String {\n+        let mut lines = vec![format!(\n+            \"Scheduler: {} ({} cores, {} memory budget, from the global settings)\",\n+            if self.enabled { \"enabled\" } else { \"disabled\" },\n+            self.capacity,\n+            if self.bytes_per_permit == 0 {\n+                \"unlimited\".into()\n+            } else {\n+                crate::stats::size(self.memory_capacity)\n+            }\n+        )];\n+        for e in &self.entries {\n+            let charge = e.charge_bytes.zip(e.charge_cpu).map_or_else(\n+                || \"see admission\".to_owned(),\n+                |(bytes, cpu)| format!(\"{cpu} cores + {}\", crate::stats::size(bytes)),\n+            );\n+            let source = if e.source == \"see admission\" {\n+                String::new()\n+            } else {\n+                format!(\" ({})\", e.source)\n+            };\n+            lines.push(format!(\n+                \"  {}: peak={}, samples={}, n={}, window max={}, bound={}, charge={}{}\",\n+                e.key,\n+                crate::stats::size(e.recorded_peak_bytes),\n+                e.successful_samples,\n+                e.n,\n+                e.window_max_bytes\n+                    .map_or_else(|| \"unknown\".into(), crate::stats::size),\n+                e.bound_bytes\n+                    .map_or_else(|| \"unknown\".into(), crate::stats::size),\n+                charge,\n+                source\n+            ));\n+        }\n+        if self.entries.is_empty() {\n+            lines.push(\"  No recorded memory peaks.\".into());\n+        }\n+        for calibration in &self.memory_calibration {\n+            lines.push(format!(\n+                \"  {}: sigma_pool={:.6}, residuals={}, p={}, q={:.6}{}\",\n+                calibration.kind,\n+                calibration.sigma_pool,\n+                calibration.residual_count,\n+                calibration.target_p,\n+                calibration.q,\n+                if calibration.calibrated {\n+                    \" (empirical)\"\n+                } else {\n+                    \" (t fallback at n=1; per-key df=4+n-1)\"\n+                }\n+            ));\n+        }\n+        lines.push(\n+            \"  Activity snapshot (may include abandoned records; no lease locks taken):\".into(),\n+        );\n+        for a in &self.activity {\n+            lines.push(format!(\n+                \"  {} {}: mode={}, build={}, domain={}, charge={} cores + {}, age={}\",\n+                a.kind,\n+                a.name,\n+                a.mode_key,\n+                a.build_id,\n+                a.pressure_domain,\n+                a.charged_cpu,\n+                crate::stats::size(a.charged_memory_bytes),\n+                a.age_secs\n+                    .map_or_else(|| \"unknown\".into(), |s| format!(\"{s}s\"))\n+            ));\n+        }\n+        if self.activity.is_empty() {\n+            lines.push(\"  No lease or waiter records.\".into());\n+        }\n+        lines.push(self.accuracy.text());\n+        lines.join(\"\\n\")\n+    }\n+}\n+\n fn read_ledger(path: &Path) -> MemoryLedger {\n-    std::fs::read(path)\n+    let mut ledger: MemoryLedger = std::fs::read(path)\n         .ok()\n         .and_then(|bytes| serde_json::from_slice(&bytes).ok())\n-        .unwrap_or_default()\n+        .unwrap_or_default();\n+    memory::prepare(&mut ledger);\n+    ledger\n }\n \n fn test_history_path(dir: &Path, binary: &str) -> PathBuf {\n@@ -1634,10 +3038,12 @@ fn read_test_history_records(path: &Path, binary: &str) -> Vec<TestHistoryRecord\n         return Vec::new();\n     };\n \n-    let mut records: Vec<_> = contents[TEST_HISTORY_HEADER_LEN as usize..]\n-        .chunks_exact(TEST_HISTORY_RECORD_LEN as usize)\n+    let (record_bytes, _) = contents[TEST_HISTORY_HEADER_LEN as usize..]\n+        .as_chunks::<{ TEST_HISTORY_RECORD_LEN as usize }>();\n+    let mut records: Vec<_> = record_bytes\n+        .iter()\n         .take(header.count as usize)\n-        .map(decode_test_history_record)\n+        .map(|bytes| decode_test_history_record(bytes))\n         .collect();\n     records.sort_unstable_by_key(|record| record.hash);\n     let mut unique: Vec<TestHistoryRecord> = Vec::with_capacity(records.len());\n@@ -1770,6 +3176,38 @@ fn raise_measurement(current: TestMeasurement, incoming: TestMeasurement) -> Tes\n     }\n }\n \n+/// Queue entries have the same kernel-owned lifetime as leases. A crashed or\n+/// cancelled waiter cannot leave a permanent head-of-line blocker.\n+fn scan_waiters(directory: &Path) -> Result<Vec<Waiting>> {\n+    let mut waiting = Vec::new();\n+    for entry in std::fs::read_dir(directory)? {\n+        let path = entry?.path();\n+        let mut lock = fslock::LockFile::open(&path)?;\n+        if lock.try_lock()? {\n+            drop(lock);\n+            let _ = std::fs::remove_file(&path);\n+        } else if let Some(record) = read_waiter(&path)? {\n+            waiting.push(record);\n+        }\n+    }\n+    Ok(waiting)\n+}\n+\n+/// A live waiter's record, or `None` when it vanished after its lock check.\n+///\n+/// `Permit::drop` takes no registrar lock: it unlocks and then removes the\n+/// file. A scan can see the lock still held and then find no file, which\n+/// means that waiter has left the queue. Do not guess a queue position for a\n+/// record that is present but unreadable; propagate that error through the\n+/// scheduler's usual fail-open path.\n+fn read_waiter(path: &Path) -> Result<Option<Waiting>> {\n+    match std::fs::read(path) {\n+        Ok(bytes) => Ok(Some(serde_json::from_slice(&bytes)?)),\n+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),\n+        Err(error) => Err(error.into()),\n+    }\n+}\n+\n /// The live lease weights, reclaiming any lease whose holder has died.\n fn scan_leases(leases: &Path) -> Result<Vec<Lease>> {\n     let mut live = Vec::new();\n@@ -1791,10 +3229,16 @@ fn scan_leases(leases: &Path) -> Result<Vec<Lease>> {\n             .and_then(|bytes| serde_json::from_slice::<Lease>(&bytes).ok())\n             .map_or_else(\n                 || Lease {\n+                    name: None,\n+                    mode_key: None,\n                     version: LEASE_VERSION,\n                     weight: 1,\n+                    cpu: None,\n+                    memory_bytes: None,\n                     priority: SchedulerPriority::Normal.as_str().into(),\n                     build_id: None,\n+                    domain: None,\n+                    bytes_per_permit: 0,\n                 },\n                 |mut lease| {\n                     lease.weight = lease.weight.max(1);"},{"sha":"587ebda19a41cdab864648e68e4c697bc6454d11","filename":"crates/mbx/src/scheduler_accuracy.rs","status":"added","additions":979,"deletions":0,"changes":979,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fscheduler_accuracy.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fscheduler_accuracy.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fscheduler_accuracy.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -0,0 +1,979 @@\n+//! Best-effort observations; rotation deliberately accepts concurrent lost lines.\n+use super::*;\n+use std::io::{BufRead, BufReader, Write};\n+\n+const FILE: &str = \"observations.jsonl\";\n+const PREVIOUS: &str = \"observations.jsonl.1\";\n+const LOCK: &str = \"observations.lock\";\n+const MAX_BYTES: u64 = 8 * 1024 * 1024;\n+\n+#[derive(Clone, Copy)]\n+pub(crate) struct Admission {\n+    pub weight: u64,\n+    pub resources: Resources,\n+    pub predicted: Option<u64>,\n+    pub source: &'static str,\n+    pub wait_ms: u64,\n+    pub started: Instant,\n+}\n+\n+#[derive(Debug, Serialize, Deserialize)]\n+struct Observation {\n+    v: u8,\n+    ts_ms: u64,\n+    mbx_version: String,\n+    pressure_domain: String,\n+    kind: String,\n+    name: String,\n+    key: String,\n+    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n+    build_id: Option<String>,\n+    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n+    build_capacity: Option<u64>,\n+    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n+    domain_capacity: Option<u64>,\n+    source: String,\n+    predicted_bytes: Option<u64>,\n+    charged_permits: u64,\n+    #[serde(default)]\n+    charged_cpu: Option<u64>,\n+    #[serde(default)]\n+    charged_memory_bytes: Option<u64>,\n+    bytes_per_permit: u64,\n+    peak_bytes: Option<u64>,\n+    outcome: String,\n+    wrapped: bool,\n+    admission_wait_ms: u64,\n+    run_ms: u64,\n+}\n+\n+impl Pool {\n+    pub(super) fn observe(&self, demand: &Demand, status: &ExitStatus, peak: Option<u64>) {\n+        // Take once: repeated completion calls and unscheduled runs cannot log.\n+        let admission = demand.observation.take();\n+        if !self.events || self.bytes_per_permit == 0 {\n+            return;\n+        }\n+        let Some(admission) = admission else { return };\n+        let kind = if demand.per_test.is_some() {\n+            \"nextest-test\"\n+        } else if demand.learns_cpu {\n+            \"test-binary\"\n+        } else if demand.links {\n+            \"link\"\n+        } else {\n+            \"compile\"\n+        };\n+        let key = demand.compile_mode.clone().unwrap_or_else(|| {\n+            // Per-test history is keyed by binary and test; the demand name\n+            // represents that identity, rather than the suite ledger key.\n+            ledger_key(&demand.name, demand.links)\n+        });\n+        let observation = Observation {\n+            v: 1,\n+            ts_ms: (self.clock)(),\n+            mbx_version: env!(\"CARGO_PKG_VERSION\").into(),\n+            pressure_domain: self.pressure_domain.into(),\n+            kind: kind.into(),\n+            name: demand.name.clone(),\n+            key,\n+            build_id: self.build.as_ref().map(|(id, _)| id.clone()),\n+            build_capacity: self.build.as_ref().map(|(_, capacity)| *capacity),\n+            domain_capacity: Some(self.domain_capacity),\n+            source: admission.source.into(),\n+            predicted_bytes: admission.predicted,\n+            charged_permits: admission.weight,\n+            charged_cpu: Some(admission.resources.cpu),\n+            charged_memory_bytes: Some(admission.resources.memory_bytes),\n+            bytes_per_permit: self.bytes_per_permit,\n+            peak_bytes: peak,\n+            outcome: outcome(status),\n+            wrapped: !demand.count_compile_samples,\n+            admission_wait_ms: admission.wait_ms,\n+            run_ms: admission\n+                .started\n+                .elapsed()\n+                .as_millis()\n+                .try_into()\n+                .unwrap_or(u64::MAX),\n+        };\n+        if let Err(error) = append(&self.dir, observation) {\n+            debug!(\"scheduler observation was not recorded: {error:#}\");\n+        }\n+    }\n+\n+    pub(crate) fn reserve_observed(\n+        &self,\n+        cpus: Option<u64>,\n+        memory_bytes: Option<u64>,\n+    ) -> Result<(super::Permit, Admission)> {\n+        let weight = self.reservation_weight(cpus, memory_bytes)?;\n+        let requested_at = Instant::now();\n+        let permit = self.reserve(cpus, memory_bytes)?;\n+        let wait_ms = requested_at\n+            .elapsed()\n+            .as_millis()\n+            .try_into()\n+            .unwrap_or(u64::MAX);\n+        Ok((\n+            permit,\n+            Admission {\n+                weight,\n+                resources: Resources {\n+                    cpu: cpus.unwrap_or(0),\n+                    memory_bytes: memory_bytes.unwrap_or(0),\n+                },\n+                predicted: None,\n+                source: \"reservation\",\n+                wait_ms,\n+                started: Instant::now(),\n+            },\n+        ))\n+    }\n+\n+    pub(crate) fn observe_reservation(&self, admission: Admission, status: Option<&ExitStatus>) {\n+        if !self.events || self.bytes_per_permit == 0 {\n+            return;\n+        }\n+        let observation = Observation {\n+            v: 1,\n+            ts_ms: (self.clock)(),\n+            mbx_version: env!(\"CARGO_PKG_VERSION\").into(),\n+            pressure_domain: self.pressure_domain.into(),\n+            kind: \"reservation\".into(),\n+            name: \"mbx reserve\".into(),\n+            key: \"reservation\".into(),\n+            build_id: self.build.as_ref().map(|(id, _)| id.clone()),\n+            build_capacity: self.build.as_ref().map(|(_, capacity)| *capacity),\n+            domain_capacity: Some(self.domain_capacity),\n+            source: admission.source.into(),\n+            predicted_bytes: None,\n+            charged_permits: admission.weight,\n+            charged_cpu: Some(admission.resources.cpu),\n+            charged_memory_bytes: Some(admission.resources.memory_bytes),\n+            bytes_per_permit: self.bytes_per_permit,\n+            peak_bytes: None,\n+            outcome: status.map_or_else(|| \"unknown\".into(), outcome),\n+            wrapped: false,\n+            admission_wait_ms: admission.wait_ms,\n+            run_ms: admission\n+                .started\n+                .elapsed()\n+                .as_millis()\n+                .try_into()\n+                .unwrap_or(u64::MAX),\n+        };\n+        if let Err(error) = append(&self.dir, observation) {\n+            debug!(\"scheduler reservation observation was not recorded: {error:#}\");\n+        }\n+    }\n+}\n+\n+fn outcome(status: &ExitStatus) -> String {\n+    if oom_killed(status) {\n+        return \"oom-killed\".into();\n+    }\n+    if status.success() {\n+        return \"success\".into();\n+    }\n+    #[cfg(unix)]\n+    {\n+        use std::os::unix::process::ExitStatusExt as _;\n+        if let Some(signal) = status.signal() {\n+            return format!(\"signal-{signal}\");\n+        }\n+    }\n+    \"failed\".into()\n+}\n+\n+/// Bound escaped JSON strings too. A hash suffix preserves distinct long keys.\n+fn compact(value: &mut String) -> Result<()> {\n+    if serde_json::to_vec(value.as_str())?.len() <= 128 {\n+        return Ok(());\n+    }\n+    let suffix = format!(\"…{:016x}\", test_history_hash(value));\n+    let mut end = value.len().min(128);\n+    while !value.is_char_boundary(end) {\n+        end -= 1;\n+    }\n+    let prefix = &value[..end];\n+    let mut shortened = format!(\"{prefix}{suffix}\");\n+    while serde_json::to_vec(&shortened)?.len() > 128 {\n+        end -= 1;\n+        while !value.is_char_boundary(end) {\n+            end -= 1;\n+        }\n+        shortened = format!(\"{}{suffix}\", &value[..end]);\n+    }\n+    *value = shortened;\n+    Ok(())\n+}\n+\n+fn append(dir: &Path, mut observation: Observation) -> Result<()> {\n+    std::fs::create_dir_all(dir)?;\n+    let path = dir.join(FILE);\n+    if std::fs::metadata(&path).is_ok_and(|m| m.len() > MAX_BYTES) {\n+        let mut lock = fslock::LockFile::open(&dir.join(LOCK))?;\n+        if lock.try_lock()? && std::fs::metadata(&path).is_ok_and(|m| m.len() > MAX_BYTES) {\n+            // Replaces the previous generation. A writer that already opened\n+            // the old inode can lose its line if another rotation overtakes it.\n+            std::fs::rename(&path, dir.join(PREVIOUS))?;\n+        }\n+    }\n+    // Shorten every long identity the same way on every line, whatever the\n+    // rest of the line holds, so one key is never split between spellings.\n+    compact(&mut observation.name)?;\n+    compact(&mut observation.key)?;\n+    compact(&mut observation.pressure_domain)?;\n+    if let Some(build_id) = &mut observation.build_id {\n+        compact(build_id)?;\n+    }\n+    let mut line = serde_json::to_vec(&observation)?;\n+    line.push(b'\\n');\n+    eyre::ensure!(line.len() < 1024, \"observation exceeds line size limit\");\n+    let mut file = std::fs::OpenOptions::new()\n+        .create(true)\n+        .append(true)\n+        .open(path)?;\n+    // Exactly one O_APPEND write; never retry a short write or take a ledger\n+    // lock. A partial line is ignored by readers.\n+    eyre::ensure!(file.write(&line)? == line.len(), \"short observation write\");\n+    Ok(())\n+}\n+\n+#[derive(Debug, Default, Serialize)]\n+pub(super) struct Counts {\n+    n: u64,\n+    success: u64,\n+    failed: u64,\n+    oom_killed: u64,\n+    other: u64,\n+    measured: u64,\n+    exceeded: u64,\n+    success_exceeded: u64,\n+    failed_exceeded: u64,\n+    oom_killed_exceeded: u64,\n+    other_exceeded: u64,\n+    worst_peak_reserved_ratio: Option<f64>,\n+    worst_ts_ms: Option<u64>,\n+    worst_key: Option<String>,\n+    worst_outcome: Option<String>,\n+    highest_peak_bytes: Option<u64>,\n+}\n+\n+impl Counts {\n+    fn add(&mut self, o: &Observation) {\n+        self.n += 1;\n+        match o.outcome.as_str() {\n+            \"success\" => self.success += 1,\n+            \"failed\" => self.failed += 1,\n+            \"oom-killed\" => self.oom_killed += 1,\n+            _ => self.other += 1,\n+        }\n+        let Some(peak) = o.peak_bytes else { return };\n+        self.measured += 1;\n+        self.highest_peak_bytes = Some(self.highest_peak_bytes.unwrap_or(0).max(peak));\n+        let reserved = o\n+            .charged_memory_bytes\n+            .unwrap_or_else(|| o.charged_permits.saturating_mul(o.bytes_per_permit));\n+        if reserved == 0 {\n+            return;\n+        }\n+        if peak > reserved {\n+            self.exceeded += 1;\n+            match o.outcome.as_str() {\n+                \"success\" => self.success_exceeded += 1,\n+                \"failed\" => self.failed_exceeded += 1,\n+                \"oom-killed\" => self.oom_killed_exceeded += 1,\n+                _ => self.other_exceeded += 1,\n+            }\n+        }\n+        let ratio = peak as f64 / reserved as f64;\n+        if self\n+            .worst_peak_reserved_ratio\n+            .is_none_or(|worst| ratio > worst)\n+        {\n+            self.worst_peak_reserved_ratio = Some(ratio);\n+            self.worst_ts_ms = Some(o.ts_ms);\n+            self.worst_key = Some(o.key.clone());\n+            self.worst_outcome = Some(o.outcome.clone());\n+        }\n+    }\n+}\n+\n+#[derive(Debug, Serialize)]\n+pub(super) struct KeySummary {\n+    key: String,\n+    #[serde(flatten)]\n+    counts: Counts,\n+    clean_samples: u64,\n+    predicted_samples: usize,\n+    median_peak_predicted_ratio: Option<f64>,\n+    p90_peak_predicted_ratio: Option<f64>,\n+    average_reserved_unused_bytes: Option<f64>,\n+}\n+\n+#[derive(Debug, Default, Serialize)]\n+pub(super) struct Summary {\n+    #[serde(flatten)]\n+    overall: Counts,\n+    start_ts_ms: Option<u64>,\n+    end_ts_ms: Option<u64>,\n+    keys: Vec<KeySummary>,\n+}\n+\n+#[derive(Default)]\n+struct Samples {\n+    counts: Counts,\n+    ratios: Vec<f64>,\n+    unused: f64,\n+    clean_n: u64,\n+}\n+\n+impl Summary {\n+    pub(super) fn read(dir: &Path) -> Self {\n+        let mut summary = Self::default();\n+        let mut keys: BTreeMap<String, Samples> = BTreeMap::new();\n+        for name in [PREVIOUS, FILE] {\n+            let Ok(file) = File::open(dir.join(name)) else {\n+                continue;\n+            };\n+            for line in BufReader::new(file)\n+                .split(b'\\n')\n+                .map_while(std::result::Result::ok)\n+            {\n+                let Ok(o) = serde_json::from_slice::<Observation>(&line) else {\n+                    continue;\n+                };\n+                if o.v != 1 {\n+                    continue;\n+                }\n+                summary.start_ts_ms =\n+                    Some(summary.start_ts_ms.map_or(o.ts_ms, |ts| ts.min(o.ts_ms)));\n+                summary.end_ts_ms = Some(summary.end_ts_ms.map_or(o.ts_ms, |ts| ts.max(o.ts_ms)));\n+                summary.overall.add(&o);\n+                let samples = keys.entry(o.key.clone()).or_default();\n+                samples.counts.add(&o);\n+                // Failed, OOM and wrapper readings still contribute to safety\n+                // counts and worst cases, but never to clean accuracy samples.\n+                if o.outcome != \"success\" || o.wrapped {\n+                    continue;\n+                }\n+                let Some(peak) = o.peak_bytes else { continue };\n+                if let Some(predicted) = o.predicted_bytes.filter(|p| *p > 0) {\n+                    samples.ratios.push(peak as f64 / predicted as f64);\n+                }\n+                samples.unused += o\n+                    .charged_memory_bytes\n+                    .unwrap_or_else(|| o.charged_permits.saturating_mul(o.bytes_per_permit))\n+                    .saturating_sub(peak) as f64;\n+                samples.clean_n += 1;\n+            }\n+        }\n+        summary.keys = keys\n+            .into_iter()\n+            .map(|(key, mut samples)| {\n+                samples.ratios.sort_by(f64::total_cmp);\n+                let n = samples.ratios.len();\n+                let median =\n+                    (n > 0).then(|| (samples.ratios[(n - 1) / 2] + samples.ratios[n / 2]) / 2.0);\n+                // Nearest-rank p90, including small samples.\n+                let p90 = (n > 0).then(|| samples.ratios[(n * 9).div_ceil(10) - 1]);\n+                KeySummary {\n+                    key,\n+                    counts: samples.counts,\n+                    clean_samples: samples.clean_n,\n+                    predicted_samples: n,\n+                    median_peak_predicted_ratio: median,\n+                    p90_peak_predicted_ratio: p90,\n+                    average_reserved_unused_bytes: (samples.clean_n > 0)\n+                        .then(|| samples.unused / samples.clean_n as f64),\n+                }\n+            })\n+            .collect();\n+        summary\n+    }\n+\n+    pub(super) fn text(&self) -> String {\n+        if self.overall.n == 0 {\n+            return \"Estimate accuracy: no observations.\".into();\n+        }\n+        fn ratio(value: Option<f64>) -> String {\n+            value.map_or_else(|| \"unknown\".into(), |r| format!(\"{r:.2}x\"))\n+        }\n+        let overall = &self.overall;\n+        let mut lines = vec![\n+            format!(\n+                \"Estimate accuracy, {} to {}: {} observations, {} exceeded their reservation.\",\n+                utc(self.start_ts_ms),\n+                utc(self.end_ts_ms),\n+                overall.n,\n+                overall.exceeded,\n+            ),\n+            format!(\n+                \"  Worst: {} of its reservation, {} ({}), at {}.\",\n+                ratio(overall.worst_peak_reserved_ratio),\n+                overall.worst_key.as_deref().unwrap_or(\"unknown\"),\n+                overall.worst_outcome.as_deref().unwrap_or(\"unknown\"),\n+                utc(overall.worst_ts_ms),\n+            ),\n+            format!(\n+                \"  Outcomes: {} success, {} failed, {} OOM-killed, {} other. Exceeded: {} success, {} failed, {} OOM-killed, {} other.\",\n+                overall.success,\n+                overall.failed,\n+                overall.oom_killed,\n+                overall.other,\n+                overall.success_exceeded,\n+                overall.failed_exceeded,\n+                overall.oom_killed_exceeded,\n+                overall.other_exceeded,\n+            ),\n+            \"  Median, p90 and unused memory count only successful runs with a measured peak that ran without another wrapper.\".into(),\n+        ];\n+        let mut keys: Vec<_> = self.keys.iter().collect();\n+        keys.sort_by(|a, b| {\n+            b.counts\n+                .worst_peak_reserved_ratio\n+                .unwrap_or(-1.0)\n+                .total_cmp(&a.counts.worst_peak_reserved_ratio.unwrap_or(-1.0))\n+                .then_with(|| a.key.cmp(&b.key))\n+        });\n+        for k in keys.into_iter().take(20) {\n+            let counts = &k.counts;\n+            lines.push(format!(\"  {}:\", k.key));\n+            lines.push(format!(\n+                \"    n={} (failed={}, OOM={}), exceeded={} (success={}, failed={}, OOM={}), worst={} at {}\",\n+                counts.n,\n+                counts.failed,\n+                counts.oom_killed,\n+                counts.exceeded,\n+                counts.success_exceeded,\n+                counts.failed_exceeded,\n+                counts.oom_killed_exceeded,\n+                ratio(counts.worst_peak_reserved_ratio),\n+                utc(counts.worst_ts_ms),\n+            ));\n+            lines.push(format!(\n+                \"    peak/predicted median={} p90={}, highest peak={}, unused on average={}\",\n+                ratio(k.median_peak_predicted_ratio),\n+                ratio(k.p90_peak_predicted_ratio),\n+                counts\n+                    .highest_peak_bytes\n+                    .map_or_else(|| \"unknown\".into(), crate::stats::size),\n+                k.average_reserved_unused_bytes.map_or_else(\n+                    || \"unknown\".into(),\n+                    |bytes| crate::stats::size(bytes as u64)\n+                ),\n+            ));\n+        }\n+        lines.join(\"\\n\")\n+    }\n+}\n+\n+/// A UTC time to the second, for reading observation spans at a glance.\n+fn utc(ms: Option<u64>) -> String {\n+    ms.and_then(|ms| i64::try_from(ms).ok())\n+        .and_then(|ms| jiff::Timestamp::from_millisecond(ms).ok())\n+        .map_or_else(\n+            || \"an unknown time\".into(),\n+            |timestamp| timestamp.strftime(\"%Y-%m-%d %H:%M:%S UTC\").to_string(),\n+        )\n+}\n+\n+#[cfg(test)]\n+mod tests {\n+    use super::*;\n+\n+    fn pool(dir: &Path, bytes: u64) -> Pool {\n+        let mut pool = Pool::new(dir.into(), 16, bytes, SchedulerPriority::Normal);\n+        pool.available_memory = || None;\n+        pool.pressure = false;\n+        pool.domain_capacity = 16;\n+        pool.clock = || 1000;\n+        pool.pressure_domain = \"fixture-domain\";\n+        pool\n+    }\n+\n+    fn observation(peak: Option<u64>, outcome: &str, ts_ms: u64) -> Observation {\n+        Observation {\n+            v: 1,\n+            ts_ms,\n+            mbx_version: \"fixture\".into(),\n+            pressure_domain: \"fixture-domain\".into(),\n+            kind: \"compile\".into(),\n+            name: \"crate\".into(),\n+            key: \"crate [compile fixture]\".into(),\n+            build_id: None,\n+            build_capacity: None,\n+            domain_capacity: None,\n+            source: \"mode\".into(),\n+            predicted_bytes: Some(100),\n+            charged_permits: 2,\n+            charged_cpu: None,\n+            charged_memory_bytes: None,\n+            bytes_per_permit: 100,\n+            peak_bytes: peak,\n+            outcome: outcome.into(),\n+            wrapped: false,\n+            admission_wait_ms: 4,\n+            run_ms: 10,\n+        }\n+    }\n+\n+    fn status(code: u32) -> ExitStatus {\n+        #[cfg(unix)]\n+        {\n+            use std::os::unix::process::ExitStatusExt;\n+            ExitStatus::from_raw(code as i32)\n+        }\n+        #[cfg(windows)]\n+        {\n+            use std::os::windows::process::ExitStatusExt;\n+            ExitStatus::from_raw(code)\n+        }\n+    }\n+\n+    #[test]\n+    fn kinds_schema_size_and_admitted_charge() {\n+        let dir = tempfile::tempdir().unwrap();\n+        let mut pool = pool(dir.path(), 100);\n+        pool.build = Some((\"build-123\".into(), 7));\n+        let demands = [\n+            (\n+                Demand::new(\"crate\", false).with_link_profile(&[]),\n+                \"compile\",\n+            ),\n+            (Demand::new(\"link\", true), \"link\"),\n+            (Demand::test(\"suite\", Some(1)), \"test-binary\"),\n+            (Demand::nextest(\"binary\", \"case\"), \"nextest-test\"),\n+        ];\n+        for (demand, kind) in demands {\n+            let permit = pool.admit(&demand).unwrap();\n+            let admission = demand.observation.get().unwrap();\n+            pool.observe(&demand, &status(0), Some(150));\n+            drop(permit);\n+            let lines = std::fs::read_to_string(dir.path().join(FILE)).unwrap();\n+            let line = lines.lines().next_back().unwrap();\n+            assert!(line.len() < 1023);\n+            let value: serde_json::Value = serde_json::from_str(line).unwrap();\n+            assert_eq!(value[\"v\"], 1);\n+            assert_eq!(value[\"ts_ms\"], 1000);\n+            assert_eq!(value[\"mbx_version\"], env!(\"CARGO_PKG_VERSION\"));\n+            assert_eq!(value[\"kind\"], kind);\n+            assert_eq!(value[\"name\"], demand.name);\n+            assert_eq!(\n+                value[\"key\"],\n+                demand\n+                    .compile_mode\n+                    .clone()\n+                    .unwrap_or_else(|| ledger_key(&demand.name, demand.links))\n+            );\n+            assert_eq!(value[\"source\"], admission.source);\n+            assert_eq!(\n+                value[\"predicted_bytes\"],\n+                serde_json::json!(admission.predicted)\n+            );\n+            assert_eq!(value[\"charged_permits\"], admission.weight);\n+            assert_eq!(value[\"charged_cpu\"], admission.resources.cpu);\n+            assert_eq!(\n+                value[\"charged_memory_bytes\"],\n+                admission.resources.memory_bytes\n+            );\n+            assert_eq!(value[\"bytes_per_permit\"], 100);\n+            assert_eq!(value[\"pressure_domain\"], \"fixture-domain\");\n+            assert_eq!(value[\"build_id\"], \"build-123\");\n+            assert_eq!(value[\"build_capacity\"], 7);\n+            assert_eq!(value[\"domain_capacity\"], 16);\n+            assert_eq!(value[\"peak_bytes\"], 150);\n+            assert_eq!(value[\"outcome\"], \"success\");\n+            assert_eq!(value[\"wrapped\"], false);\n+            assert!(value[\"run_ms\"].is_u64());\n+            assert!(value[\"admission_wait_ms\"].is_u64());\n+            pool.observe(&demand, &status(0), Some(150));\n+            assert_eq!(\n+                std::fs::read_to_string(dir.path().join(FILE)).unwrap(),\n+                lines\n+            );\n+        }\n+        let mut long = observation(Some(u64::MAX), \"failed\", u64::MAX);\n+        long.predicted_bytes = Some(u64::MAX);\n+        long.charged_permits = u64::MAX;\n+        long.charged_cpu = Some(u64::MAX);\n+        long.charged_memory_bytes = Some(u64::MAX);\n+        long.bytes_per_permit = u64::MAX;\n+        long.admission_wait_ms = u64::MAX;\n+        long.run_ms = u64::MAX;\n+        long.name = \"\\n🦀\".repeat(500);\n+        long.key = \"\\u{0001}🦀\".repeat(500);\n+        long.pressure_domain = \"\\n\".repeat(500);\n+        append(dir.path(), long).unwrap();\n+        let bytes = std::fs::read(dir.path().join(FILE)).unwrap();\n+        for line in bytes.split(|b| *b == b'\\n').filter(|line| !line.is_empty()) {\n+            assert!(line.len() < 1023);\n+            serde_json::from_slice::<Observation>(line).unwrap();\n+        }\n+    }\n+\n+    #[test]\n+    fn old_observation_lines_parse_without_optional_capacities() {\n+        let mut value = serde_json::to_value(observation(Some(10), \"success\", 1000)).unwrap();\n+        value.as_object_mut().unwrap().remove(\"charged_cpu\");\n+        value\n+            .as_object_mut()\n+            .unwrap()\n+            .remove(\"charged_memory_bytes\");\n+        value.as_object_mut().unwrap().remove(\"build_id\");\n+        value.as_object_mut().unwrap().remove(\"build_capacity\");\n+        value.as_object_mut().unwrap().remove(\"domain_capacity\");\n+        let parsed: Observation = serde_json::from_value(value).unwrap();\n+        assert_eq!(parsed.charged_cpu, None);\n+        assert_eq!(parsed.charged_memory_bytes, None);\n+        assert_eq!(parsed.build_id, None);\n+        assert_eq!(parsed.build_capacity, None);\n+        assert_eq!(parsed.domain_capacity, None);\n+\n+        let encoded = serde_json::to_value(observation(Some(10), \"success\", 1000)).unwrap();\n+        assert!(encoded.get(\"build_id\").is_none());\n+        assert!(encoded.get(\"build_capacity\").is_none());\n+        assert!(encoded.get(\"domain_capacity\").is_none());\n+        let dir = tempfile::tempdir().unwrap();\n+        append(dir.path(), observation(Some(10), \"success\", 1000)).unwrap();\n+        let summary = Summary::read(dir.path());\n+        assert_eq!(summary.overall.n, 1);\n+        assert_eq!(summary.overall.exceeded, 0);\n+    }\n+\n+    #[test]\n+    fn reservation_observation_records_weight_and_respects_gates() {\n+        let dir = tempfile::tempdir().unwrap();\n+        let observed_pool = pool(dir.path(), 100);\n+        let (permit, admission) = observed_pool.reserve_observed(Some(3), None).unwrap();\n+        drop(permit);\n+        observed_pool.observe_reservation(admission, Some(&status(0)));\n+        let line = std::fs::read_to_string(dir.path().join(FILE)).unwrap();\n+        let value: serde_json::Value = serde_json::from_str(line.lines().next().unwrap()).unwrap();\n+        assert_eq!(value[\"kind\"], \"reservation\");\n+        assert_eq!(value[\"key\"], \"reservation\");\n+        assert_eq!(value[\"charged_permits\"], 3);\n+        assert_eq!(value[\"charged_cpu\"], 3);\n+        assert_eq!(value[\"charged_memory_bytes\"], 0);\n+        assert_eq!(value[\"bytes_per_permit\"], 100);\n+        assert_eq!(value[\"peak_bytes\"], serde_json::Value::Null);\n+        assert_eq!(value[\"outcome\"], \"success\");\n+        let summary = Summary::read(dir.path());\n+        assert_eq!(summary.overall.n, 1);\n+        assert_eq!(summary.overall.exceeded, 0);\n+        assert_eq!(summary.overall.measured, 0);\n+        assert_eq!(summary.keys.len(), 1);\n+        assert_eq!(summary.keys[0].key, \"reservation\");\n+        assert_eq!(summary.keys[0].counts.n, 1);\n+\n+        for (events, bytes) in [(false, 100), (true, 0)] {\n+            let gated_dir = tempfile::tempdir().unwrap();\n+            let mut gated_pool = pool(gated_dir.path(), bytes);\n+            gated_pool.events = events;\n+            let (permit, admission) = gated_pool.reserve_observed(Some(1), None).unwrap();\n+            drop(permit);\n+            gated_pool.observe_reservation(admission, Some(&status(0)));\n+            assert!(!gated_dir.path().join(FILE).exists());\n+        }\n+    }\n+\n+    #[test]\n+    fn summary_prefers_exact_memory_charge_and_supports_legacy_lines() {\n+        let dir = tempfile::tempdir().unwrap();\n+        let mut exact = observation(Some(150), \"success\", 1000);\n+        exact.charged_cpu = Some(2);\n+        exact.charged_memory_bytes = Some(100);\n+        append(dir.path(), exact).unwrap();\n+        append(dir.path(), observation(Some(150), \"success\", 2000)).unwrap();\n+        let summary = Summary::read(dir.path());\n+        assert_eq!(summary.overall.exceeded, 1);\n+        assert_eq!(summary.overall.worst_peak_reserved_ratio, Some(1.5));\n+        assert_eq!(summary.keys[0].average_reserved_unused_bytes, Some(25.0));\n+        let (permit, admission) = pool(dir.path(), 100)\n+            .reserve_observed(Some(2), Some(201))\n+            .unwrap();\n+        drop(permit);\n+        pool(dir.path(), 100).observe_reservation(admission, None);\n+        let lines = std::fs::read_to_string(dir.path().join(FILE)).unwrap();\n+        let value: serde_json::Value =\n+            serde_json::from_str(lines.lines().next_back().unwrap()).unwrap();\n+        assert_eq!(value[\"charged_cpu\"], 2);\n+        assert_eq!(value[\"charged_memory_bytes\"], 201);\n+        assert_eq!(value[\"charged_permits\"], 3);\n+    }\n+\n+    #[test]\n+    fn gates_and_missing_admission_do_not_log() {\n+        for (events, bytes) in [(false, 100), (true, 0)] {\n+            let dir = tempfile::tempdir().unwrap();\n+            let mut pool = pool(dir.path(), bytes);\n+            pool.events = events;\n+            let demand = Demand::new(\"crate\", false);\n+            let _permit = pool.admit(&demand).unwrap();\n+            pool.observe(&demand, &status(0), Some(150));\n+            assert!(!dir.path().join(FILE).exists());\n+        }\n+        let dir = tempfile::tempdir().unwrap();\n+        pool(dir.path(), 100).observe(&Demand::new(\"unadmitted\", false), &status(0), Some(150));\n+        assert!(!dir.path().join(FILE).exists());\n+    }\n+\n+    #[test]\n+    fn rotation_replaces_previous_and_skips_held_lock() {\n+        let dir = tempfile::tempdir().unwrap();\n+        let path = dir.path().join(FILE);\n+        File::create(&path).unwrap().set_len(MAX_BYTES + 1).unwrap();\n+        std::fs::write(dir.path().join(PREVIOUS), b\"old\").unwrap();\n+        let mut lock = fslock::LockFile::open(&dir.path().join(LOCK)).unwrap();\n+        lock.lock().unwrap();\n+        append(dir.path(), observation(Some(100), \"success\", 1)).unwrap();\n+        assert!(std::fs::metadata(&path).unwrap().len() > MAX_BYTES);\n+        assert_eq!(std::fs::read(dir.path().join(PREVIOUS)).unwrap(), b\"old\");\n+        drop(lock);\n+        append(dir.path(), observation(Some(100), \"success\", 2)).unwrap();\n+        assert!(std::fs::metadata(dir.path().join(PREVIOUS)).unwrap().len() > MAX_BYTES);\n+        assert!(std::fs::metadata(path).unwrap().len() < 1024);\n+    }\n+\n+    #[test]\n+    fn prediction_sources_are_from_the_selected_path() {\n+        let dir = tempfile::tempdir().unwrap();\n+        let pool = pool(dir.path(), 100);\n+        let demand = Demand::new(\"crate\", false).with_link_profile(&[]);\n+        assert_eq!(pool.prediction(&demand).2, \"default\");\n+        pool.record_link_peak(\"crate\", 1000, false, None).unwrap();\n+        assert_eq!(pool.prediction(&demand).2, \"legacy\");\n+        for _ in 0..3 {\n+            pool.record_compile(&demand, 200, false, true).unwrap();\n+        }\n+        assert_eq!(pool.prediction(&demand), (3, Some(300), \"window\"));\n+        let link = Demand::new(\"unseen\", true);\n+        assert_eq!(pool.prediction(&link).2, \"link-floor\");\n+        for _ in 0..3 {\n+            pool.record_link_peak(\"known [link]\", 300, true, None)\n+                .unwrap();\n+        }\n+        assert_eq!(pool.prediction(&link).2, \"link-window\");\n+        assert_eq!(pool.prediction(&Demand::new(\"known\", true)).2, \"window\");\n+        let test = Demand::test(\"suite\", Some(1));\n+        pool.record_link_peak(&test.name, 300, false, None).unwrap();\n+        assert_eq!(pool.prediction(&test).2, \"test-history\");\n+        pool.record_test_history(\"bin\", \"case\", Some(300), None)\n+            .unwrap();\n+        assert_eq!(\n+            pool.prediction(&Demand::nextest(\"bin\", \"case\")).2,\n+            \"test-history\"\n+        );\n+        assert_eq!(\n+            pool.prediction(&Demand::nextest(\"bin\", \"sibling\")).2,\n+            \"test-history\"\n+        );\n+    }\n+\n+    #[test]\n+    fn summary_fixture_counts_failures_apart_and_uses_only_clean_samples() {\n+        let dir = tempfile::tempdir().unwrap();\n+        let mut previous = File::create(dir.path().join(PREVIOUS)).unwrap();\n+        previous.write_all(b\"\\xff\\n\").unwrap();\n+        for (peak, ts) in [(50, 1000), (100, 2000)] {\n+            writeln!(\n+                previous,\n+                \"{}\",\n+                serde_json::to_string(&observation(Some(peak), \"success\", ts)).unwrap()\n+            )\n+            .unwrap();\n+        }\n+        writeln!(previous, \"malformed\").unwrap();\n+        for (peak, outcome, ts) in [\n+            (Some(200), \"success\", 3000),\n+            (Some(500), \"failed\", 4000),\n+            (Some(800), \"oom-killed\", 5000),\n+            (None, \"success\", 6000),\n+        ] {\n+            append(dir.path(), observation(peak, outcome, ts)).unwrap();\n+        }\n+        let mut wrapped = observation(Some(1000), \"success\", 7000);\n+        wrapped.wrapped = true;\n+        append(dir.path(), wrapped).unwrap();\n+        let mut unknown = observation(Some(60), \"success\", 8000);\n+        unknown.predicted_bytes = None;\n+        append(dir.path(), unknown).unwrap();\n+        let summary = Summary::read(dir.path());\n+        assert_eq!(summary.overall.n, 8);\n+        assert_eq!(summary.overall.exceeded, 3);\n+        assert_eq!(summary.overall.failed_exceeded, 1);\n+        assert_eq!(summary.overall.oom_killed_exceeded, 1);\n+        assert_eq!(summary.overall.worst_peak_reserved_ratio, Some(5.0));\n+        assert_eq!(summary.overall.worst_ts_ms, Some(7000));\n+        assert_eq!(summary.start_ts_ms, Some(1000));\n+        assert_eq!(summary.end_ts_ms, Some(8000));\n+        let key = &summary.keys[0];\n+        assert_eq!(key.counts.failed, 1);\n+        assert_eq!(key.counts.oom_killed, 1);\n+        assert_eq!(key.clean_samples, 4);\n+        assert_eq!(key.predicted_samples, 3);\n+        assert_eq!(key.median_peak_predicted_ratio, Some(1.0));\n+        assert_eq!(key.p90_peak_predicted_ratio, Some(2.0));\n+        assert_eq!(key.average_reserved_unused_bytes, Some(97.5));\n+        assert_eq!(key.counts.highest_peak_bytes, Some(1000));\n+        let json = serde_json::to_value(&summary).unwrap();\n+        assert_eq!(json[\"n\"], 8);\n+        assert_eq!(json[\"keys\"][0][\"failed\"], 1);\n+        let text = summary.text();\n+        assert!(\n+            text.contains(\"1970-01-01 00:00:01 UTC to 1970-01-01 00:00:08 UTC\"),\n+            \"{text}\"\n+        );\n+        assert!(text.contains(\"at 1970-01-01 00:00:07 UTC\"), \"{text}\");\n+    }\n+\n+    #[test]\n+    fn failed_oom_wrapped_and_unavailable_peaks_are_recorded() {\n+        let dir = tempfile::tempdir().unwrap();\n+        let pool = pool(dir.path(), 100);\n+        let mut demand = Demand::new(\"crate\", false);\n+        demand.count_compile_samples = false;\n+        for (status, expected) in [(status(0), \"success\"), (status(256), \"failed\")] {\n+            let _permit = pool.admit(&demand).unwrap();\n+            pool.observe(&demand, &status, None);\n+            let text = std::fs::read_to_string(dir.path().join(FILE)).unwrap();\n+            let o: Observation = serde_json::from_str(text.lines().next_back().unwrap()).unwrap();\n+            assert_eq!(o.outcome, expected);\n+            assert!(o.wrapped);\n+            assert_eq!(o.peak_bytes, None);\n+        }\n+        #[cfg(unix)]\n+        {\n+            let _permit = pool.admit(&demand).unwrap();\n+            pool.observe(&demand, &status(9), Some(900));\n+            let summary = Summary::read(dir.path());\n+            assert_eq!(summary.overall.oom_killed, 1);\n+            assert_eq!(summary.overall.exceeded, 1);\n+            drop(_permit);\n+            let _permit = pool.admit(&demand).unwrap();\n+            pool.observe(&demand, &status(15), Some(900));\n+            let summary = Summary::read(dir.path());\n+            assert_eq!(summary.overall.other, 1);\n+            assert_eq!(summary.overall.other_exceeded, 1);\n+            let text = std::fs::read_to_string(dir.path().join(FILE)).unwrap();\n+            let o: Observation = serde_json::from_str(text.lines().next_back().unwrap()).unwrap();\n+            assert_eq!(o.outcome, \"signal-15\");\n+        }\n+    }\n+\n+    #[test]\n+    fn session_events_setting_is_forwarded() {\n+        let dir = tempfile::tempdir().unwrap();\n+        let mut config = Config::for_test(dir.path());\n+        config.scheduler.enabled = true;\n+        for enabled in [false, true] {\n+            config.events = enabled;\n+            let env = session_environment_with_jobs(&config, None);\n+            assert!(env.contains(&(\"MBX_SCHED_EVENTS\".into(), u8::from(enabled).to_string())));\n+            assert_eq!(Pool::from_config(&config).unwrap().events, enabled);\n+            assert_eq!(\n+                reservation_pool(&config, SchedulerPriority::Normal)\n+                    .unwrap()\n+                    .events,\n+                enabled\n+            );\n+        }\n+    }\n+\n+    #[test]\n+    fn default_stats_ignores_observations_in_text_and_json() {\n+        let dir = tempfile::tempdir().unwrap();\n+        let config = Config::for_test(dir.path());\n+        let before = crate::stats::collect(&config.store_dir(), &config.target.root).unwrap();\n+        append(\n+            &dir.path().join(SCHEDULER_DIR),\n+            observation(Some(500), \"failed\", 1000),\n+        )\n+        .unwrap();\n+        let after = crate::stats::collect(&config.store_dir(), &config.target.root).unwrap();\n+        assert_eq!(before.text(false), after.text(false));\n+        assert_eq!(\n+            serde_json::to_value(before).unwrap(),\n+            serde_json::to_value(after).unwrap()\n+        );\n+    }\n+\n+    #[test]\n+    fn text_limits_ranked_keys_while_json_retains_all() {\n+        let dir = tempfile::tempdir().unwrap();\n+        for i in 0..25 {\n+            let mut o = observation(Some(i * 100), \"success\", i + 1);\n+            o.key = format!(\"key-{i:02}\");\n+            append(dir.path(), o).unwrap();\n+        }\n+        let summary = Summary::read(dir.path());\n+        let text = summary.text();\n+        assert_eq!(\n+            text.lines()\n+                .filter(|line| line.starts_with(\"  key-\"))\n+                .count(),\n+            20\n+        );\n+        assert!(text.contains(\"  key-24:\"));\n+        assert!(!text.contains(\"  key-04:\"));\n+        assert!(text.find(\"  key-24:\").unwrap() < text.find(\"  key-23:\").unwrap());\n+        assert_eq!(\n+            serde_json::to_value(&summary).unwrap()[\"keys\"]\n+                .as_array()\n+                .unwrap()\n+                .len(),\n+            25\n+        );\n+    }\n+\n+    #[test]\n+    fn even_median_and_nearest_rank_p90() {\n+        let dir = tempfile::tempdir().unwrap();\n+        for peak in [100, 300, 200, 400] {\n+            append(dir.path(), observation(Some(peak), \"success\", 1)).unwrap();\n+        }\n+        let summary = Summary::read(dir.path());\n+        assert_eq!(summary.keys[0].median_peak_predicted_ratio, Some(2.5));\n+        assert_eq!(summary.keys[0].p90_peak_predicted_ratio, Some(4.0));\n+    }\n+\n+    #[test]\n+    fn a_long_build_id_is_shortened_instead_of_dropping_the_line() {\n+        let dir = tempfile::tempdir().unwrap();\n+        let mut long = observation(Some(1), \"success\", 1);\n+        long.build_id = Some(\"b\".repeat(2000));\n+        append(dir.path(), long).unwrap();\n+        let summary = Summary::read(dir.path());\n+        assert_eq!(summary.keys.len(), 1);\n+        assert_eq!(summary.keys[0].counts.n, 1);\n+    }\n+\n+    #[test]\n+    fn a_long_key_is_shortened_the_same_way_on_every_line() {\n+        let dir = tempfile::tempdir().unwrap();\n+        let key = format!(\"crate [compile {}]\", \"x\".repeat(200));\n+        let mut short_line = observation(Some(1), \"success\", 1);\n+        short_line.key.clone_from(&key);\n+        let mut long_line = observation(Some(u64::MAX), \"success\", u64::MAX);\n+        long_line.key.clone_from(&key);\n+        long_line.mbx_version = \"v\".repeat(300);\n+        append(dir.path(), short_line).unwrap();\n+        append(dir.path(), long_line).unwrap();\n+        let summary = Summary::read(dir.path());\n+        assert_eq!(summary.keys.len(), 1);\n+        assert_eq!(summary.keys[0].counts.n, 2);\n+        assert!(summary.keys[0].key.len() < key.len());\n+    }\n+\n+    #[test]\n+    fn empty_summary_is_read_only() {\n+        let dir = tempfile::tempdir().unwrap();\n+        assert_eq!(\n+            Summary::read(&dir.path().join(\"missing\")).text(),\n+            \"Estimate accuracy: no observations.\"\n+        );\n+        assert!(!dir.path().join(\"missing\").exists());\n+    }\n+}"},{"sha":"596ad851b8ef5887e8422471d0fc07a30d089498","filename":"crates/mbx/src/scheduler_legacy_tests.rs","status":"added","additions":571,"deletions":0,"changes":571,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fscheduler_legacy_tests.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fscheduler_legacy_tests.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fscheduler_legacy_tests.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -0,0 +1,571 @@\n+// Compatibility reference copied from fe73826. Keep independent of the vector policy.\n+#[derive(Clone, Serialize, Deserialize)]\n+pub(super) struct Lease {\n+    version: u8,\n+    #[serde(default)]\n+    name: Option<String>,\n+    #[serde(default)]\n+    mode_key: Option<String>,\n+    weight: u64,\n+    priority: String,\n+    #[serde(default)]\n+    build_id: Option<String>,\n+    #[serde(default)]\n+    domain: Option<String>,\n+    #[serde(default)]\n+    bytes_per_permit: u64,\n+}\n+\n+#[derive(Clone, Serialize, Deserialize)]\n+pub(super) struct Waiting {\n+    #[serde(default)]\n+    name: Option<String>,\n+    #[serde(default)]\n+    mode_key: Option<String>,\n+    ticket: u64,\n+    weight: u64,\n+    priority: String,\n+    domain: String,\n+    domain_capacity: u64,\n+    #[serde(default)]\n+    global_capacity: Option<u64>,\n+    bytes_per_permit: u64,\n+    build: Option<(String, u64)>,\n+}\n+\n+fn fits(used: u64, weight: u64, capacity: u64) -> bool {\n+    used == 0 || used.saturating_add(weight) <= capacity\n+}\n+\n+// Sessions keep their original permit units across a configuration change.\n+// Never charge a larger memory permit as one of a smaller pool's permits.\n+// Keep the original weight as a CPU floor: reservations and tests may have\n+// requested that many cores, even when their memory fits fewer new permits.\n+fn lease_weight(lease: &Lease, bytes_per_permit: u64) -> u64 {\n+    weight_in_units(lease.weight, lease.bytes_per_permit, bytes_per_permit)\n+}\n+\n+fn weight_in_units(weight: u64, original_unit: u64, unit: u64) -> u64 {\n+    if unit == 0 {\n+        weight\n+    } else {\n+        weight.max(weight.saturating_mul(original_unit).div_ceil(unit))\n+    }\n+}\n+\n+/// Protect every prefix of the older queue against every possible completion\n+/// order. Earlier waiters eventually become leases too, so their weights join\n+/// the subset sums after checking each prefix.\n+fn can_pass_waiters(capacity: u64, live: &[u64], older: &[u64], weight: u64) -> bool {\n+    if older.is_empty() {\n+        return true;\n+    }\n+    // Bound the complete bitset, including future leases from older waiters.\n+    const MAX_BITS: u64 = 1 << 16;\n+    let Some(total) = live.iter().chain(older).try_fold(0_u64, |sum, w| {\n+        sum.checked_add(*w).filter(|sum| *sum < MAX_BITS)\n+    }) else {\n+        return false;\n+    };\n+    let used: u64 = live.iter().sum();\n+    let Some(free) = capacity.checked_sub(used) else {\n+        return false;\n+    };\n+    if weight > free {\n+        return false;\n+    }\n+    let mut sums = vec![0_u64; (total as usize + 1).div_ceil(64)];\n+    sums[0] = 1;\n+    for w in live {\n+        add_subset_weight(&mut sums, *w as usize);\n+    }\n+    let mut prefix = 0;\n+    for h in older {\n+        prefix += h;\n+        let slack = if prefix <= free {\n+            free - prefix\n+        } else {\n+            let threshold = (prefix - free) as usize;\n+            let first_word = threshold / 64;\n+            let Some(sum) = (first_word..sums.len()).find_map(|index| {\n+                let bits = if index == first_word {\n+                    sums[index] & (u64::MAX << (threshold % 64))\n+                } else {\n+                    sums[index]\n+                };\n+                (bits != 0).then(|| index * 64 + bits.trailing_zeros() as usize)\n+            }) else {\n+                return false;\n+            };\n+            (sum - threshold) as u64\n+        };\n+        if weight > slack {\n+            return false;\n+        }\n+        add_subset_weight(&mut sums, *h as usize);\n+    }\n+    true\n+}\n+\n+fn add_subset_weight(sums: &mut [u64], weight: usize) {\n+    let words = weight / 64;\n+    let shift = weight % 64;\n+    for index in (words..sums.len()).rev() {\n+        let mut shifted = sums[index - words] << shift;\n+        if shift != 0 && index > words {\n+            shifted |= sums[index - words - 1] >> (64 - shift);\n+        }\n+        sums[index] |= shifted;\n+    }\n+}\n+\n+fn domain_used(live: &[Lease], domain: &str, bytes_per_permit: u64) -> u64 {\n+    live.iter()\n+        // Old wrappers do not identify their domain. Charge them locally too\n+        // until they finish, rather than over-admitting during an upgrade.\n+        .filter(|lease| lease.domain.as_deref().is_none_or(|id| id == domain))\n+        .map(|lease| lease_weight(lease, bytes_per_permit))\n+        .sum()\n+}\n+\n+fn build_fits(\n+    live: &[Lease],\n+    build: &Option<(String, u64)>,\n+    weight: u64,\n+    bytes_per_permit: u64,\n+) -> bool {\n+    build.as_ref().is_none_or(|(id, capacity)| {\n+        fits(\n+            live.iter()\n+                .filter(|lease| lease.build_id.as_ref() == Some(id))\n+                .map(|lease| lease_weight(lease, bytes_per_permit))\n+                .sum(),\n+            weight,\n+            *capacity,\n+        )\n+    })\n+}\n+\n+#[derive(Debug, PartialEq, Eq)]\n+pub(super) enum AdmissionDecision {\n+    Ordered,\n+    Passing,\n+    Waiting,\n+}\n+\n+/// Pure admission policy, shared by the pool and the event simulations. Keep\n+/// today's scope exceptions as a fast path; only a refusal needs the slack\n+/// calculation across every scope the passer shares with an older waiter.\n+pub(super) fn admission_decision<'a>(\n+    capacity: u64,\n+    live: &[Lease],\n+    waiting: impl Iterator<Item = &'a Waiting>,\n+    request: &Waiting,\n+) -> AdmissionDecision {\n+    let used = live\n+        .iter()\n+        .map(|lease| lease_weight(lease, request.bytes_per_permit))\n+        .sum();\n+    if !build_fits(\n+        live,\n+        &request.build,\n+        request.weight,\n+        request.bytes_per_permit,\n+    ) || !fits(\n+        domain_used(live, &request.domain, request.bytes_per_permit),\n+        request.weight,\n+        request.domain_capacity,\n+    ) || !fits(used, request.weight, capacity)\n+    {\n+        return AdmissionDecision::Waiting;\n+    }\n+    let mut older: Vec<_> = waiting\n+        .filter(|older| {\n+            older.ticket < request.ticket\n+                && !(older.priority == \"low\" && request.priority == \"normal\")\n+        })\n+        .collect();\n+    older.sort_unstable_by_key(|older| older.ticket);\n+    let ordered_blocked = older.iter().any(|older| {\n+        if !build_fits(live, &older.build, older.weight, older.bytes_per_permit) {\n+            return older.build.as_ref().map(|(id, _)| id)\n+                == request.build.as_ref().map(|(id, _)| id);\n+        }\n+        if !fits(\n+            domain_used(live, &older.domain, older.bytes_per_permit),\n+            older.weight,\n+            older.domain_capacity,\n+        ) {\n+            return older.domain == request.domain;\n+        }\n+        true\n+    });\n+    if !ordered_blocked {\n+        return AdmissionDecision::Ordered;\n+    }\n+    let scope_allows = |capacity, unit, build: Option<&str>, domain: Option<&str>| {\n+        let weights: Vec<_> = live\n+            .iter()\n+            .filter(|lease| {\n+                build.is_none_or(|id| lease.build_id.as_deref() == Some(id))\n+                    && domain.is_none_or(|id| {\n+                        lease\n+                            .domain\n+                            .as_deref()\n+                            .is_none_or(|lease_id| lease_id == id)\n+                    })\n+            })\n+            .map(|lease| lease_weight(lease, unit))\n+            .collect();\n+        // Include all older waiters in this physical scope, even if a\n+        // different ceiling currently blocks them. Their weights can later\n+        // become live leases and must participate in the prefix calculation.\n+        let heads: Vec<_> = older\n+            .iter()\n+            .filter(|waiter| {\n+                build.is_none_or(|id| waiter.build.as_ref().map(|(id, _)| id.as_str()) == Some(id))\n+                    && domain.is_none_or(|id| waiter.domain == id)\n+            })\n+            .map(|waiter| weight_in_units(waiter.weight, waiter.bytes_per_permit, unit))\n+            .collect();\n+        can_pass_waiters(\n+            capacity,\n+            &weights,\n+            &heads,\n+            weight_in_units(request.weight, request.bytes_per_permit, unit),\n+        )\n+    };\n+    // Every scope may retain older permit units/limits, so protect each\n+    // distinct recorded pair, starting with the request's global budget.\n+    if !scope_allows(capacity, request.bytes_per_permit, None, None) {\n+        return AdmissionDecision::Waiting;\n+    }\n+    let mut checked_global =\n+        std::collections::BTreeSet::from([(capacity, request.bytes_per_permit)]);\n+    let mut checked = std::collections::BTreeSet::new();\n+    for waiter in &older {\n+        // Older mbx records lack the global ceiling; retain the request's\n+        // capacity as the fallback until those waiters leave the queue.\n+        let waiter_capacity = waiter.global_capacity.unwrap_or(capacity);\n+        if checked_global.insert((waiter_capacity, waiter.bytes_per_permit))\n+            && !scope_allows(waiter_capacity, waiter.bytes_per_permit, None, None)\n+        {\n+            return AdmissionDecision::Waiting;\n+        }\n+        if waiter.domain == request.domain\n+            && checked.insert((false, waiter.domain_capacity, waiter.bytes_per_permit))\n+            && !scope_allows(\n+                waiter.domain_capacity,\n+                waiter.bytes_per_permit,\n+                None,\n+                Some(&waiter.domain),\n+            )\n+        {\n+            return AdmissionDecision::Waiting;\n+        }\n+        if let (Some((id, ceiling)), Some((request_id, _))) = (&waiter.build, &request.build)\n+            && id == request_id\n+            && checked.insert((true, *ceiling, waiter.bytes_per_permit))\n+            && !scope_allows(*ceiling, waiter.bytes_per_permit, Some(id), None)\n+        {\n+            return AdmissionDecision::Waiting;\n+        }\n+    }\n+    AdmissionDecision::Passing\n+}\n+\n+pub(super) fn local_ceiling(\n+    capacity: u64,\n+    bytes_per_permit: u64,\n+    cpus: u64,\n+    memory: Option<u64>,\n+) -> u64 {\n+    let memory = if bytes_per_permit == 0 {\n+        capacity\n+    } else {\n+        memory.map_or(capacity, |bytes| {\n+            // The budget admission enforces. Permit rounding puts it fewer\n+            // than `capacity` bytes below the configured value.\n+            let budget = capacity.saturating_mul(bytes_per_permit);\n+            if budget > bytes {\n+                (bytes / 100 * 85) / bytes_per_permit\n+            } else {\n+                capacity\n+            }\n+        })\n+    };\n+    capacity.min(cpus).min(memory).max(1)\n+}\n+\n+pub(super) fn prediction(pool: &Pool, demand: &Demand) -> (u64, Option<u64>, &'static str) {\n+    if let Some(identity) = &demand.per_test {\n+        let path = test_history_path(&pool.dir.join(TEST_HISTORY_DIR), &identity.binary);\n+        let history = lookup_test_history(&path, &identity.binary, &identity.test);\n+        if history.header.count > 0 {\n+            refresh_test_history(&path);\n+        }\n+        identity.known.set(Some(history.test.unwrap_or_default()));\n+        let measurement = history\n+            .test\n+            .or_else(|| (history.header.count > 0).then_some(history.header.maximum));\n+        let cores = measurement\n+            .and_then(|measurement| measurement.cores)\n+            .unwrap_or(1)\n+            .max(1);\n+        if pool.bytes_per_permit == 0 {\n+            return (cores.min(pool.capacity), None, \"unmeasured\");\n+        }\n+        let known_peak = measurement.and_then(|measurement| measurement.peak);\n+        let predicted = known_peak\n+            .unwrap_or_else(|| UNMEASURED_TEST_WEIGHT.saturating_mul(pool.bytes_per_permit));\n+        let weight = predicted\n+            .div_ceil(pool.bytes_per_permit)\n+            .max(cores)\n+            .clamp(1, pool.capacity);\n+        return (\n+            weight,\n+            Some(predicted),\n+            if known_peak.is_some() {\n+                \"test-history\"\n+            } else {\n+                \"unmeasured\"\n+            },\n+        );\n+    }\n+    // What a test binary was measured using beats what it said or what\n+    // its harness would default to: libtest starts a thread per CPU\n+    // whether or not the tests keep them busy.\n+    let learned = demand\n+        .learns_cpu\n+        .then(|| {\n+            read_ledger(&pool.ledger_path())\n+                .cpus\n+                .get(&demand.name)\n+                .copied()\n+        })\n+        .flatten();\n+    let threads = learned\n+        .or(demand.threads)\n+        .unwrap_or_else(|| pool.capacity.div_ceil(2))\n+        .max(1);\n+    let link_floor = demand.links.then_some(LINK_WEIGHT);\n+    if pool.bytes_per_permit == 0 {\n+        return (\n+            link_floor.unwrap_or(1).max(threads).min(pool.capacity),\n+            None,\n+            \"unmeasured\",\n+        );\n+    }\n+    let ledger = read_ledger(&pool.ledger_path());\n+    let recorded = ledger\n+        .crates\n+        .get(&ledger_key(&demand.name, demand.links))\n+        .copied();\n+    let mut link_source = \"link-floor\";\n+    let link_bytes = link_floor.map(|weight| {\n+        // What this machine's links have actually cost beats a constant\n+        // chosen before anyone had seen one. Every test binary is its own\n+        // crate name, so a cold `cargo test --no-run` never gets to reuse\n+        // the measurement of the link it just made -- the per-crate entry\n+        // is always missing for the one in front of it -- and this is the\n+        // history it can use instead. The heaviest of the window rather\n+        // than its average, because the cost of guessing low is an\n+        // out-of-memory kill and the cost of guessing high is a wait.\n+        //\n+        // A link with a known profile consults only that profile's\n+        // window, so a release LTO link never speaks for a dev link.\n+        let window = match &demand.profile {\n+            Some(profile) => ledger\n+                .profile_link_peaks\n+                .get(profile)\n+                .map_or(&[][..], Vec::as_slice),\n+            None => ledger.link_peaks.as_slice(),\n+        };\n+        let measured = (window.len() >= MIN_LINK_SAMPLES)\n+            .then(|| window.iter().copied().max())\n+            .flatten();\n+        if measured.is_some() {\n+            link_source = \"link-window\";\n+        }\n+        measured.unwrap_or_else(|| weight.saturating_mul(pool.bytes_per_permit))\n+    });\n+    // History replaces the floor rather than merely raising it. The floor\n+    // is a guess for links the pool has never seen; once one has been\n+    // measured, charging it the guess anyway would hold the tail of every\n+    // build -- the link-heavy stretch -- to half the concurrency its real\n+    // memory justifies. The ledger never lowers a recorded peak and an\n+    // OOM kill escalates past it, so trusting the measurement stays safe\n+    // in the direction that matters.\n+    //\n+    // Only a *link's* own history may retire the link floor, which is why\n+    // the two are separate ledger entries. One crate is compiled both\n+    // ways in a single build -- `cargo check` emits metadata where `cargo\n+    // build` links -- and the metadata-only measurement is the smaller of\n+    // the two by far. Keyed by name alone it would retire the floor for\n+    // the link beside it, which is over-admission with a plausible number\n+    // attached to it.\n+    let (estimate, source) = if let Some(key) = &demand.compile_mode {\n+        let (value, trusted) = legacy_compile_prediction(&ledger, &demand.name, key);\n+        (\n+            value,\n+            if trusted {\n+                \"mode\"\n+            } else if value.is_some() {\n+                \"crate-wide\"\n+            } else {\n+                \"unmeasured\"\n+            },\n+        )\n+    } else {\n+        (\n+            recorded,\n+            if recorded.is_none() {\n+                \"unmeasured\"\n+            } else if demand.learns_cpu {\n+                \"test-history\"\n+            } else if demand.links {\n+                \"link-history\"\n+            } else {\n+                \"crate-wide\"\n+            },\n+        )\n+    };\n+    let (predicted, source) = match estimate {\n+        Some(value) => (Some(value), source),\n+        None if link_bytes.is_some() => (link_bytes, link_source),\n+        None => (None, source),\n+    };\n+    // Memory and threads are separate costs of the same process; it takes\n+    // whichever share of the pool is larger.\n+    let weight = predicted\n+        .map_or(1, |bytes| bytes.div_ceil(pool.bytes_per_permit))\n+        .max(threads)\n+        .clamp(1, pool.capacity);\n+    (weight, predicted, source)\n+}\n+\n+// State writer copied from f47d416, before calibrated windows.\n+pub(super) fn record_compile(\n+        pool: &super::Pool,\n+        demand: &Demand,\n+        measured: u64,\n+        oom: bool,\n+        succeeded: bool,\n+    ) -> Result<()> {\n+        let Some(key) = demand.compile_mode.as_ref() else {\n+            return Ok(());\n+        };\n+        if pool.bytes_per_permit == 0 {\n+            return Ok(());\n+        }\n+        let succeeded = succeeded && demand.count_compile_samples;\n+        let peak = ledger_peak(measured, oom, false, succeeded, pool.bytes_per_permit);\n+        // Ordinary light crates need no ledger lock. A concurrent first heavy\n+        // sample may be missed here; that only delays trusting the light mode.\n+        if peak.is_none()\n+            && !read_ledger(&pool.ledger_path())\n+                .crates\n+                .contains_key(&demand.name)\n+        {\n+            return Ok(());\n+        }\n+        std::fs::create_dir_all(&pool.dir)?;\n+        let mut lock = fslock::LockFile::open(&pool.dir.join(LEDGER_LOCK))?;\n+        lock.lock()?;\n+        let mut ledger = read_ledger(&pool.ledger_path());\n+        let mode_peak = peak.unwrap_or(measured);\n+        let bare_known = ledger.crates.get(&demand.name).copied();\n+        let mode_known = ledger.crates.get(key).copied();\n+        let count = ledger.compile_samples.get(key).copied().unwrap_or(0);\n+        if bare_known.is_some_and(|bare| peak.is_none_or(|peak| peak <= bare))\n+            && mode_known.is_some_and(|known| known >= mode_peak)\n+            && (!succeeded || oom || count >= 3)\n+        {\n+            return Ok(());\n+        }\n+        if let Some(peak) = peak {\n+            // A mode may survive without its bare entry (e.g. an old writer's\n+            // eviction). Recreating the fallback must cover every retained\n+            // mode, rather than cap a known mode below its measured maximum.\n+            let retained = if bare_known.is_none() {\n+                let prefix = format!(\"{} [compile \", demand.name);\n+                ledger\n+                    .crates\n+                    .iter()\n+                    .filter(|(name, _)| name.starts_with(&prefix))\n+                    .map(|(_, peak)| *peak)\n+                    .max()\n+                    .unwrap_or(0)\n+            } else {\n+                0\n+            };\n+            let bare = ledger.crates.entry(demand.name.clone()).or_default();\n+            *bare = (*bare).max(peak).max(retained);\n+        }\n+        if !ledger.crates.contains_key(&demand.name) {\n+            return Ok(());\n+        }\n+        // Even a light successful mode must learn when its crate is heavy.\n+        let mode = ledger.crates.entry(key.clone()).or_default();\n+        *mode = (*mode).max(mode_peak);\n+        if succeeded && !oom {\n+            let count = ledger.compile_samples.entry(key.clone()).or_default();\n+            *count = count.saturating_add(1).min(3);\n+        }\n+        ledger.version = LEDGER_VERSION;\n+        trim_compile_ledger(&mut ledger);\n+        let mut contents = serde_json::to_vec(&ledger)?;\n+        contents.push(b'\\n');\n+        crate::util::write_advisory(&pool.ledger_path(), &contents)\n+    }\n+\n+\n+// Link writer copied from f47d416.\n+pub(super) fn record_link_peak(\n+        pool: &super::Pool,\n+        name: &str,\n+        peak: u64,\n+        links: bool,\n+        profile: Option<&str>,\n+    ) -> Result<()> {\n+        std::fs::create_dir_all(&pool.dir)\n+            .wrap_err_with(|| format!(\"failed to create {}\", pool.dir.display()))?;\n+        let mut lock = fslock::LockFile::open(&pool.dir.join(LEDGER_LOCK))?;\n+        lock.lock()?;\n+        let path = pool.ledger_path();\n+        let mut ledger = read_ledger(&path);\n+        ledger.version = LEDGER_VERSION;\n+        // The window records every link, including one whose per-crate entry\n+        // is already higher: it says what links cost around here lately, which\n+        // a measurement no worse than the last one still answers.\n+        if links {\n+            let window = match profile {\n+                Some(profile) => ledger\n+                    .profile_link_peaks\n+                    .entry(profile.to_string())\n+                    .or_default(),\n+                None => &mut ledger.link_peaks,\n+            };\n+            window.push(peak);\n+            let surplus = window.len().saturating_sub(MAX_LINK_SAMPLES);\n+            window.drain(..surplus);\n+            while ledger.profile_link_peaks.len() > MAX_LEDGER_ENTRIES {\n+                ledger.profile_link_peaks.pop_first();\n+            }\n+        }\n+        let known = ledger.crates.get(name).is_some_and(|known| *known >= peak);\n+        if known && !links {\n+            // Nothing moved: the entry already stands higher and there is no\n+            // window entry to add. Rewriting the file identically would cost\n+            // every repeat compilation a write under this lock.\n+            return Ok(());\n+        }\n+        if !known {\n+            ledger.crates.insert(name.to_string(), peak);\n+        }\n+        trim_compile_ledger(&mut ledger);\n+        let mut contents = serde_json::to_vec(&ledger)?;\n+        contents.push(b'\\n');\n+        // A heuristic every link refreshes: a lost write costs one sample.\n+        crate::util::write_advisory(&path, &contents)\n+    }"},{"sha":"18c4f76326260842d24f508eb928e72650aa6e3d","filename":"crates/mbx/src/scheduler_memory.rs","status":"added","additions":704,"deletions":0,"changes":704,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fscheduler_memory.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fscheduler_memory.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fscheduler_memory.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -0,0 +1,704 @@\n+//! Windowed log-space prediction. Legacy ledger values are written separately.\n+use super::{MAX_LEDGER_ENTRIES, MemoryLedger};\n+use std::collections::BTreeMap;\n+\n+pub(super) const WINDOW: usize = 16;\n+const MAX_RESIDUALS: usize = 256;\n+const MIN_RESIDUALS: usize = 50;\n+const MIN_POOL_KEYS: usize = 10;\n+/// Samples a key needs, like a key qualifying for the pooled spread, before\n+/// its own estimate may exceed the previous rule's charge.\n+const MIN_KEY_SAMPLES: usize = 4;\n+const DEFAULT_SIGMA_POOL: f64 = 0.5;\n+const NU0: usize = 4;\n+pub(super) const KINDS: [&str; 4] = [\"compile\", \"link\", \"test-binary\", \"nextest-test\"];\n+// Smallest p passing the 2026-10-18 causal 2D-P1 replay: 4.979% exceedance,\n+// max concurrent actual peaks 85.91 GiB (<98 GiB physical). Analysis and\n+// snapshot: mr-boxington-wt/replay/windowed/report.md and results.json.\n+pub(super) const TARGET_P: f64 = 0.95;\n+// One-sided Student-t p=.95, df 1..30; the duration-estimator replay table.\n+const T_QUANTILES: [f64; 30] = [\n+    6.313751514675,\n+    2.919985580354,\n+    2.353363434802,\n+    2.131846786327,\n+    2.015048373333,\n+    1.943180280515,\n+    1.89457860509,\n+    1.859548037531,\n+    1.833112932656,\n+    1.812461122812,\n+    1.795884818704,\n+    1.782287555649,\n+    1.770933395987,\n+    1.761310135775,\n+    1.753050355693,\n+    1.745883676276,\n+    1.739606726075,\n+    1.734063606617,\n+    1.729132811521,\n+    1.724718242921,\n+    1.720742902812,\n+    1.71714437438,\n+    1.713871527747,\n+    1.710882079909,\n+    1.708140761252,\n+    1.705617919759,\n+    1.703288445722,\n+    1.701130934266,\n+    1.699127026534,\n+    1.697260886594,\n+];\n+const NORMAL_QUANTILE: f64 = 1.6448536269514715;\n+\n+#[derive(Debug, Clone, Copy)]\n+pub(super) struct Features {\n+    pub mean: f64,\n+    pub scale: f64,\n+}\n+\n+#[derive(Clone, Copy)]\n+pub(super) struct Sample {\n+    pub peak: u64,\n+    pub features: Option<Features>,\n+    pub calibrate: bool,\n+}\n+\n+impl Features {\n+    // A planned cold key has no residual. Preserve that fact even if another\n+    // process records its first sample while this request waits in the queue.\n+    pub(super) const COLD: Self = Self {\n+        mean: 0.0,\n+        scale: 0.0,\n+    };\n+}\n+\n+#[derive(Debug, Clone, Copy)]\n+pub(super) struct Estimate {\n+    pub n: usize,\n+    pub window_max: u64,\n+    pub bound: u64,\n+    pub charge: u64,\n+    pub q: f64,\n+    pub features: Features,\n+}\n+\n+pub(super) fn kind(key: &str) -> &'static str {\n+    if key.ends_with(\" [link]\") {\n+        \"link\"\n+    } else if key.contains(\" [test\") {\n+        \"test-binary\"\n+    } else {\n+        \"compile\"\n+    }\n+}\n+\n+fn moments(values: &[u64]) -> (f64, f64) {\n+    let mean = values.iter().map(|p| (*p as f64).ln()).sum::<f64>() / values.len() as f64;\n+    let variance = if values.len() > 1 {\n+        values\n+            .iter()\n+            .map(|p| ((*p as f64).ln() - mean).powi(2))\n+            .sum::<f64>()\n+            / (values.len() - 1) as f64\n+    } else {\n+        0.0\n+    };\n+    (mean, variance)\n+}\n+\n+pub(super) fn sigma_pool(ledger: &MemoryLedger, kind: &str) -> f64 {\n+    ledger\n+        .pooled_spreads\n+        .get(kind)\n+        .copied()\n+        .unwrap_or(DEFAULT_SIGMA_POOL)\n+}\n+\n+fn conformal_rank(n: usize) -> usize {\n+    ((TARGET_P * (n + 1) as f64).ceil() as usize).min(n)\n+}\n+\n+pub(super) fn quantile(ledger: &MemoryLedger, kind: &str, n: usize) -> f64 {\n+    let mut residuals: Vec<_> = ledger\n+        .memory_residuals\n+        .get(kind)\n+        .into_iter()\n+        .flatten()\n+        .copied()\n+        .filter(|r| r.is_finite())\n+        .collect();\n+    if residuals.len() >= MIN_RESIDUALS {\n+        residuals.sort_by(f64::total_cmp);\n+        // Finite-sample conformal rank, clamped to the available history.\n+        let rank = conformal_rank(residuals.len());\n+        residuals[rank - 1]\n+    } else {\n+        let df = NU0 + n.max(1) - 1;\n+        T_QUANTILES.get(df - 1).copied().unwrap_or(NORMAL_QUANTILE)\n+    }\n+}\n+\n+pub(super) fn estimate(ledger: &MemoryLedger, key: &str, kind: &str) -> Option<Estimate> {\n+    let values = ledger.memory_windows.get(key)?;\n+    let window_max = *values.iter().max()?;\n+    let n = values.len();\n+    let (mean, variance) = moments(values);\n+    let s = ((NU0 as f64 * sigma_pool(ledger, kind).powi(2) + (n - 1) as f64 * variance)\n+        / (NU0 + n - 1) as f64)\n+        .sqrt();\n+    let features = Features {\n+        mean,\n+        scale: s * (1.0 + 1.0 / n as f64).sqrt(),\n+    };\n+    let q = quantile(ledger, kind, n);\n+    // Float-to-integer casts saturate at u64::MAX for an overflowing bound.\n+    let bound = (mean + q * features.scale).exp().ceil() as u64;\n+    Some(Estimate {\n+        n,\n+        window_max,\n+        bound,\n+        charge: window_max.max(bound),\n+        q,\n+        features,\n+    })\n+}\n+\n+/// Whether a kind's pooled spread comes from data rather than the default.\n+fn calibrated(ledger: &MemoryLedger, kind_name: &str) -> bool {\n+    ledger\n+        .memory_windows\n+        .iter()\n+        .filter(|(key, values)| kind(key) == kind_name && values.len() >= 4)\n+        .count()\n+        >= MIN_POOL_KEYS\n+}\n+\n+/// While a kind's spread is still the default, a window's bound is several\n+/// times wider than this workload's measured variation, so a key's first\n+/// samples would be charged far more than the previous rule ever charged.\n+/// Until enough keys calibrate the spread, cap the charge at the previous\n+/// rule's, and never below the window's largest peak.\n+fn warm_up_charge(\n+    ledger: &MemoryLedger,\n+    kind_name: &str,\n+    estimate: &Estimate,\n+    previous: Option<u64>,\n+) -> u64 {\n+    // Per key as well as per kind: a calibrated kind can still have a wide\n+    // spread, and a key with one or two samples would then be charged far\n+    // above anything it was charged before, without receiving a new sample.\n+    let warming = !calibrated(ledger, kind_name) || estimate.n < MIN_KEY_SAMPLES;\n+    match previous {\n+        Some(previous) if warming => estimate.charge.min(previous.max(estimate.window_max)),\n+        _ => estimate.charge,\n+    }\n+}\n+\n+/// The charge f47d416's rule gives a compile mode, when it has any history.\n+fn previous_compile_charge(ledger: &MemoryLedger, name: &str, key: &str) -> Option<u64> {\n+    let bare = ledger.crates.get(name).copied();\n+    let Some(peak) = ledger.crates.get(key).copied() else {\n+        return bare;\n+    };\n+    // An old writer can discard windows. Preserve its charge, including mode\n+    // headroom or the crate-wide fallback before three successes.\n+    let old_charge = if ledger.compile_samples.get(key).copied().unwrap_or(0) >= 3 {\n+        let padded = peak.saturating_add(peak.div_ceil(2));\n+        bare.map_or(padded, |bare| padded.min(bare))\n+    } else {\n+        bare.unwrap_or(peak)\n+    };\n+    Some(peak.max(old_charge))\n+}\n+\n+/// `default` is what the previous rule charged a compile with no recorded\n+/// history: light crates never get a legacy entry, yet they do get windows.\n+fn compile_window_charge(\n+    ledger: &MemoryLedger,\n+    name: &str,\n+    key: &str,\n+    default: u64,\n+) -> Option<u64> {\n+    let estimate = estimate(ledger, key, \"compile\")?;\n+    let previous =\n+        previous_compile_charge(ledger, name, key).or_else(|| (default > 0).then_some(default));\n+    Some(warm_up_charge(ledger, \"compile\", &estimate, previous))\n+}\n+\n+pub(super) fn compile_prediction(\n+    ledger: &MemoryLedger,\n+    name: &str,\n+    key: &str,\n+    default: u64,\n+) -> (Option<u64>, &'static str) {\n+    if let Some(charge) = compile_window_charge(ledger, name, key, default) {\n+        return (Some(charge), \"window\");\n+    }\n+    if ledger.crates.contains_key(key) {\n+        return (previous_compile_charge(ledger, name, key), \"legacy\");\n+    }\n+    let prefix = format!(\"{name} [compile \");\n+    if let Some(charge) = ledger\n+        .memory_windows\n+        .keys()\n+        .filter(|key| key.starts_with(&prefix))\n+        .filter_map(|key| compile_window_charge(ledger, name, key, default))\n+        .max()\n+    {\n+        return (Some(charge), \"sibling\");\n+    }\n+    match ledger.crates.get(name).copied() {\n+        Some(peak) => (Some(peak), \"legacy\"),\n+        None => (None, \"default\"),\n+    }\n+}\n+\n+/// Shared by admission and stats, including old-writer and eviction fallbacks.\n+pub(super) fn link_prediction(\n+    ledger: &MemoryLedger,\n+    key: &str,\n+    profile: Option<&str>,\n+    floor: u64,\n+) -> (Option<u64>, &'static str) {\n+    let window = match profile {\n+        Some(profile) => ledger\n+            .profile_link_peaks\n+            .get(profile)\n+            .map_or(&[][..], Vec::as_slice),\n+        None => ledger.link_peaks.as_slice(),\n+    };\n+    let fallback = match ledger.crates.get(key).copied() {\n+        Some(peak) => (peak, \"legacy\"),\n+        None => match window.iter().copied().max() {\n+            Some(peak) => (peak, \"link-window\"),\n+            None => (floor, \"link-floor\"),\n+        },\n+    };\n+    if let Some(estimate) = estimate(ledger, key, \"link\") {\n+        return (\n+            Some(warm_up_charge(ledger, \"link\", &estimate, Some(fallback.0))),\n+            \"window\",\n+        );\n+    }\n+    (Some(fallback.0), fallback.1)\n+}\n+\n+fn trim(ledger: &mut MemoryLedger) {\n+    while ledger.memory_windows.len() > MAX_LEDGER_ENTRIES {\n+        let smallest = ledger\n+            .memory_windows\n+            .iter()\n+            .min_by_key(|(_, peaks)| peaks.iter().max().copied().unwrap_or(0))\n+            .map(|(key, _)| key.clone())\n+            .expect(\"overfull windows\");\n+        ledger.memory_windows.remove(&smallest);\n+    }\n+}\n+\n+/// Sanitize only the new fields. Old writers must see unchanged legacy fields.\n+pub(super) fn prepare(ledger: &mut MemoryLedger) {\n+    for window in ledger.memory_windows.values_mut() {\n+        window.retain(|p| *p > 0);\n+        window.drain(..window.len().saturating_sub(WINDOW));\n+    }\n+    ledger.memory_windows.retain(|key, w| {\n+        // Native cc:<filename> keys collide across libraries; their history\n+        // must remain a never-lowered legacy maximum, not a rolling window.\n+        (key.contains(\" [compile \") || key.ends_with(\" [link]\")) && !w.is_empty()\n+    });\n+    trim(ledger);\n+    ledger\n+        .memory_residuals\n+        .retain(|kind, _| KINDS.contains(&kind.as_str()));\n+    for residuals in ledger.memory_residuals.values_mut() {\n+        residuals.retain(|r| r.is_finite());\n+        residuals.drain(..residuals.len().saturating_sub(MAX_RESIDUALS));\n+    }\n+    let mut spreads: BTreeMap<&str, Vec<f64>> = BTreeMap::new();\n+    for (key, values) in &ledger.memory_windows {\n+        if values.len() >= 4 {\n+            spreads\n+                .entry(kind(key))\n+                .or_default()\n+                .push(moments(values).1.sqrt());\n+        }\n+    }\n+    ledger.pooled_spreads = KINDS\n+        .into_iter()\n+        .map(|kind| {\n+            let values = spreads.entry(kind).or_default();\n+            let sigma = if values.len() < MIN_POOL_KEYS {\n+                DEFAULT_SIGMA_POOL\n+            } else {\n+                values.sort_by(f64::total_cmp);\n+                let mid = values.len() / 2;\n+                if values.len().is_multiple_of(2) {\n+                    (values[mid - 1] + values[mid]) / 2.0\n+                } else {\n+                    values[mid]\n+                }\n+            };\n+            (kind.to_string(), sigma)\n+        })\n+        .collect();\n+}\n+\n+/// Called under the ledger lock, before appending the new peak. Only successful\n+/// unwrapped runs calibrate; an OOM still appends its doubled peak as a floor.\n+pub(super) fn record(\n+    ledger: &mut MemoryLedger,\n+    key: &str,\n+    kind: &str,\n+    peak: u64,\n+    features: Option<Features>,\n+    calibrate: bool,\n+) {\n+    if peak == 0 {\n+        return;\n+    }\n+    if calibrate\n+        && let Some(features) = features\n+        && features.scale > 0.0\n+    {\n+        let residual = ((peak as f64).ln() - features.mean) / features.scale;\n+        if residual.is_finite() {\n+            let history = ledger.memory_residuals.entry(kind.to_string()).or_default();\n+            history.push(residual);\n+            history.drain(..history.len().saturating_sub(MAX_RESIDUALS));\n+        }\n+    }\n+    let window = ledger.memory_windows.entry(key.to_string()).or_default();\n+    window.push(peak);\n+    window.drain(..window.len().saturating_sub(WINDOW));\n+    trim(ledger);\n+}\n+\n+#[cfg(test)]\n+mod tests {\n+    use super::*;\n+\n+    fn calibrate(ledger: &mut MemoryLedger, kind_name: &str) {\n+        for index in 0..MIN_POOL_KEYS {\n+            let key = match kind_name {\n+                \"link\" => format!(\"calibration-{index} [link]\"),\n+                \"test-binary\" => format!(\"calibration-{index} [test]\"),\n+                _ => format!(\"calibration-{index} [compile mode]\"),\n+            };\n+            ledger.memory_windows.insert(key, vec![100; 4]);\n+        }\n+    }\n+\n+    #[test]\n+    fn warmup_compile_cap_uses_previous_charge_and_respects_window_max() {\n+        let key = \"crate [compile mode]\";\n+        let mut ledger = MemoryLedger::default();\n+        ledger.crates.insert(\"crate\".into(), 200);\n+        ledger.memory_windows.insert(key.into(), vec![100]);\n+        let raw = estimate(&ledger, key, \"compile\").unwrap().charge;\n+        assert!(raw > 200);\n+        assert_eq!(compile_window_charge(&ledger, \"crate\", key, 0), Some(200));\n+\n+        ledger.crates.insert(\"crate\".into(), 200);\n+        ledger.memory_windows.insert(key.into(), vec![500]);\n+        let raw = estimate(&ledger, key, \"compile\").unwrap().charge;\n+        assert!(raw > 500);\n+        assert_eq!(compile_window_charge(&ledger, \"crate\", key, 0), Some(500));\n+    }\n+\n+    #[test]\n+    fn calibrated_compile_kind_uses_raw_estimate() {\n+        let key = \"crate [compile mode]\";\n+        let mut ledger = MemoryLedger::default();\n+        ledger.crates.insert(\"crate\".into(), 200);\n+        ledger.memory_windows.insert(key.into(), vec![100; 4]);\n+        calibrate(&mut ledger, \"compile\");\n+        let raw = estimate(&ledger, key, \"compile\").unwrap().charge;\n+        assert!(raw > 200);\n+        assert_eq!(compile_window_charge(&ledger, \"crate\", key, 0), Some(raw));\n+    }\n+\n+    #[test]\n+    fn link_warmup_uses_legacy_profile_and_floor_fallbacks() {\n+        let key = \"crate [link]\";\n+        let mut legacy = MemoryLedger::default();\n+        legacy.crates.insert(key.into(), 200);\n+        legacy.memory_windows.insert(key.into(), vec![100]);\n+        let raw = estimate(&legacy, key, \"link\").unwrap().charge;\n+        assert!(raw > 200);\n+        assert_eq!(\n+            link_prediction(&legacy, key, None, 50),\n+            (Some(200), \"window\")\n+        );\n+\n+        let mut profile = MemoryLedger::default();\n+        profile\n+            .profile_link_peaks\n+            .insert(\"release\".into(), vec![200]);\n+        profile.memory_windows.insert(key.into(), vec![100]);\n+        assert_eq!(\n+            link_prediction(&profile, key, Some(\"release\"), 50),\n+            (Some(200), \"window\")\n+        );\n+\n+        let mut floor = MemoryLedger::default();\n+        floor.memory_windows.insert(key.into(), vec![5000]);\n+        let raw = estimate(&floor, key, \"link\").unwrap().charge;\n+        assert!(raw > 1000);\n+        assert_eq!(\n+            link_prediction(&floor, key, None, 1000),\n+            (Some(5000), \"window\"),\n+            \"the charge cannot fall below the largest observed window peak\"\n+        );\n+    }\n+\n+    #[test]\n+    fn compile_window_without_any_previous_rule_value_or_default_is_not_capped() {\n+        // With no default (CPU-only scheduling) there is nothing to cap at; with\n+        // a default, see warm_up_caps_a_key_without_history_at_the_default_charge.\n+        let key = \"crate [compile mode]\";\n+        let mut ledger = MemoryLedger::default();\n+        ledger.memory_windows.insert(key.into(), vec![100]);\n+        let raw = estimate(&ledger, key, \"compile\").unwrap().charge;\n+        assert_eq!(compile_window_charge(&ledger, \"crate\", key, 0), Some(raw));\n+    }\n+    #[test]\n+    fn fixed_vectors_and_shrinkage() {\n+        for (n, expected) in [(1, 452), (2, 484), (3, 583), (16, 2533)] {\n+            let mut ledger = MemoryLedger::default();\n+            ledger\n+                .memory_windows\n+                .insert(\"key\".into(), (1..=n).map(|x| x * 100).collect());\n+            let estimate = estimate(&ledger, \"key\", \"compile\").unwrap();\n+            assert_eq!(estimate.charge, expected, \"n={n}\");\n+            assert_eq!(estimate.n, n as usize);\n+        }\n+        let mut ledger = MemoryLedger::default();\n+        ledger.memory_windows.insert(\"key\".into(), vec![100, 200]);\n+        ledger.pooled_spreads.insert(\"compile\".into(), 0.25);\n+        let e = estimate(&ledger, \"key\", \"compile\").unwrap();\n+        let key_variance = 2.0_f64.ln().powi(2) / 2.0;\n+        let expected = ((4.0 * 0.25_f64.powi(2) + key_variance) / 5.0).sqrt() * 1.5_f64.sqrt();\n+        assert!((e.features.scale - expected).abs() < 1e-12);\n+    }\n+    #[test]\n+    fn t_fallback_nearest_rank_calibration_and_window_floor() {\n+        let mut ledger = MemoryLedger::default();\n+        ledger.memory_windows.insert(\"key\".into(), vec![100]);\n+        assert_eq!(quantile(&ledger, \"compile\", 1), T_QUANTILES[3]);\n+        assert_eq!(quantile(&ledger, \"compile\", 40), NORMAL_QUANTILE);\n+        ledger\n+            .memory_residuals\n+            .insert(\"compile\".into(), vec![-10.0; 49]);\n+        assert_eq!(quantile(&ledger, \"compile\", 1), T_QUANTILES[3]);\n+        ledger\n+            .memory_residuals\n+            .insert(\"compile\".into(), (0..50).map(|i| i as f64).collect());\n+        assert_eq!(quantile(&ledger, \"compile\", 1), 48.0);\n+        ledger\n+            .memory_residuals\n+            .insert(\"compile\".into(), vec![-10.0; 50]);\n+        let e = estimate(&ledger, \"key\", \"compile\").unwrap();\n+        assert!(e.bound < 100);\n+        assert_eq!(e.charge, 100);\n+        assert_eq!(quantile(&ledger, \"link\", 1), T_QUANTILES[3]);\n+    }\n+    #[test]\n+    fn finite_sample_rank_matches_review_scenario_and_clamps_to_history() {\n+        let mut ledger = MemoryLedger::default();\n+        ledger.memory_windows.insert(\"key\".into(), vec![100; 16]);\n+        ledger\n+            .memory_residuals\n+            .insert(\"compile\".into(), (0..50).map(|i| i as f64 / 10.0).collect());\n+        assert_eq!(quantile(&ledger, \"compile\", 16), 4.8);\n+        assert_eq!(estimate(&ledger, \"key\", \"compile\").unwrap().charge, 312);\n+        ledger\n+            .memory_residuals\n+            .insert(\"compile\".into(), (0..256).map(|i| i as f64).collect());\n+        assert_eq!(quantile(&ledger, \"compile\", 16), 244.0); // rank 245\n+        assert_eq!(conformal_rank(50), 49);\n+        assert_eq!(conformal_rank(256), 245);\n+        assert_eq!(conformal_rank(1), 1); // Clamp to the available history.\n+    }\n+    #[test]\n+    fn pooled_spread_qualifies_ten_keys_of_each_kind_independently() {\n+        let mut ledger = MemoryLedger::default();\n+        for i in 0..9 {\n+            ledger\n+                .memory_windows\n+                .insert(format!(\"crate{i} [compile mode]\"), vec![100, 200, 400, 800]);\n+        }\n+        ledger\n+            .memory_windows\n+            .insert(\"short\".into(), vec![100, 200, 400]);\n+        prepare(&mut ledger);\n+        assert_eq!(sigma_pool(&ledger, \"compile\"), 0.5);\n+        ledger\n+            .memory_windows\n+            .insert(\"tenth [compile mode]\".into(), vec![100, 200, 400, 800]);\n+        prepare(&mut ledger);\n+        assert!((sigma_pool(&ledger, \"compile\") - 0.8948491622597644).abs() < 1e-12);\n+        assert_eq!(sigma_pool(&ledger, \"link\"), 0.5);\n+    }\n+    #[test]\n+    fn histories_roll_estimates_fall_and_zero_scale_skips_residuals() {\n+        let mut ledger = MemoryLedger::default();\n+        record(&mut ledger, \"key\", \"compile\", 10000, None, true);\n+        let high = estimate(&ledger, \"key\", \"compile\").unwrap().charge;\n+        for _ in 0..16 {\n+            let features = estimate(&ledger, \"key\", \"compile\").unwrap().features;\n+            record(&mut ledger, \"key\", \"compile\", 100, Some(features), true);\n+        }\n+        assert_eq!(ledger.memory_windows[\"key\"], vec![100; 16]);\n+        assert!(estimate(&ledger, \"key\", \"compile\").unwrap().charge < high);\n+        for _ in 0..300 {\n+            record(\n+                &mut ledger,\n+                \"key\",\n+                \"compile\",\n+                100,\n+                Some(Features {\n+                    mean: 100.0_f64.ln(),\n+                    scale: 1.0,\n+                }),\n+                true,\n+            );\n+        }\n+        assert_eq!(ledger.memory_residuals[\"compile\"].len(), 256);\n+        assert_eq!(ledger.memory_residuals[\"compile\"], vec![0.0; 256]);\n+        record(\n+            &mut ledger,\n+            \"key\",\n+            \"compile\",\n+            100,\n+            Some(Features {\n+                mean: 0.0,\n+                scale: 0.0,\n+            }),\n+            true,\n+        );\n+        assert_eq!(ledger.memory_residuals[\"compile\"], vec![0.0; 256]);\n+    }\n+    #[test]\n+    fn a_calibrated_wide_spread_does_not_uncap_a_key_with_few_samples() {\n+        // Ten link keys with four samples each and a wide spread, as in review.\n+        let mut ledger = MemoryLedger::default();\n+        for i in 0..MIN_POOL_KEYS {\n+            ledger\n+                .memory_windows\n+                .insert(format!(\"calibrating{i} [link]\"), vec![100, 145, 213, 320]);\n+        }\n+        let key = \"heavy [link]\";\n+        ledger.memory_windows.insert(key.into(), vec![21_000]);\n+        ledger.crates.insert(key.into(), 21_000);\n+        prepare(&mut ledger);\n+        assert!(calibrated(&ledger, \"link\"));\n+        assert!(sigma_pool(&ledger, \"link\") > 0.45);\n+        let raw = estimate(&ledger, key, \"link\").unwrap().charge;\n+        assert!(\n+            raw > 90_000,\n+            \"the wide spread makes the raw bound large: {raw}\"\n+        );\n+        // One sample: still held to the previous rule's charge.\n+        assert_eq!(\n+            link_prediction(&ledger, key, None, 1000),\n+            (Some(21_000), \"window\")\n+        );\n+        // With four samples of its own, the key's estimate applies uncapped.\n+        ledger\n+            .memory_windows\n+            .insert(key.into(), vec![21_000, 21_000, 21_000, 21_000]);\n+        prepare(&mut ledger);\n+        let own = estimate(&ledger, key, \"link\").unwrap().charge;\n+        assert_eq!(\n+            link_prediction(&ledger, key, None, 1000),\n+            (Some(own), \"window\")\n+        );\n+    }\n+\n+    #[test]\n+    fn warm_up_caps_a_key_without_history_at_the_default_charge() {\n+        // A light crate never gets a legacy entry, but it does get a window.\n+        // The previous rule charged it the default; warm-up must not exceed that.\n+        let mut ledger = MemoryLedger::default();\n+        let key = \"light [compile mode]\";\n+        record(&mut ledger, key, \"compile\", 100, None, true);\n+        let raw = estimate(&ledger, key, \"compile\").unwrap().charge;\n+        assert!(\n+            raw > 200,\n+            \"the default spread makes the raw bound wide: {raw}\"\n+        );\n+        assert_eq!(\n+            compile_prediction(&ledger, \"light\", key, 200),\n+            (Some(200), \"window\")\n+        );\n+        // Never below the window's largest peak.\n+        assert_eq!(\n+            compile_prediction(&ledger, \"light\", key, 50),\n+            (Some(100), \"window\")\n+        );\n+        // No default (CPU-only scheduling): nothing to cap at.\n+        assert_eq!(\n+            compile_prediction(&ledger, \"light\", key, 0),\n+            (Some(raw), \"window\")\n+        );\n+    }\n+\n+    #[test]\n+    fn new_maps_are_bounded_and_cold_hierarchy_uses_sibling_charges() {\n+        let mut ledger = MemoryLedger::default();\n+        assert_eq!(\n+            compile_prediction(&ledger, \"crate\", \"crate [compile new]\", 0),\n+            (None, \"default\")\n+        );\n+        ledger.crates.insert(\"crate\".into(), 99999);\n+        assert_eq!(\n+            compile_prediction(&ledger, \"crate\", \"crate [compile new]\", 0),\n+            (Some(99999), \"legacy\")\n+        );\n+        record(\n+            &mut ledger,\n+            \"crate [compile old]\",\n+            \"compile\",\n+            100,\n+            None,\n+            true,\n+        );\n+        assert_eq!(\n+            compile_prediction(&ledger, \"crate\", \"crate [compile new]\", 0),\n+            (Some(452), \"sibling\")\n+        );\n+        record(\n+            &mut ledger,\n+            \"crate [compile other]\",\n+            \"compile\",\n+            200,\n+            None,\n+            true,\n+        );\n+        assert_eq!(\n+            compile_prediction(&ledger, \"crate\", \"crate [compile new]\", 0),\n+            (Some(904), \"sibling\")\n+        );\n+        for i in 0..MAX_LEDGER_ENTRIES {\n+            record(\n+                &mut ledger,\n+                &format!(\"other{i}\"),\n+                \"compile\",\n+                1000,\n+                None,\n+                true,\n+            );\n+        }\n+        assert_eq!(ledger.memory_windows.len(), MAX_LEDGER_ENTRIES);\n+        assert!(!ledger.memory_windows.contains_key(\"crate [compile old]\"));\n+        let mut oversized = MemoryLedger::default();\n+        oversized.memory_windows.insert(\"key\".into(), vec![0; 100]);\n+        oversized\n+            .memory_residuals\n+            .insert(\"unknown\".into(), vec![0.0; 300]);\n+        prepare(&mut oversized);\n+        assert!(oversized.memory_windows.is_empty());\n+        assert!(oversized.memory_residuals.is_empty());\n+    }\n+}"},{"sha":"70daccac5d34cec9a5193d51c5fd545252b950f2","filename":"crates/mbx/src/scheduler_tests.rs","status":"modified","additions":2914,"deletions":10,"changes":2924,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fscheduler_tests.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fscheduler_tests.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fscheduler_tests.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d"},{"sha":"8b456763ee3e442e9c530e57fb56eac4ad335778","filename":"crates/mbx/src/session.rs","status":"modified","additions":107,"deletions":7,"changes":114,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fsession.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fsession.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fsession.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -53,10 +53,9 @@ pub use shims::{\n     PathShims, ShimLink, install_path_shims, install_shim, install_shim_named, shim_file_name,\n };\n #[cfg(test)]\n-use shims::{\n-    TargetedCompiler, resolve_in_path, resolve_named_compiler, resolve_on_path, symlink_shim,\n-    targeted_compiler_language,\n-};\n+use shims::{TargetedCompiler, resolve_named_compiler, targeted_compiler_language};\n+#[cfg(all(test, unix))]\n+use shims::{resolve_in_path, resolve_on_path, symlink_shim};\n use stats::StatsReport;\n pub(crate) use stats::display_stats;\n pub(crate) use stats::session_was_active;\n@@ -1258,7 +1257,9 @@ async fn action_remote_cache(config: &Config, store: &Path) -> Result<Option<Age\n     let Some(client) = crate::remote::remote_client(config).await? else {\n         return Ok(None);\n     };\n-    let Some(mode) = crate::policy::effective_remote_cache_mode(config.remote.mode) else {\n+    let Some(mode) =\n+        crate::policy::effective_remote_cache_mode(config.remote.mode, config.remote.trust_writes)\n+    else {\n         return Ok(None);\n     };\n     Ok(Some(AgentRemoteCache {\n@@ -1278,6 +1279,58 @@ pub fn is_rustc_shim() -> bool {\n         .is_some_and(|stem| stem == OsStr::new(RUSTC_SHIM_STEM))\n }\n \n+/// Whether Cargo ran `mbx` itself as a rustc wrapper, which is what\n+/// `build.rustc-wrapper = \"mbx\"` in Cargo configuration produces. mbx exports\n+/// its own `RUSTC_WRAPPER` for each session, so the setting is unsupported.\n+pub fn is_configured_as_rustc_wrapper() -> bool {\n+    let arguments = std::env::args_os().take(3).collect::<Vec<_>>();\n+    let Some((program, rest)) = arguments.split_first() else {\n+        return false;\n+    };\n+    let rest = rest.iter().map(OsString::as_os_str).collect::<Vec<_>>();\n+    is_rustc_wrapper_invocation(program, &rest)\n+}\n+\n+/// Tell the user to remove `build.rustc-wrapper`, instead of letting Cargo\n+/// read the compiler path as a `-Zscript` file.\n+pub fn reject_configured_rustc_wrapper() -> ExitCode {\n+    eprintln!(\n+        \"mbx[error]: mbx is configured as Cargo's rustc wrapper (`build.rustc-wrapper`, \\\n+         `RUSTC_WRAPPER`, or `CARGO_BUILD_RUSTC_WRAPPER`), which it does not support.\\n\\\n+         Remove that setting: mbx sets `RUSTC_WRAPPER` for each build itself.\"\n+    );\n+    ExitCode::FAILURE\n+}\n+\n+fn is_rustc_wrapper_invocation(program: &OsStr, arguments: &[&OsStr]) -> bool {\n+    let file_stem = |path: &OsStr| Path::new(path).file_stem().map(OsStr::to_os_string);\n+    match file_stem(program) {\n+        Some(stem) if stem == OsStr::new(\"mbx\") => {\n+            let Some(first) = arguments.first() else {\n+                return false;\n+            };\n+            if Path::new(first).components().count() > 1 {\n+                return file_stem(first).is_some_and(|stem| stem == OsStr::new(\"rustc\"));\n+            }\n+            // Without RUSTC set, Cargo passes a bare `rustc`. That also names\n+            // `cargo rustc`, so only Cargo's compiler probes and compilations\n+            // qualify: none of these is a `cargo rustc` option. Cargo's own\n+            // `-V`/`--version` stay with Cargo.\n+            *first == OsStr::new(\"rustc\")\n+                && arguments.get(1).is_some_and(|argument| {\n+                    let argument = argument.to_string_lossy();\n+                    argument == \"-vV\"\n+                        || argument == \"-\"\n+                        || argument.starts_with('@')\n+                        || [\"--print\", \"--crate-name\", \"--emit\", \"--edition\"]\n+                            .iter()\n+                            .any(|flag| argument.starts_with(flag))\n+                })\n+        }\n+        _ => false,\n+    }\n+}\n+\n /// Whether this process was invoked as the rustdoc shim.\n pub fn is_rustdoc_shim() -> bool {\n     std::env::args_os()\n@@ -1788,6 +1841,44 @@ fn executable_stem(executable: &OsStr) -> Option<&str> {\n     Path::new(executable).file_stem()?.to_str()\n }\n \n+/// Whether running `compiler` really runs some other program whose memory\n+/// is not the compile's: Cargo's earlier `RUSTC_WRAPPER`, which wraps every\n+/// compiler call, or a workspace wrapper other than clippy-driver. Under\n+/// `cargo clippy` the workspace wrapper is recorded for the whole build, but\n+/// dependencies still run the real rustc, and clippy-driver compiles in its\n+/// own process, so both measure a real compile.\n+pub(crate) fn compiler_runs_through_wrapper(compiler: &OsStr) -> bool {\n+    compiler_runs_through_wrapper_using(compiler, |name| std::env::var_os(name))\n+}\n+\n+fn compiler_runs_through_wrapper_using(\n+    compiler: &OsStr,\n+    get: impl Fn(&str) -> Option<OsString>,\n+) -> bool {\n+    get(PREVIOUS_RUSTC_WRAPPER_ENV).is_some()\n+        || (!is_clippy_driver(compiler)\n+            && get(PREVIOUS_RUSTC_WORKSPACE_WRAPPER_ENV).is_some_and(|wrapper| wrapper == compiler))\n+}\n+\n+pub(crate) fn is_clippy_driver(compiler: &OsStr) -> bool {\n+    executable_stem(compiler) == Some(\"clippy-driver\")\n+}\n+\n+fn transparent_compiler_demand(\n+    name: &str,\n+    described: &[OsString],\n+    incremental_flag: Option<&OsStr>,\n+    wrapped: bool,\n+    clippy: bool,\n+) -> crate::scheduler::Demand {\n+    crate::scheduler::Demand::new(name, links_natively(described)).with_compiler_execution(\n+        described,\n+        incremental_flag,\n+        wrapped,\n+        clippy,\n+    )\n+}\n+\n /// Run the compiler without caching. `described` is `arguments` with any\n /// `@argfile` expanded, which is where to look for what is being compiled;\n /// rustc itself is given `arguments` unchanged.\n@@ -1813,8 +1904,17 @@ fn run_transparent_rustc(\n                 .to_str()\n                 .is_some_and(|argument| argument.starts_with(\"--print\"))\n     });\n+    let incremental_flag = bypassed\n+        .then(|| crate::rustc::bypassed_library_incremental_flag(described))\n+        .flatten();\n     let demand = crate_name.as_deref().filter(|_| !is_query).map(|name| {\n-        crate::scheduler::Demand::new(name, links_natively(described)).with_link_profile(described)\n+        transparent_compiler_demand(\n+            name,\n+            described,\n+            incremental_flag.as_deref(),\n+            compiler_runs_through_wrapper(&rustc),\n+            is_clippy_driver(&rustc),\n+        )\n     });\n     let permit = demand\n         .as_ref()\n@@ -1832,7 +1932,7 @@ fn run_transparent_rustc(\n         Command::new(&rustc)\n     };\n     command.args(&arguments);\n-    if bypassed && let Some(flag) = crate::rustc::bypassed_library_incremental_flag(described) {\n+    if let Some(flag) = incremental_flag {\n         command.arg(flag);\n     }\n     command.env_remove(PREVIOUS_RUSTC_WRAPPER_ENV);"},{"sha":"ef147f27e2f75cb5a975d87f4376fee1b955cdcd","filename":"crates/mbx/src/session_tests.rs","status":"modified","additions":133,"deletions":2,"changes":135,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fsession_tests.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fsession_tests.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fsession_tests.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -1,7 +1,9 @@\n #[cfg(unix)]\n use super::shims::remove_stranded_binary_shims;\n-use super::shims::{ShimLease, binary_identity, installation_identity};\n-use super::shims::{first_in_path, is_shim_directory, mark_shim_directory};\n+#[cfg(unix)]\n+use super::shims::{ShimLease, first_in_path};\n+use super::shims::{binary_identity, installation_identity};\n+use super::shims::{is_shim_directory, mark_shim_directory};\n use super::*;\n use crate::config::SummaryStyle;\n \n@@ -2068,3 +2070,132 @@ fn routine_bypasses_are_debug_but_failed_cache_paths_are_warnings() {\n         AgentRequest::RecordWarning { .. }\n     ));\n }\n+\n+#[test]\n+fn configured_rustc_wrapper_is_recognized() {\n+    let os = OsStr::new;\n+    let rustc = os(\"/toolchain/bin/rustc\");\n+    assert!(is_rustc_wrapper_invocation(os(\"mbx\"), &[rustc]));\n+    assert!(is_rustc_wrapper_invocation(\n+        os(\"mbx\"),\n+        &[os(\"rustc\"), os(\"-vV\")]\n+    ));\n+    assert!(is_rustc_wrapper_invocation(\n+        os(\"mbx\"),\n+        &[os(\"rustc\"), os(\"--crate-name\"), os(\"x\")]\n+    ));\n+    assert!(!is_rustc_wrapper_invocation(os(\"mbx\"), &[]));\n+    assert!(is_rustc_wrapper_invocation(\n+        os(\"mbx\"),\n+        &[os(\"rustc\"), os(\"@/tmp/args\")]\n+    ));\n+    assert!(is_rustc_wrapper_invocation(\n+        os(\"mbx\"),\n+        &[os(\"rustc\"), os(\"--print=cfg\")]\n+    ));\n+    assert!(!is_rustc_wrapper_invocation(\n+        os(\"mbx\"),\n+        &[os(\"rustc\"), os(\"--version\")]\n+    ));\n+    assert!(!is_rustc_wrapper_invocation(\n+        os(\"mbx\"),\n+        &[os(\"rustc\"), os(\"-V\")]\n+    ));\n+    assert!(!is_rustc_wrapper_invocation(\n+        os(\"mbx\"),\n+        &[os(\"rustc\"), os(\"--crate-type=cdylib\")]\n+    ));\n+    assert!(!is_rustc_wrapper_invocation(os(\"mbx\"), &[os(\"rustc\")]));\n+    assert!(!is_rustc_wrapper_invocation(\n+        os(\"mbx\"),\n+        &[os(\"rustc\"), os(\"--release\")]\n+    ));\n+    assert!(!is_rustc_wrapper_invocation(os(\"mbx\"), &[os(\"build\")]));\n+    assert!(!is_rustc_wrapper_invocation(os(\"cargo\"), &[rustc]));\n+}\n+\n+#[test]\n+fn bypassed_incremental_flag_is_in_the_transparent_compiler_demand() {\n+    let args = vec![\n+        OsString::from(\"--crate-type=rlib\"),\n+        OsString::from(\"--emit=metadata\"),\n+    ];\n+    let demand = transparent_compiler_demand(\n+        \"crate\",\n+        &args,\n+        Some(OsStr::new(\"-Cincremental=private-state\")),\n+        false,\n+        false,\n+    );\n+    assert!(\n+        demand\n+            .compile_mode_key()\n+            .unwrap()\n+            .contains(\"incremental-on\")\n+    );\n+    let cold = transparent_compiler_demand(\"crate\", &args, None, false, false);\n+    assert!(cold.compile_mode_key().unwrap().contains(\"incremental-off\"));\n+    assert_ne!(demand.compile_mode_key(), cold.compile_mode_key());\n+}\n+\n+#[test]\n+fn only_a_compiler_run_through_another_program_is_wrapped() {\n+    let rustc = OsStr::new(\"/toolchain/bin/rustc\");\n+    let clippy = OsStr::new(\"/toolchain/bin/clippy-driver\");\n+    let other = OsStr::new(\"/usr/bin/cache-wrapper\");\n+    let env = |cache: Option<&OsStr>, workspace: Option<&OsStr>| {\n+        let cache = cache.map(OsStr::to_os_string);\n+        let workspace = workspace.map(OsStr::to_os_string);\n+        move |name: &str| match name {\n+            PREVIOUS_RUSTC_WRAPPER_ENV => cache.clone(),\n+            PREVIOUS_RUSTC_WORKSPACE_WRAPPER_ENV => workspace.clone(),\n+            _ => None,\n+        }\n+    };\n+    // Cargo's RUSTC_WRAPPER runs in front of every compiler call.\n+    assert!(compiler_runs_through_wrapper_using(\n+        rustc,\n+        env(Some(other), None)\n+    ));\n+    assert!(compiler_runs_through_wrapper_using(\n+        clippy,\n+        env(Some(other), None)\n+    ));\n+    // A workspace wrapper other than clippy-driver runs in place of rustc.\n+    assert!(compiler_runs_through_wrapper_using(\n+        other,\n+        env(None, Some(other))\n+    ));\n+    // Under `cargo clippy`, dependencies still run rustc, and clippy-driver\n+    // compiles in its own process.\n+    assert!(!compiler_runs_through_wrapper_using(\n+        rustc,\n+        env(None, Some(clippy))\n+    ));\n+    assert!(!compiler_runs_through_wrapper_using(\n+        clippy,\n+        env(None, Some(clippy))\n+    ));\n+    assert!(!compiler_runs_through_wrapper_using(rustc, env(None, None)));\n+}\n+\n+#[test]\n+fn transparent_wrapped_compiles_do_not_count_samples_and_clippy_has_its_own_mode() {\n+    let args = vec![\n+        OsString::from(\"--crate-type=rlib\"),\n+        OsString::from(\"--emit=metadata\"),\n+    ];\n+    let wrapped = transparent_compiler_demand(\"crate\", &args, None, true, false);\n+    assert!(!wrapped.counts_compile_samples());\n+    let check = transparent_compiler_demand(\"crate\", &args, None, false, false);\n+    let clippy = transparent_compiler_demand(\"crate\", &args, None, false, true);\n+    assert!(check.counts_compile_samples());\n+    assert!(clippy.counts_compile_samples());\n+    assert_ne!(check.compile_mode_key(), clippy.compile_mode_key());\n+    assert!(\n+        clippy\n+            .compile_mode_key()\n+            .unwrap()\n+            .contains(\"[compile clippy \")\n+    );\n+}"},{"sha":"3b1cd0b97a31c314e614a9ae759d7daacfaf8faf","filename":"crates/mbx/src/stats.rs","status":"modified","additions":34,"deletions":1,"changes":35,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fstats.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fstats.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fstats.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -46,6 +46,8 @@ pub(crate) struct Report {\n     pub savings: Lifetime,\n     pub cache: Cache,\n     pub sharing: SharingEstimate,\n+    #[serde(skip_serializing_if = \"Option::is_none\")]\n+    pub scheduler: Option<crate::scheduler::SchedulerReport>,\n }\n \n #[derive(Serialize)]\n@@ -87,6 +89,7 @@ pub(crate) fn collect(store: &Path, target_root: &Path) -> Result<Report> {\n     let live_cache_bytes =\n         sharing.map_err(|_| eyre::eyre!(\"sizing the cache store panicked\"))??;\n     Ok(Report {\n+        scheduler: None,\n         version: 1,\n         store: store.display().to_string(),\n         savings: Lifetime::from(&tally),\n@@ -122,7 +125,7 @@ impl From<&savings::Tally> for Lifetime {\n     }\n }\n \n-fn size(bytes: u64) -> String {\n+pub(crate) fn size(bytes: u64) -> String {\n     ByteSize::b(bytes).display().iec().to_string()\n }\n \n@@ -240,6 +243,9 @@ impl Report {\n         if cheeky && let Some(quip) = self.savings.quip() {\n             lines.extend([String::new(), quip]);\n         }\n+        if let Some(scheduler) = &self.scheduler {\n+            lines.extend([String::new(), scheduler.text()]);\n+        }\n         lines.join(\"\\n\")\n     }\n }\n@@ -295,13 +301,40 @@ mod tests {\n         assert_eq!(report.since(), \"since 2023-11-14\");\n     }\n \n+    #[test]\n+    fn scheduler_section_is_in_text_and_json_without_creating_files() {\n+        let root = tempfile::tempdir().unwrap();\n+        let mut config = crate::config::Config::for_test(root.path());\n+        config.scheduler.enabled = true;\n+        config.scheduler.cpus = 4;\n+        config.scheduler.reserve_cpus = 0;\n+        config.scheduler.memory_bytes = Some(4000);\n+        let mut report = collect(&config.store_dir(), &config.target.root).unwrap();\n+        report.scheduler = Some(crate::scheduler::scheduler_report(&config));\n+        let text = report.text(false);\n+        assert!(\n+            text.contains(\n+                \"Scheduler: enabled (4 cores, 3.9 KiB memory budget, from the global settings)\"\n+            ),\n+            \"{text}\"\n+        );\n+        assert!(text.contains(\"No recorded memory peaks.\"));\n+        let json = serde_json::to_value(&report).unwrap();\n+        assert_eq!(json[\"scheduler\"][\"bytes_per_permit\"], 1000);\n+        assert_eq!(json[\"scheduler\"][\"capacity\"], 4);\n+        assert_eq!(json[\"scheduler\"][\"entries\"], serde_json::json!([]));\n+        assert!(!root.path().join(\"scheduler\").exists());\n+    }\n+\n     #[test]\n     fn an_empty_stats_report_is_read_only_and_versioned() {\n         let root = tempfile::tempdir().unwrap();\n         let store = root.path().join(\"store\");\n         let report = collect(&store, &root.path().join(\"targets\")).unwrap();\n         let json = serde_json::to_value(&report).unwrap();\n         assert_eq!(json[\"version\"], 1);\n+        assert!(json.get(\"scheduler\").is_none());\n+        assert!(!report.text(false).contains(\"Scheduler:\"));\n         assert!(json[\"savings\"][\"since_unix_secs\"].is_null());\n         assert_eq!(json[\"cache\"][\"bytes\"], 0);\n         assert!(report.text(true).contains(\"no savings recorded yet\"));"},{"sha":"22aede84688ee9eba6d07661b40c323bd1e0ef3f","filename":"crates/mbx/src/target.rs","status":"modified","additions":36,"deletions":6,"changes":42,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Ftarget.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Ftarget.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Ftarget.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -362,6 +362,41 @@ fn retire_view(directory: &Path) -> std::io::Result<PathBuf> {\n     Ok(aside)\n }\n \n+/// Remove the `target` link in a checkout when it points at that checkout's\n+/// own managed view and the view is gone.\n+///\n+/// Collection removes a view but cannot remove the link inside a live\n+/// checkout, so the link is left dangling until the next build places the view\n+/// again. Cargo cannot create a directory through it, which fails a command\n+/// like `cargo clean -p` that has nothing to build. A link to anywhere else, or\n+/// to a view that still exists, is left alone. Returns whether a link was\n+/// removed.\n+pub fn remove_dangling_link(root: &Path, workspace_root: &Path) -> Result<bool> {\n+    let directory = view_dir(root, workspace_root);\n+    let link = workspace_root.join(\"target\");\n+    if directory.try_exists()?\n+        || !std::fs::read_link(&link).is_ok_and(|destination| destination == directory)\n+    {\n+        return Ok(false);\n+    }\n+    // A running command that holds the view's lease may be placing it again.\n+    let Some(_reservation) = try_reserve_view(&directory) else {\n+        return Ok(false);\n+    };\n+    // Re-read under the reservation: only the link this checkout's own view\n+    // owns may go, and a placement for another root could have replaced it.\n+    if directory.try_exists()?\n+        || !std::fs::read_link(&link).is_ok_and(|destination| destination == directory)\n+    {\n+        return Ok(false);\n+    }\n+    match remove_link(&link) {\n+        Ok(()) => Ok(true),\n+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(false),\n+        Err(error) => Err(error.into()),\n+    }\n+}\n+\n /// Remove the managed target view owned by exactly one workspace.\n ///\n /// A view a running command holds the lease on is left as it is, record and\n@@ -373,12 +408,7 @@ pub fn remove_workspace(root: &Path, workspace_root: &Path) -> Result<RemoveOutc\n         // link inside a live checkout. Let an explicit clean finish that job\n         // once the destination is gone, without deleting an unrecorded view\n         // that may still contain outputs.\n-        let directory = view_dir(root, workspace_root);\n-        let link = workspace_root.join(\"target\");\n-        if !directory.exists()\n-            && std::fs::read_link(&link).is_ok_and(|destination| destination == directory)\n-        {\n-            remove_link(&link)?;\n+        if remove_dangling_link(root, workspace_root)? {\n             return Ok(RemoveOutcome::Removed(0));\n         }\n         return Ok(RemoveOutcome::Missing);"},{"sha":"8bab67ce29d4c0587078bb45a53a9909f135362c","filename":"crates/mbx/src/target_seed.rs","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Ftarget_seed.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Ftarget_seed.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Ftarget_seed.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -66,6 +66,7 @@ impl Donor {\n \n     /// `path`, inside the donor's managed directory, and the same place\n     /// spelled through the checkout's `target` link.\n+    #[cfg(unix)]\n     fn respellings(&self, path: &Path) -> Vec<PathBuf> {\n         let mut spellings = vec![path.to_path_buf()];\n         if let Ok(inside) = path.strip_prefix(&self.directory) {\n@@ -492,6 +493,8 @@ fn remove_abandoned_staging(profile: &Path) {\n }\n \n /// Where symbolic links in a copied tree may point.\n+// Only Unix copies symbolic links; Windows leaves such a unit for the build.\n+#[cfg_attr(not(unix), allow(dead_code))]\n struct Links<'a> {\n     /// The tree being copied.\n     source: &'a Path,"},{"sha":"71e462eff7317721b3751bd22d71b4f68cfe0c30","filename":"crates/mbx/src/target_seed_tests.rs","status":"modified","additions":17,"deletions":4,"changes":21,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Ftarget_seed_tests.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Ftarget_seed_tests.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Ftarget_seed_tests.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -301,10 +301,23 @@ fn only_units_the_donors_last_build_read_are_copied() {\n             )\n             .unwrap();\n     }\n-    std::fs::File::open(stale.join(\"fingerprint\"))\n-        .unwrap()\n-        .set_modified(old)\n-        .unwrap();\n+    // Windows opens a directory only with backup semantics, and setting its\n+    // times needs attribute access that a plain open does not ask for.\n+    #[cfg(windows)]\n+    let fingerprint = {\n+        use std::os::windows::fs::OpenOptionsExt as _;\n+        use windows_sys::Win32::Storage::FileSystem::{\n+            FILE_FLAG_BACKUP_SEMANTICS, FILE_WRITE_ATTRIBUTES,\n+        };\n+        std::fs::OpenOptions::new()\n+            .access_mode(FILE_WRITE_ATTRIBUTES)\n+            .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)\n+            .open(stale.join(\"fingerprint\"))\n+            .unwrap()\n+    };\n+    #[cfg(not(windows))]\n+    let fingerprint = std::fs::File::open(stale.join(\"fingerprint\")).unwrap();\n+    fingerprint.set_modified(old).unwrap();\n \n     let outcome = seed(\n         to.path(),"},{"sha":"dcbe0d21af348147a05cd831980195bf5be27df9","filename":"crates/mbx/src/target_tests.rs","status":"modified","additions":34,"deletions":0,"changes":34,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Ftarget_tests.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Ftarget_tests.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Ftarget_tests.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -640,6 +640,40 @@ fn explicit_removal_drops_a_link_left_dangling_by_collection() {\n     assert!(std::fs::symlink_metadata(workspace.join(\"target\")).is_err());\n }\n \n+#[test]\n+fn drops_a_link_left_dangling_by_collection_without_touching_other_links() {\n+    let directory = tempfile::tempdir().unwrap();\n+    let config = test_config(directory.path(), true);\n+    let workspace = checkout(directory.path(), \"project\");\n+    let managed = place(&config, &workspace, &workspace.join(\"target\"), false).unwrap();\n+\n+    assert!(!remove_dangling_link(&config.target.root, &workspace).unwrap());\n+    assert!(managed.exists());\n+\n+    std::fs::remove_dir_all(&managed).unwrap();\n+    std::fs::remove_file(view_record_path(&config.target.root, &workspace)).unwrap();\n+    assert!(remove_dangling_link(&config.target.root, &workspace).unwrap());\n+    assert!(std::fs::symlink_metadata(workspace.join(\"target\")).is_err());\n+\n+    let other = checkout(directory.path(), \"other\");\n+    symlink_dir(&directory.path().join(\"missing\"), &other.join(\"target\")).unwrap();\n+    assert!(!remove_dangling_link(&config.target.root, &other).unwrap());\n+    assert!(std::fs::symlink_metadata(other.join(\"target\")).is_ok());\n+}\n+\n+#[test]\n+fn keeps_a_dangling_link_while_a_command_holds_the_view() {\n+    let directory = tempfile::tempdir().unwrap();\n+    let config = test_config(directory.path(), true);\n+    let workspace = checkout(directory.path(), \"project\");\n+    let managed = place(&config, &workspace, &workspace.join(\"target\"), false).unwrap();\n+    std::fs::remove_dir_all(&managed).unwrap();\n+    let _lease = ViewLease::acquire(&config.target.root, &workspace).unwrap();\n+\n+    assert!(!remove_dangling_link(&config.target.root, &workspace).unwrap());\n+    assert!(std::fs::symlink_metadata(workspace.join(\"target\")).is_ok());\n+}\n+\n #[test]\n fn keeps_the_target_directory_of_an_idle_checkout() {\n     let directory = tempfile::tempdir().unwrap();"},{"sha":"a597b4c514eca8816b03b3e7910a1f654ceb40b6","filename":"crates/mbx/src/workspace_state.rs","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fworkspace_state.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Fsrc%2Fworkspace_state.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Fsrc%2Fworkspace_state.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -471,6 +471,8 @@ fn set_file_metadata(path: &Path, mode: u32, secs: u64, nanos: u32) -> Result<()\n     #[cfg(not(unix))]\n     {\n         let mut permissions = std::fs::metadata(path)?.permissions();\n+        // Not Unix, so this clears only the read-only attribute.\n+        #[allow(clippy::permissions_set_readonly_false)]\n         permissions.set_readonly(false);\n         std::fs::set_permissions(path, permissions.clone())?;\n         File::options()"},{"sha":"ba993ec3461c35fac9f0b82b39bad18aa4dfde7b","filename":"crates/mbx/tests/build.rs","status":"modified","additions":204,"deletions":0,"changes":204,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Ftests%2Fbuild.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Ftests%2Fbuild.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Ftests%2Fbuild.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -1421,6 +1421,206 @@ fn eager_incremental_keeps_non_workspace_dependencies_shared() {\n     );\n }\n \n+/// One checkout's incremental state directory.\n+fn incremental_checkout(cache: &Path, workspace: &Path) -> PathBuf {\n+    let workspace = workspace.canonicalize().unwrap();\n+    incremental_checkouts(cache)\n+        .into_iter()\n+        .find(|(root, _)| root.canonicalize().is_ok_and(|root| root == workspace))\n+        .map(|(_, state)| state)\n+        .unwrap_or_else(|| panic!(\"{} keeps no incremental state\", workspace.display()))\n+}\n+\n+/// The checkouts' incremental state directories, keyed by workspace root.\n+fn incremental_checkouts(cache: &Path) -> Vec<(PathBuf, PathBuf)> {\n+    std::fs::read_dir(cache.join(\"incremental\"))\n+        .into_iter()\n+        .flatten()\n+        .flatten()\n+        .filter_map(|checkout| {\n+            let record: serde_json::Value =\n+                serde_json::from_slice(&std::fs::read(checkout.path().join(\"checkout.json\")).ok()?)\n+                    .ok()?;\n+            let root = PathBuf::from(record[\"workspace_root\"].as_str()?);\n+            Some((root, checkout.path()))\n+        })\n+        .collect()\n+}\n+\n+/// Whether the `rustc` these tests build with accepts incremental state\n+/// recorded in another checkout under `-Zremap-cwd-prefix` (1.98 and later).\n+fn rustc_relocates_incremental_state() -> bool {\n+    let output = Command::new(\"rustc\").arg(\"-vV\").output().unwrap();\n+    let verbose = String::from_utf8(output.stdout).unwrap();\n+    let release = verbose\n+        .lines()\n+        .find_map(|line| line.strip_prefix(\"release: \"))\n+        .expect(\"rustc -vV names its release\");\n+    let mut parts = release.split(|c: char| !c.is_ascii_digit());\n+    let mut next = || parts.next().unwrap().parse::<u32>().unwrap();\n+    (next(), next()) >= (1, 98)\n+}\n+\n+#[test]\n+fn learned_state_seeds_another_checkout_when_rustc_remaps_the_working_directory() {\n+    const MARKER: &str = \"seeded-from-first\";\n+    let store = tempfile::tempdir().unwrap();\n+    let first = tempfile::tempdir().unwrap();\n+    let second = tempfile::tempdir().unwrap();\n+    let unremapped = tempfile::tempdir().unwrap();\n+    let reports = tempfile::tempdir().unwrap();\n+    let remapped = [\n+        (\"RUSTC_BOOTSTRAP\", \"1\"),\n+        (\"RUSTFLAGS\", \"-Zremap-cwd-prefix=/src\"),\n+    ];\n+    // A module the edit never touches compiles to its own codegen units, which\n+    // rustc reuses rather than recompiles when it accepts the state.\n+    let stable = (0..64)\n+        .map(|index| {\n+            format!(\"pub fn f{index}(x: u64) -> u64 {{ x.rotate_left({index}) ^ {index} }}\\n\")\n+        })\n+        .collect::<String>();\n+    let lib = |value: u32| {\n+        format!(\n+            \"#![doc = include_str!(\\\"../../README.md\\\")]\\npub mod stable;\\npub fn value() -> u32 {{ {value} }}\\n\"\n+        )\n+    };\n+    let edit = |project: &Path| std::fs::write(project.join(\"base/src/lib.rs\"), lib(21)).unwrap();\n+    for project in [first.path(), second.path(), unremapped.path()] {\n+        write_dependent_project(project);\n+        std::fs::write(project.join(\"base/src/stable.rs\"), &stable).unwrap();\n+        std::fs::write(project.join(\"base/src/lib.rs\"), lib(0)).unwrap();\n+    }\n+\n+    build_with(\n+        first.path(),\n+        store.path(),\n+        &reports.path().join(\"first.json\"),\n+        &remapped,\n+    );\n+    edit(first.path());\n+    let edited = build_with(\n+        first.path(),\n+        store.path(),\n+        &reports.path().join(\"first-edit.json\"),\n+        &remapped,\n+    )\n+    .0;\n+    assert!(compiled_incrementally(&edited) >= 1, \"{edited}\");\n+    // rustc leaves files it does not know about in the state directory alone,\n+    // and the seed copies all of it: the marker is how the second checkout's\n+    // state can tell where it came from.\n+    let first_state = incremental_checkout(store.path(), first.path());\n+    let units = find_files(&first_state, |path| {\n+        file_name_is(path, |name| name == \"query-cache.bin\")\n+    });\n+    assert!(!units.is_empty(), \"the edit should leave rustc state\");\n+    for unit in &units {\n+        // <unit>/<crate>-<hash>/<session>/query-cache.bin\n+        let unit = unit.ancestors().nth(3).unwrap();\n+        std::fs::write(unit.join(MARKER), b\"\").unwrap();\n+    }\n+\n+    build_with(\n+        second.path(),\n+        store.path(),\n+        &reports.path().join(\"second.json\"),\n+        &remapped,\n+    );\n+    edit(second.path());\n+    let seeded = build_with(\n+        second.path(),\n+        store.path(),\n+        &reports.path().join(\"second-edit.json\"),\n+        &remapped,\n+    )\n+    .0;\n+    assert!(compiled_incrementally(&seeded) >= 1, \"{seeded}\");\n+    let second_state = incremental_checkout(store.path(), second.path());\n+    let seeded_from_first = !find_files(&second_state, |path| {\n+        file_name_is(path, |name| name == MARKER)\n+    })\n+    .is_empty();\n+    // Before 1.98, rustc checks incremental state against the real working\n+    // directory and ignores another checkout's whatever the flag says, so mbx\n+    // copies nothing.\n+    if !rustc_relocates_incremental_state() {\n+        assert!(\n+            !seeded_from_first,\n+            \"state rustc would ignore should not be copied\"\n+        );\n+        return;\n+    }\n+    assert!(\n+        seeded_from_first,\n+        \"the second checkout's first edit should start from the first checkout's state\"\n+    );\n+    // Copied is not reused: rustc rejects state recorded with different\n+    // options and compiles everything afresh. It links each codegen unit it\n+    // reuses from the previous session into the new one, so only reuse leaves\n+    // the newest session holding the donor's own object files.\n+    #[cfg(unix)]\n+    {\n+        use std::os::unix::fs::MetadataExt as _;\n+        let objects = |directory: &Path| {\n+            find_files(directory, |path| {\n+                path.extension().is_some_and(|extension| extension == \"o\")\n+            })\n+        };\n+        let donor = objects(&first_state)\n+            .iter()\n+            .map(|path| std::fs::metadata(path).unwrap().ino())\n+            .collect::<std::collections::HashSet<_>>();\n+        let newest = find_files(&second_state, |path| {\n+            file_name_is(path, |name| name == \"dep-graph.bin\")\n+        })\n+        .into_iter()\n+        .filter(|graph| {\n+            graph.ancestors().nth(2).is_some_and(|krate| {\n+                krate\n+                    .file_name()\n+                    .is_some_and(|name| name.to_string_lossy().starts_with(\"base-\"))\n+            })\n+        })\n+        .max_by_key(|graph| std::fs::metadata(graph).unwrap().modified().unwrap())\n+        .expect(\"the second checkout keeps state for base\")\n+        .parent()\n+        .unwrap()\n+        .to_path_buf();\n+        let reused = objects(&newest)\n+            .iter()\n+            .filter(|path| donor.contains(&std::fs::metadata(path).unwrap().ino()))\n+            .count();\n+        assert!(\n+            reused > 0,\n+            \"rustc should reuse the seeded codegen units in {}\",\n+            newest.display()\n+        );\n+    }\n+\n+    // Without the flag rustc would ignore another checkout's state, so none\n+    // is copied.\n+    build_with(\n+        unremapped.path(),\n+        store.path(),\n+        &reports.path().join(\"unremapped.json\"),\n+        &[],\n+    );\n+    edit(unremapped.path());\n+    build_with(\n+        unremapped.path(),\n+        store.path(),\n+        &reports.path().join(\"unremapped-edit.json\"),\n+        &[],\n+    );\n+    let unremapped_state = incremental_checkout(store.path(), unremapped.path());\n+    assert!(\n+        find_files(&unremapped_state, |path| file_name_is(path, |name| name\n+            == MARKER))\n+        .is_empty()\n+    );\n+}\n+\n #[test]\n fn learned_private_dependents_reuse_state_after_the_target_is_removed() {\n     let store = tempfile::tempdir().unwrap();\n@@ -5425,10 +5625,14 @@ mod target_views {\n         let cas = store.path().join(\"actions/cas/v1\");\n         std::fs::remove_dir_all(&cas).unwrap();\n         std::fs::write(&cas, b\"not a directory\").unwrap();\n+        // A deleted checkout's incremental state is kept for new checkouts to\n+        // start from until it expires; expiry is measured in whole seconds.\n+        std::thread::sleep(std::time::Duration::from_millis(1100));\n \n         let output = mbx_command()\n             .args([\"gc\", \"--max-size\", \"20GiB\"])\n             .env(\"MBX_CACHE_DIR\", store.path())\n+            .env(\"MBX_GC_INCREMENTAL_MAX_AGE\", \"0s\")\n             .output()\n             .expect(\"mbx should run\");\n "},{"sha":"c49f224b89413700dcfa1daed681185452218e3a","filename":"crates/mbx/tests/configured_rustc_wrapper.rs","status":"added","additions":39,"deletions":0,"changes":39,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Ftests%2Fconfigured_rustc_wrapper.rs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/crates%2Fmbx%2Ftests%2Fconfigured_rustc_wrapper.rs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/crates%2Fmbx%2Ftests%2Fconfigured_rustc_wrapper.rs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -0,0 +1,39 @@\n+//! `build.rustc-wrapper = \"mbx\"` in Cargo configuration makes Cargo run\n+//! `mbx <rustc> <args>`. Real Cargo is the oracle that mbx reports the\n+//! unsupported setting instead of Cargo's `-Zscript` error.\n+#![cfg(unix)]\n+\n+use std::process::Command;\n+\n+#[test]\n+fn cargo_reports_mbx_configured_as_the_rustc_wrapper() {\n+    let temp = tempfile::tempdir().unwrap();\n+    let root = temp.path().canonicalize().unwrap();\n+    std::fs::create_dir_all(root.join(\"src\")).unwrap();\n+    std::fs::write(\n+        root.join(\"Cargo.toml\"),\n+        \"[package]\\nname='wrapper-fixture'\\nversion='0.0.0'\\nedition='2021'\\n\",\n+    )\n+    .unwrap();\n+    std::fs::write(root.join(\"src/main.rs\"), \"fn main() {}\\n\").unwrap();\n+\n+    let cargo = std::env::var_os(\"CARGO\").unwrap_or_else(|| \"cargo\".into());\n+    let output = Command::new(cargo)\n+        .arg(\"build\")\n+        .arg(\"--config\")\n+        .arg(format!(\n+            \"build.rustc-wrapper='{}'\",\n+            env!(\"CARGO_BIN_EXE_mbx\")\n+        ))\n+        .current_dir(&root)\n+        .env(\"CARGO_TARGET_DIR\", root.join(\"target\"))\n+        .env_remove(\"RUSTC_WRAPPER\")\n+        .env_remove(\"CARGO_BUILD_RUSTC_WRAPPER\")\n+        .output()\n+        .unwrap();\n+\n+    let stderr = String::from_utf8_lossy(&output.stderr);\n+    assert!(!output.status.success(), \"build should fail:\\n{stderr}\");\n+    assert!(stderr.contains(\"Remove that setting\"), \"{stderr}\");\n+    assert!(!stderr.contains(\"-Zscript\"), \"{stderr}\");\n+}"},{"sha":"85f7634b2120c32213d6dffe04d15ba5d7d5a3d5","filename":"docs/.vitepress/theme/EndevSponsors.vue","status":"modified","additions":4,"deletions":2,"changes":6,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2F.vitepress%2Ftheme%2FEndevSponsors.vue","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2F.vitepress%2Ftheme%2FEndevSponsors.vue","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/docs%2F.vitepress%2Ftheme%2FEndevSponsors.vue?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -35,8 +35,10 @@ onMounted(async () => {\n <style scoped>\n .EndevSponsors { align-items: center; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin: 0 auto; max-width: 1000px; padding: 24px; }\n .EndevSponsorsTitle { color: var(--vp-c-text-2); font-size: 13px; font-weight: 600; text-transform: uppercase; }\n-.EndevSponsorsLogo { align-items: center; border: 1px solid var(--vp-c-divider); border-radius: 8px; display: inline-flex; height: 40px; justify-content: center; padding: 8px 12px; }\n-.EndevSponsorsLogo:hover { border-color: var(--vp-c-brand-1); }\n+.EndevSponsorsLogo { align-items: center; background: #171717; border: 1px solid var(--vp-c-divider); border-radius: 8px; display: inline-flex; height: 40px; justify-content: center; padding: 8px 12px; }\n+.EndevSponsorsLogo:hover { background: #242424; border-color: var(--vp-c-brand-1); }\n+.dark .EndevSponsorsLogo { background: var(--vp-c-bg-soft); }\n+.dark .EndevSponsorsLogo:hover { background: var(--vp-c-bg-elv); }\n .EndevSponsorsLogo img { display: block; height: 22px; max-width: 120px; object-fit: contain; width: auto; }\n .EndevSponsorsCta { color: var(--vp-c-text-2); font-size: 13px; text-decoration: none; }\n .EndevSponsorsCta:hover { color: var(--vp-c-brand-1); }"},{"sha":"104057cf6e68a781e92928eb7d53900cdaeacae3","filename":"docs/cli/configuration.md","status":"modified","additions":22,"deletions":12,"changes":34,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fcli%2Fconfiguration.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fcli%2Fconfiguration.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/docs%2Fcli%2Fconfiguration.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -162,12 +162,12 @@ Collect learned incremental state unused this long, or `\"none\"`.\n \n - **Type:** `option<string>`\n - **Optional:** true\n-- **Default:** 5% of the cache disk, from 10 GiB to 100 GiB; shared budget when `gc.max_total_size` is set\n+- **Default:** 5% of the cache disk, from 10 GiB to 100 GiB; with `gc.max_total_size`, 10% of the total, at least 10 GiB but never above the total\n - **Set with:** `MBX_GC_INCREMENTAL_MAX_SIZE`\n \n Shared budget for learned incremental state and generated source trees, or `\"none\"`.\n \n-Over budget, mbx collects the incremental state of inactive checkouts least recently used first and keeps the most recently used checkout's. Generated source trees get whatever budget incremental state leaves.\n+Over budget, mbx collects the incremental state of inactive checkouts least recently used first and keeps the most recently used checkout's. Generated source trees get whatever budget incremental state leaves. With `gc.max_total_size`, defaults to 10% of that total, at least 10 GiB but never above the total.\n \n ### `gc.interval`\n \n@@ -198,7 +198,7 @@ It also caps how much one build downloads from the remote cache. Unlike the othe\n \n Combined size target for the action store, managed targets, and incremental state, or `\"none\"`.\n \n-A size such as `50GiB` counts logical bytes across the action store, managed targets, learned incremental state, and generated source trees. When set, it replaces the disk-scaled defaults of the component budgets; explicit component limits still apply. Active and protected state may exceed this target.\n+A size such as `50GiB` counts logical bytes across the action store, managed targets, learned incremental state, and generated source trees. When set, it replaces disk-scaled defaults and caps incremental state and generated source trees at 10% of the total, at least 10 GiB but never above the total, unless `gc.incremental_max_size` is explicit. Explicit component limits still apply. Active and protected state may exceed this target.\n \n ### `gc.min_free_size`\n \n@@ -273,12 +273,12 @@ A workspace crate qualifies on its first source edit; any other crate after thre\n \n - **Type:** `option<string>`\n - **Optional:** true\n-- **Default:** 8 GiB, or `gc.max_total_size` when set\n+- **Default:** 8 GiB\n - **Set with:** `MBX_LEARNED_INCREMENTAL_MAX_SIZE`\n \n How much learned incremental state one crate may keep, or `\"none\"`.\n \n-State past this is discarded before the crate compiles again.\n+State past this is discarded before the crate compiles again. Defaults to 8 GiB even when `gc.max_total_size` is set.\n \n ### `linker.default`\n \n@@ -336,7 +336,7 @@ Has no effect when `display` is `plain`.\n \n Remote access mode.\n \n-Only trusted CI (a push to a protected branch on GitHub Actions or GitLab CI) may write. Everywhere else, including a local shell, `read-write` acts as `read-only` and `write-only` disables the remote.\n+Only trusted CI (a push to a protected branch on GitHub Actions or GitLab CI) may write, unless `remote.trust_writes` is set. Everywhere else, including a local shell, `read-write` acts as `read-only` and `write-only` disables the remote.\n \n **Choices:**\n - `read-write`\n@@ -424,6 +424,16 @@ File containing a bearer token for a cache server.\n \n An `s3://` remote refuses it. `remote.token` takes precedence over it, and it takes precedence over `remote.oidc_audience`.\n \n+### `remote.trust_writes`\n+\n+- **Type:** `bool`\n+- **Default:** `false`\n+- **Set with:** `MBX_REMOTE_TRUST_WRITES`\n+\n+Skip the CI write policy and use `remote.mode` as configured.\n+\n+For CI systems mbx does not detect, such as Buildkite or Jenkins. Set it only from the agent or pipeline environment, only for builds you trust, and never from a file that a pull request can change. Workspace `.mbx.toml` refuses it. The write credential should still be limited to those builds.\n+\n ### `remote.url`\n \n - **Type:** `option<url>`\n@@ -477,9 +487,9 @@ mbx must be able to write to it. mbx uses it only on Linux, and only while `sche\n - **Default:** logical CPUs\n - **Set with:** `MBX_SCHEDULER_CPUS`\n \n-Number of compile permits in the machine-wide pool.\n+CPU core budget in the machine-wide pool before `scheduler.reserve_cpus`.\n \n-A typical compilation takes one permit; links and memory-heavy crates can take more. This may also be set in workspace `.mbx.toml`; the environment variable wins.\n+Compilers charge their thread counts; test binaries can use learned core counts. Memory has its own independent budget. This may also be set in workspace `.mbx.toml`; the environment variable wins.\n \n ### `scheduler.enabled`\n \n@@ -498,9 +508,9 @@ Cache hits never take a permit. A compilation that runs the compiler takes one f\n - **Default:** 85% of physical memory, or of the Linux cgroup memory limit if lower\n - **Set with:** `MBX_SCHEDULER_MEMORY`\n \n-Memory budget the permits divide, such as `24GiB`, or `\"none\"`.\n+Independent memory budget, such as `24GiB`, or `\"none\"`.\n \n-Each permit stands for an equal share of it. `\"none\"` leaves plain CPU permits and also turns off `scheduler.pressure` and `scheduler.suspend`. This may also be set in workspace `.mbx.toml`; the environment variable wins.\n+Requests charge predicted memory bytes separately from CPU cores. `\"none\"` schedules CPU only and turns off `scheduler.pressure` and `scheduler.suspend`. This may also be set in workspace `.mbx.toml`; the environment variable wins.\n \n ### `scheduler.pressure`\n \n@@ -533,9 +543,9 @@ While a normal-priority build is waiting, a `low` build leaves about a quarter o\n - **Default:** `0`\n - **Set with:** `MBX_SCHEDULER_RESERVE_CPUS`\n \n-Permits withheld from `scheduler.cpus` to leave CPUs for other work.\n+CPU cores withheld from `scheduler.cpus` to leave CPUs for other work.\n \n-At least one permit always remains. This may also be set in workspace `.mbx.toml`; the environment variable wins.\n+At least one core always remains; the memory budget is unaffected. This may also be set in workspace `.mbx.toml`; the environment variable wins.\n \n ### `scheduler.suspend`\n "},{"sha":"cfe4462fc1ddc1f59d9115bddc12229116d30d57","filename":"docs/cli/gc.md","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fcli%2Fgc.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fcli%2Fgc.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/docs%2Fcli%2Fgc.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -5,14 +5,14 @@\n \n Collect build state and evict store objects to fit the size budgets.\n \n-mbx collects learned incremental state and managed targets first, then evicts store objects until the action store fits its budget (`--max-size`, or `gc.max_size` by default, lowered when `gc.max_total_size` leaves less room). When a disk has less free space than `gc.min_free_size`, mbx also collects past those budgets to free the shortfall: private state and managed targets go first, then shared store objects, even below `gc.max_size`. Active and most recently used state stays, so a disk filled by something else can remain short.\n+mbx collects learned incremental state and managed targets first, then evicts store objects until the action store fits its budget (`--max-size`, or `gc.max_size` by default, lowered when `gc.max_total_size` leaves less room). Under a combined budget, incremental state and generated source trees default to a cap of 10% of the total, at least 10 GiB but never above the total. When a disk has less free space than `gc.min_free_size`, mbx also collects past those budgets to free the shortfall: private state and managed targets go first, then shared store objects, even below `gc.max_size`. Active and most recently used state stays, so a disk filled by something else can remain short.\n \n An evicted object is rebuilt when a build needs it again.\n \n ## Flags\n - **`--max-size <SIZE>`** — Size the action store may occupy afterwards, such as `20GiB`.\n \n-  Defaults to `gc.max_size`. Managed targets, learned incremental state, and generated source trees are still collected to their own budgets. With `gc.max_total_size` set, they share what is left of that total after the action store, whose share this flag caps.\n+  Defaults to `gc.max_size`. Managed targets, learned incremental state, and generated source trees are still collected to their own budgets. With `gc.max_total_size` set, incremental state and generated source trees default to a cap of 10% of the total, at least 10 GiB but never above the total; managed targets use what remains after them and the action store, whose share this flag caps.\n - **`--json`** — Print a stable machine-readable report.\n - **`--dry-run`** — Show what collection would remove without changing any files.\n "},{"sha":"0dea85367aaf87daf89b995a09237dd99b0a93cd","filename":"docs/cli/index.md","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fcli%2Findex.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fcli%2Findex.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/docs%2Fcli%2Findex.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -1,7 +1,7 @@\n <!-- @generated by usage-cli from usage spec -->\n # `mbx`\n \n-**Version:** 1.24.1\n+**Version:** 1.25.0\n \n - **Usage:** `mbx [+TOOLCHAIN] <SUBCOMMAND>`\n \n@@ -41,7 +41,7 @@\n - [`mbx clean [--under <ROOT>] [WORKSPACE]`](/cli/clean.md)\n - [`mbx adopt [-r --recursive] [--dry-run] [PATH]…`](/cli/adopt.md)\n - [`mbx tui [--once]`](/cli/tui.md)\n-- [`mbx stats [--json]`](/cli/stats.md)\n+- [`mbx stats [--json] [--scheduler]`](/cli/stats.md)\n - [`mbx prefetch <CARGO_ARGS>…`](/cli/prefetch.md)\n - [`mbx exec [--project-root <DIR>] <COMMAND>…`](/cli/exec.md)\n - [`mbx reserve [FLAGS] <COMMAND>…`](/cli/reserve.md)"},{"sha":"4959af38be20dcfaa94d5210a243882ef4607fa3","filename":"docs/cli/reserve.md","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fcli%2Freserve.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fcli%2Freserve.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/docs%2Fcli%2Freserve.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -13,7 +13,7 @@ This is for work such as a VM, Docker build, or another compiler that consumes t\n - **`<COMMAND>…`** — Command and arguments to run while capacity is reserved.\n \n ## Flags\n-- **`--cpus <N>`** — CPU permits to hold while the command runs.\n+- **`--cpus <N>`** — CPU cores to hold while the command runs.\n - **`--memory <SIZE>`** — Memory to hold from the configured scheduler budget.\n - **`--priority <PRIORITY>`** — Whether this reservation yields capacity to normal-priority builds.\n "},{"sha":"83914a2b0e312d65218c2745824bac779b48d9e9","filename":"docs/cli/stats.md","status":"modified","additions":2,"deletions":1,"changes":3,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fcli%2Fstats.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fcli%2Fstats.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/docs%2Fcli%2Fstats.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -1,10 +1,11 @@\n <!-- @generated by usage-cli from usage spec -->\n # `mbx stats`\n \n-- **Usage:** `mbx stats [--json]`\n+- **Usage:** `mbx stats [--json] [--scheduler]`\n \n Show lifetime savings, pruning totals, and estimated workspace sharing.\n \n ## Flags\n - **`--json`** — Print a stable machine-readable report, with byte counts and nanoseconds.\n+- **`--scheduler`** — Show compile memory estimates and a read-only scheduler activity snapshot.\n - **`-h --help`** — Print help"},{"sha":"b48e27901a79222e75d9547f6b023d1c79bff98e","filename":"docs/configuration.md","status":"modified","additions":7,"deletions":5,"changes":12,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fconfiguration.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fconfiguration.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/docs%2Fconfiguration.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -173,17 +173,19 @@ Or run `mbx settings set gc.max_total_size 50GiB`. The environment equivalent is\n \n The budget covers action-store objects and results, managed targets, learned\n incremental state, and [generated source trees](/limits#out-dir-sharing).\n-These components share the budget without the usual disk-scaled size caps.\n-The per-crate learned incremental limit defaults to this same budget.\n+These components share the budget without the usual disk-scaled size caps;\n+learned incremental state and generated source trees default to a cap of 10%\n+of the total, at least 10 GiB but never above the total.\n+The per-crate learned incremental limit still defaults to 8 GiB.\n Explicit component limits still apply; remove those settings if you want mbx\n to manage the allocation. Age limits and the automatic disk-free-space\n safeguard remain enabled.\n \n Collection reserves only the space the action store occupies, up to its limit,\n so an empty store does not force useful targets out. Learned incremental state\n-and generated source trees use the remaining allowance; managed targets use what\n-remains after them. If protected state leaves less room, mbx collects the\n-action store to fit the remaining budget. This order favors shared cached\n+and generated source trees use the remaining allowance up to their cap; managed\n+targets use what remains after them. If protected state leaves less room, mbx\n+collects the action store to fit the remaining budget. This order favors shared cached\n results and incremental state over older target directories; allocation is not\n based on measured rebuild cost.\n "},{"sha":"4f2e3c3eb08fa35a61eabe29daa2f97ef03ed928","filename":"docs/how-it-works.md","status":"modified","additions":12,"deletions":12,"changes":24,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fhow-it-works.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fhow-it-works.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/docs%2Fhow-it-works.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -218,18 +218,18 @@ hit where it would have compiled cold. Both paths rehash every input before\n trusting anything, so the worst a stale record can do is fall back\n to compiling.\n \n-Permits are weighted by memory. Native links start at two permits, and every\n-compilation is thereafter weighted by what it actually used, so admission uses\n-the estimated memory cost of the running work. This is a scheduling estimate,\n-not an operating-system memory limit. A link that turns out to fit in one\n-permit stops being charged for two, which keeps the link-heavy tail of a build\n-from running at half concurrency. A link mbx has never seen is weighed by the\n-heaviest of this machine's recent links. That matters for tests: each test\n-binary has its own crate name, so a cold `cargo test --no-run` has no\n-per-crate history for the links in front of it. A compilation the Linux OOM\n-killer stops is recorded heavier than it measured, so its retry runs with more\n-room. Compiler memory use is measured only on Unix. On Windows, native links\n-keep their two-permit weight and other compilations take one permit.\n+The pool budgets CPU cores and predicted memory independently. A compiler's\n+thread count charges CPU; measured peak history charges memory bytes. A large,\n+CPU-light compile therefore leaves room for other work that fits the remaining\n+memory. Unmeasured single-threaded compiles start with one default memory share,\n+and native links start with two. The share is the memory budget divided by the\n+CPU budget. Link history replaces that guess; a new link uses the heaviest of\n+this machine's recent links. Each test binary has its own crate name, so this\n+window helps a cold `cargo test --no-run` whose links have no per-crate history.\n+A compilation the Linux OOM killer stops is recorded heavier than it measured,\n+so its retry runs with more room. These are scheduling estimates, not operating\n+system memory limits. Compiler memory use is measured only on Unix; Windows\n+keeps the unmeasured guesses.\n \n The pool size, memory budget, and priority are settings; see\n [machine-wide compile scheduling](/scheduling#machine-wide-compile-scheduling)."},{"sha":"a11e826f05fc559dbb8cd34b9b439060b4d7d8cc","filename":"docs/incremental.md","status":"modified","additions":35,"deletions":4,"changes":39,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fincremental.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fincremental.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/docs%2Fincremental.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -32,13 +32,43 @@ Dependents of a crate using private incremental state also keep private state,\n because their inputs contain an artifact other checkouts cannot share. They can\n publish again after the edited crate compiles once more without a source change.\n \n+### Start new checkouts warm\n+\n+rustc ignores incremental state recorded under another working directory, so a\n+new checkout's first edit to each crate compiles that crate from scratch. Give\n+rustc the same working directory in every checkout and that state carries over:\n+\n+```toml\n+# .cargo/config.toml\n+[build]\n+rustflags = [\"-Zremap-cwd-prefix=/src\"]\n+```\n+\n+The flag needs a nightly toolchain, or `RUSTC_BOOTSTRAP=1` on a stable one, and\n+seeding needs rustc 1.98 or later: earlier releases check incremental state\n+against the real working directory and ignore another checkout's, so mbx copies\n+nothing for them.\n+With it, when a crate first needs private state in a checkout, mbx copies the\n+state of the most recently used checkout that has some for the same crate and\n+flags, hard-linking its files. rustc validates the copied state against the\n+sources it compiles, as after any edit, so the first edit in a new worktree\n+compiles incrementally.\n+\n+rustc also records the paths of the crates it links and the outputs it writes,\n+and each checkout has its own target directory. So that those match too, mbx\n+names every path under the working directory relative to it when it compiles a\n+crate with private state under this flag. Debug info and panic messages then\n+name paths under `/src` instead of the checkout.\n+\n ### Where state lives\n \n mbx keeps the state and its records under `incremental/` in the cache\n directory, separately for each checkout. `cargo clean` does not remove this\n state. `mbx clean` and `mbx cache remove` remove it for the selected workspace.\n-[Collection](/managed-targets#collection) removes it for deleted, expired, or\n+[Collection](/managed-targets#collection) removes it for expired or\n least-recently-used checkouts, but never removes state a running build is using.\n+A deleted checkout's state stays until then too, so that a new checkout can\n+start from it.\n \n ### Bound the storage\n \n@@ -69,9 +99,10 @@ mbx settings set gc.incremental_max_age 14d      # or none\n \n When set, `gc.max_total_size` is one combined budget for the action store,\n [managed target directories](/managed-targets), learned incremental state, and\n-generated source trees. It replaces the default aggregate incremental cap, and\n-the per-crate limit defaults to the combined budget. Explicit incremental\n-limits still apply. See [Single cache budget](/configuration#single-cache-budget).\n+generated source trees. The aggregate incremental cap defaults to 10% of that\n+total, at least 10 GiB but never above the total; the per-crate limit stays at\n+8 GiB. Explicit incremental limits still apply. See\n+[Single cache budget](/configuration#single-cache-budget).\n \n ## Eager incremental reuse\n "},{"sha":"b2a54e2c45c7d816209153d50392885babedcfce","filename":"docs/managed-targets.md","status":"modified","additions":3,"deletions":1,"changes":4,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fmanaged-targets.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fmanaged-targets.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/docs%2Fmanaged-targets.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -487,7 +487,9 @@ For one setting covering all managed build data, use `gc.max_total_size` alone:\n max_total_size = \"50GiB\"\n ```\n \n-This replaces implicit component size caps with a shared logical-byte budget.\n+This replaces disk-scaled component caps with a shared logical-byte budget;\n+learned incremental state and generated source trees default to a cap of 10%\n+of the total, at least 10 GiB but never above the total.\n Explicit component caps still apply. See\n [Single cache budget](/configuration#single-cache-budget) for allocation order,\n protected state, and physical-space limitations. The following example instead"},{"sha":"ca4469d02dd62f301585f620d627d71b30444fba","filename":"docs/remote-cache.md","status":"modified","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fremote-cache.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fremote-cache.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/docs%2Fremote-cache.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -232,6 +232,26 @@ mbx reads the trigger from the CI system's own variables:\n | GitHub Actions | `GITHUB_ACTIONS` | `GITHUB_EVENT_NAME` is `push`, `GITHUB_REF_TYPE` is `branch`, and `GITHUB_REF_PROTECTED` is true |\n | GitLab CI | `GITLAB_CI` | `CI_PIPELINE_SOURCE` is `push`, `CI_COMMIT_REF_PROTECTED` is true, and neither `CI_COMMIT_TAG` nor `CI_MERGE_REQUEST_IID` is set |\n \n+### CI systems mbx does not detect\n+\n+On any other CI system, such as Buildkite or Jenkins, `read-write` acts as\n+`read-only`, because mbx cannot tell a trusted build from a pull request. Set\n+`remote.trust_writes` (`MBX_REMOTE_TRUST_WRITES=true`) to skip the policy and\n+use `remote.mode` as configured:\n+\n+```sh\n+# Buildkite agent environment hook, so a pull request cannot change it\n+if [ \"$BUILDKITE_BRANCH\" = \"$BUILDKITE_PIPELINE_DEFAULT_BRANCH\" ] \\\n+  && [ \"$BUILDKITE_PULL_REQUEST\" = false ]; then\n+  export MBX_REMOTE_TRUST_WRITES=true\n+fi\n+```\n+\n+`mbx doctor` then reports `configured read-write, effective read-write`. The\n+setting turns the policy off entirely, so set it only from the agent or\n+pipeline environment, never from a file a pull request can edit (workspace\n+`.mbx.toml` refuses it), and limit the write credential to the same builds.\n+\n This policy prevents untrusted code from publishing objects that later builds\n would trust. The server should still authenticate and authorize requests; the\n client-side policy is not an access-control boundary."},{"sha":"6a6ace9b98e6cdf102c75d6d1f8e563d54c05987","filename":"docs/scheduling.md","status":"modified","additions":169,"deletions":20,"changes":189,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fscheduling.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fscheduling.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/docs%2Fscheduling.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -47,18 +47,137 @@ builds can collectively start more compiler processes than the machine can\n comfortably run. mbx coordinates them through a shared pool under the cache\n directory. Scheduling is on by default; `MBX_SCHEDULER=0` disables it.\n \n-A permit represents a share of the pool's CPU and memory budget. The pool has\n-`scheduler.cpus` permits (default: logical CPUs), minus\n-`scheduler.reserve_cpus` (default: 0), with at least one permit remaining.\n-`scheduler.memory` defaults to 85% of physical memory. In a Linux container,\n-the cgroup's memory limit constrains that budget.\n-\n-Compiler processes take permits according to their estimated memory use.\n-Unmeasured compilations start at one permit; native links start at two and can\n-use estimates from earlier links. Measurements refine later admissions. mbx\n-measures compiler memory on Unix only, so on Windows, compilations keep these\n-starting weights. Set `scheduler.memory = \"none\"` to use CPU permits without\n-memory weighting.\n+The pool has two independent budgets: CPU cores and memory bytes. The CPU\n+budget is `scheduler.cpus` (default: logical CPUs) minus\n+`scheduler.reserve_cpus` (default: 0), with at least one core remaining.\n+The memory budget is `scheduler.memory`, which defaults to 85% of physical\n+memory. In a Linux container, the cgroup's memory limit constrains that default.\n+Reserving CPUs does not reduce the memory budget.\n+\n+A request must fit both budgets. CPU charges follow the compiler's thread\n+count, or a test's learned core use. Memory charges use predicted bytes from\n+past measurements. A compile predicted to use 24 GiB on one core therefore\n+leaves other cores available for work that fits the remaining memory.\n+Each budget allows an oversize request when no running request consumes that\n+resource: an oversize memory request still needs CPU room, and an oversize\n+CPU request still needs memory room.\n+\n+For unmeasured work, the memory guess retains the old permit size: memory\n+budget divided by the CPU budget, rounded down. Ordinary single-threaded\n+compiles start at one such share, native links at two, and unmeasured nextest\n+tests at two. Higher thread counts retain at least their old memory guess.\n+Measurements refine later admissions and use raw predicted bytes, without\n+rounding to CPU shares. mbx measures compiler memory on Unix only, so on\n+Windows, compilations keep the starting guesses. Set\n+`scheduler.memory = \"none\"` for CPU-only scheduling.\n+Cargo's `-j` or `CARGO_BUILD_JOBS` adds a CPU ceiling for one build; it does\n+not impose another memory ceiling.\n+\n+For compiles, mbx keeps separate histories for each set of emitted outputs,\n+crate types, explicit targets, test compilation, optimization, LTO, codegen\n+units, debug info, incremental compilation and compiler thread settings.\n+Repeated emit and crate-type flags are combined, sorted and deduplicated;\n+output paths and dep-info do not distinguish modes. With no emit flag, rustc\n+emits a link output. Clippy has separate modes. Links retain their existing\n+crate and code-generation-profile keys. Native C/C++ compiles keep their\n+never-lowered legacy maximum: their filename-only keys can collide across libraries, so small compiles must not\n+push another library’s heavy peak out of history. Other keys without a Rust\n+compile mode or link identity also retain the legacy rule.\n+\n+Each Rust compile-mode or link key keeps the last **16 successful, unwrapped\n+peak-RSS measurements**.\n+Starting with the first sample, mbx estimates an upper bound in log space:\n+`exp(mean(log peaks) + q * s * sqrt(1 + 1/n))`. The charge is the larger of\n+that bound and the window maximum. The spread `s` shrinks the key's sample\n+variance toward a pooled spread with four prior degrees of freedom. The\n+pooled spread is the median log-space sample standard deviation over keys\n+of the same kind with at least four samples; fewer than ten qualifying keys\n+use a spread of 0.5. This is recomputed when the ledger is read.\n+\n+The target probability is **0.95**, selected by causal admission replay.\n+For each kind, the latest 256 standardized prediction residuals calibrate\n+`q` using finite-sample rank `ceil(0.95 * (N + 1))`, clamped to the\n+`N` available residuals. Before 50 residuals, mbx uses a one-sided Student-t multiplier with `4 + n - 1` degrees of freedom.\n+Residuals use the prediction features frozen before admission waiting, and\n+only successful, unwrapped runs calibrate them. Zero-spread predictions have\n+no defined standardized residual and skip calibration for that sample.\n+\n+A compile mode without window samples first uses its retained legacy per-mode\n+entry, preserving the old headroom and crate-wide fallback rules. If that entry\n+is absent, it uses the largest current charge among sibling modes of the same\n+crate. With no sampled siblings it uses the legacy crate-wide maximum, then\n+the default one-share memory guess. A link without window samples first uses\n+its legacy per-key maximum, then its profile's recent link maximum if available (the global link window for links\n+without a profile), then the two-share link floor. Test-binary and nextest\n+histories keep their existing behavior.\n+\n+Estimates can fall as old peaks roll out of the window. An OOM kill appends\n+its doubled measured peak, even for wrapped work, so the charge rises to at\n+least that value. Ordinary failures and wrapped successes do not teach the\n+new windows. Each window map is capped at 1024 keys, evicting the smallest\n+window maximum first. Legacy all-time peaks, compile sample counts and link\n+windows are still written with their original rules for older mbx versions.\n+Old ledgers read without migration; older writers can discard the new fields,\n+which makes new readers return to the cold-start hierarchy until they relearn.\n+\n+`mbx stats --scheduler` shows each key's window size, window maximum, bound,\n+charge and source, alongside its legacy peak and sample count. It also shows\n+pooled spreads, residual counts and quantile multipliers for each kind.\n+Before calibration the kind summary shows the cold-key multiplier (n=1);\n+JSON includes each measured key's actual multiplier. Test-run charges still\n+defer to admission. Add `--json` for raw bytes. Without `--scheduler`, the\n+stats output omits this section. Charges use global scheduler settings;\n+a workspace `.mbx.toml` can change them for that workspace's builds.\n+The read-only activity snapshot shows each lease and waiter with its name, mode\n+key, build ID, pressure domain, age, and the charge it was really admitted or\n+queued with. Older records show unknown names; abandoned records can remain\n+visible until an admission reclaims them.\n+\n+With memory weighting enabled, completed admitted compiles, links, test binaries,\n+and nextest tests append estimate-accuracy observations to\n+`<cache_dir>/scheduler/observations.jsonl`. The existing `events` setting gates\n+this log (on by default); `events = false` disables observations too. Each line\n+pairs the prediction and its source with charged CPU cores and memory bytes,\n+plus legacy admitted permits and bytes per permit,\n+measured child peak RSS (or null), outcome, wrapper status, and wait/run times.\n+Observations include build identity and applicable build and domain capacities.\n+`mbx reserve` records each reservation's CPU and memory charges, legacy weight,\n+wait and run times, and command\n+outcome; reservations have no peak measurement.\n+Peak RSS has the same child-process measurement limitations as the memory ledger.\n+Lines are smaller than 1 KiB; exceptionally long names, keys, or pressure domains\n+are shortened with a hash suffix to preserve distinct identities.\n+\n+Before appending to a file over 8 MiB, a writer tries `observations.lock` without\n+waiting, then rotates to `observations.jsonl.1`, replacing the previous generation.\n+The usual retention bound is two approximately 8 MiB files. A busy rotation lock\n+can temporarily allow growth; concurrent appends and rotation can lose a few lines.\n+Observation failures are debug-logged and do not prevent the workload from running.\n+\n+The estimate-accuracy section of `mbx stats --scheduler` reads both generations,\n+ignoring malformed lines, and shows the retained time span as UTC dates and\n+times. Timestamp fields in `--json` are Unix milliseconds.\n+It shows total observations, reservation exceedances, the worst peak/reservation\n+ratio and its timestamp, and the 20 keys with the highest worst-case ratios.\n+`--json` includes all keys, counts, highest peaks, median and nearest-rank p90\n+peak/prediction ratios, and average reserved-but-unused bytes (clamped to zero\n+when a run exceeds its reservation). Failed and OOM-killed runs have separate\n+counts and still contribute to exceedances and worst cases; median, p90, and\n+unused-byte averages use only successful unwrapped measurements. Missing peaks\n+count as observations but do not contribute to measured statistics. Without\n+observations, this section shows a short empty-state line.\n+\n+When a compilation cannot fit, it queues before newer requests, so a large\n+compilation still runs while other builds keep submitting small ones. Newer\n+requests may use capacity a waiting request cannot use when it next becomes\n+able to start, only when both CPU and memory fit the safe slack in every\n+shared scope. The memory calculation rounds completion subsets up in 16 MiB\n+units and subtracts their maximum rounding error; a calculation that exceeds\n+the bounded subset bitset refuses the pass. Within one scope this never delays an older request. When a request\n+waits on its own build or container limit, the existing rule already lets\n+other builds or containers start, which can rarely delay the waiting request\n+after a pass. Cancelling a waiter or killing its process releases its queue\n+position.\n \n Cache hits do not need compiler permits. If a process dies, the kernel\n releases its permits. For the weighting and recovery details, see\n@@ -86,6 +205,32 @@ container's admissions. Suspended work is the exception: while compiler\n supervision in any container has frozen a compilation, every container sharing\n the cache waits for it to resume.\n \n+When containers share a cache directory, configure `scheduler.cpus` and\n+`scheduler.memory` in their shared configuration using the host's budget.\n+Otherwise each container defaults the shared pool to its own limits. For\n+example, a host budget of 64 CPUs and 256 GiB is:\n+\n+```toml\n+[scheduler]\n+cpus = 64\n+memory = \"256GiB\"\n+```\n+\n+mbx also enforces a separate ceiling for each container. The ceiling is the\n+container's available CPUs and, when the configured memory budget exceeds the\n+container's memory limit, 85% of that limit. A memory budget that fits within\n+local memory applies as configured. All builds in that container share the\n+ceiling; other containers draw from their own ceilings and the common host pool.\n+Pressure control remains local to each container. During an upgrade, older\n+compiler leases without a container identity count against every container\n+until they finish. Records from older wrappers reserve their full legacy\n+weight in cores and that weight times their original memory share in bytes.\n+New wrappers still write the original weight and memory share for older readers;\n+new records carry exact CPU and memory charges as well. Older mbx versions\n+read the same single-number charge as today, including its cap at the writing\n+process's own capacity; new versions read the exact cores and bytes. Upgrade\n+all wrappers sharing the pool to get ordered admission.\n+\n Set `scheduler.pressure = false` (`MBX_SCHEDULER_PRESSURE=0`) to admit\n compilations on permits and memory estimates alone. Disabling the scheduler or\n setting `scheduler.memory = \"none\"` also disables pressure control. If the\n@@ -94,7 +239,8 @@ checks.\n \n Use `scheduler.priority = \"low\"` (`MBX_SCHEDULER_PRIORITY=low`) for an editor's\n background check or CI on a shared machine. While normal-priority work is\n-waiting, low-priority builds leave a quarter of the pool available for it.\n+waiting, low-priority builds leave a quarter of each budget available for it,\n+without withholding the whole CPU or memory budget.\n \n ## Reserve capacity for external work\n \n@@ -105,7 +251,9 @@ memory but does not run through mbx, such as a build in a VM or container:\n mbx reserve --memory 6GiB --cpus 4 -- ./run-windows-build-in-vm.sh\n ```\n \n-The command waits until the requested capacity is free, then a dedicated worker\n+CPU and memory requests reserve exactly their separate amounts; an omitted\n+resource reserves zero of that resource. The command waits until both amounts\n+fit, then a dedicated worker\n holds it until the external command exits. Killing the invoking `mbx reserve`\n process alone does not release capacity while that worker still waits for the\n command; a crashed worker does release its lease through the operating system.\n@@ -139,16 +287,17 @@ For Cargo test, each test binary waits for permits before it starts:\n - Once a binary has been measured, it asks for the average number of cores it\n   kept busy: CPU time divided by wall time, rounded to the nearest core.\n - Before that, `--test-threads=N` or `RUST_TEST_THREADS=N` asks for `N`\n-  permits, and otherwise the binary asks for half the pool, rounded up.\n-- A binary whose measured memory needs more permits takes that many instead.\n+  cores, and otherwise the binary asks for half the CPU budget, rounded up.\n+- Memory is charged separately using the binary's measured peak. Before a\n+  measurement exists, its memory guess preserves the old thread-based charge.\n \n For Cargo test, only complete suite runs are measured; a run narrowed by a\n test name, `--skip`, or `--ignored` is not. A run under a second is too short\n to average, so the binary is recorded as one core. A recorded core count only goes up,\n because a suite measured on a busy machine gets fewer cores than it would use.\n mbx measures CPU and memory on Unix only. On Windows, a Cargo test binary asks\n for its stated thread count or half the pool; an unmeasured nextest test asks\n-for one core and, when memory scheduling is on, two memory permits.\n+for one core and, when memory scheduling is on, two default memory shares.\n \n History is kept per Git repository, package, and test binary. Worktrees of one\n repository share it; separate clones and unrelated projects do not. Outside\n@@ -161,7 +310,7 @@ and test name. A test with history uses its own measurements. A new test uses\n the largest measurements of other tests in that binary; when the binary has\n no history, it starts with one core and, when memory scheduling is on, two\n memory permits. Successful tests record their measured peak even when they use\n-less than one permit, so later runs can use a smaller estimate. On Unix, peak\n+less than one default memory share, so later runs can use a smaller estimate. On Unix, peak\n memory is the largest single process reported by `rusage`; a descendant's\n peak is folded in when it exits, but concurrent child processes are not added\n together.\n@@ -195,8 +344,8 @@ These run unscheduled:\n | Limit | Affects |\n | --- | --- |\n | `scheduler.cpus`, `scheduler.memory` | The shared compiler pool |\n-| `scheduler.reserve_cpus` | Capacity left outside that pool |\n-| Cargo `-j` or `CARGO_BUILD_JOBS` | How much of the pool one build may hold |\n+| `scheduler.reserve_cpus` | CPU cores left outside that pool |\n+| Cargo `-j` or `CARGO_BUILD_JOBS` | CPU cores one build may hold |\n | `scheduler.priority = \"low\"` | Whether a build yields to waiting normal-priority work |\n | `scheduler.tests = true` | Whether Cargo test binaries and nextest tests take permits |\n "},{"sha":"5ea6a7da9ef0c406072ca07a72e7187015170f59","filename":"docs/setup.md","status":"modified","additions":3,"deletions":1,"changes":4,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fsetup.md","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/docs%2Fsetup.md","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/docs%2Fsetup.md?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -165,7 +165,9 @@ Outside mise activation, the Cargo shim finds mbx this way:\n - On Unix, it runs the mbx that `mbx setup` recorded while that file exists,\n   then resolves the active `mbx` from `PATH` after an upgrade removes it.\n - On Windows, `cargo.exe` resolves the active mbx from `PATH`, with the\n-  recorded mbx as a fallback.\n+  recorded mbx as a fallback. It skips mise's `mbx.exe` shim, in mise's data\n+  directory or `MISE_SHIMS_DIR`, which fails in directories where mise does\n+  not enable mbx.\n \n On Unix, once mise prunes the mbx version that `mbx setup` recorded, as it does\n after `mise upgrade`, the Cargo shim works only where `mbx` is on `PATH`."},{"sha":"652cca2dc8322465a25134695fe4dfe950e9c824","filename":"e2e-win/CargoDispatch.Tests.ps1","status":"modified","additions":49,"deletions":8,"changes":57,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/e2e-win%2FCargoDispatch.Tests.ps1","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/e2e-win%2FCargoDispatch.Tests.ps1","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/e2e-win%2FCargoDispatch.Tests.ps1?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -4,20 +4,38 @@ Describe 'Cargo command dispatch' {\n         $script:OriginalCacheDir = [Environment]::GetEnvironmentVariable('MBX_CACHE_DIR', 'Process')\n         $script:OriginalGcAuto = [Environment]::GetEnvironmentVariable('MBX_GC_AUTO', 'Process')\n         $script:OriginalTargetDir = [Environment]::GetEnvironmentVariable('CARGO_TARGET_DIR', 'Process')\n+        $script:OriginalShimDir = [Environment]::GetEnvironmentVariable('MBX_TEST_SHIM_DIR', 'Process')\n+        $script:OriginalRustAnalyzerConfig = [Environment]::GetEnvironmentVariable('MBX_TEST_RUST_ANALYZER_CONFIG', 'Process')\n+        $script:OriginalMiseShell = [Environment]::GetEnvironmentVariable('MISE_SHELL', 'Process')\n+        $script:OriginalMiseConfigFile = [Environment]::GetEnvironmentVariable('MISE_CONFIG_FILE', 'Process')\n         $script:TestRoot = Join-Path $TestDrive ([System.Guid]::NewGuid().ToString())\n         New-Item -ItemType Directory -Path $script:TestRoot | Out-Null\n         Set-Location $script:TestRoot\n         $env:MBX_CACHE_DIR = Join-Path $script:TestRoot 'cache'\n         $env:MBX_GC_AUTO = '0'\n         Remove-Item Env:CARGO_TARGET_DIR -ErrorAction Ignore\n+        # Windows finds LocalAppData and AppData without reading the\n+        # environment, so `mbx setup` would otherwise write the shim and the\n+        # rust-analyzer config into the real profile. Debug builds take both\n+        # locations from these variables instead.\n+        $env:MBX_TEST_SHIM_DIR = Join-Path $script:TestRoot 'mbx\\bin'\n+        $env:MBX_TEST_RUST_ANALYZER_CONFIG = Join-Path $script:TestRoot 'config\\rust-analyzer\\rust-analyzer.toml'\n+        # In a shell with mise activated, `mbx setup --status` would check the\n+        # developer's mise config. The Bats suite clears these for the same reason.\n+        Remove-Item Env:MISE_SHELL -ErrorAction Ignore\n+        Remove-Item Env:MISE_CONFIG_FILE -ErrorAction Ignore\n     }\n \n     AfterEach {\n         Set-Location $script:OriginalDir\n         foreach ($item in @(\n             @{ Name = 'MBX_CACHE_DIR'; Value = $script:OriginalCacheDir },\n             @{ Name = 'MBX_GC_AUTO'; Value = $script:OriginalGcAuto },\n-            @{ Name = 'CARGO_TARGET_DIR'; Value = $script:OriginalTargetDir }\n+            @{ Name = 'CARGO_TARGET_DIR'; Value = $script:OriginalTargetDir },\n+            @{ Name = 'MBX_TEST_SHIM_DIR'; Value = $script:OriginalShimDir },\n+            @{ Name = 'MBX_TEST_RUST_ANALYZER_CONFIG'; Value = $script:OriginalRustAnalyzerConfig },\n+            @{ Name = 'MISE_SHELL'; Value = $script:OriginalMiseShell },\n+            @{ Name = 'MISE_CONFIG_FILE'; Value = $script:OriginalMiseConfigFile }\n         )) {\n             if ($null -eq $item.Value) {\n                 Remove-Item \"Env:$($item.Name)\" -ErrorAction Ignore\n@@ -72,17 +90,15 @@ mbx-probe = \"new --vcs none\"\n         $mbx = (Get-Command mbx).Source\n         $originalPath = $env:PATH\n         $originalDisable = $env:MBX_DISABLE\n-        $localAppData = [Environment]::GetFolderPath([Environment+SpecialFolder]::LocalApplicationData)\n-        $shimDir = Join-Path $localAppData 'mbx\\bin'\n+        $shimDir = $env:MBX_TEST_SHIM_DIR\n         $targetFile = Join-Path $shimDir 'mbx-target'\n-        $targetExisted = Test-Path -LiteralPath $targetFile\n-        $originalTargetBytes = if ($targetExisted) { [IO.File]::ReadAllBytes($targetFile) } else { $null }\n         try {\n             $output = & $mbx setup 2>&1 | Out-String\n             $LASTEXITCODE | Should -Be 0 -Because $output\n \n             Test-Path -LiteralPath (Join-Path $shimDir 'cargo.exe') | Should -BeTrue\n             Test-Path -LiteralPath $targetFile | Should -BeTrue\n+            Test-Path -LiteralPath $env:MBX_TEST_RUST_ANALYZER_CONFIG | Should -BeTrue\n             $statusOutput = & $mbx setup --status 2>&1 | Out-String\n             $LASTEXITCODE | Should -Be 0 -Because $statusOutput\n \n@@ -103,11 +119,36 @@ mbx-probe = \"new --vcs none\"\n             $version | Should -Match '^cargo '\n         } finally {\n             $env:PATH = $originalPath\n-            if ($targetExisted) {\n-                [IO.File]::WriteAllBytes($targetFile, $originalTargetBytes)\n+            if ($null -eq $originalDisable) {\n+                Remove-Item Env:MBX_DISABLE -ErrorAction Ignore\n             } else {\n-                Remove-Item -LiteralPath $targetFile -ErrorAction Ignore\n+                $env:MBX_DISABLE = $originalDisable\n             }\n+        }\n+    }\n+\n+    It 'skips the mise mbx shim when the cargo.exe shim forwards' {\n+        $mbx = (Get-Command mbx).Source\n+        $originalPath = $env:PATH\n+        $originalDisable = $env:MBX_DISABLE\n+        $shimDir = $env:MBX_TEST_SHIM_DIR\n+        try {\n+            $output = & $mbx setup 2>&1 | Out-String\n+            $LASTEXITCODE | Should -Be 0 -Because $output\n+\n+            # Outside a directory whose mise config enables mbx, mise's shim\n+            # fails. Any executable that is not mbx stands in for it here.\n+            $miseShims = Join-Path $script:TestRoot 'mise\\shims'\n+            New-Item -ItemType Directory -Path $miseShims | Out-Null\n+            Copy-Item -LiteralPath (Join-Path $env:SystemRoot 'System32\\whoami.exe') -Destination (Join-Path $miseShims 'mbx.exe')\n+\n+            $env:PATH = \"$shimDir;$miseShims;$originalPath\"\n+            $env:MBX_DISABLE = '1'\n+            $version = & cargo.exe --version 2>&1 | Out-String\n+            $LASTEXITCODE | Should -Be 0 -Because $version\n+            $version | Should -Match '^cargo '\n+        } finally {\n+            $env:PATH = $originalPath\n             if ($null -eq $originalDisable) {\n                 Remove-Item Env:MBX_DISABLE -ErrorAction Ignore\n             } else {"},{"sha":"1d33576ee50f1dc97a7413f71e567a3c3e2697d6","filename":"e2e-win/run.ps1","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/e2e-win%2Frun.ps1","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/e2e-win%2Frun.ps1","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/e2e-win%2Frun.ps1?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -2,6 +2,11 @@ param(\n     [string]$TestName\n )\n \n+# Load Pester before Enter-VsDevShell rewrites the environment: on a profile\n+# path with non-ASCII characters it can mangle PSModulePath, after which only\n+# the Pester 3 that ships with Windows is found and no test runs.\n+Import-Module Pester -MinimumVersion 5.0 -ErrorAction Stop\n+\n if (-not (Get-Command cl.exe -ErrorAction Ignore)) {\n     $vswhere = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio\\Installer\\vswhere.exe'\n     if (-not (Test-Path $vswhere)) {"},{"sha":"9b5d47bf1217f882bdf2ed9c516682864d424efe","filename":"mise-tasks/bench/_default","status":"added","additions":12,"deletions":0,"changes":12,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/mise-tasks%2Fbench%2F_default","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/mise-tasks%2Fbench%2F_default","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/mise-tasks%2Fbench%2F_default?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -0,0 +1,12 @@\n+#!/usr/bin/env bash\n+#MISE description=\"Compare cargo, mbx, and kache on a pinned real-world project\"\n+#MISE depends=[\"perf:prepare\"]\n+# Real-world comparison against raw cargo and kache, on a pinned third-party\n+# project. Long-running by nature: every cell is a full build of somebody\n+# else's workspace. See benchmarks/README.md.\n+set -euo pipefail\n+\n+exec python3 benchmarks/real_world.py \\\n+  --mbx target/release/mbx \\\n+  --scenarios warm,worktree,commit,edit \\\n+  --output target/benchmarks"},{"sha":"dd7ad598f172558fdcaba1d49e14da73943a793a","filename":"mise-tasks/bench/refresh","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/mise-tasks%2Fbench%2Frefresh","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/mise-tasks%2Fbench%2Frefresh","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/mise-tasks%2Fbench%2Frefresh?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -0,0 +1,19 @@\n+#!/usr/bin/env bash\n+#MISE description=\"Refresh published hk and aube benchmarks\"\n+#MISE depends=[\"perf:prepare\"]\n+# What CI runs. Adds the contention batch, repeats every scenario so the site\n+# can tell a result from the machine, and rewrites the results file the\n+# documentation site reads.\n+set -euo pipefail\n+\n+for subject in hk aube; do\n+  results=benchmarks/results.json\n+  if [ \"$subject\" = aube ]; then results=benchmarks/results-aube.json; fi\n+  python3 benchmarks/real_world.py \\\n+    --subject \"$subject\" \\\n+    --mbx target/release/mbx \\\n+    --scenarios warm,worktree,commit,edit,contention \\\n+    --trials 3 \\\n+    --output \"target/benchmarks/$subject\" \\\n+    --write-results \"$results\"\n+done"},{"sha":"ac1214160d8fd6f393ed3a03e4ab3c1a23f41a6e","filename":"mise-tasks/render/docs","status":"added","additions":44,"deletions":0,"changes":44,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/mise-tasks%2Frender%2Fdocs","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/mise-tasks%2Frender%2Fdocs","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/mise-tasks%2Frender%2Fdocs?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -0,0 +1,44 @@\n+#!/usr/bin/env python\n+#MISE description=\"Generate reference documentation from the usage spec\"\n+#MISE depends=[\"bootstrap\"]\n+\"\"\"Render docs/cli from the mbx usage spec.\n+\n+One script for every platform: the old `run_windows` copy of these steps\n+needed PowerShell one-liners for what `sed` does on Unix.\n+\"\"\"\n+\n+import re\n+import shutil\n+import subprocess\n+import sys\n+from pathlib import Path\n+\n+CLI = Path(\"docs/cli\")\n+MBX = Path(\"target/mbx-bootstrap/mbx.exe\" if sys.platform == \"win32\" else \"target/mbx-bootstrap/mbx\")\n+\n+\n+def rewrite(path, pattern, replacement):\n+    # Newline-preserving, so a Windows run leaves the same bytes as a Unix one.\n+    with open(path, encoding=\"utf-8\", newline=\"\") as f:\n+        text = f.read()\n+    with open(path, \"w\", encoding=\"utf-8\", newline=\"\") as f:\n+        f.write(re.sub(pattern, replacement, text, flags=re.MULTILINE))\n+\n+\n+shutil.rmtree(CLI, ignore_errors=True)\n+spec = subprocess.run([MBX, \"__usage_spec__\"], check=True, stdout=subprocess.PIPE).stdout\n+subprocess.run(\n+    [\n+        \"usage\", \"generate\", \"markdown\", \"--file\", \"-\", \"--multi\",\n+        \"--replace-pre-with-code-fences\", \"--url-prefix\", \"/cli\",\n+        \"--out-dir\", str(CLI),\n+    ],\n+    input=spec,\n+    check=True,\n+)\n+\n+# The configuration reference is not its own page: /configuration embeds it\n+# with an @include, so its headings are demoted to sit under that page's\n+# \"Settings\" section and the generated index links there instead.\n+rewrite(CLI / \"configuration.md\", r\"^## \", \"### \")\n+rewrite(CLI / \"index.md\", re.escape(\"(/cli/configuration.md)\"), \"(/configuration#settings)\")"},{"sha":"8a89f3890eeedd71ffd24ed6bf78352647668047","filename":"mise.lock","status":"modified","additions":40,"deletions":0,"changes":40,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/mise.lock","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/mise.lock","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/mise.lock?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -286,6 +286,46 @@ url = \"https://nodejs.org/dist/v24.21.0/node-v24.21.0-darwin-arm64.tar.gz\"\n checksum = \"sha256:158f7685b44de51f6c0df1d153526cbcd3e1bc739a8dfc607721cef75de9e541\"\n url = \"https://nodejs.org/dist/v24.21.0/node-v24.21.0-win-x64.zip\"\n \n+[[tools.python]]\n+version = \"3.15.0\"\n+backend = \"core:python\"\n+specifiers = [\"3\"]\n+\n+[tools.python.\"platforms.linux-arm64\"]\n+checksum = \"sha256:064778ca701efc4c8366d0b235a2a0f5dbe14d921aeb2ef4f5c7b93e5a75cbd0\"\n+url = \"https://github.com/astral-sh/python-build-standalone/releases/download/20261013/cpython-3.15.0+20261013-aarch64-unknown-linux-gnu-install_only_stripped.tar.gz\"\n+provenance = \"github-attestations\"\n+\n+[tools.python.\"platforms.linux-arm64-musl\"]\n+checksum = \"sha256:d6064f89c264cce8444e4eb8c2d5041827fe20bf0836b2042a91807ff8a9596d\"\n+url = \"https://github.com/astral-sh/python-build-standalone/releases/download/20261013/cpython-3.15.0+20261013-aarch64-unknown-linux-musl-install_only_stripped.tar.gz\"\n+provenance = \"github-attestations\"\n+\n+[tools.python.\"platforms.linux-x64\"]\n+checksum = \"sha256:69740dcd9b3480b3d53760f2d3b75582adb14fa54434628dea32480ddede542a\"\n+url = \"https://github.com/astral-sh/python-build-standalone/releases/download/20261013/cpython-3.15.0+20261013-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz\"\n+provenance = \"github-attestations\"\n+\n+[tools.python.\"platforms.linux-x64-musl\"]\n+checksum = \"sha256:e33aa97230e4a72c108a82365fd3d14a28d04a8451d15d0e9bc2b0521d2fec11\"\n+url = \"https://github.com/astral-sh/python-build-standalone/releases/download/20261013/cpython-3.15.0+20261013-x86_64-unknown-linux-musl-install_only_stripped.tar.gz\"\n+provenance = \"github-attestations\"\n+\n+[tools.python.\"platforms.macos-arm64\"]\n+checksum = \"sha256:b4ab2009803cef142e4ebf2ebef225f6875f83cc35caf4eefb437aa9b2b76783\"\n+url = \"https://github.com/astral-sh/python-build-standalone/releases/download/20261013/cpython-3.15.0+20261013-aarch64-apple-darwin-install_only_stripped.tar.gz\"\n+provenance = \"github-attestations\"\n+\n+[tools.python.\"platforms.macos-x64\"]\n+checksum = \"sha256:4760e8fb2821441c0dbc72be49a25400c6ae90be4daa7e2a49617ed09f6a2919\"\n+url = \"https://github.com/astral-sh/python-build-standalone/releases/download/20261013/cpython-3.15.0+20261013-x86_64-apple-darwin-install_only_stripped.tar.gz\"\n+provenance = \"github-attestations\"\n+\n+[tools.python.\"platforms.windows-x64\"]\n+checksum = \"sha256:743d2269e74a98f7c4281dbc2e8710c171be1965693720aac818ff0157e4d965\"\n+url = \"https://github.com/astral-sh/python-build-standalone/releases/download/20261013/cpython-3.15.0+20261013-x86_64-pc-windows-msvc-install_only_stripped.tar.gz\"\n+provenance = \"github-attestations\"\n+\n [[tools.tak]]\n version = \"0.0.15\"\n backend = \"github:jdx/tak\""},{"sha":"7fce255f320b0c05beb4d783cefddb5575d55dbc","filename":"mise.toml","status":"modified","additions":18,"deletions":64,"changes":82,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/mise.toml","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/mise.toml","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/mise.toml?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -3,24 +3,27 @@ min_version = \"2026.9.7\"\n [env]\n _.path = [\"test/bats/bin\"]\n \n+# The previous bootstrap binary may still be running, for example the\n+# `gc --automatic` it starts after a build, and Linux refuses to write over it\n+# (\"Text file busy\"). Copy to a file of this run's own and rename it into\n+# place. scripts/install-bootstrap.ps1 does the Windows equivalent.\n [tasks.bootstrap]\n hide = true\n run = [\n   \"cargo build --package mbx --target-dir target/mbx-bootstrap-build\",\n   \"mkdir -p target/mbx-bootstrap\",\n-  \"cp target/mbx-bootstrap-build/debug/mbx target/mbx-bootstrap/mbx\",\n+  \"staged=$(mktemp target/mbx-bootstrap/.mbx.XXXXXX) && { cp -p target/mbx-bootstrap-build/debug/mbx \\\"$staged\\\" && mv -f \\\"$staged\\\" target/mbx-bootstrap/mbx || { rm -f \\\"$staged\\\"; false; }; }\",\n ]\n run_windows = [\n   \"cargo build --package mbx --target-dir target/mbx-bootstrap-build\",\n-  \"New-Item -ItemType Directory -Force target/mbx-bootstrap | Out-Null\",\n-  \"Copy-Item -Force target/mbx-bootstrap-build/debug/mbx.exe target/mbx-bootstrap/mbx.exe\",\n+  \"pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/install-bootstrap.ps1\",\n ]\n \n [tasks.build]\n alias = \"b\"\n depends = [\"bootstrap\"]\n run = \"./target/mbx-bootstrap/mbx build --workspace --all-targets\"\n-run_windows = \"./target/mbx-bootstrap/mbx.exe build --workspace --all-targets\"\n+run_windows = 'target\\mbx-bootstrap\\mbx.exe build --workspace --all-targets'\n \n [tasks.test]\n alias = \"t\"\n@@ -36,7 +39,7 @@ description = \"Run Rust tests\"\n # got that far.\n depends = [\"build\"]\n run = \"./target/mbx-bootstrap/mbx test --workspace\"\n-run_windows = \"./target/mbx-bootstrap/mbx.exe test --workspace\"\n+run_windows = 'target\\mbx-bootstrap\\mbx.exe test --workspace'\n \n [tasks.\"test:release-diagnostics\"]\n description = \"Check publication diagnostics in the release-built wrapper\"\n@@ -46,13 +49,13 @@ run = \"cargo test --release -p mbx --test build cc_publication_failures_are_visi\n description = \"Check Cargo's interactive display and terminal handoff\"\n depends = [\"bootstrap\"]\n run = \"MBX_BIN=$PWD/target/mbx-bootstrap/mbx python3 scripts/test-cargo-pretty.py\"\n-run_windows = \"Write-Output 'PTY integration coverage runs on Unix; renderer tests run on every platform'\"\n+run_windows = \"pwsh -NoProfile -Command \\\"Write-Output 'PTY integration coverage runs on Unix; renderer tests run on every platform'\\\"\"\n \n [tasks.\"test:e2e\"]\n description = \"Run platform behavioral tests\"\n depends = [\"build\"]\n run = \"MBX_BIN=$PWD/target/mbx-bootstrap/mbx bats test\"\n-run_windows = \"pwsh e2e-win/run.ps1\"\n+run_windows = \"pwsh -NoProfile e2e-win/run.ps1\"\n \n [tasks.\"test:bats\"]\n description = \"Run behavioral tests\"\n@@ -62,7 +65,7 @@ run = \"MBX_BIN=$PWD/target/mbx-bootstrap/mbx bats test\"\n [tasks.format]\n depends = [\"bootstrap\"]\n run = \"./target/mbx-bootstrap/mbx fmt --all\"\n-run_windows = \"./target/mbx-bootstrap/mbx.exe fmt --all\"\n+run_windows = 'target\\mbx-bootstrap\\mbx.exe fmt --all'\n \n [tasks.lint]\n depends = [\"bootstrap\"]\n@@ -72,9 +75,9 @@ run = [\n   \"./target/mbx-bootstrap/mbx clippy --release --workspace --all-features --all-targets -- -D warnings\",\n ]\n run_windows = [\n-  \"./target/mbx-bootstrap/mbx.exe fmt --all --check\",\n-  \"./target/mbx-bootstrap/mbx.exe clippy --workspace --all-features --all-targets -- -D warnings\",\n-  \"./target/mbx-bootstrap/mbx.exe clippy --release --workspace --all-features --all-targets -- -D warnings\",\n+  'target\\mbx-bootstrap\\mbx.exe fmt --all --check',\n+  'target\\mbx-bootstrap\\mbx.exe clippy --workspace --all-features --all-targets -- -D warnings',\n+  'target\\mbx-bootstrap\\mbx.exe clippy --release --workspace --all-features --all-targets -- -D warnings',\n ]\n \n [tasks.lint-fix]\n@@ -84,8 +87,8 @@ run = [\n   \"./target/mbx-bootstrap/mbx clippy --workspace --all-features --all-targets --fix --allow-dirty --allow-staged -- -D warnings\",\n ]\n run_windows = [\n-  \"./target/mbx-bootstrap/mbx.exe fmt --all\",\n-  \"./target/mbx-bootstrap/mbx.exe clippy --workspace --all-features --all-targets --fix --allow-dirty --allow-staged -- -D warnings\",\n+  'target\\mbx-bootstrap\\mbx.exe fmt --all',\n+  'target\\mbx-bootstrap\\mbx.exe clippy --workspace --all-features --all-targets --fix --allow-dirty --allow-staged -- -D warnings',\n ]\n \n [tasks.ci]\n@@ -111,28 +114,11 @@ description = \"Render the landing-page showreel to docs/public/showreel-120.mp4\n dir = \"docs\"\n run = \"aube install && exec aube run showreel:video\"\n \n-[tasks.\"render:docs\"]\n-description = \"Generate reference documentation from the usage spec\"\n-depends = [\"bootstrap\"]\n-# The configuration reference is not its own page: /configuration embeds it\n-# with an @include, so its headings are demoted to sit under that page's\n-# \"Settings\" section and the generated index links there instead.\n-run = [\n-  \"rm -rf docs/cli && ./target/mbx-bootstrap/mbx __usage_spec__ | usage generate markdown --file - --multi --replace-pre-with-code-fences --url-prefix /cli --out-dir docs/cli\",\n-  \"sed -i.bak -e 's/^## /### /' docs/cli/configuration.md && rm docs/cli/configuration.md.bak\",\n-  \"sed -i.bak -e 's|(/cli/configuration.md)|(/configuration#settings)|' docs/cli/index.md && rm docs/cli/index.md.bak\",\n-]\n-run_windows = [\n-  \"Remove-Item -Recurse -Force -ErrorAction SilentlyContinue docs/cli; ./target/mbx-bootstrap/mbx.exe __usage_spec__ | usage generate markdown --file - --multi --replace-pre-with-code-fences --url-prefix /cli --out-dir docs/cli\",\n-  \"[IO.File]::WriteAllText('docs/cli/configuration.md', ([IO.File]::ReadAllText('docs/cli/configuration.md') -replace '(?m)^## ', '### '))\",\n-  \"[IO.File]::WriteAllText('docs/cli/index.md', ([IO.File]::ReadAllText('docs/cli/index.md') -replace [regex]::Escape('(/cli/configuration.md)'), '(/configuration#settings)'))\",\n-]\n-\n [tasks.\"check:docs\"]\n description = \"Check that generated documentation is current\"\n depends = [\"render:docs\"]\n run = \"git diff --exit-code -- docs/cli && test -z \\\"$(git status --porcelain --untracked-files=all -- docs/cli)\\\"\"\n-run_windows = \"git diff --exit-code -- docs/cli; if (git status --porcelain --untracked-files=all -- docs/cli) { exit 1 }\"\n+run_windows = \"pwsh -NoProfile -Command \\\"git diff --exit-code -- docs/cli; if (git status --porcelain --untracked-files=all -- docs/cli) { exit 1 }\\\"\"\n \n # VitePress validates page links at build time but not #fragments, so a\n # renamed heading rots its inbound anchors silently. --offline keeps external\n@@ -155,39 +141,6 @@ description = \"Measure instruction-counted performance benchmarks\"\n depends = [\"perf:prepare\"]\n run = \"tak run\"\n \n-# Real-world comparison against raw cargo and kache, on a pinned third-party\n-# project. Long-running by nature: every cell is a full build of somebody\n-# else's workspace. See benchmarks/README.md.\n-[tasks.bench]\n-description = \"Compare cargo, mbx, and kache on a pinned real-world project\"\n-depends = [\"perf:prepare\"]\n-run = \"\"\"\n-python3 benchmarks/real_world.py \\\n-  --mbx target/release/mbx \\\n-  --scenarios warm,worktree,commit,edit \\\n-  --output target/benchmarks\n-\"\"\"\n-\n-# What CI runs. Adds the contention batch, repeats every scenario so the site\n-# can tell a result from the machine, and rewrites the results file the\n-# documentation site reads.\n-[tasks.\"bench:refresh\"]\n-description = \"Refresh published hk and aube benchmarks\"\n-depends = [\"perf:prepare\"]\n-run = \"\"\"\n-for subject in hk aube; do\n-  results=benchmarks/results.json\n-  if [ \"$subject\" = aube ]; then results=benchmarks/results-aube.json; fi\n-  python3 benchmarks/real_world.py \\\n-    --subject \"$subject\" \\\n-    --mbx target/release/mbx \\\n-    --scenarios warm,worktree,commit,edit,contention \\\n-    --trials 3 \\\n-    --output \"target/benchmarks/$subject\" \\\n-    --write-results \"$results\" || exit \"$?\"\n-done\n-\"\"\"\n-\n [tasks.\"perf:record\"]\n description = \"Record performance benchmarks in local git notes\"\n depends = [\"perf:prepare\"]\n@@ -204,6 +157,7 @@ communique = { version = \"latest\", minimum_release_age = \"0s\" }\n jactionlint = \"latest\"\n lychee = \"0.24.2\"\n node = \"24\"\n+python = \"3\"\n # Native scheduler integration tests exercise cargo-nextest's test runner.\n \"aqua:nextest-rs/nextest/cargo-nextest\" = \"0.9.140\"\n # Rust is deliberately absent: the toolchain floats to whatever the"},{"sha":"da4ba74e29911233d21570a9ea1358194f7904ce","filename":"renovate.json","status":"modified","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/renovate.json","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/renovate.json","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/renovate.json?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -2,5 +2,12 @@\n   \"$schema\": \"https://docs.renovatebot.com/renovate-schema.json\",\n   \"extends\": [\n     \"local>jdx/renovate-config\"\n+  ],\n+  \"packageRules\": [\n+    {\n+      \"description\": \"The perf-runner image sets the toolchain every perf baseline is measured on; review bumps instead of automerging them.\",\n+      \"matchPackageNames\": [\"ghcr.io/jdx/perf-runner\"],\n+      \"automerge\": false\n+    }\n   ]\n }"},{"sha":"ac279d3ec6d7ada6c032018ea47d5058ecedbcec","filename":"scripts/install-bootstrap.ps1","status":"added","additions":75,"deletions":0,"changes":75,"blob_url":"https://github.com/jdx/mr-boxington/blob/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/scripts%2Finstall-bootstrap.ps1","raw_url":"https://github.com/jdx/mr-boxington/raw/2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d/scripts%2Finstall-bootstrap.ps1","contents_url":"https://api.github.com/repos/jdx/mr-boxington/contents/scripts%2Finstall-bootstrap.ps1?ref=2ade2bc6b661f1b40a55cfa7083fa9a4efc9348d","patch":"@@ -0,0 +1,75 @@\n+# Install the freshly built bootstrap mbx for the Windows `bootstrap` task.\n+#\n+# The previous bootstrap binary may still be running, for example the\n+# `gc --automatic` it starts after a build, and Windows refuses to replace a\n+# running executable. ReplaceFile can still move it aside, so leftovers are\n+# removed once nothing runs them.\n+$ErrorActionPreference = 'Stop'\n+\n+$directory = 'target/mbx-bootstrap'\n+$built = 'target/mbx-bootstrap-build/debug/mbx.exe'\n+$attempts = 5\n+\n+New-Item -ItemType Directory -Force $directory | Out-Null\n+Get-ChildItem $directory -Filter '*.old' | ForEach-Object {\n+    $leftover = $_.FullName\n+    # Fails while still running, or after another run removed it first. The\n+    # second case throws even with -ErrorAction SilentlyContinue.\n+    try {\n+        Remove-Item -Force $leftover\n+    } catch {\n+        Write-Verbose \"kept ${leftover}: $_\"\n+    }\n+}\n+\n+# .NET resolves relative paths against the process directory, not $PWD.\n+$root = (Resolve-Path $directory).Path\n+$installed = Join-Path $root 'mbx.exe'\n+# A complete copy under a name no other run uses, so a failed copy or an\n+# overlapping run never leaves a partial or missing mbx.exe.\n+$staged = Join-Path $root \"mbx-$([guid]::NewGuid()).new\"\n+\n+try {\n+    Copy-Item $built $staged\n+    foreach ($attempt in 1..$attempts) {\n+        try {\n+            # An atomic replace, which Windows refuses while mbx.exe runs.\n+            [IO.File]::Move($staged, $installed, $true)\n+            return\n+        } catch [UnauthorizedAccessException], [IO.IOException] {\n+            $failure = $_\n+        } catch {\n+            $failure = $_\n+            break\n+        }\n+        $aside = Join-Path $root \"mbx-$([guid]::NewGuid()).old\"\n+        try {\n+            # ReplaceFile moves the running executable aside and puts the new\n+            # one in its place.\n+            [IO.File]::Replace($staged, $installed, $aside)\n+            return\n+        } catch {\n+            # Another run may have replaced or removed it meanwhile; try again.\n+            $failure = $_\n+            # ReplaceFile can fail after moving the old file aside.\n+            if ((Test-Path $aside) -and -not (Test-Path $installed)) {\n+                try {\n+                    [IO.File]::Move($aside, $installed)\n+                } catch {\n+                    Write-Warning \"could not restore $installed from ${aside}: $_\"\n+                }\n+            }\n+        }\n+    }\n+    throw $failure\n+} finally {\n+    # Nothing is left after a successful install. After a failure, including a\n+    # copy that stopped partway, remove this run's partial or unused copy.\n+    if (Test-Path -LiteralPath $staged) {\n+        try {\n+            Remove-Item -Force -LiteralPath $staged\n+        } catch {\n+            Write-Warning \"could not remove ${staged}: $_\"\n+        }\n+    }\n+}"}]}