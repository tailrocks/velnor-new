_id":"RA_kwDOU73bVs4neIfz","name":"jactionlint_2.3.0_windows_arm64.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":6774682,"digest":"sha256:3e281bdc90c4ad99d9827362f2419e701e0733920227247a07212e22c5d183ac","download_count":88,"created_at":"2026-10-21T11:00:38Z","updated_at":"2026-10-21T11:00:38Z","browser_download_url":"https://github.com/jdx/jactionlint/releases/download/v2.3.0/jactionlint_2.3.0_windows_arm64.zip"},{"url":"https://api.github.com/repos/jdx/jactionlint/releases/assets/662213047","id":662213047,"node_id":"RA_kwDOU73bVs4neJG3","name":"packslip.sigstore.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":21696,"digest":"sha256:3f7f7be6f9617910c9ac92451d0ea022f942511a4610a929572e8116502709d7","download_count":361,"created_at":"2026-10-21T11:01:33Z","updated_at":"2026-10-21T11:01:33Z","browser_download_url":"https://github.com/jdx/jactionlint/releases/download/v2.3.0/packslip.sigstore.json"}],"tarball_url":"https://api.github.com/repos/jdx/jactionlint/tarball/v2.3.0","zipball_url":"https://api.github.com/repos/jdx/jactionlint/zipball/v2.3.0","body":"jactionlint 2.3.0 adds an `allow-unused` option to `ignores` entries in the config file and fixes a `workflow-call-permissions` false positive for OIDC. It is also built with Go 1.27.3, so online checks reject certificates from the compromised eMudhra CA.\n\n## Added\n\n- **`allow-unused` for durable ignores.** An `ignores` entry with `allow-unused: true` is not reported as `unused-ignore` when it suppresses nothing. Use it for findings that come and go, such as one caused by a moving tag. `expired-ignore` still reports the entry when it expires. The default is `false`, and any value other than `true` or `false` is a config error. The option is also in the config JSON Schema. (#297, @jdx)\n  ```yaml\n  ignores:\n    - rule: unpinned-uses\n      uses: actions/cache\n      reason: pinned by the Actions lock file on some branches\n      allow-unused: true\n  ```\n\n## Fixed\n\n- **`workflow-call-permissions`** no longer reports a missing `id-token: write` when the caller sets no `permissions:` and `assume-default-permissions` is `permissive` or not set. In that case, GitHub gives the called job an OIDC token. With `assume-default-permissions: restricted`, jactionlint still reports it. (#299, @jdx)\n- **Online checks reject forged certificates from the compromised eMudhra CA.** Release binaries are now built with Go 1.27.3, which rejects these certificate chains. Older binaries do not have this fix, so replace them with this release if you use `--online`. (#301, @jdalton)\n\n## New Contributors\n\n* @jdalton made their first contribution in #292\n\n**Full Changelog**: https://github.com/jdx/jactionlint/compare/v2.2.0...v2.3.0\n\n## 💚 Sponsor jactionlint\n\njactionlint is a fork of [rhysd/actionlint](https://github.com/rhysd/actionlint), maintained by [@jdx](https://github.com/jdx), an open source developer at [**entire.io**](https://entire.io/), the title sponsor of his open source work.\n\nIf jactionlint has a place in your development workflow, please consider becoming an [individual or company sponsor](https://jdx.dev/sponsors.html). Your support funds ongoing development and helps keep jactionlint fast, free, and independent.\n","mentions_count":2}