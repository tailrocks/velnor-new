//! Turn launch routes preserve pair budgets and configured capacity.

use std::cell::RefCell;
use std::rc::Rc;

use crate::error::HostError;
use crate::journal::{LaunchIdentity, LaunchReservation};
use crate::launch_harness::{Mode, Script, available, ctx, open};
use crate::worker::{
    BollardCreate, PreparedDind, ResourceBudget, ResourceBudgetConfig, Started, bollard_create,
    dind_create, runner_create_for_identity,
};

use super::super::capacity::{CapacityHysteresis, GuestResourceLimits, install_job_capacity};
use super::super::{Drive, LaunchWorker, drive_ready, scale_session};
use super::policy::TurnPolicy;

type ContainerLimits = (Option<i64>, Option<i64>, Option<i64>);

struct RecordedPair {
    budget: ResourceBudget,
    dind: ContainerLimits,
    runner: Option<ContainerLimits>,
}

#[derive(Clone, Default)]
struct RecordingWorker {
    pairs: Rc<RefCell<Vec<RecordedPair>>>,
}

fn budget(
    runner_cpu_millicores: u64,
    runner_memory_bytes: u64,
    dind_cpu_millicores: u64,
    dind_memory_bytes: u64,
) -> Result<ResourceBudget, HostError> {
    ResourceBudgetConfig {
        runner_cpu_millicores,
        runner_memory_bytes,
        dind_cpu_millicores,
        dind_memory_bytes,
    }
    .validate()
}

fn container_limits(create: &BollardCreate) -> Result<ContainerLimits, HostError> {
    let host = create
        .config
        .host_config
        .as_ref()
        .ok_or(HostError::Docker)?;
    Ok((host.nano_cpus, host.memory, host.memory_swap))
}

fn assert_pair_limits(
    pair: &RecordedPair,
    budget: ResourceBudget,
    dind: ContainerLimits,
    runner: ContainerLimits,
) {
    assert_eq!(pair.budget, budget);
    assert_eq!(pair.dind, dind);
    assert_eq!(pair.runner, Some(runner));
}

impl LaunchWorker for RecordingWorker {
    async fn prepare_dind(
        &self,
        identity: &LaunchIdentity,
        resource_budget: ResourceBudget,
    ) -> Result<PreparedDind, HostError> {
        let dind = dind_create(identity, resource_budget)?;
        let limits = container_limits(&bollard_create(&dind)?)?;
        self.pairs.borrow_mut().push(RecordedPair {
            budget: resource_budget,
            dind: limits,
            runner: None,
        });
        PreparedDind::from_journal(
            identity,
            "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            resource_budget,
        )
    }

    async fn start_runner(
        &self,
        prepared: &PreparedDind,
        _payload: &[u8],
    ) -> Result<Started, HostError> {
        let budget = prepared.resource_budget();
        let runner = runner_create_for_identity(prepared.identity(), None, budget)?;
        let limits = container_limits(&bollard_create(&runner)?)?;
        let mut pairs = self.pairs.borrow_mut();
        let pair = pairs
            .iter_mut()
            .find(|pair| pair.budget == budget && pair.runner.is_none())
            .ok_or(HostError::Config)?;
        pair.runner = Some(limits);
        Ok(Started {
            dind_id: prepared.dind_id().to_owned(),
            runner_id: "runner-test".to_owned(),
        })
    }
}

async fn run_initial_callback(
    journal: &crate::Journal,
    worker: &RecordingWorker,
    resource_budget: ResourceBudget,
) -> Result<(), String> {
    let policy = TurnPolicy::new(resource_budget, 4);
    let context = ctx();
    let mut transport = Script {
        calls: Vec::new(),
        mode: Mode::Ok,
    };
    let launched = policy
        .scale_session(|budget| {
            scale_session(
                &mut transport,
                &context,
                journal,
                "statistics",
                budget,
                worker,
            )
        })
        .await
        .map_err(|error| error.to_string())?;
    assert!(launched.is_some());
    assert_eq!(transport.calls, ["jit"]);
    Ok(())
}

async fn run_assignment_callback(
    journal: &crate::Journal,
    worker: &RecordingWorker,
    resource_budget: ResourceBudget,
) -> Result<(), String> {
    let polled = available(&[42]);
    let admission = super::admission(journal, 1, 4, 4, 0, 0, &polled)
        .await
        .map_err(|error| error.to_string())?;
    assert_eq!(admission.decision, super::Admit::Start { stop: false });
    assert!(matches!(
        admission.reservation,
        Some(LaunchReservation::New(_))
    ));

    let policy = TurnPolicy::new(resource_budget, 4);
    let context = ctx();
    let mut transport = Script {
        calls: Vec::new(),
        mode: Mode::Ok,
    };
    let launched = policy
        .drive_ready(|budget| {
            drive_ready(
                &mut transport,
                &context,
                &polled,
                journal,
                admission.reservation,
                budget,
                worker,
            )
        })
        .await
        .map_err(|error| error.to_string())?;
    assert!(launched.is_some());
    assert_eq!(transport.calls, ["acquire", "jit", "ack"]);
    Ok(())
}

#[tokio::test]
async fn production_launch_routes_forward_distinct_budgets_to_both_host_configs()
-> Result<(), String> {
    let _capacity = install_job_capacity(4);
    let (_scratch, journal) = open("budget-forwarding").await?;
    let worker = RecordingWorker::default();
    let initial_budget =
        budget(750, 1_073_741_824, 2_000, 2_147_483_648).map_err(|error| error.to_string())?;
    let assignment_budget =
        budget(1_500, 3_221_225_472, 500, 1_073_741_824).map_err(|error| error.to_string())?;
    run_initial_callback(&journal, &worker, initial_budget).await?;
    run_assignment_callback(&journal, &worker, assignment_budget).await?;

    let pairs = worker.pairs.borrow();
    assert_eq!(pairs.len(), 2);
    assert_pair_limits(
        &pairs[0],
        initial_budget,
        (
            Some(2_000_000_000),
            Some(2_147_483_648),
            Some(2_147_483_648),
        ),
        (Some(750_000_000), Some(1_073_741_824), Some(1_073_741_824)),
    );
    assert_pair_limits(
        &pairs[1],
        assignment_budget,
        (Some(500_000_000), Some(1_073_741_824), Some(1_073_741_824)),
        (
            Some(1_500_000_000),
            Some(3_221_225_472),
            Some(3_221_225_472),
        ),
    );
    Ok(())
}

#[test]
fn configured_max_jobs_caps_measured_capacity_and_unknown_metrics_yield_one()
-> Result<(), HostError> {
    let policy = TurnPolicy::new(budget(750, 1_073_741_824, 2_000, 2_147_483_648)?, 4);
    let mut capacity = CapacityHysteresis::new();
    let unknown = policy.capacity(&mut capacity, GuestResourceLimits::default(), 0);
    assert_eq!(unknown.ceiling, 1);
    assert_eq!(unknown.occupied, 0);

    let measured = GuestResourceLimits {
        cpu_workers: Some(8),
        memory_workers: Some(8),
        storage_workers: Some(8),
    };
    let _candidate = policy.capacity(&mut capacity, measured, 0);
    let capped = policy.capacity(&mut capacity, measured, 0);
    assert_eq!(capped.ceiling, 4);
    Ok(())
}
